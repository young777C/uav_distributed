     8	  now=$(date +%s)
     9	  e=$(cat $L/zoo_*.log 2>/dev/null | grep -cE "FAILED|Traceback|server died|HANG")
    10	  if [ "$e" -gt "$seen_err" ]; then echo "[$(date +%H:%M)] ⚠ new failure line(s) — check logs"; seen_err=$e; fi
    11	  done_arms=$(grep -c "done  zoo_pgif_trk_" $L/progress.log)
    12	  if [ $((now - last)) -ge 120 ] || [ "$done_arms" -ge 5 ]; then
    13	    n=$(cat $L/zoo_pgif_trk_*_p*.log 2>/dev/null | grep -cE "ep[0-9]+ seed")
    14	    cmp=$(python3 $D/oracle_cmp.py 2>/dev/null)
    15	    echo "[$(date +%H:%M)] 上界诊断(目标不在候选→强制弃权)${n}/20 集，完成 ${done_arms}/5 段 | 承诺正确/最长正确/最长锁错(上界/v1):${cmp}"
    16	    last=$now
    17	    [ "$done_arms" -ge 5 ] && break
    18	  fi
    19	  sleep 10
    20	done
    21	echo "[$(date +%H:%M)] ticker stopped"
