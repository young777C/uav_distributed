     1	"""DAM4SAM socket service (runs in the isolated `dam4sam` conda env / dam4sam-svc container).
     2	
     3	External-baseline bridge: the policy-server (cu118, tid_head=dam4sam) can't share a process with
     4	DAM4SAM (torch2.1 + SAM2). This tiny server loads DAM4SAMTracker and serves it over the length-
     5	prefixed-pickle bridge (rollout/bridge.py). Protocol (dicts):
     6	  {cmd:init,  rgb:(H,W,3) uint8, box:(x,y,w,h)} -> {ok, bbox:(x,y,w,h)|None}   # reset+init from target box
     7	  {cmd:track, rgb:(H,W,3) uint8}                -> {bbox:(x,y,w,h)|None}        # predicted target box
     8	  {cmd:close}                                    -> {ok}
     9	bbox is derived from DAM4SAM's predicted mask (min/max of nonzero). None if the mask is empty.
    10	
    11	Launch (in dam4sam-svc): conda activate dam4sam && python .../dam4sam_service.py --model sam21pp-L --port 5601
    12	"""
    13	from __future__ import annotations
    14	import argparse
    15	import os
    16	import socket
    17	import sys
    18	
    19	import numpy as np
    20	from PIL import Image
    21	
    22	_REPO = "/nvidia/hque/code/cyhe/uav-acot-track"
    23	sys.path.insert(0, os.path.join(_REPO, "carla_uav_tracking"))
    24	sys.path.insert(0, os.path.join(_REPO, "external/DAM4SAM"))
    25	os.chdir(os.path.join(_REPO, "external/DAM4SAM"))
    26	
    27	from rollout.bridge import send_msg, recv_msg  # noqa: E402
    28	
    29	
    30	def _mask_to_bbox(m):
    31	    m = np.asarray(m)
    32	    ys, xs = np.where(m > 0)
    33	    if len(xs) == 0:
    34	        return None
    35	    return (float(xs.min()), float(ys.min()), float(xs.max() - xs.min()), float(ys.max() - ys.min()))
    36	
    37	
    38	def _pred_mask(out):
    39	    if isinstance(out, dict):
    40	        return out.get("pred_mask", next(iter(out.values())))
    41	    return out
    42	
    43	
    44	def main():
    45	    ap = argparse.ArgumentParser()
    46	    ap.add_argument("--model", default="sam21pp-L", choices=["sam21pp-L", "sam21pp-B", "sam21pp-S", "sam21pp-T"])
    47	    ap.add_argument("--port", type=int, default=5601)
    48	    a = ap.parse_args()
    49	    from dam4sam_tracker import DAM4SAMTracker
    50	    tracker = DAM4SAMTracker(a.model)
    51	    print(f"[dam4sam-svc] tracker loaded ({a.model}, ckpt={os.path.basename(tracker.checkpoint)})", flush=True)
    52	
    53	    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    54	    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    55	    srv.bind(("0.0.0.0", a.port)); srv.listen(1)
    56	    print(f"[dam4sam-svc] listening on 0.0.0.0:{a.port}", flush=True)
    57	    while True:
    58	        conn, addr = srv.accept()
    59	        print(f"[dam4sam-svc] client {addr}", flush=True)
    60	        try:
    61	            while True:
    62	                msg = recv_msg(conn); cmd = msg.get("cmd")
    63	                if cmd == "init":
    64	                    img = Image.fromarray(np.asarray(msg["rgb"], dtype=np.uint8))
    65	                    x, y, w, h = msg["box"]
    66	                    out = tracker.initialize(img, None, bbox=(int(x), int(y), int(w), int(h)))
    67	                    send_msg(conn, {"ok": True, "bbox": _mask_to_bbox(_pred_mask(out))})
    68	                elif cmd == "track":
    69	                    img = Image.fromarray(np.asarray(msg["rgb"], dtype=np.uint8))
    70	                    out = tracker.track(img)
    71	                    send_msg(conn, {"bbox": _mask_to_bbox(_pred_mask(out)), "iou": out.get("iou", float("nan"))})
    72	                elif cmd == "close":
    73	                    send_msg(conn, {"ok": True}); break
    74	                else:
    75	                    send_msg(conn, {"error": f"unknown cmd {cmd}"})
    76	        except (ConnectionError, EOFError) as e:
    77	            print(f"[dam4sam-svc] client disconnected: {e}", flush=True)
    78	        finally:
    79	            conn.close()
    80	
    81	
    82	if __name__ == "__main__":
    83	    main()
     1	"""Env-side stub that forwards .act() to the policy server over TCP (bridge.py).
     2	
     3	Implements the same .reset()/.act() contract StudentRolloutEnv expects, so the env
     4	loop is unchanged whether the policy is local or remote. Reconstructs a lightweight
     5	`info` (cand_set with per-slot identity/depth + pred_slot) for the scorer — the big
     6	VLM features never cross the wire.
     7	"""
     8	
     9	from __future__ import annotations
    10	
    11	import socket
    12	from types import SimpleNamespace
    13	
    14	import numpy as np
    15	
    16	from rollout.bridge import send_msg, recv_msg
    17	
    18	
    19	class RemotePolicy:
    20	    def __init__(self, host: str, port: int, timeout: float = 120.0):
    21	        self.sock = socket.create_connection((host, port), timeout=timeout)
    22	
    23	    def reset(self):
    24	        send_msg(self.sock, {"cmd": "reset"})
    25	        recv_msg(self.sock)
    26	
    27	    def act(self, obs, gt_candidates):
    28	        send_msg(self.sock, {"cmd": "act", "rgb": obs.rgb, "language": obs.language,
    29	                             "proprio": np.asarray(obs.proprio), "step": int(obs.step),
    30	                             "target_color": getattr(obs, "target_color", ""),
    31	                             "target_bp": getattr(obs, "target_bp", ""),
    32	                             "rgb_hi": getattr(obs, "rgb_hi", None),
    33	                             "retarget_event": bool(getattr(obs, "retarget_event", False)),
    34	                             "gt_candidates": gt_candidates})
    35	        r = recv_msg(self.sock)
    36	        cl = r.get("cand_lite")
    37	        if cl is None:
    38	            cand_set = None
    39	        else:
    40	            cand_set = SimpleNamespace(
    41	                cands=[SimpleNamespace(**c) for c in cl["cands"]],
    42	                true_idx=cl["true_idx"])
    43	        info = SimpleNamespace(cand_set=cand_set, pred_slot=r["pred_slot"])
    44	        return tuple(r["action"]), r["search_mode"], info
    45	
    46	    def close(self):
    47	        try:
    48	            send_msg(self.sock, {"cmd": "close"})
    49	            recv_msg(self.sock)
    50	        except OSError:
    51	            pass
    52	        self.sock.close()
     1	"""Length-prefixed pickle wire protocol for the env↔policy socket bridge.
     2	
     3	The CARLA env (cyh-carla, py3.6) and the VLA policy (acot-uav-train, py3.11) cannot
     4	share a process (incompatible python/torch/carla). They talk over TCP on the shared
     5	`cyh-carla-net`: the env sends each tick's frame + GT, the policy returns the action.
     6	
     7	pickle protocol 2 so a py3.11 server can read a py3.6 client's frames and vice-versa.
     8	numpy arrays pickle portably across versions. Messages are plain dicts.
     9	"""
    10	
    11	from __future__ import annotations
    12	
    13	import pickle
    14	import socket
    15	import struct
    16	
    17	_PROTO = 2
    18	_HDR = struct.Struct(">Q")     # 8-byte big-endian length prefix
    19	
    20	
    21	def send_msg(sock: socket.socket, obj) -> None:
    22	    data = pickle.dumps(obj, protocol=_PROTO)
    23	    sock.sendall(_HDR.pack(len(data)) + data)
    24	
    25	
    26	def _recv_exact(sock: socket.socket, n: int) -> bytes:
    27	    buf = bytearray()
    28	    while len(buf) < n:
    29	        chunk = sock.recv(n - len(buf))
    30	        if not chunk:
    31	            raise ConnectionError("socket closed mid-message")
    32	        buf.extend(chunk)
    33	    return bytes(buf)
    34	
    35	
    36	def recv_msg(sock: socket.socket):
    37	    (n,) = _HDR.unpack(_recv_exact(sock, _HDR.size))
    38	    return pickle.loads(_recv_exact(sock, n))

