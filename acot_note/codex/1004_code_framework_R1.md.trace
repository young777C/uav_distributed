     2	(v1 attribute opening + TAHRelM + PGIF tempered/absent-hold, deployable v2: tracker ids + occlusion-aware candidates),
     3	dev 91000–19, vs the old setting V0 (ideal sim ids, all in-frame candidates). Per S2 tick:
     4	  true = target slot among the candidates (−1 = target not a candidate: occluded / out of frame), mem = TAHRelM's raw
     5	  pick, anc = PGIF output (committed pick; None/−1 = absent).
     6	GT is used only to score.   python tah_need.py"""
     7	import collections
     8	
     9	import numpy as np
    10	
    11	import opening_cl as oc
    12	
    13	ARMS = {"v1 开局 + 部署 v2(最终模型)": ["zoa_pgif_trk_a", "zoa_pgif_trk_b", "zoa_pgif_trk_c"],
    14	        "H-A(原开局)+ 部署 v2": ["v2h_pgif_trk"]}
