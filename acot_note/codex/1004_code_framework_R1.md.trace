     6	last=0
     7	while [ ! -e $D/STOP ]; do
     8	  now=$(date +%s)
     9	  e=$(cat $D/logs/train_s*.log $L/zv90s0*.log 2>/dev/null | grep -cE "Traceback|Error|FAILED|server died|HANG")
    10	  [ "$e" -gt "$seen" ] && { echo "[$(date +%H:%M)] ⚠ new failure line(s) — check logs"; seen=$e; }
    11	  if [ $((now - last)) -ge 120 ]; then
    12	    tr=$(for s in 0 1 2; do l=$(grep "\] ep" $D/logs/train_s$s.log 2>/dev/null | tail -1); echo -n "s$s $(echo "$l" | grep -oE 'ep[0-9]+/[0-9]+') val $(echo "$l" | grep -oE 'val_acc=[0-9.]+' | cut -d= -f2) best $(echo "$l" | grep -oE 'best=[0-9.]+' | cut -d= -f2); "; done)
    13	    gb=$(cat $L/zv90s0_pgif_trk_*_p*.log 2>/dev/null | grep -cE "ep[0-9]+ seed"); gl=$(cat $L/zv90s0L_pgif_trk_*_p*.log 2>/dev/null | grep -cE "ep[0-9]+ seed")
    14	    st=$(tail -1 $D/logs/pipeline.log | cut -c9-80)
    15	    echo "[$(date +%H:%M)] 训练 ${tr}| dev 验收 best ${gb}/20 · last ${gl}/20 | 流水线:${st}"
    16	    last=$now
    17	    grep -q "pipeline done" $D/logs/pipeline.log && { grep -A 14 "== s0 BEST" $D/logs/pipeline.log; break; }
    18	  fi
    19	  sleep 15
    20	done

