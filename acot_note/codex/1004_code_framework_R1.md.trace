    63	                frames.append({"feat": feats.astype(np.float16), "pos": pos,
    64	                               "aidx": np.array(aidx, np.int16), "tidx": tidx})
    65	            if frames: episodes.append(frames); order.append(ei)   # ei = position in the full ordered list
    66	        print(f"[tah_cache] ep{ei} {os.path.basename(ep)}: {len(frames)} frames (total eps={len(episodes)})", flush=True)
    67	    torch.save({"episodes": episodes, "d_feat": 384, "order": order, "fov": fov}, a.out)
    68	    nf = sum(len(e) for e in episodes)
    69	    print(f"[tah_cache] wrote {a.out}: {len(episodes)} episodes, {nf} frames", flush=True)
