### runs/opening_dump/run_dump.sh
     1	#!/usr/bin/env bash
     2	# Opening benchmark dump (1004 opening-fix plan): short episodes (13 steps → S2 ticks 0/6/12) with occlusion-aware
     3	# candidates; policy saves frame + candidates + language + current grounding logits at those ticks.
     4	#   usage: run_dump.sh <k> <carla_port> <gpu> <seed_base> <episodes>
     5	cd /nvidia/hque/code/cyhe/uav-acot-track; D=runs/opening_dump
     6	k=$1; CP=$2; G=$3; SB=$4; N=$5
     7	SRV=dump-$k CARLA_PORT=$CP GPU=$G TM_PORT=$((9700 + 10 * k)) OUT_NAME=open_dump_$k EPISODES=$N SEED_BASE=$SB STEPS=13 \
     8	  VIS_RAYCAST=1 OPENING_DUMP=$PWD/$D/npz \
     9	  HEAD_ARGS="--tid-head tah --tah-ckpt runs/tah_relm_dag.pt --conf-tau 0.5 --gallery-seed committed --reanchor off --occl-cands" \
    10	  bash carla_uav_tracking/rollout/eval_asd.sh > $D/logs/dump_$k.log 2>&1 < /dev/null
    11	echo "[$(date +%H:%M)] dump $k done" >> $D/logs/progress.log
