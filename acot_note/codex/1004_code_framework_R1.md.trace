### runs/opening_dump/start_base.sh
     1	#!/usr/bin/env bash
     2	# Start 3 extra CARLA servers one at a time (Town05 preloaded), then the PAIRED BASELINE of the held-out opening
     3	# validation: OPENING=head (current grounding head) on the same seeds 93100–93239.
     4	cd /nvidia/hque/code/cyhe/uav-acot-track/runs/opening_dump
     5	start() { CP=$1; A=$2
     6	  docker exec -d cyh-carla bash -c "/home/carla/CarlaUE4.sh -RenderOffScreen -graphicsadapter=$A -carla-rpc-port=$CP -nosound -fps=20 > /tmp/carla_$CP.log 2>&1"
     7	  for i in $(seq 1 60); do docker exec cyh-carla python -c "import socket;s=socket.socket();s.settimeout(2);s.connect(('127.0.0.1',$CP))" 2>/dev/null && break; sleep 10; done; sleep 20
     8	  docker exec cyh-carla python -c "import carla;c=carla.Client('127.0.0.1',$CP);c.set_timeout(180);c.load_world('Town05')" \
     9	    && echo "[$(date +%H:%M)] CARLA $CP up (adapter $A), Town05 preloaded" >> logs/progress.log
    10	}
    11	start 2270 5; start 2290 7; start 2310 6
    12	bash run_openval.sh head 5 2270 5 93100 47 head '' &
    13	bash run_openval.sh head 6 2290 7 93147 47 head '' &
    14	bash run_openval.sh head 7 2310 0 93194 46 head '' &
    15	wait
### runs/opening_dump/wait_f_v3.sh
     1	#!/usr/bin/env bash
     2	# start F-v3 (dev downstream with the v3 opening) on each server as soon as its v1 F arm is finished
     3	cd /nvidia/hque/code/cyhe/uav-acot-track/runs/opening_dump; L=../asd/iter
     4	for x in a b; do (
     5	  until [ $(cat $L/zoa_pgif_trk_${x}_p*.log 2>/dev/null | grep -cE 'ep[0-9]+ seed') -ge 7 ] && ! docker ps --format '{{.Names}}' | grep -q "^it-zoa_pgif_trk_${x}$"; do sleep 20; done
     6	  sleep 10; bash chains_v3.sh $x ) &
     7	done
     8	wait

