    24	    if os.path.exists(f):
    25	        print(len(json.load(open(f))["episodes"])); break
    26	else:
    27	    print(0)
    28	EOF
    29	}
    30	echo "[$(date +%H:%M)] start $NAME ($TOWN) [watchdog]" >> $L/progress.log
    31	done_eps=0; part=${START_PART:-1}; parts=""; P0=$part   # START_PART: resume after a host reboot without overwriting earlier parts
    32	while [ $done_eps -lt $N ]; do
    33	  out=paper_it_${NAME}_p$part; log=$L/${NAME}_p$part.log; parts="$parts $EO/$out.json"
    34	  TOWN=$TOWN TM_PORT=$((TM + 10 * (part - 1))) ASD_CFG=$CFG SRV=it-$NAME CARLA_PORT=$CP GPU=$GPU OUT_NAME=$out \
    35	    SEED_BASE=$((B + done_eps)) EPISODES=$((N - done_eps)) ASD_LOG=$PWD/$L/${NAME}_p$part.jsonl HEAD_ARGS="$HEAD" \
    36	    setsid bash $R/eval_asd.sh > $log 2>&1 < /dev/null &
    37	  EV=$!; last=$(date +%s); seen=0; limit=$FIRST; hung=0
    38	  while kill -0 $EV 2>/dev/null; do
    39	    sleep 30; c=$(grep -cE 'ep[0-9]+ seed' $log)
    40	    if [ "$c" -gt "$seen" ]; then seen=$c; last=$(date +%s); limit=$STALL; fi
    41	    if [ $(( $(date +%s) - last )) -gt $limit ]; then hung=1; break; fi
    42	  done
    43	  if [ $hung = 1 ]; then
    44	    echo "[$(date +%H:%M)] HANG $NAME part$part after $seen eps on CARLA $CP → restart + resume" >> $L/progress.log
    45	    pkill -TERM -s $(ps -o sid= -p $EV | tr -d ' ') 2>/dev/null; kill $EV 2>/dev/null
    46	    docker exec cyh-carla pkill -f "policy-host it-$NAME " ; docker rm -f it-$NAME >/dev/null 2>&1
    47	    restart_carla
    48	  fi
    49	  wait $EV 2>/dev/null
    50	  k=$(count_done $EO/$out.json); done_eps=$((done_eps + k)); part=$((part + 1))
    51	  if [ $hung = 0 ] && [ "$k" = 0 ] && [ $done_eps -lt $N ]; then
    52	    # client died without finishing an episode (e.g. simulator time-out after a mid-tick client death leaves the
    53	    # sync-mode server wedged) → restart the server before the next part instead of reconnecting to a dead one
    54	    echo "[$(date +%H:%M)] FAILED-0ep $NAME part$((part - 1)) on CARLA $CP → restart CARLA + resume" >> $L/progress.log
    55	    docker exec cyh-carla pkill -f "policy-host it-$NAME " ; docker rm -f it-$NAME >/dev/null 2>&1
    56	    restart_carla
    57	  fi
    58	  [ $part -gt $((P0 + 5)) ] && { echo "[$(date +%H:%M)] GIVE UP $NAME after 5 restarts" >> $L/progress.log; break; }
    59	done
    60	python3 - $EO/paper_it_$NAME.json $parts <<'EOF'
    61	import glob, json, os, re, sys
    62	out = sys.argv[1]; eps = []
    63	# merge EVERY part of this arm (incl. parts written by an earlier invocation before a resume), ordered by part number
    64	parts = sorted({re.sub(r"\.partial$", "", p) for p in glob.glob(out[:-5] + "_p[0-9]*.json*")},
    65	               key=lambda p: int(re.search(r"_p(\d+)\.json$", p).group(1)))
