runs/asd/iter/status_ticker.sh:2:# Progress ticker for the 1003 iteration: one status line every 120 s; immediate lines on arm done / failure /
runs/asd/iter/status_ticker.sh:9:    n=$(basename $f .log); c=${n%_p[0-9]}; docker ps --format '{{.Names}}' | grep -q "^it-$c$" || continue
runs/asd/iter/status_ticker.sh:10:    tot=$(grep -oE "episodes=[0-9]+" $f | head -1 | cut -d= -f2); s="$s $n $(grep -cE 'ep[0-9]+ seed' $f)/${tot:-20}"
runs/asd/iter/status_ticker.sh:12:  carla=$(docker exec cyh-carla bash -c 'ps -eo args | grep Shipping | grep -v grep | wc -l' 2>/dev/null || echo 0)
runs/asd/iter/status_ticker.sh:13:  dam=$(docker exec dam4sam-svc bash -c 'ps -eo args | grep [d]am4sam_service.py | grep -c python' 2>/dev/null || echo 0)
runs/asd/iter/status_ticker.sh:14:  echo "$s | CARLA×$carla DAM4SAM×$dam | done $(grep -c 'done  ' progress.log)"
