 succeeded in 0ms:
     1	"""What decides correct re-acquisition? (dev, Town05, seeds 91000–19; tick logs aligned to scorer seeds per part)
     2	(1) Episode level: share of the variance of the committed correct-lock ratio explained by opening correctness (R²), and
     3	    the decomposition  mean = P(open ok)·C_ok + P(open wrong)·C_wrong.
     4	(2) Event level: every RE-APPEARANCE of the target among the candidates after ≥1 tick of absence (occluded / out of
     5	    frame). Outcome over the first 5 ticks after re-appearance: RE-ACQUIRED (output = target in ≥3), WRONG (output =
     6	    a distractor in ≥3), else MIXED. Factors: opening correct, pre-loss lock correct (output = target at the last tick
     7	    before the absence), absence length, target tracker-id changed across the absence (tracker arms), look-alikes.
     8	GT is used only for scoring.   python reacq_factors.py"""
     9	import collections
    10	import glob
    11	import json
    12	import os
    13	
    14	import numpy as np
    15	
    16	import iter_gate as g
    17	
    18	LG = os.path.join(os.path.dirname(__file__), "..", "..", "runs", "asd")
    19	ARMS = [("V0 旧设定(理想 ID,不考虑遮挡)", "pgif", ["deploy_all/tahrelm_pgif.jsonl"], "eval_out/paper_dep_tahrelm_pgif.json"),
    20	        ("B  PGIF·理想 ID", "v2_pgif_sim", None, None), ("H-B PGIF+不可见·理想 ID", "v2h_pgif_sim", None, None),
    21	        ("A′ PGIF·调后跟踪器", "v2t_pgif_trk", None, None), ("H-A PGIF+不可见·调后跟踪器", "v2h_pgif_trk", None, None)]
    22	
    23	
    24	def aligned(stem, logs, json_path):
    25	    """seed -> sorted tick records."""
    26	    pairs = []
    27	    if logs:
    28	        pairs = [(os.path.join(LG, logs[0]), json_path)]
    29	    else:
    30	        for jl in sorted(glob.glob(os.path.join(LG, "iter", f"{stem}_p[0-9].jsonl"))):
    31	            k = jl.split("_p")[-1].split(".")[0]
    32	            js = sorted(glob.glob(f"eval_out/paper_it_{stem}_p{k}.json*"))
    33	            if js:
    34	                pairs.append((jl, js[-1]))
    35	    out = {}
    36	    for jl, js in pairs:
    37	        try:
    38	            eps = [e for e in json.load(open(js))["episodes"] if not e.get("skipped")]
    39	        except Exception:
    40	            continue
    41	        E = collections.defaultdict(list)
    42	        for line in open(jl):
    43	            try:
    44	                r = json.loads(line)
    45	            except ValueError:
    46	                continue
    47	            E[r["ep"]].append(r)
    48	        for ep, e in zip(sorted(E), eps):
    49	            out.setdefault(e["episode_seed"], sorted(E[ep], key=lambda r: r["t"]))
    50	    return out
    51	
    52	
    53	def out_id(r):
    54	    """identity output this tick: actor/tracklet id of PGIF's pick (None = absent / no pick)."""
    55	    s = r.get("anc") if "anc" in r else r.get("mem")
    56	    if s is None or s < 0 or s >= len(r["aidx"]):
    57	        return None
    58	    return r["aidx"][s]
    59	
    60	
    61	def events(R):
    62	    ev = []; i = 0
    63	    present = [r.get("true") is not None and r["true"] >= 0 for r in R]
    64	    while i < len(R):
    65	        if present[i]:
    66	            i += 1; continue
    67	        j = i
    68	        while j < len(R) and not present[j]:
    69	            j += 1
    70	        if i > 0 and j < len(R):                               # absence [i, j) bounded by presence on both sides
    71	            pre = R[i - 1]; post = R[j:j + 5]
    72	            tgt_pre = pre["aidx"][pre["true"]]; tgt_post = R[j]["aidx"][R[j]["true"]]
    73	            ok = sum(out_id(r) is not None and r["true"] >= 0 and out_id(r) == r["aidx"][r["true"]] for r in post)
    74	            wrong = sum(out_id(r) is not None and (r["true"] is None or r["true"] < 0 or out_id(r) != r["aidx"][r["true"]]) for r in post)
    75	            ev.append({"len": j - i, "pre_ok": out_id(pre) == tgt_pre, "id_changed": tgt_pre != tgt_post,
    76	                       "res": "re-acq" if ok >= 3 else ("wrong" if wrong >= 3 else "mixed"), "n_cand": len(R[j]["aidx"])})
    77	        i = j
    78	    return ev
    79	
    80	
    81	def main():
    82	    for lab, stem, logs, jpath in ARMS:
    83	        A = g.load(stem) if jpath is None else {e["episode_seed"]: e for e in json.load(open(jpath))["episodes"] if not e.get("skipped")}
    84	        T = aligned(stem, logs, jpath)
    85	        S = [s for s in A if s in T and T[s]]
    86	        op = {}
    87	        for s in S:
    88	            r0 = next((r for r in T[s] if r.get("true") is not None and r["true"] >= 0), None)
    89	            op[s] = r0 is not None and out_id(r0) == r0["aidx"][r0["true"]]
    90	        y = np.array([1 - A[s]["mis_follow_sustained"] for s in S]); x = np.array([op[s] for s in S], float)
    91	        r2 = np.corrcoef(x, y)[0, 1] ** 2 if x.std() > 0 else float("nan")
    92	        p = x.mean(); c_ok = y[x == 1].mean(); c_bad = y[x == 0].mean() if (x == 0).any() else float("nan")
    93	        print(f"\n## {lab}  (n={len(S)})")
    94	        print(f"  episode: R²(opening → correct ratio) = {r2:.2f} | P(open ok) {p:.2f} · C_ok {c_ok:.2f} + P(wrong) {1-p:.2f} · C_wrong {c_bad:.2f} = {y.mean():.3f}")
    95	        print(f"           if opening were always right (C_ok kept): {c_ok:.2f}  (+{c_ok - y.mean():.2f})")
    96	        EV = [(s, e) for s in S for e in events(T[s])]
    97	        if not EV:
    98	            continue
    99	        def rate(sel):
   100	            sub = [e for s, e in EV if sel(s, e)]
   101	            if not sub:
   102	                return "—"
   103	            c = collections.Counter(e["res"] for e in sub)
   104	            return f"n={len(sub):3d} 找回 {c['re-acq']/len(sub):.0%} 错锁 {c['wrong']/len(sub):.0%}"
   105	        print(f"  re-appearance events: {len(EV)}")
   106	        print(f"    all                         : {rate(lambda s, e: True)}")
   107	        print(f"    opening right / wrong       : {rate(lambda s, e: op[s])}  ||  {rate(lambda s, e: not op[s])}")
   108	        print(f"    pre-loss lock right / wrong : {rate(lambda s, e: e['pre_ok'])}  ||  {rate(lambda s, e: not e['pre_ok'])}")
   109	        print(f"    open right & pre-loss right : {rate(lambda s, e: op[s] and e['pre_ok'])}  ||  open wrong & pre-loss right: {rate(lambda s, e: (not op[s]) and e['pre_ok'])}")
   110	        print(f"    pre-loss right, absence ≤8 / >8 ticks : {rate(lambda s, e: e['pre_ok'] and e['len'] <= 8)}  ||  {rate(lambda s, e: e['pre_ok'] and e['len'] > 8)}")
   111	        if "trk" in stem:
   112	            print(f"    pre-loss right, target id kept / changed : {rate(lambda s, e: e['pre_ok'] and not e['id_changed'])}  ||  {rate(lambda s, e: e['pre_ok'] and e['id_changed'])}")
   113	        print(f"    pre-loss right, ≤4 / ≥5 candidates at re-appearance : {rate(lambda s, e: e['pre_ok'] and e['n_cand'] <= 4)}  ||  {rate(lambda s, e: e['pre_ok'] and e['n_cand'] >= 5)}")
   114	
