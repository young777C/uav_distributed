   116	if __name__ == "__main__":
   117	    main()
     1	"""Align ASD tick logs (runs/asd/*.jsonl, keyed by policy-reset index `ep`) to scorer episode seeds.
     2	Skipped episodes (e.g. 'target stationary') never reset the policy, so logged episodes map IN ORDER onto the
     3	NON-skipped seeds of the eval json. Verified by step counts (max logged t <= scorer steps, near-equal)."""
     4	import json, os
     5	
     6	EO = os.path.join(os.path.dirname(__file__), "eval_out")
     7	LG = os.path.join(os.path.dirname(__file__), "..", "..", "runs", "asd")
     8	
     9	
    10	def aligned(stem, jsonl):
    11	    """→ {seed: [tick records]} for non-skipped seeds."""
    12	    d = json.load(open(os.path.join(EO, stem + ".json")))
    13	    seeds = [e["episode_seed"] for e in d["episodes"] if not e.get("skipped")]
    14	    E = {}
    15	    for line in open(os.path.join(LG, jsonl + ".jsonl")):
    16	        r = json.loads(line); E.setdefault(r["ep"], []).append(r)
    17	    eps = sorted(E)
    18	    assert len(eps) <= len(seeds), (stem, len(eps), len(seeds))
    19	    return {s: E[e] for e, s in zip(eps, seeds)}
    20	
    21	
    22	def runs(S, field):
    23	    """Longest continuous CORRECT and WRONG run (s) over target-visible ticks (1 tick = 6 frames = 0.6 s); an
    24	    out-of-view tick ends both runs. Final pick = `field` (PGIF output 'anc') or the raw memory pick 'mem'."""
    25	    bc = bw = 0.0; cc = cw = 0; t0c = t0w = 0; ok_n = n = 0
    26	    for r in S:
    27	        if r["true"] is None or r["true"] < 0:
    28	            cc = cw = 0; continue
    29	        pick = r[field] if r.get(field) is not None else r["mem"]
    30	        ok = pick == r["true"]; n += 1; ok_n += ok
    31	        if ok:
    32	            t0c = r["t"] if cc == 0 else t0c; cc += 1; cw = 0; bc = max(bc, (r["t"] - t0c) / 10 + 0.6)
    33	        else:
    34	            t0w = r["t"] if cw == 0 else t0w; cw += 1; cc = 0; bw = max(bw, (r["t"] - t0w) / 10 + 0.6)
    35	    return bc, bw, (ok_n / n if n else float("nan"))
     1	"""1003 mechanism diagnostics from the per-tick ASD logs (runs/asd/iter/<arm>[_p<k>].jsonl), aligned to scorer seeds
     2	(skipped episodes never reset the policy → logged episodes map in order onto the NON-skipped seeds of the same part).
     3	Per arm: tick accuracy of every source and of the final output, opening correctness (first logged tick), and the
     4	committed correct-lock ratio stratified by opening correctness. Fusion arms (V3 family): error correlation between
     5	TAHRelM and DAM4SAM picks (pre-registered H3c: measured on V3-ensemble = no feedback), mis-gates (a source that was
     6	RIGHT gets rewritten to a WRONG posterior identity). V1: AUROC of the SAM2 predicted IoU for "DAM4SAM pick is right".
     7	  python iter_mech.py [--json eval_out/iter_mech.json]"""
     8	import argparse
     9	import glob
    10	import json
    11	import os
    12	import re
    13	
    14	import numpy as np
    15	
    16	EO = os.path.join(os.path.dirname(__file__), "eval_out")
    17	LG = os.path.join(os.path.dirname(__file__), "..", "..", "runs", "asd", "iter")
    18	ARMS = ["v1_t05", "v1nog_t05", "v2_t05", "v3_t05", "v3v2_t05", "v3ens_t05", "v3com_t05", "v3gt_t05",
    19	        "v3_t03", "v3_t10", "pgif_t03"]
    20	
    21	
    22	def _json_of(path):
    23	    for f in (path, path + ".partial"):
    24	        if os.path.exists(f):
    25	            return json.load(open(f))["episodes"]
    26	    return []
    27	
    28	
    29	def aligned(arm):
    30	    """→ {seed: (scorer episode, [tick records])}."""
    31	    out = {}
    32	    logs = sorted(glob.glob(os.path.join(LG, f"{arm}_p[0-9].jsonl"))) or [os.path.join(LG, f"{arm}.jsonl")]
    33	    for jl in logs:
    34	        if not os.path.exists(jl):
    35	            continue
    36	        m = re.search(r"_p(\d)\.jsonl$", jl)
    37	        eps = _json_of(os.path.join(EO, f"paper_it_{arm}_p{m.group(1)}.json" if m else f"paper_it_{arm}.json"))
    38	        scored = [e for e in eps if not e.get("skipped")]
    39	        E = {}
    40	        for line in open(jl):
    41	            r = json.loads(line)
    42	            E.setdefault(r["ep"], []).append(r)
    43	        for k, e in zip(sorted(E), scored):
    44	            out.setdefault(int(e["episode_seed"]), (e, E[k]))
    45	    return out
    46	
    47	
    48	def auroc(score, label):
    49	    s, y = np.asarray(score, float), np.asarray(label, bool)
    50	    if y.all() or (~y).all():
    51	        return float("nan")
    52	    r = np.argsort(np.argsort(s)) + 1.0
    53	    return float((r[y].sum() - y.sum() * (y.sum() + 1) / 2) / (y.sum() * (~y).sum()))
    54	
    55	
    56	def arm_stats(arm):
    57	    A = aligned(arm)
    58	    if not A:
    59	        return None
    60	    vis = lambda R: [r for r in R if r.get("true") is not None and r["true"] >= 0]
    61	    fused = any("picks" in r for _, R in A.values() for r in R)
    62	    out_key = "map" if fused else "anc"
    63	    res = {"arm": arm, "n_ep": len(A)}
    64	    T = [r for _, R in A.values() for r in vis(R)]
    65	    res["ticks"] = len(T)
    66	    res["acc_out"] = float(np.mean([r[out_key] == r["true"] for r in T]))
    67	    if fused:
    68	        for s in ("tah", "dam", "lang"):
    69	            P = [r for r in T if r["picks"].get(s) is not None and r["picks"][s] >= 0]
    70	            res[f"acc_{s}"] = float(np.mean([r["picks"][s] == r["true"] for r in P])) if P else float("nan")
    71	            res[f"present_{s}"] = len(P) / max(len(T), 1)
    72	        B = [r for r in T if r["picks"].get("tah") is not None and r["picks"].get("dam") is not None]
    73	        et = np.array([r["picks"]["tah"] != r["true"] for r in B], float)
    74	        ed = np.array([r["picks"]["dam"] != r["true"] for r in B], float)
    75	        res["rho_err"] = float(np.corrcoef(et, ed)[0, 1]) if len(B) > 2 and et.std() > 0 and ed.std() > 0 else float("nan")
    76	        res["p_dam_wrong_given_tah_wrong"] = float(ed[et == 1].mean()) if (et == 1).any() else float("nan")
    77	        res["both_wrong_same_id"] = float(np.mean([r["picks"]["tah"] == r["picks"]["dam"] != r["true"] for r in B]))
    78	        res["tah_eq_dam"] = float(np.mean([r["picks"]["tah"] == r["picks"]["dam"] for r in B]))
    79	        for s in ("tah", "dam"):   # gate events on a source = posterior ≠ its pick → its memory is rewritten
    80	            G = [r for r in T if r.get("gate", {}).get(s) and r["picks"].get(s) is not None]

