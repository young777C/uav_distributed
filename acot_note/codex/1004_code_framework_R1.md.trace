### runs/opening_dump/run_openval.sh
     1	#!/usr/bin/env bash
     2	# Closed-loop OPENING validation (1004 opening fix): short episodes (STEPS=19 → S2 ticks 0/6/12/18) with the FINAL
     3	# deployable model config (TAH + PGIF tempered + absent-hold, tuned tracker ids, ray-cast occlusion-aware candidates)
     4	# and the opening scorer under test. Held-out seeds (never used for training / selection).
     5	#   usage: run_openval.sh <tag> <k> <carla_port> <gpu> <seed_base> <episodes> <OPENING> '<OPENING_CFG>'
     6	cd /nvidia/hque/code/cyhe/uav-acot-track; D=runs/opening_dump
     7	tag=$1; k=$2; CP=$3; G=$4; SB=$5; N=$6
     8	export OPENING=$7 OPENING_CFG="$8" VIS_RAYCAST=1 HIRES=3
     9	export TRK_CFG='{"max_age":8,"w_app":0.85,"gate_px":150,"gate_box":2.0,"min_cos":0.2}'
    10	SRV=ov-$tag-$k CARLA_PORT=$CP GPU=$G TM_PORT=$((9600 + 10 * k)) OUT_NAME=open_val_${tag}_$k EPISODES=$N SEED_BASE=$SB STEPS=19 \
    11	  ASD_CFG='{"filter_kind":"tempered","resid_decay":0.98,"absent_hold":true,"absent_max":8}' ASD_LOG=$PWD/$D/val/${tag}_$k.jsonl \
    12	  HEAD_ARGS="--tid-head tah --tah-ckpt runs/tah_relm_dag.pt --conf-tau 0.5 --gallery-seed committed --reanchor off --occl-cands --tracklets tracker --asd filter" \
    13	  bash carla_uav_tracking/rollout/eval_asd.sh > $D/logs/ov_${tag}_$k.log 2>&1 < /dev/null
    14	echo "[$(date +%H:%M)] openval $tag $k done" >> $D/logs/progress.log
