### runs/opening_dump/launch_v4.sh
     1	#!/usr/bin/env bash
     2	# v4 opening (agg=last + force_final + seed_asd=3) — (1) F-v4: dev 91000–19 full-length closed loop on 5 servers (paired
     3	# with H-A / v1 / v3); (2) held-out opening validation on FRESH seeds 93520–93659 on 5 servers (3 restarted).
     4	cd /nvidia/hque/code/cyhe/uav-acot-track/runs/opening_dump; L=../asd/iter
     5	V4='{"window":3,"ft":0.5,"agg":"last","force_final":true,"seed_asd":3.0}'
     6	TAH="--tid-head tah --tah-ckpt runs/tah_relm_dag.pt --conf-tau 0.5 --gallery-seed committed --reanchor off --occl-cands --tracklets tracker"
     7	H='{"filter_kind":"tempered","resid_decay":0.98,"absent_hold":true,"absent_max":8}'
     8	export VIS_RAYCAST=1 HIRES=3 FIRST_MIN=25 OPENING=attr OPENING_CFG="$V4"
     9	export TRK_CFG='{"max_age":8,"w_app":0.85,"gate_px":150,"gate_box":2.0,"min_cos":0.2}'
    10	i=0
    11	for spec in "a 2050 1 9301" "b 2060 1 9331" "c 2070 2 9361" "d 2080 2 9391" "e 2250 4 9421"; do
    12	  set -- $spec
    13	  ( cd /nvidia/hque/code/cyhe/uav-acot-track && SEED_BASE=$((91000 + 4 * i)) EPISODES=4 bash $L/launch_wd.sh zo4_pgif_trk_$1 $2 $3 $4 Town05 "$TAH --asd filter" "$H" ) &
    14	  i=$((i + 1)); sleep 1
    15	done
    16	unset OPENING OPENING_CFG
    17	bash run_openval.sh v4 60 2090 4 93520 28 attr "$V4" &
    18	bash run_openval.sh v4 61 2230 5 93548 28 attr "$V4" &
    19	start() { CP=$1; A=$2
    20	  docker exec -d cyh-carla bash -c "/home/carla/CarlaUE4.sh -RenderOffScreen -graphicsadapter=$A -carla-rpc-port=$CP -nosound -fps=20 > /tmp/carla_$CP.log 2>&1"
    21	  for k in $(seq 1 60); do docker exec cyh-carla python -c "import socket;s=socket.socket();s.settimeout(2);s.connect(('127.0.0.1',$CP))" 2>/dev/null && break; sleep 10; done; sleep 20
    22	  docker exec cyh-carla python -c "import carla;c=carla.Client('127.0.0.1',$CP);c.set_timeout(180);c.load_world('Town05')"; echo "[$(date +%H:%M)] CARLA $CP up" >> logs/progress.log
    23	}
    24	start 2270 5; bash run_openval.sh v4 62 2270 7 93576 28 attr "$V4" &
    25	start 2290 7; bash run_openval.sh v4 63 2290 0 93604 28 attr "$V4" &
    26	start 2310 6; bash run_openval.sh v4 64 2310 6 93632 28 attr "$V4" &
    27	wait
### runs/opening_dump/open_ticker.sh
     1	#!/usr/bin/env bash
     2	# Progress ticker for the opening-fix plan: every 120 s one line (dumps / offline scoring / closed-loop arms);
     3	# immediate lines on new failures. Exits when runs/opening_dump/STOP exists.
     4	D=/nvidia/hque/code/cyhe/uav-acot-track/runs/opening_dump; L=/nvidia/hque/code/cyhe/uav-acot-track/runs/asd/iter
     5	SC=/tmp/claude-1003/-nvidia-hque-code-cyhe/53155ce0-e03b-4eea-abe6-a0b3a03acfc0/tasks/blfnzau49.output
     6	seen_err=$(cat $D/logs/*.log $L/zo_*.log 2>/dev/null | grep -cE "FAILED|Traceback|server died|HANG")
     7	last=0
     8	while [ ! -e $D/STOP ]; do
     9	  now=$(date +%s)
    10	  e=$(cat $D/logs/*.log $L/zo_*.log 2>/dev/null | grep -cE "FAILED|Traceback|server died|HANG")
    11	  if [ "$e" -gt "$seen_err" ]; then echo "[$(date +%H:%M)] ⚠ new failure line(s) — check logs"; seen_err=$e; fi
    12	  if [ $((now - last)) -ge 120 ]; then
    13	    dumps=$(grep -c "done" $D/logs/progress.log 2>/dev/null); sc=$(grep -oE "scored [0-9]+/[0-9]+" $SC 2>/dev/null | tail -1)
    14	    [ -s $SC ] && grep -q "## dev" $SC && sc="$sc (scoring finished)"
    15	    arms=""; for f in $(ls $L/zo_*_p*.log 2>/dev/null); do n=$(basename $f .log); arms="$arms ${n%_p[0-9]} $(grep -cE 'ep[0-9]+ seed' $f)/20"; done
    16	    echo "[$(date +%H:%M)] dumps ${dumps:-0}/7 | offline scoring: ${sc:-waiting} |${arms:- closed-loop: not started}"
    17	    last=$now
    18	  fi
    19	  sleep 10
    20	done
    21	echo "[$(date +%H:%M)] ticker stopped"
