     1	"""Train the Temporal Association Head (TAH, path-B). Supervised association over episode sequences:
     2	roll the recurrent memory over frames, predict the target candidate (CE vs GT tidx), teacher-force the
     3	memory update from the GT target embedding. Off-screen frames (tidx=-1) hold memory + skip loss.
     4	Reports val target-accuracy + mis_follow (1-acc) to compare vs the heuristic stack."""
     5	from __future__ import annotations
     6	import argparse, os, sys
     7	import numpy as np
     8	
     9	_REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    10	if _REPO not in sys.path: sys.path.insert(0, _REPO)
    11	
    12	
    13	def run_epoch(model, episodes, opt, device, train=True, rel=False, fnoise=0.0, pjit=0.0, perm=False):
    14	    import torch
    15	    model.train(train)
    16	    tot_loss = n_loss = correct = total = 0
    17	    order = np.random.permutation(len(episodes)) if train else range(len(episodes))
    18	    for ei in order:
    19	        frames = episodes[ei]
    20	        m = model.reset(device)
    21	        losses = []
    22	        for fr in frames:
    23	            feat = torch.tensor(np.asarray(fr["feat"], np.float32), device=device)
    24	            pos = torch.tensor(fr["pos"], device=device)
    25	            tidx = int(fr["tidx"])
    26	            if train:                                               # Tier-2 augmentation (train only)
    27	                if fnoise > 0:
    28	                    feat = feat + fnoise * torch.randn_like(feat); feat = feat / (feat.norm(dim=-1, keepdim=True) + 1e-8)
    29	                if pjit > 0:
    30	                    pos = pos.clone(); pos[:, :2] = pos[:, :2] + pjit * torch.randn_like(pos[:, :2])
    31	                if perm and feat.shape[0] > 1:                      # candidate-order permutation invariance
    32	                    p = torch.randperm(feat.shape[0], device=device)
    33	                    feat, pos = feat[p], pos[p]
    34	                    if tidx >= 0: tidx = int((p == tidx).nonzero()[0])
    35	            logits, conf, e = model.step(feat, pos, m)
    36	            if tidx >= 0:
    37	                losses.append(torch.nn.functional.cross_entropy(logits.unsqueeze(0),
    38	                              torch.tensor([tidx], device=device)))
    39	                pred = int(logits.argmax()); correct += (pred == tidx); total += 1
    40	                if rel:
    41	                    m = model.update(m, feat[tidx], pos[tidx])                   # TAHRel: DINOv2 feat + pos
    42	                else:
    43	                    m = model.update(m, e[tidx].detach() if not train else e[tidx])
    44	            # tidx<0 (target off-screen): hold memory, no loss
    45	        if losses:
    46	            loss = torch.stack(losses).mean()
    47	            if train:
    48	                opt.zero_grad(); loss.backward()
    49	                torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0); opt.step()
    50	            tot_loss += float(loss); n_loss += 1
    51	    return tot_loss / max(n_loss, 1), correct / max(total, 1)
    52	
    53	
    54	def main():
    55	    ap = argparse.ArgumentParser()
    56	    ap.add_argument("--cache", nargs="+", default=["runs/tah_cache.pt"],
    57	                    help="one or more caches; episodes are concatenated in the given order. The validation split is "
    58	                         "taken from the FIRST cache only (first val_frac of its episodes) — identical to the "
    59	                         "single-cache behaviour when one cache is given")
    60	    ap.add_argument("--seed", type=int, default=None, help="torch / numpy seed (training-seed replicates s0/s1/s2)")
    61	    ap.add_argument("--save-last", action="store_true", help="also save the final-epoch weights to <out>_last.pt "
    62	                    "(the offline val split can saturate early, so best-by-val may pick an under-trained epoch)")
    63	    ap.add_argument("--out", default="runs/tah.pt")
    64	    ap.add_argument("--epochs", type=int, default=40)
    65	    ap.add_argument("--lr", type=float, default=3e-4)
    66	    ap.add_argument("--val-frac", type=float, default=0.15)
    67	    ap.add_argument("--rel", action="store_true", help="Tier-1: use TAHRel (relative/vehicle-invariant features)")
    68	    ap.add_argument("--motion", action="store_true", help="path-A: use TAHRelM (TAHRel + learned motion-consensus + EMA vel)")
    69	    ap.add_argument("--aug", action="store_true", help="Tier-2: candidate-permutation + feature-noise + pos-jitter")
    70	    ap.add_argument("--fnoise", type=float, default=0.05)
    71	    ap.add_argument("--pjit", type=float, default=0.02)
    72	    ap.add_argument("--wd", type=float, default=1e-4)
    73	    ap.add_argument("--device", default="cuda:0")
    74	    a = ap.parse_args()
    75	    import torch
    76	    from train.tah import TAH, TAHRel, TAHRelM
    77	    if a.seed is not None:
    78	        np.random.seed(a.seed); torch.manual_seed(a.seed)
    79	    datas = [torch.load(c, weights_only=False) for c in a.cache]
    80	    data = datas[0]
    81	    assert all(d["d_feat"] == data["d_feat"] for d in datas), "caches disagree on d_feat"
    82	    first = data["episodes"]
    83	    nval = max(1, int(len(first) * a.val_frac))
    84	    val = first[:nval]
    85	    tr = first[nval:] + [e for d in datas[1:] for e in d["episodes"]]
    86	    print(f"[tah] caches: " + ", ".join(f"{c} ({len(d['episodes'])} eps)" for c, d in zip(a.cache, datas)), flush=True)
    87	    arch = "relm" if a.motion else ("rel" if a.rel else "abs")
    88	    print(f"[tah] {len(tr)} train / {len(val)} val episodes; d_feat={data['d_feat']}; "
    89	          f"arch={arch} aug={a.aug} (fnoise={a.fnoise} pjit={a.pjit})", flush=True)
    90	    rel = a.rel or a.motion   # both TAHRel/TAHRelM use the relative update path in run_epoch
    91	    a.rel = rel
    92	    model = (TAHRelM(d_feat=data["d_feat"]) if a.motion else
    93	             TAHRel(d_feat=data["d_feat"]) if a.rel else TAH(d_feat=data["d_feat"])).to(a.device)
    94	    print(f"[tah] params: {sum(p.numel() for p in model.parameters())}", flush=True)
    95	    opt = torch.optim.AdamW(model.parameters(), lr=a.lr, weight_decay=a.wd)
    96	    fn, pj, pm = (a.fnoise, a.pjit, True) if a.aug else (0.0, 0.0, False)
    97	    best = 0.0
    98	    for ep in range(a.epochs):
    99	        tl, ta = run_epoch(model, tr, opt, a.device, train=True, rel=a.rel, fnoise=fn, pjit=pj, perm=pm)
   100	        with torch.no_grad():
   101	            vl, va = run_epoch(model, val, opt, a.device, train=False, rel=a.rel)
   102	        if va > best:
   103	            best = va
   104	            torch.save({"model": model.state_dict(), "d_feat": data["d_feat"], "arch": arch,
   105	                        "recipe": {k: v for k, v in vars(a).items()}, "n_train_eps": len(tr), "n_val_eps": len(val),
   106	                        "best_epoch": ep + 1, "best_val_acc": float(va)}, a.out)
   107	        print(f"[tah] ep{ep+1}/{a.epochs} train_loss={tl:.3f} train_acc={ta:.3f} | "
   108	              f"val_acc={va:.3f} (mis={1-va:.3f}) best={best:.3f}", flush=True)
   109	    if a.save_last:
   110	        lp = a.out[:-3] + "_last.pt" if a.out.endswith(".pt") else a.out + "_last"
   111	        torch.save({"model": model.state_dict(), "d_feat": data["d_feat"], "arch": arch,
   112	                    "recipe": {k: v for k, v in vars(a).items()}, "n_train_eps": len(tr), "n_val_eps": len(val),
   113	                    "epoch": a.epochs, "val_acc": float(va)}, lp)
   114	        print(f"[tah] last-epoch weights → {lp}", flush=True)
   115	    print(f"[tah] done. best val_acc={best:.3f} (mis_follow={1-best:.3f}) → {a.out}", flush=True)
   116	    print(f"[tah] compare vs heuristic stack: l5 offline mis ~0.26 (1-0.738); reid-dino gallery.", flush=True)
   117	
   118	
   119	if __name__ == "__main__":
   120	    main()

