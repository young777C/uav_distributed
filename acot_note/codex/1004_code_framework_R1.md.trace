### runs/tah_v90/ticker5.sh
     1	#!/usr/bin/env bash
     2	# Progress ticker (training + dev gate phase): every 120 s — per-seed epoch / latest val acc / best; dev gate episodes for
     3	# the s0 BEST (zv90s0_*) and s0 LAST (zv90s0L_*) arms; immediate lines on new failures; final pipeline result lines.
