     1	"""Datasets for Stage-1 EAR warmup.
     2	
     3	RealEARDataset  — reads episode H5 (waypoint GT + UAV pose) + a precomputed VLM
     4	                  context cache (per-episode .npz from backbone_kv.precompute).
     5	SyntheticEARDataset — dependency-free; a LEARNABLE cond->waypoint mapping so the
     6	                  Stage-1 loop can be smoke-tested with no VLM / no CARLA data.
     7	
     8	Waypoint GT (`annotation/waypoints`, shape (T,9) -> (T,3,3) = [+2s,+4s,+6s]×xyz) is
     9	world-frame; we predict it RELATIVE to the current UAV position and /scale so the
    10	target is translation-invariant and O(1).
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import glob
    16	from pathlib import Path
    17	
    18	import numpy as np
    19	import torch
    20	from torch.utils.data import Dataset
    21	
    22	from acot_probe.projection import inverse_pose_matrix
    23	
    24	
    25	def _select_episodes(cfg, split):
    26	    """Episodes for a split. Prefer the A2 manifest; else fall back to a naive slice."""
    27	    import json
    28	    all_eps = sorted(glob.glob(cfg["data"]["episodes_glob"]))
    29	    manifest_path = cfg["data"].get("split_manifest")
    30	    if manifest_path and Path(manifest_path).exists():
    31	        man = json.loads(Path(manifest_path).read_text())
    32	        names = set(man.get(split, []))
    33	        return [e for e in all_eps if Path(e).name in names]
    34	    # fallback (no manifest): naive episode slice, train/val only
    35	    vf = cfg["data"].get("val_frac", 0.15)
    36	    n_val = max(1, int(len(all_eps) * vf))
    37	    if split == "test":
    38	        return []
    39	    return all_eps[n_val:] if split == "train" else all_eps[:n_val]
    40	
    41	
    42	class RealEARDataset(Dataset):
    43	    def __init__(self, cfg, split="train"):
    44	        self.cfg = cfg
    45	        self.scale = cfg["waypoint"].get("scale", 50.0)
    46	        fps = cfg.get("fps", 10)
    47	        self.offsets = [int(o * fps) for o in cfg["waypoint"].get("offsets_s", [2, 4, 6])]
    48	        self.k = len(self.offsets)
    49	        self.rel = cfg["waypoint"].get("relative_to_uav", True)
    50	        self.cam_frame = cfg["waypoint"].get("camera_frame", False)  # predict in camera frame
    51	        self.ctx_dir = Path(cfg["data"]["context_cache"])
    52	        self._zc = {}          # ctx npz cache (path -> (frames, ctx)); load each file ONCE
    53	        self._hc = {}          # h5 field cache (ep -> (waypoints, uav_xyz, occ)); read ONCE
    54	        eps = _select_episodes(cfg, split)
    55	        self.index = self._build_index(eps, cfg)
    56	        self.cond_dim = self._peek_cond_dim()
    57	
    58	    def _build_index(self, eps, cfg):
    59	        import h5py
    60	        stride = int(cfg["data"].get("frame_stride", 3))
    61	        cap = int(cfg["data"].get("max_frames_per_episode", 200))
    62	        # Drop each episode's last `horizon` frames: their +6s waypoint GT is clamped
    63	        # to the final frame (degenerate) — see postprocess._compute_waypoints. Also
    64	        # drops episodes too short to yield any valid-horizon frame.
    65	        horizon = int(cfg["waypoint"].get("max_horizon_s", 6) * cfg.get("fps", 10))
    66	        idx = []
    67	        for ep in eps:
    68	            ctx = self.ctx_dir / (Path(ep).stem + ".npz")
    69	            if not ctx.exists():
    70	                continue
    71	            with h5py.File(ep, "r") as f:
    72	                n = f["rgb"].shape[0]
    73	            valid_n = n - horizon
    74	            if valid_n <= 0:
    75	                continue
    76	            for i in list(range(0, valid_n, stride))[:cap]:
    77	                idx.append((ep, str(ctx), i))
    78	        return idx
    79	
    80	    def _peek_cond_dim(self):
    81	        if not self.index:
    82	            return self.cfg["ear"].get("cond_dim", 2048)
    83	        z = np.load(self.index[0][1])
    84	        return int(z["ctx"].shape[-1])
    85	
    86	    def __len__(self):
    87	        return len(self.index)
    88	
    89	    def _ctx(self, path):
    90	        z = self._zc.get(path)
    91	        if z is None:
    92	            d = np.load(path)
    93	            z = (np.asarray(d["frames"]), np.asarray(d["ctx"], dtype=np.float32))
    94	            self._zc[path] = z
    95	        return z
    96	
    97	    def _h5(self, ep):
    98	        h = self._hc.get(ep)
    99	        if h is None:
   100	            import h5py
   101	            with h5py.File(ep, "r") as f:
   102	                occ = np.asarray(f["annotation/occlusion"][:], np.float32) \
   103	                    if "annotation/occlusion" in f else None
   104	                tgt = np.stack([f["target/tx"][:], f["target/ty"][:],
   105	                                f["target/tz"][:]], -1).astype(np.float32)
   106	                uav = np.stack([f["state/uav_x"][:], f["state/uav_y"][:],
   107	                                f["state/uav_z"][:]], -1).astype(np.float32)
   108	                cam = np.stack([f["state/cam_x"][:], f["state/cam_y"][:], f["state/cam_z"][:],
   109	                                f["state/cam_pitch"][:], f["state/cam_yaw"][:]], -1).astype(np.float32)
   110	                vel = np.stack([f["state/uav_vx"][:], f["state/uav_vy"][:],
   111	                                f["state/uav_vz"][:]], -1).astype(np.float32)
   112	                h = (tgt, uav, cam, vel, occ)   # waypoints computed on-the-fly at self.offsets
   113	            self._hc[ep] = h
   114	        return h
   115	
   116	    def __getitem__(self, j):
   117	        # in-memory caches: each ctx npz / h5 file is read ONCE, then indexed (was
   118	        # reloading the whole npz + reopening h5 per sample -> GPU-starved training).
   119	        ep, ctx_path, i = self.index[j]
   120	        frames, ctx = self._ctx(ctx_path)
   121	        row = min(int(np.searchsorted(frames, i)), len(frames) - 1)
   122	        cond = torch.from_numpy(ctx[row])                       # (M, C)
   123	        tgt, uav_all, cam, vel, occ = self._h5(ep)
   124	        n = len(tgt)
   125	        fut = np.stack([tgt[min(i + off, n - 1)] for off in self.offsets])  # (K,3) future target world
   126	        if self.cam_frame:
   127	            # transform future target into the CURRENT camera frame (fwd, right, up) ->
   128	            # removes UAV-yaw ambiguity of a world-frame target (root cause #1)
   129	            M = inverse_pose_matrix(*cam[i])                    # world -> camera-local (4x4)
   130	            homog = np.concatenate([fut, np.ones((self.k, 1), np.float32)], -1)
   131	            wp = (homog @ M.T)[:, :3].astype(np.float32)
   132	        else:
   133	            wp = fut - uav_all[i][None, :]
   134	        wp = (wp / self.scale).astype(np.float32)
   135	        # proprio: altitude + camera pitch (depth via ground plane) + velocity (motion)
   136	        proprio = np.array([cam[i][2] / 30.0, cam[i][3] / 90.0,
   137	                            vel[i][0] / 15.0, vel[i][1] / 15.0, vel[i][2] / 15.0], np.float32)
   138	        vis = float(occ[i] < 0.8) if occ is not None else 1.0
   139	        mask = torch.ones(cond.shape[0], dtype=torch.bool)
   140	        return {"cond": cond, "cond_mask": mask, "wp": torch.from_numpy(wp),
   141	                "proprio": torch.from_numpy(proprio), "vis": torch.tensor(vis)}
   142	
   143	
   144	class SyntheticEARDataset(Dataset):
   145	    """cond ~ N(0,1) (M,C); wp = pooled(cond) @ W + b + noise -> learnable by EAR."""
   146	
   147	    def __init__(self, n=512, m=16, c=64, k=3, seed=0, map_seed=42):
   148	        rng = np.random.default_rng(seed)
   149	        self.k = k
   150	        self.cond_dim = c
   151	        self._cond = rng.normal(0, 1, (n, m, c)).astype(np.float32)
   152	        # SHARED mapping across train/val (fixed map_seed) — like the real physics;
   153	        # train/val differ only in sampled cond, not in the cond->waypoint function.
   154	        W = np.random.default_rng(map_seed).normal(0, 1, (c, k * 3)).astype(np.float32) / np.sqrt(c)
   155	        pooled = self._cond.mean(1)                              # (n, c)
   156	        wp = pooled @ W
   157	        wp = wp / (wp.std() + 1e-6)                              # unit-scale (like real /scale)
   158	        wp = wp + 0.03 * rng.normal(0, 1, (n, k * 3)).astype(np.float32)
   159	        self._wp = wp.reshape(n, k, 3).astype(np.float32)
   160	
   161	    def __len__(self):
   162	        return len(self._cond)
   163	
   164	    def __getitem__(self, j):
   165	        cond = torch.from_numpy(self._cond[j])
   166	        return {"cond": cond, "cond_mask": torch.ones(cond.shape[0], dtype=torch.bool),
   167	                "wp": torch.from_numpy(self._wp[j]), "proprio": torch.zeros(5),
   168	                "vis": torch.tensor(1.0)}
   169	
   170	
   171	def collate(batch):
   172	    """Pad variable-length cond token sets to the batch max M."""
   173	    M = max(b["cond"].shape[0] for b in batch)
   174	    C = batch[0]["cond"].shape[1]
   175	    cond = torch.zeros(len(batch), M, C)
   176	    mask = torch.zeros(len(batch), M, dtype=torch.bool)
   177	    for i, b in enumerate(batch):
   178	        m = b["cond"].shape[0]
   179	        cond[i, :m] = b["cond"]
   180	        mask[i, :m] = b["cond_mask"]
     1	"""Precompute + cache the frozen VLM's layer-L context tokens per frame.
     2	
     3	EAR/IAR read the frozen backbone's per-layer representation via cross-attention.
     4	Per design principle 1, we run the VLM ONCE over the dataset and cache the layer-L
     5	image tokens to disk, so Stage-1/2 training never forwards the 3B VLM in the loop.
     6	
     7	Reuses acot_probe.backbones (run from the uav-acot-track/ root so the import
     8	resolves). Only run AFTER data generation is complete and a working GPU is present.
     9	
    10	    python -m train.backbone_kv --config train/config.yaml
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import argparse
    16	import glob
    17	import re
    18	from pathlib import Path
    19	
    20	import numpy as np
    21	import yaml
    22	
    23	
    24	_POS_RE = re.compile(
    25	    r"\b(directly |straight )?(ahead|in front|front[- ]?left|front[- ]?right|front[- ]?center|"
    26	    r"to the (?:left|right)|on the (?:left|right)|in the front[- ]?(?:left|right|center))\b",
    27	    re.I)
    28	
    29	
    30	def neutralize_language(lang: str) -> str:
    31	    """Ablation A: strip TIME-VARYING clauses (spatial bearing, intent, distance) from
    32	    the per-episode instruction, keeping only the time-invariant target IDENTITY. e.g.
    33	    'Keep tracking the yellow Jeep Wrangler directly ahead, which is about to turn
    34	    right, maintaining a tracking distance of about 50 m.' -> 'Keep tracking the
    35	    yellow Jeep Wrangler.'  Everything after the first comma (intent/distance) is
    36	    dropped; leading positional phrases are removed. Identity (color+make) survives."""
    37	    s = lang.split(",")[0]                       # drop ", which is about to ..., maintaining ..."
    38	    s = _POS_RE.sub("", s)                        # drop "directly ahead" / "in the front-left" ...
    39	    s = re.sub(r"\s{2,}", " ", s).strip().rstrip(".").strip()
    40	    return s + "."
    41	
    42	
    43	def _pool_grid(grid: np.ndarray, g: int) -> np.ndarray:
    44	    """(Gh,Gw,C) -> (g*g, C) by average pooling to a g×g grid (cache-size control)."""
    45	    Gh, Gw, C = grid.shape
    46	    if Gh <= g and Gw <= g:
    47	        return grid.reshape(-1, C)
    48	    import torch
    49	    t = torch.from_numpy(grid).permute(2, 0, 1)[None]         # (1,C,Gh,Gw)
    50	    t = torch.nn.functional.adaptive_avg_pool2d(t, (g, g))
    51	    return t[0].permute(1, 2, 0).reshape(-1, C).numpy()
    52	
    53	
    54	def precompute(cfg, shard=0, num_shards=1, device=None):
    55	    import h5py
    56	    from acot_probe.backbones import build_backbone
    57	
    58	    b = cfg["backbone"]
    59	    layer = int(b.get("layer", 16))
    60	    g = int(b.get("ctx_grid", 8))
    61	    stride = int(cfg["data"].get("frame_stride", 3))
    62	    cap = int(cfg["data"].get("max_frames_per_episode", 200))
    63	    out_dir = Path(cfg["data"]["context_cache"])
    64	    out_dir.mkdir(parents=True, exist_ok=True)
    65	
    66	    bk = build_backbone(b["kind"], b["model_id"], (device or b.get("device", "cuda:0")),
    67	                        min_pixels=b.get("min_pixels"), max_pixels=b.get("max_pixels")).load()
    68	    try:
    69	        for ep in sorted(glob.glob(cfg["data"]["episodes_glob"]))[shard::num_shards]:
    70	            out = out_dir / (Path(ep).stem + ".npz")
    71	            if out.exists():
    72	                continue
    73	            with h5py.File(ep, "r") as f:
    74	                n = f["rgb"].shape[0]
    75	                lang = f.attrs.get("language", "")
    76	                lang = lang.decode() if isinstance(lang, bytes) else str(lang)
    77	                if bool(b.get("no_language", False)):
    78	                    lang = "Track the target vehicle."   # ablation: strip ALL target identity
    79	                elif bool(b.get("neutralize_language", False)):
    80	                    lang = neutralize_language(lang)
    81	                frames = list(range(0, n, stride))[:cap]
    82	                ctx = []
    83	                from PIL import Image
    84	                for i in frames:
    85	                    img = Image.fromarray(np.asarray(f["rgb"][i]))
    86	                    feats = bk.encode(img, lang, [layer])
    87	                    grid = next(iter(feats.values()))[0]        # (Gh,Gw,C)
    88	                    ctx.append(_pool_grid(grid, g))
    89	            np.savez_compressed(out, frames=np.array(frames, np.int64),
    90	                                ctx=np.stack(ctx).astype(np.float32))
    91	            print(f"[ctx] {out.name}: {len(frames)} frames, tokens={ctx[0].shape}")
    92	    finally:
    93	        bk.free()
    94	
    95	
    96	def precompute_multilayer(cfg, layers, shard=0, num_shards=1, device=None):
    97	    """Stage-2 cache: store SEVERAL layers per frame for IAR.
    98	    Output npz: frames, grid=(g,g), layers, ctx=(F, L, g*g, C)."""
    99	    import h5py
   100	    from acot_probe.backbones import build_backbone
   101	
   102	    b = cfg["backbone"]
   103	    g = int(b.get("ctx_grid", 8))
   104	    stride = int(cfg["data"].get("frame_stride", 3))
   105	    cap = int(cfg["data"].get("max_frames_per_episode", 200))
   106	    out_dir = Path(cfg["data"]["stage2_context_cache"])
   107	    out_dir.mkdir(parents=True, exist_ok=True)
   108	
   109	    bk = build_backbone(b["kind"], b["model_id"], (device or b.get("device", "cuda:0")),
   110	                        min_pixels=b.get("min_pixels"), max_pixels=b.get("max_pixels")).load()
   111	    try:
   112	        from PIL import Image
   113	        for ep in sorted(glob.glob(cfg["data"]["episodes_glob"]))[shard::num_shards]:
   114	            out = out_dir / (Path(ep).stem + ".npz")
   115	            if out.exists():
   116	                continue
   117	            with h5py.File(ep, "r") as f:
   118	                n = f["rgb"].shape[0]
   119	                lang = f.attrs.get("language", "")
   120	                lang = lang.decode() if isinstance(lang, bytes) else str(lang)
   121	                if bool(b.get("no_language", False)):
   122	                    lang = "Track the target vehicle."   # ablation: strip ALL target identity
   123	                elif bool(b.get("neutralize_language", False)):
   124	                    lang = neutralize_language(lang)
   125	                frames = list(range(0, n, stride))[:cap]
   126	                per_frame, used = [], None
   127	                for i in frames:
   128	                    feats = bk.encode(Image.fromarray(np.asarray(f["rgb"][i])), lang, layers)
   129	                    used = sorted(feats)
   130	                    per_frame.append(np.stack([_pool_grid(feats[L][0], g) for L in used]))
   131	            if not per_frame or used is None:
   132	                continue
   133	            ctx_arr = np.stack(per_frame).astype(np.float16)         # fp16: half disk, VLM feats tolerate it
   134	            np.save(out.with_name(out.stem + ".ctx.npy"), ctx_arr)   # uncompressed -> mmap-ready
   135	            np.savez(out, frames=np.array(frames, np.int64),         # slim meta (no ctx)
   136	                     grid=np.array([g, g], np.int64),
   137	                     layers=np.array(used, np.int64))
   138	            print(f"[ctx-ml] {out.name}: {len(frames)}f × {len(used)}L, tokens={g*g} (+mmap npy)")
   139	    finally:
   140	        bk.free()
   141	
   142	
   143	def main():
   144	    ap = argparse.ArgumentParser()
   145	    ap.add_argument("--config", required=True)
   146	    ap.add_argument("--layers", type=int, nargs="+", default=None,
   147	                    help="multi-layer Stage-2 cache (e.g. --layers 4 8 12 16)")
   148	    ap.add_argument("--shard", type=int, default=0, help="this process's shard index")
   149	    ap.add_argument("--num-shards", type=int, default=1, help="total shards (GPUs)")
   150	    ap.add_argument("--device", default=None, help="override backbone device, e.g. cuda:2")
   151	    args = ap.parse_args()
   152	    cfg = yaml.safe_load(Path(args.config).read_text())
   153	    if args.layers:
   154	        precompute_multilayer(cfg, args.layers, args.shard, args.num_shards, args.device)
   155	    else:
   156	        precompute(cfg, args.shard, args.num_shards, args.device)
   157	
   158	
   159	if __name__ == "__main__":
   160	    main()

