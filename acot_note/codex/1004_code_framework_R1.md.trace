    30	           "longW": lambda e: e["max_wrong_run_s"]}
    31	LABEL = {"correct": "正确锁定比例(承诺)", "correct_l": "正确比例(宽松·弃权算对)", "correct_s": "正确比例(严格·弃权算错)",
