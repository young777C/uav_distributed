codex
One subtle finding: the current policy reseeds candidate shuffling to a fixed `shuffle_seed` on every reset, and that seed is not exposed by `policy_server.py`. That is exactly the kind of small behavior-affecting constant a framework should either freeze deliberately or make explicit.
exec
/bin/sh -lc "nl -ba carla_uav_tracking/rollout/opening_zoom.py | sed -n '1,240p'" in /nvidia/hque/code/cyhe/uav-acot-track
 succeeded in 0ms:
     1	"""Zoom-and-verify opening identity (1004 opening fix). GT-free: uses the camera frame, the candidate boxes and the
     2	language instruction only. Each candidate is cropped (side = scale·box), optionally spot-lit (outside of its own box
     3	dimmed), resized, and the frozen Qwen3-VL-4B-Instruct the policy already loads is asked whether it is the described
     4	vehicle; score = logit(yes) − logit(no). Shared by the offline benchmark (opening_score.py) and policy.py."""
     5	from __future__ import annotations
     6	
     7	import os
     8	
     9	import numpy as np
    10	import torch
    11	from PIL import Image
    12	
    13	COLOR2 = {"dark red", "dark green", "light blue", "royal blue", "dark blue"}
    14	COLOR1 = {"black", "white", "gray", "grey", "silver", "red", "orange", "yellow", "green", "blue", "brown", "beige",
    15	          "purple", "gold"}
    16	
    17	
    18	def describe(lang: str):
    19	    """'Keep tracking the yellow Jeep Wrangler directly ahead, ...' → ('yellow Jeep Wrangler', 'yellow', 'Jeep Wrangler')."""
    20	    from train.backbone_kv import neutralize_language
    21	    n = neutralize_language(lang); i = n.lower().rfind(" the ")
    22	    d = (n[i + 5:] if i >= 0 else n).rstrip(".").strip()
    23	    w = d.split()
    24	    if len(w) >= 2 and " ".join(w[:2]).lower() in COLOR2:
    25	        return d, " ".join(w[:2]), " ".join(w[2:])
    26	    if w and w[0].lower() in COLOR1:
    27	        return d, w[0], " ".join(w[1:])
    28	    return d, "", d
    29	
    30	
    31	def crop(rgb, u, v, w, h, scale, R, spotlight=False):
    32	    H, W = rgb.shape[:2]; side = max(32.0, max(w, h) * scale); half = side / 2
    33	    if spotlight:
    34	        rgb = rgb.astype(np.float32); m = np.full(rgb.shape[:2], 0.35, np.float32); b = max(w, h) * 0.6
    35	        m[max(0, int(v - b)):int(v + b), max(0, int(u - b)):int(u + b)] = 1.0
    36	        rgb = (rgb * m[..., None]).clip(0, 255).astype(np.uint8)
    37	    x0, y0, x1, y1 = int(round(u - half)), int(round(v - half)), int(round(u + half)), int(round(v + half))
    38	    pad = max(0, -x0, -y0, x1 - W, y1 - H)
    39	    img = np.pad(rgb, ((pad, pad), (pad, pad), (0, 0)), mode="edge") if pad else rgb
    40	    return Image.fromarray(np.ascontiguousarray(img[y0 + pad:y1 + pad, x0 + pad:x1 + pad])).resize((R, R), Image.BICUBIC)
    41	
    42	
    43	class ZoomVerifier:
    44	    """Wraps an already-loaded Qwen3-VL (model + processor) — no second copy of the weights."""
    45	
    46	    def __init__(self, model, processor, device, scale=3.0, R=336, spotlight=True):
    47	        self.model, self.proc, self.dev = model, processor, device
    48	        self.scale, self.R, self.spotlight = float(scale), int(R), bool(spotlight)
    49	        tok = processor.tokenizer
    50	        self.yes = [tok.encode(t, add_special_tokens=False)[0] for t in ("Yes", "yes", " Yes", " yes")]
    51	        self.no = [tok.encode(t, add_special_tokens=False)[0] for t in ("No", "no", " No", " no")]
    52	
    53	    @torch.no_grad()
    54	    def yesno(self, crops, q) -> np.ndarray:
    55	        msgs = [[{"role": "user", "content": [{"type": "image"}, {"type": "text", "text": q}]}]] * len(crops)
    56	        texts = [self.proc.apply_chat_template(m, tokenize=False, add_generation_prompt=True) for m in msgs]
    57	        side = self.proc.tokenizer.padding_side; self.proc.tokenizer.padding_side = "left"
    58	        try:
    59	            inp = self.proc(text=texts, images=crops, return_tensors="pt", padding=True).to(self.dev)
    60	        finally:
    61	            self.proc.tokenizer.padding_side = side
    62	        lg = self.model(**inp).logits[:, -1].float()
    63	        return (torch.logsumexp(lg[:, self.yes], 1) - torch.logsumexp(lg[:, self.no], 1)).cpu().numpy()
    64	
    65	    @torch.no_grad()
    66	    def scores(self, rgb, cands, language, rgb_hi=None) -> np.ndarray:
    67	        desc, _, _ = describe(language)
    68	        src, f = np.asarray(rgb, np.uint8), 1.0
    69	        if rgb_hi is not None:                       # same camera at k× resolution → crop real pixels, not upsampling
    70	            src = np.asarray(rgb_hi, np.uint8); f = src.shape[1] / float(np.asarray(rgb).shape[1])
    71	        crops = [crop(src, c.u * f, c.v * f, c.w * f, c.h * f, self.scale, self.R, self.spotlight) for c in cands]
    72	        q = (f"Is the brightly lit vehicle in the center of this image a {desc}? Answer yes or no." if self.spotlight
    73	             else f"Is the vehicle in the center of this image a {desc}? Answer yes or no.")
    74	        return self.yesno(crops, q)
    75	
    76	
    77	def norm(s):
    78	    s = " ".join(s.lower().split())
    79	    return "gray" if s == "grey" else s
    80	
    81	
    82	class Dino:
    83	    """Frozen DINOv2 ViT-S/14 crop features (CLS + mean patch, L2-normalised)."""
    84	
    85	    def __init__(self, dev):
    86	        import timm
    87	        self.m = timm.create_model("vit_small_patch14_dinov2.lvd142m", pretrained=True, num_classes=0, img_size=224).to(dev).eval()
    88	        self.dev = dev
    89	        self.mean = torch.tensor([0.485, 0.456, 0.406], device=dev).view(1, 3, 1, 1)
    90	        self.std = torch.tensor([0.229, 0.224, 0.225], device=dev).view(1, 3, 1, 1)
    91	
    92	    @torch.no_grad()
    93	    def feats(self, imgs, flip=False):
    94	        x = torch.from_numpy(np.stack([np.asarray(i, np.float32) / 255.0 for i in imgs])).permute(0, 3, 1, 2).to(self.dev)
    95	        if flip:
    96	            x = x.flip(3)
    97	        x = (x - self.mean) / self.std
    98	        t = self.m.forward_features(x)                                       # (B, 1+P, C)
    99	        f = torch.cat([t[:, 0], t[:, 1:].mean(1)], 1)
   100	        return torch.nn.functional.normalize(f, dim=1).cpu().numpy()
   101	
   102	
   103	def hist(rgb, u, v, w, h, bins=6):
   104	    """RGB histogram of the inner 70% of the box (car body, little road) — sqrt-normalised, flip-invariant."""
   105	    a = np.asarray(crop(rgb, u, v, w * 0.7, h * 0.7, 1.0, 48), np.float32).reshape(-1, 3)
   106	    q = np.clip((a / 256.0 * bins).astype(int), 0, bins - 1)
   107	    hst = np.bincount(q[:, 0] * bins * bins + q[:, 1] * bins + q[:, 2], minlength=bins ** 3).astype(np.float32)
   108	    return np.sqrt(hst / hst.sum())
   109	
   110	
   111	class AttrScorer:
   112	    """Opening identity from TRAINED attribute classifiers (opening_cls.py → eval_out/opening_attr_cls.pt): per candidate
   113	    score = wm·log p(model noun of the instruction) + wc·log p(colour word) [+ wq·Qwen colour yes/no log-odds].
   114	    Same interface as ZoomVerifier; GT-free at run time (crops of the k× opening frame + candidate boxes + language)."""
   115	
   116	    def __init__(self, model, processor, device, ckpt="", wm=1.0, wc=1.0, wq=0.0, ft=0.0):
   117	        eo = os.path.join(os.path.dirname(os.path.abspath(__file__)), "eval_out")
   118	        ck = torch.load(ckpt or os.path.join(eo, "opening_attr_cls.pt"), map_location=device, weights_only=False)
   119	        self.ft = float(ft); self.ftnet = None
   120	        if self.ft:                      # fine-tuned DINOv2 (opening_ft.py), blended: (1-ft)·linear + ft·fine-tuned
   121	            import timm
   122	            fk = torch.load(os.path.join(eo, "opening_attr_ft.pt"), map_location=device, weights_only=False)
   123	            b = timm.create_model("vit_small_patch14_dinov2.lvd142m", pretrained=False, num_classes=0, img_size=224)
   124	            net = torch.nn.ModuleDict({"b": b, "hm": torch.nn.Linear(768, len(fk["cls_m"])),
   125	                                       "hc": torch.nn.Linear(768, len(fk["cls_c"]))})
   126	            net.load_state_dict(fk["state"]); self.ftnet = net.to(device).eval()
   127	            self.ft_idx = ({c: i for i, c in enumerate(fk["cls_m"])}, {c: i for i, c in enumerate(fk["cls_c"])})
   128	            self.ft_scale = float(fk["test_scale"])
   129	        self.dino, self.dev = Dino(device), device
   130	        self.scales = tuple(ck["scales"])
   131	        self.heads = {}
   132	        for k in ("m", "c"):
   133	            sd = ck[f"W{k}"]; W = torch.nn.Linear(sd["weight"].shape[1], sd["weight"].shape[0]).to(device)
   134	            W.load_state_dict(sd); W.eval()
   135	            self.heads[k] = (W, {c: i for i, c in enumerate(ck[f"cls_{k}"])}, float(ck[f"T{k}"]))
   136	        self.wm, self.wc, self.wq = float(wm), float(wc), float(wq)
   137	        self.zv = ZoomVerifier(model, processor, device, scale=2.0, spotlight=False) if self.wq else None
   138	
   139	    @torch.no_grad()
   140	    def scores(self, rgb, cands, language, rgb_hi=None) -> np.ndarray:
   141	        _, color, model = describe(language)
   142	        src, f = np.asarray(rgb, np.uint8), 1.0
   143	        if rgb_hi is not None:
   144	            src = np.asarray(rgb_hi, np.uint8); f = src.shape[1] / float(np.asarray(rgb).shape[1])
   145	        boxes = [(c.u * f, c.v * f, c.w * f, c.h * f) for c in cands]
   146	        F = sum(self.dino.feats([crop(src, *b, sc, 224) for b in boxes], fl) for sc in self.scales for fl in (False, True))
   147	        Ft = torch.tensor(F / (2 * len(self.scales)), device=self.dev)
   148	        Ht = torch.tensor(np.stack([hist(src, *b) for b in boxes]), device=self.dev)
   149	        s = np.zeros(len(cands)); lin = {"m": Ft, "c": torch.cat([Ft, Ht], 1)}; fto = {}
   150	        if self.ftnet is not None:
   151	            x = torch.from_numpy(np.stack([np.asarray(crop(src, *b, self.ft_scale, 224), np.float32) / 255.0 for b in boxes]))
   152	            x = ((x.permute(0, 3, 1, 2).to(self.dev) - self.dino.mean) / self.dino.std)
   153	            t = self.ftnet["b"].forward_features(torch.cat([x, x.flip(3)]))
   154	            f = torch.cat([t[:, 0], t[:, 1:].mean(1)], 1); n = len(boxes)
   155	            for k in ("m", "c"):
   156	                lp = torch.log_softmax(self.ftnet["h" + k](f).float(), 1); fto[k] = ((lp[:n] + lp[n:]) / 2).cpu().numpy()
   157	        for k, w, word in (("m", self.wm, model), ("c", self.wc, color)):
   158	            if not (w and word):
   159	                continue
   160	            W, idx, T = self.heads[k]; v = np.zeros(len(cands))
   161	            if norm(word) in idx and self.ft < 1:
   162	                v += (1 - self.ft) * torch.log_softmax(W(lin[k]) * 20.0 / T, 1)[:, idx[norm(word)]].cpu().numpy()
   163	            fi = self.ft_idx[0 if k == "m" else 1] if self.ftnet is not None else {}
   164	            if norm(word) in fi:
   165	                v += self.ft * fto[k][:, fi[norm(word)]]
   166	            s += w * v
   167	        if self.zv is not None and color:
   168	            s += self.wq * self.zv.yesno([crop(src, *b, 2.0, 336) for b in boxes],
   169	                                         f"Is the vehicle in the center of this image {color}? Answer yes or no.")
   170	        return s

