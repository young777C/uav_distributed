acot_note/codex/1003_data_v6_impl_R1.md.trace:4679:+        # v6: the episode's own attrs['fov'] (written by the recorder) is authoritative; `fov` is only
acot_note/codex/1003_data_v6_impl_R1.md.trace:4680:+        # a cross-check. Files without the attr are refused unless allow_legacy_fov (then `fov`/90 used).
acot_note/codex/1003_data_v6_impl_R1.md.trace:4681:+        self._allow_legacy_fov = bool(allow_legacy_fov)
acot_note/codex/1003_data_v6_impl_R1.md.trace:4682:         # §10: the sensor FOV was narrowed 90→70; bbox/off_screen projection MUST use the
acot_note/codex/1003_data_v6_impl_R1.md.trace:4683:         # SAME fov as the camera (else off_screen under-reports — the target leaves the real
acot_note/codex/1003_data_v6_impl_R1.md.trace:4684:         # 70° frame but a 90° projection still counts it in-frame). Caller passes output.fov.
acot_note/codex/1003_data_v6_impl_R1.md.trace:4685:-        self._fov = float(fov)
acot_note/codex/1003_data_v6_impl_R1.md.trace:4686:+        self._fov = None if fov is None else float(fov)
acot_note/codex/1003_data_v6_impl_R1.md.trace:4692:+            if "fov" in f.attrs:
acot_note/codex/1003_data_v6_impl_R1.md.trace:4693:+                fov = float(f.attrs["fov"])
acot_note/codex/1003_data_v6_impl_R1.md.trace:4694:+                if self._fov is not None and abs(fov - self._fov) > 1e-6:
acot_note/codex/1003_data_v6_impl_R1.md.trace:4695:+                    raise ValueError(f"{episode_path}: attrs fov={fov} != expected {self._fov}")
acot_note/codex/1003_data_v6_impl_R1.md.trace:4696:+            elif self._allow_legacy_fov:
acot_note/codex/1003_data_v6_impl_R1.md.trace:4697:+                fov = self._fov if self._fov is not None else _FOV_DEG
acot_note/codex/1003_data_v6_impl_R1.md.trace:4699:+                raise ValueError(f"{episode_path}: no attrs['fov'] — refusing to guess the camera FOV")
acot_note/codex/1003_data_v6_impl_R1.md.trace:4700:+            self._fov = fov
acot_note/codex/1003_data_v6_impl_R1.md.trace:4703:             bboxes = self._compute_bboxes(f, n_steps, self._fov)               # (n, 4)
acot_note/codex/1003_data_v6_impl_R1.md.trace:4746:             distance_m=dist_m, rng=_r.Random(seed))
