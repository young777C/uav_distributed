     1	#!/usr/bin/env bash
     2	# Progress ticker (oracle-absent upper bound): every 120 s — episodes done (5 arms × 4) + live paired comparison vs v1;
     3	# immediate lines on new failures. Exits when runs/opening_dump/STOP exists or all 5 arms are done.
     4	D=/nvidia/hque/code/cyhe/uav-acot-track/runs/opening_dump; L=/nvidia/hque/code/cyhe/uav-acot-track/runs/asd/iter
