   180	
   181	        # --- re-acquisition: each target-loss is one attempt, resolved on recovery ---
   182	        lost_now = (not target_present) or in_loss_window
   183	        if lost_now and not self._was_lost:            # a loss STARTS → open a new attempt
   184	            self._reacq_open = True
   185	            self._reacq_start = step
   186	            self._reacq_wrong_counted = False
   187	            self._reacq_attempts += 1
   188	        if self._reacq_open:
   189	            if (not self._reacq_wrong_counted and target_present
   190	                    and self._committed is not None and self._committed != "target"):
   191	                self._reacq_wrong += 1                  # locked a wrong car while recovering (once/attempt)
   192	                self._reacq_wrong_counted = True
   193	            if (not lost_now) and target_present and self._committed == "target":
   194	                self._reacq_success += 1                # correctly re-acquired the TRUE target
   195	                self._reacq_conv.append(step - self._reacq_start)
   196	                self._reacq_open = False                # attempt resolved
   197	        self._was_lost = lost_now
   198	
   199	    def should_truncate(self) -> bool:
   200	        return self._off_run >= self.max_lost
   201	
   202	    # ------------------------------------------------------------------
   203	    def finalize(self) -> dict:
   204	        present = max(self._present, 1)
   205	        att = self._reacq_attempts
   206	        conv = self._reacq_conv
   207	        success = (not self._failed) and (self._off_run < self.max_lost)
   208	        return {
   209	            "success": bool(success),
   210	            "mis_follow_inst": self._inst_wrong / present,
   211	            "mis_follow_sustained": self._sustain_wrong / present,
   212	            "id_switches": self._id_switches,
   213	            "track_frames": self._present,
   214	            "track_seconds": self._present / self.fps,
   215	            "centering_rate": self._central / present,
   216	            "max_wrong_run_s": self._max_wrong_run / self.fps,
   217	            "max_correct_run_s": self._max_correct_run / self.fps,   # longest continuous correct lock (committed)
   218	            **({"vis_frames": self._present_vis,
   219	                "occluded_frames": self._present - self._present_vis,
   220	                "correct_committed_vis": (1 - self._sustain_wrong_vis / self._present_vis) if self._present_vis else None,
   221	                "correct_strict_vis": (self._strict_ok_vis / self._present_vis) if self._present_vis else None,
   222	                "abstain_rate_vis": (self._abstain_vis / self._present_vis) if self._present_vis else None,
   223	                "abstain_rate_occluded": (self._abstain_occ / (self._present - self._present_vis))
   224	                if self._present > self._present_vis else None} if self._vis_measured else {}),
   225	            "mean_uav_target_dist": (self._dist_sum / self._dist_n) if self._dist_n else None,
   226	            # re-acquisition (guide §7): each target-loss = one attempt (deliberate loss
   227	            # window OR model-caused loss). success = re-locked TRUE target; the no-WM
   228	            # baseline's failure modes are timeout (never re-acquired) + lock-wrong.
   229	            "reacquire_attempts": att,
   230	            "reacquire_success_rate": (self._reacq_success / att) if att else None,
   231	            "reacquire_timeout_rate": ((att - self._reacq_success) / att) if att else None,
   232	            "reacquire_lock_wrong_rate": (self._reacq_wrong / att) if att else None,
   233	            "reacquire_convergence_s_mean": (float(np.mean(conv)) / self.fps) if conv else None,
   234	            # shortcut checks (§7): high ⇒ a shortcut survived, re-harden data (§2.3)
   235	            "shortcut_nearest_rate": (self._nearest_pred / self._nearest_denom) if self._nearest_denom else None,
   236	            "shortcut_target_central_rate": self._central_target / present,
   237	            # per-frame grounding stratifiers (online-vs-offline diagnosis)
   238	            "mis_by_N": {k: v[0] / v[1] for k, v in self._byN.items() if v[1]},
   239	            "n_dist": {k: v[1] for k, v in self._byN.items()},
   240	            "mis_by_central": {k: (v[0] / v[1] if v[1] else None) for k, v in self._byC.items()},
   241	            "c_dist": {k: v[1] for k, v in self._byC.items()},
   242	            "mis_by_depth": {k: v[0] / v[1] for k, v in self._byD.items() if v[1]},
   243	            "d_dist": {k: v[1] for k, v in self._byD.items()},
   244	            "steps": self.n,
   245	        }

codex
A couple of important safety details are emerging: GT is not one channel here, it is several differently privileged surfaces (`target_color`/`target_bp`, true candidate slots, `gt_idx`, road oracle, raycast visibility, DUMP labels). The design catches many of them, but it currently under-specifies how to mechanically prevent policy-side accidental reads during P0/P1.
