    22	
    23	def analyse(name, T):
    24	    c = collections.Counter(); sw = collections.Counter()
    25	    for s, R in T.items():
    26	        R = [r for r in R if "true" in r and "mem" in r]
    27	        prev_vis, prev_tid, since = False, None, 99
    28	        for r in R:
    29	            vis = r["true"] is not None and r["true"] >= 0
    30	            anc = r.get("anc"); out = anc if anc is not None and anc >= 0 and anc < len(r["aidx"]) else None
    31	            if not vis:
    32	                c["tick_absent"] += 1
    33	                c["absent_out_distractor" if out is not None else "absent_out_abstain"] += 1
    34	                prev_vis = False; since = 0; continue
    35	            tid = r["aidx"][r["true"]]
    36	            phase = "reappear(≤5 tick)" if since <= 5 else "steady"
    37	            if prev_vis and prev_tid is not None and tid != prev_tid:
    38	                sw["target tracker-id switch"] += 1
    39	            c[f"vis_{phase}"] += 1
    40	            raw_ok = r["mem"] == r["true"]; out_ok = out == r["true"]
    41	            c[f"raw_ok_{phase}"] += raw_ok; c[f"out_ok_{phase}"] += out_ok
    42	            if not out_ok:
    43	                if out is None:
    44	                    k = "abstain while target visible"
    45	                elif not raw_ok and out == r["mem"]:
    46	                    k = "TAHRelM raw wrong, PGIF follows"
    47	                elif raw_ok:
    48	                    k = "TAHRelM raw RIGHT, PGIF overrides to wrong"
    49	                else:
    50	                    k = "both wrong (different)"
    51	                c["err:" + k + f" [{phase}]"] += 1; c["err_total"] += 1
    52	            prev_vis, prev_tid = True, tid; since += 1
    53	    n_vis = c["vis_steady"] + c["vis_reappear(≤5 tick)"]
    54	    print(f"\n## {name}: {len(T)} episodes, {n_vis + c['tick_absent']} S2 ticks")
    55	    print(f"  target visible ticks {n_vis} | target NOT a candidate (occluded/out of frame) {c['tick_absent']} "
    56	          f"→ output a distractor {c['absent_out_distractor']} / abstain {c['absent_out_abstain']}")
    57	    for ph in ("steady", "reappear(≤5 tick)"):
    58	        n = c[f"vis_{ph}"]
    59	        if n:
    60	            print(f"  [{ph:17s}] n={n:5d} | TAHRelM raw acc {c[f'raw_ok_{ph}'] / n:.3f} | committed (PGIF) acc {c[f'out_ok_{ph}'] / n:.3f}")
    61	    print(f"  wrong committed ticks while target visible: {c['err_total']} — attribution:")
    62	    for k, v in sorted(((k, v) for k, v in c.items() if k.startswith("err:")), key=lambda kv: -kv[1]):
    63	        print(f"     {v:5d}  ({v / max(1, c['err_total']):.0%})  {k[4:]}")
    64	    print(f"  target tracker-id switches between consecutive visible ticks: {sw['target tracker-id switch']}")
    65	    wrong_all = c["err_total"] + c["absent_out_distractor"]
    66	    print(f"  ALL wrong-identity ticks (visible-wrong + absent-but-committed-to-distractor) = {wrong_all}: "
    67	          f"visible & TAHRelM raw wrong = {sum(v for k, v in c.items() if k.startswith('err:TAHRelM raw wrong') or k.startswith('err:both'))} "
    68	          f"| target absent → distractor = {c['absent_out_distractor']}")
    69	
    70	
    71	def main():
