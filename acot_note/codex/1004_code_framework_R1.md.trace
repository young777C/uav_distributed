    17	def load_v0():
    18	    import json, os
    19	    LG = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "runs", "asd", "deploy_all", "tahrelm_pgif.jsonl")
    20	    return oc.load([(LG, os.path.join(os.path.dirname(os.path.abspath(__file__)), "eval_out", "paper_dep_tahrelm_pgif.json"))])
