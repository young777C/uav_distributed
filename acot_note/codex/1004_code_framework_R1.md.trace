    32	def load_config():
    33	    with open(os.path.join(_CARLA_PKG, "config", "default.yaml")) as f:
    34	        cfg = yaml.safe_load(f)
    35	    scen = os.path.join(_CARLA_PKG, "config", "scenarios", "mvp.yaml")
    36	    if os.path.exists(scen):
    37	        with open(scen) as f:
    38	            _merge(cfg, yaml.safe_load(f) or {})
