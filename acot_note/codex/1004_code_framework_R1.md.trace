runs/opening_dump/open_ticker8.sh:12:    va=$(cat $D/logs/ov_attr_*.log 2>/dev/null | grep -cE "ep[0-9]+ seed"); vh=$(cat $D/logs/ov_head_*.log 2>/dev/null | grep -cE "ep[0-9]+ seed")
runs/opening_dump/open_ticker8.sh:13:    ra=$(python3 $D/ocl_rate.py attr 1 2 3 4 9 2>/dev/null); rh=$(python3 $D/ocl_rate.py head 5 6 7 2>/dev/null); rf=$(python3 $D/ocl_rate.py fix 20 21 22 23 24 25 2>/dev/null); r3=$(python3 $D/ocl_rate.py v3 40 41 42 43 44 45 46 47 2>/dev/null); v3n=$(cat $D/logs/ov_v3_*.log 2>/dev/null | grep -cE "ep[0-9]+ seed"); vf=$(cat $D/logs/ov_fix_*.log 2>/dev/null | grep -cE "ep[0-9]+ seed")
runs/opening_dump/open_ticker8.sh:14:    arms=""; for x in a b c; do n=$(cat $L/zoa_pgif_trk_${x}_p*.log 2>/dev/null | grep -cE 'ep[0-9]+ seed'); arms="$arms $x:${n:-0}"; done
