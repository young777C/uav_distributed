    14	    echo "[$(date +%H:%M)] 诊断1 弃权+滑行 ${n1}/20 [$(python3 $D/oracle_cmp.py zoo 2>/dev/null)] ‖ 诊断2 只禁学习 ${n2}/20 [$(python3 $D/oracle_cmp.py zoh 2>/dev/null)](格式:诊断/v1)"
    15	    last=$now
