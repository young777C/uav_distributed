    12	import numpy as np
    13	
    14	EO = os.path.join(os.path.dirname(__file__), "eval_out")
    15	def _strict(e):
    16	    """per-frame pick == target over target-present frames; ABSTENTION (no pick) counts as NOT correct."""
    17	    nd, bn = e.get("n_dist") or {}, e.get("mis_by_N") or {}
