 succeeded in 0ms:
     1	"""GT-free tracklet IDs for the candidate boxes (1004 · 'deployable v2').
     2	
     3	Replaces the simulator's persistent actor index (`Candidate.idx`) as the identity key used by PGIF, the commitment
     4	hysteresis, the re-ID gallery and WHERE. A SORT/DeepSORT-style assigner run at every S2 tick on what a detector
     5	would output: box centre + size and an appearance embedding (crop-DINOv2) — never `is_target` / `idx`.
     6	
     7	  • predict each live track with an image-space constant-velocity model (velocity per tick, EMA);
     8	  • cost(track, box) = (1 − w_app)·d/gate + w_app·(1 − cos(app_track, feat)), gate = max(gate_px, gate_box·box size);
     9	    pairs outside the motion gate or below `min_cos` are forbidden;
    10	  • Hungarian assignment (scipy; greedy fallback); matched → update state; unmatched track → age += 1, deleted after
    11	    `max_age` missed ticks; unmatched box → NEW id.
    12	So a vehicle that stays unseen for more than `max_age` ticks (occlusion / out of frame) comes back with a new id, and
    13	look-alikes that cross can swap ids — the failure modes a real tracker has and the simulator ids do not.
    14	"""
    15	from __future__ import annotations
    16	
    17	import numpy as np
    18	
    19	try:
    20	    from scipy.optimize import linear_sum_assignment as _lsa
    21	except Exception:          # pragma: no cover - scipy missing → greedy
    22	    _lsa = None
    23	
    24	_BIG = 1e6
    25	
    26	
    27	class TrackletAssigner:
    28	    def __init__(self, max_age: int = 5, gate_px: float = 100.0, gate_box: float = 3.0, w_app: float = 0.5,
    29	                 min_cos: float = 0.3, vel_beta: float = 0.5, app_alpha: float = 0.3):
    30	        self.max_age, self.gate_px, self.gate_box = int(max_age), float(gate_px), float(gate_box)
    31	        self.w_app, self.min_cos = float(w_app), float(min_cos)
    32	        self.vel_beta, self.app_alpha = float(vel_beta), float(app_alpha)
    33	        self.reset()
    34	
    35	    def reset(self):
    36	        self.tracks: dict[int, dict] = {}      # id -> {pos(2,), vel(2,), app(C,)|None, age, hits}
    37	        self.next_id = 0
    38	        self.n_new = self.n_deleted = 0
    39	
    40	    def _cost(self, uv, sizes, feats):
    41	        ids = list(self.tracks)
    42	        C = np.full((len(ids), len(uv)), _BIG)
    43	        for a, tid in enumerate(ids):
    44	            t = self.tracks[tid]
    45	            pred = t["pos"] + t["vel"] * (t["age"] + 1)            # vel is per tick; coast over missed ticks
    46	            d = np.linalg.norm(uv - pred[None], axis=1)
    47	            gate = np.maximum(self.gate_px, self.gate_box * sizes)
    48	            m = d / gate
    49	            if feats is not None and t["app"] is not None:
    50	                cos = feats @ t["app"]
    51	                app = 1.0 - cos
    52	                ok = (m <= 1.0) & (cos >= self.min_cos)
    53	            else:
    54	                app = np.zeros(len(uv)); ok = m <= 1.0
    55	            C[a] = np.where(ok, (1 - self.w_app) * m + self.w_app * app, _BIG)
    56	        return ids, C
    57	
    58	    def update(self, uv, sizes, feats=None) -> list[int]:
    59	        """uv (n,2) box centres px, sizes (n,) box side px, feats (n,C) L2-normalised or None → n tracklet ids."""
    60	        uv = np.asarray(uv, np.float64).reshape(-1, 2); sizes = np.asarray(sizes, np.float64).reshape(-1)
    61	        feats = None if feats is None else np.asarray(feats, np.float64)
    62	        n = len(uv); out = [-1] * n
    63	        if self.tracks and n:
    64	            ids, C = self._cost(uv, sizes, feats)
    65	            if _lsa is not None:
    66	                rows, cols = _lsa(C)
    67	                pairs = [(r, c) for r, c in zip(rows, cols) if C[r, c] < _BIG]
    68	            else:                                                  # greedy by ascending cost
    69	                pairs, used_r, used_c = [], set(), set()
    70	                for flat in np.argsort(C, axis=None):
    71	                    r, c = divmod(int(flat), C.shape[1])
    72	                    if C[r, c] >= _BIG:
    73	                        break
    74	                    if r not in used_r and c not in used_c:
    75	                        pairs.append((r, c)); used_r.add(r); used_c.add(c)
    76	            for r, c in pairs:
    77	                tid = ids[r]; t = self.tracks[tid]
    78	                step_v = (uv[c] - t["pos"]) / (t["age"] + 1)
    79	                t["vel"] = (1 - self.vel_beta) * t["vel"] + self.vel_beta * step_v if t["hits"] > 1 else step_v
    80	                t["pos"] = uv[c].copy(); t["age"] = 0; t["hits"] += 1
    81	                if feats is not None:
    82	                    a = feats[c] if t["app"] is None else (1 - self.app_alpha) * t["app"] + self.app_alpha * feats[c]
    83	                    t["app"] = a / (np.linalg.norm(a) + 1e-8)
    84	                out[c] = tid
    85	        matched = {tid for tid in out if tid >= 0}
    86	        for tid in list(self.tracks):                              # age / delete unmatched tracks
    87	            if tid not in matched:
    88	                self.tracks[tid]["age"] += 1
    89	                if self.tracks[tid]["age"] > self.max_age:
    90	                    del self.tracks[tid]; self.n_deleted += 1
    91	        for c in range(n):                                         # births
    92	            if out[c] < 0:
    93	                tid = self.next_id; self.next_id += 1; self.n_new += 1
    94	                self.tracks[tid] = {"pos": uv[c].copy(), "vel": np.zeros(2), "age": 0, "hits": 1,
    95	                                    "app": None if feats is None else feats[c] / (np.linalg.norm(feats[c]) + 1e-8)}
    96	                out[c] = tid
    97	        return out

