    68	        self._spawn_points = self._map.get_spawn_points()
    69	
    70	    # ------------------------------------------------------------------
    71	    # Episode Lifecycle
    72	    # ------------------------------------------------------------------
    73	
    74	    def setup_episode(self) -> dict[str, Any]:
    75	        """Spawn all actors for a new episode. Returns episode metadata."""
    76	        env_cfg = self._config.get("environment", {})
    77	        scene_cfg = self._config.get("scene", {})
    78	
    79	        # -- Seeding (P1-b): make the whole episode reproducible --
    80	        seed = env_cfg.get("seed", None)
    81	        if seed is not None:
    82	            seed = int(seed)
