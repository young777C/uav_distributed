runs/opening_dump/chains_attr.sh:7:TAH="--tid-head tah --tah-ckpt runs/tah_relm_dag.pt --conf-tau 0.5 --gallery-seed committed --reanchor off --occl-cands --tracklets tracker"
runs/opening_dump/chains_attr.sh:9:export VIS_RAYCAST=1 HIRES=3 FIRST_MIN=25 OPENING=attr OPENING_CFG='{"window":3,"ft":0.5}'
runs/opening_dump/chains_attr.sh:10:export TRK_CFG='{"max_age":8,"w_app":0.85,"gate_px":150,"gate_box":2.0,"min_cos":0.2}'
runs/opening_dump/wait_f_v3.sh:5:  until [ $(cat $L/zoa_pgif_trk_${x}_p*.log 2>/dev/null | grep -cE 'ep[0-9]+ seed') -ge 7 ] && ! docker ps --format '{{.Names}}' | grep -q "^it-zoa_pgif_trk_${x}$"; do sleep 20; done
runs/opening_dump/open_ticker7.sh:2:# Progress ticker (opening fix, closed-loop validation): every 120 s — held-out opening validation (attr 4×35 eps vs
runs/opening_dump/open_ticker7.sh:12:    va=$(cat $D/logs/ov_attr_*.log 2>/dev/null | grep -cE "ep[0-9]+ seed"); vh=$(cat $D/logs/ov_head_*.log 2>/dev/null | grep -cE "ep[0-9]+ seed")
runs/opening_dump/open_ticker7.sh:13:    ra=$(python3 $D/ocl_rate.py attr 1 2 3 4 9 2>/dev/null); rh=$(python3 $D/ocl_rate.py head 5 6 7 2>/dev/null); rf=$(python3 $D/ocl_rate.py fix 20 21 22 23 24 25 2>/dev/null); vf=$(cat $D/logs/ov_fix_*.log 2>/dev/null | grep -cE "ep[0-9]+ seed")
runs/opening_dump/open_ticker7.sh:14:    arms=""; for x in a b c; do n=$(cat $L/zoa_pgif_trk_${x}_p*.log 2>/dev/null | grep -cE 'ep[0-9]+ seed'); arms="$arms $x:${n:-0}"; done
runs/opening_dump/open_ticker7.sh:20:echo "[$(date +%H:%M)] ticker stopped"
runs/opening_dump/open_ticker9.sh:2:# Progress ticker (opening fix, closed-loop validation): every 120 s — held-out opening validation (attr 4×35 eps vs
runs/opening_dump/open_ticker9.sh:12:    va=$(cat $D/logs/ov_attr_*.log 2>/dev/null | grep -cE "ep[0-9]+ seed"); vh=$(cat $D/logs/ov_head_*.log 2>/dev/null | grep -cE "ep[0-9]+ seed")
runs/opening_dump/open_ticker9.sh:13:    ra=$(python3 $D/ocl_rate.py attr 1 2 3 4 9 2>/dev/null); rh=$(python3 $D/ocl_rate.py head 5 6 7 2>/dev/null); rf=$(python3 $D/ocl_rate.py fix 20 21 22 23 24 25 2>/dev/null); r3=$(python3 $D/ocl_rate.py v3 40 41 42 43 44 45 46 47 2>/dev/null); v3n=$(cat $D/logs/ov_v3_*.log 2>/dev/null | grep -cE "ep[0-9]+ seed"); vf=$(cat $D/logs/ov_fix_*.log 2>/dev/null | grep -cE "ep[0-9]+ seed")
runs/opening_dump/open_ticker9.sh:14:    arms=""; for x in a b; do n=$(cat $L/zo3_pgif_trk_${x}_p*.log 2>/dev/null | grep -cE "ep[0-9]+ seed"); arms="$arms $x:${n:-0}"; done
runs/opening_dump/open_ticker9.sh:20:echo "[$(date +%H:%M)] ticker stopped"
runs/opening_dump/chains_v3.sh:7:TAH="--tid-head tah --tah-ckpt runs/tah_relm_dag.pt --conf-tau 0.5 --gallery-seed committed --reanchor off --occl-cands --tracklets tracker"
runs/opening_dump/chains_v3.sh:9:export VIS_RAYCAST=1 HIRES=3 FIRST_MIN=25 OPENING=attr OPENING_CFG='{"window":3,"ft":0.5,"agg":"last","final_reset":true,"reset_asd":true}'
runs/opening_dump/chains_v3.sh:10:export TRK_CFG='{"max_age":8,"w_app":0.85,"gate_px":150,"gate_box":2.0,"min_cos":0.2}'
runs/opening_dump/run_dumph.sh:2:# Opening benchmark dump (1004 opening-fix plan): short episodes (13 steps → S2 ticks 0/6/12) with occlusion-aware
runs/opening_dump/run_dumph.sh:3:# candidates; policy saves frame + candidates + language + current grounding logits at those ticks.
runs/opening_dump/run_dumph.sh:4:#   usage: run_dump.sh <k> <carla_port> <gpu> <seed_base> <episodes>
runs/opening_dump/run_dumph.sh:9:  HEAD_ARGS="--tid-head tah --tah-ckpt runs/tah_relm_dag.pt --conf-tau 0.5 --gallery-seed committed --reanchor off --occl-cands" \
runs/opening_dump/run_dumph.sh:10:  bash carla_uav_tracking/rollout/eval_asd.sh > $D/logs/dumph_$k.log 2>&1 < /dev/null
runs/opening_dump/start_base.sh:3:# validation: OPENING=head (current grounding head) on the same seeds 93100–93239.
runs/opening_dump/start_base.sh:6:  docker exec -d cyh-carla bash -c "/home/carla/CarlaUE4.sh -RenderOffScreen -graphicsadapter=$A -carla-rpc-port=$CP -nosound -fps=20 > /tmp/carla_$CP.log 2>&1"
