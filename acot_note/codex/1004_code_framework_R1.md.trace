### runs/opening_dump/open_ticker5.sh
     1	#!/usr/bin/env bash
     2	# Progress ticker (opening fix, closed-loop validation): every 120 s — held-out opening validation V (4×35 eps, live
     3	# opening correct-lock rate) + dev downstream arms F (zoa_pgif_trk_{a,b,c}); immediate lines on new failures.
     4	D=/nvidia/hque/code/cyhe/uav-acot-track/runs/opening_dump; L=/nvidia/hque/code/cyhe/uav-acot-track/runs/asd/iter
     5	R=/nvidia/hque/code/cyhe/uav-acot-track/carla_uav_tracking/rollout
     6	seen_err=$(cat $D/logs/ov_attr_*.log $L/zoa_*.log 2>/dev/null | grep -cE "FAILED|Traceback|server died|HANG")
     7	last=0
     8	while [ ! -e $D/STOP ]; do
     9	  now=$(date +%s)
    10	  e=$(cat $D/logs/ov_attr_*.log $L/zoa_*.log 2>/dev/null | grep -cE "FAILED|Traceback|server died|HANG")
    11	  if [ "$e" -gt "$seen_err" ]; then echo "[$(date +%H:%M)] ⚠ new failure line(s) — check logs"; seen_err=$e; fi
    12	  if [ $((now - last)) -ge 120 ]; then
    13	    v=$(for k in 1 2 3 4; do grep -cE "ep[0-9]+ seed" $D/logs/ov_attr_$k.log 2>/dev/null; done | paste -sd+ | bc)
    14	    pr=""; for k in 1 2 3 4; do j=$R/eval_out/open_val_attr_$k.json; [ -e $j ] || j=$j.partial; [ -e $j ] && pr="$pr $D/val/attr_$k.jsonl:$j"; done
    15	    rate=$( [ -n "$pr" ] && cd $R && python3 - $pr <<'PY'
    16	import sys, collections
    17	sys.argv = ["x"] + sys.argv[1:]
    18	import opening_cl as o
    19	T = {}
    20	for p in sys.argv[1:]:
    21	    T.update(o.load([tuple(p.split(":"))]))
    22	f = []; l = []
    23	for s, Rr in T.items():
    24	    P = [r for r in Rr if r.get("true") is not None and r["true"] >= 0]
    25	    if not P: continue
    26	    f.append(o.out_id(P[0]) == P[0]["aidx"][P[0]["true"]])
    27	    rl = next((r for r in P if r["t"] >= 12), None)
    28	    if rl is not None: l.append(o.out_id(rl) == rl["aidx"][rl["true"]])
    29	print(f"首帧 {sum(f)}/{len(f)} 窗口后 {sum(l)}/{len(l)}" + (f" = {sum(l)/len(l):.0%}" if l else ""))
    30	PY
    31	)
    32	    arms=""; for x in a b c; do n=$(cat $L/zoa_pgif_trk_${x}_p*.log 2>/dev/null | grep -cE 'ep[0-9]+ seed'); arms="$arms $x:${n:-0}"; done
    33	    echo "[$(date +%H:%M)] V 留出开局验证 ${v:-0}/140 集 | 开局正确 ${rate:-—} | F dev 闭环(7/7/6)$arms"
    34	    last=$now
    35	  fi
    36	  sleep 10
    37	done
    38	echo "[$(date +%H:%M)] ticker stopped"
