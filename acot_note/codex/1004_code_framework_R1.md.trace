     7	i=0; sb=93100
     8	for spec in "2050 1 18" "2060 1 18" "2080 2 18" "2270 5 18" "2290 7 17" "2310 0 17" "2070 2 17" "2250 6 17"; do
     9	  set -- $spec; bash run_openval.sh v3p $((50 + i)) $1 $2 $sb $3 attr "$V3" &
    10	  sb=$((sb + $3)); i=$((i + 1)); sleep 1
