     1	"""ASD module — drift correction for closed-loop self-updating identity memories.
     2	
     3	MAIN METHOD (mode="filter", filter_kind="tempered") = PGIF, Posterior-Gated Identity Filtering:
     4	  a memory-agnostic wrapper around ANY identity memory that (i) picks a candidate, (ii) reports a confidence on any
     5	  scale, (iii) exposes an update hook. Per decision tick it keeps a tempered, confidence-weighted evidence count per
     6	  persistent tracklet  L_k <- lam*L_k + (0.5 + rank(conf))*1[k = memory pick]  and, when argmax_k L_k disagrees with
     7	  the memory's pick, re-does the memory update with the argmax crop and commits control to it (posterior gating).
     8	  Rationale (acot_note/1001_innovation-design.md): self-update makes the memory's errors autocorrelated, so evidence
     9	  must be tempered (untempered Bayes = ablation, gets captured); gating stops wrong picks being written into memory.
    10	ABLATIONS: filter_kind="resid" (equal weights), "bayes" (untempered sticky HMM), gate_memory=False (commit-only).
    11	LEGACY (negative results, kept for reproducibility): modes "rule"/"learned" = frozen appearance+language anchor with
    12	  multi-hypothesis CUSUM; "observe" = log statistics only (no intervention).
    13	GT is never used at decision time; `true_slot` is only written to the log for offline scoring."""
    14	from __future__ import annotations
    15	
    16	import json
    17	
    18	import numpy as np
    19	
    20	STAT_NAMES = ["disagree", "margin", "anc_dissim", "lang_disfavor", "disagree_x_margin"]
    21	
    22	
    23	class ASD:
    24	    def __init__(self, mode: str = "rule", k_anchor: int = 3, beta_lang: float = 0.25, lang_ema: float = 0.7,
    25	                 tau: float = 0.1, kappa: float = 0.25, h: float = 2.0, refractory: int = 3,
    26	                 learned_ckpt: str | None = None, log_path: str | None = None, anchor_mode: str = "first",
    27	                 eps_switch: float = 0.01, q_lo: float = 0.2, q_hi: float = 0.7, conf_window: int = 30,
    28	                 gate_memory: bool = True, filter_kind: str = "bayes", resid_decay: float = 0.98,
    29	                 alpha: dict | None = None, naive: bool = False, gate_tah: bool = True, gate_dam: bool = True,
    30	                 absent_hold: bool = False, absent_max: int = 8):
    31	        assert mode in ("observe", "rule", "learned", "filter"), mode
    32	        self.mode, self.k_anchor, self.beta, self.lema = mode, int(k_anchor), float(beta_lang), float(lang_ema)
    33	        self.tau, self.kappa, self.h, self.refractory = float(tau), float(kappa), float(h), int(refractory)
    34	        self.w = self.b = None
    35	        if mode == "learned":
    36	            assert learned_ckpt, "mode=learned needs learned_ckpt"
    37	            ck = json.load(open(learned_ckpt))
    38	            self.w, self.b = np.asarray(ck["w"], np.float64), float(ck["b"])
    39	            self.prior_logit = float(ck.get("prior_logit", 0.0))
    40	            self.h = float(ck.get("h", self.h))
    41	            self.mu, self.sd = np.asarray(ck["mu"]), np.asarray(ck["sd"])
    42	        self.log_path = log_path
    43	        # anchor_mode: 'first' = anchor = M's picks during the window (inherits cold-start errors) |
    44	        # 'spec' = sequential SPEC identification: integrate language evidence per actor over the window, anchor
    45	        # to the argmax actor's crops and correct M if it disagrees (also fixes wrong cold-start locks).
    46	        assert anchor_mode in ("first", "spec"), anchor_mode
    47	        self.anchor_mode = anchor_mode
    48	        # filter mode (ASD-IF): sticky Bayes filter over persistent tracklets; the memory's pick is a noisy
    49	        # observation whose error rate q is set by the rank of its confidence within a sliding window
    50	        # (scale-free → memory-agnostic, no per-memory calibration). Output = MAP tracklet (posterior gating).
    51	        self.eps_switch, self.q_lo, self.q_hi, self.conf_window = float(eps_switch), float(q_lo), float(q_hi), int(conf_window)
    52	        self.gate_memory = bool(gate_memory)          # ablation: False = override commitment only, memory still self-updates
    53	        assert filter_kind in ("bayes", "resid", "tempered"), filter_kind
    54	        self.filter_kind, self.resid_decay = filter_kind, float(resid_decay)   # 'resid' = longest-residence heuristic
    55	        # V3 fusion: per-source weights (default equal), naive = per-tick vote (no tempering, ensemble control)
    56	        self.alpha = dict(alpha or {}); self.naive = bool(naive)
    57	        self.gate_tah, self.gate_dam = bool(gate_tah), bool(gate_dam)
    58	        # 1004 deployable v2 · ABSENCE HYPOTHESIS: the posterior also ranges over tracklets NOT visible this tick (seen
    59	        # within the last `absent_max` ticks). If its MAP tracklet is currently unseen (occluded / out of frame), PGIF
    60	        # outputs "absent" (no pick → the commitment is held, the memory is not written) instead of being forced to
    61	        # pick the best VISIBLE tracklet — the forced choice is what turns a target occlusion into a wrong lock.
    62	        # The evidence update itself is unchanged.
    63	        self.absent_hold, self.absent_max = bool(absent_hold), int(absent_max)
    64	        self.ep = -1
    65	        self.reset()
    66	
    67	    # ------------------------------------------------------------------ state
    68	    def reset(self):
    69	        self.anchor: list[np.ndarray] = []      # frozen early-track appearance bank (drift-immune reference)
    70	        self.win_feats: dict[int, list] = {}    # spec-anchor window: actor id -> crops seen
    71	        self.win_ticks = 0
    72	        self.belief: dict[int, float] = {}      # filter: posterior over tracklet ids
    73	        self.conf_hist: list[float] = []
    74	        self.src_hist: dict[str, list] = {}     # V3 fusion: per-source confidence windows
    75	        self.lang_score: dict[int, float] = {}  # per-actor EMA of z-scored language logit (spec integration)
    76	        self.S: dict[int, float] = {}           # multi-hypothesis CUSUM: per challenger identity (actor id)
    77	        self.cool = 0                           # refractory ticks after an alarm
    78	        self.tick = 0
    79	        self.fires = 0
    80	        self.last_seen: dict[int, int] = {}     # absence hypothesis: tracklet id -> last tick it was visible
    81	        self.absents = 0
    82	        self.ep += 1
    83	
    84	    # ------------------------------------------------------------------ stats
    85	    def _lang_z(self, aidx, lang):
    86	        if lang is None or len(lang) == 0:
    87	            return np.zeros(len(aidx))
    88	        l = np.asarray(lang, np.float64)
    89	        z = (l - l.mean()) / (l.std() + 1e-6) if len(l) > 1 else np.zeros_like(l)
    90	        for a, v in zip(aidx, z):
    91	            p = self.lang_score.get(int(a), float(v))
    92	            self.lang_score[int(a)] = self.lema * p + (1 - self.lema) * float(v)
    93	        return np.array([self.lang_score[int(a)] for a in aidx])
    94	
    95	    def stats(self, feats, aidx, mem_slot, lang):
    96	        zl = self._lang_z(aidx, lang)
    97	        cosA = (feats @ np.stack(self.anchor).T).max(axis=1) if self.anchor else np.zeros(len(aidx))
    98	        a = cosA + self.beta * zl                                    # anchor (spec-side) score
    99	        anc = int(a.argmax())
   100	        dis = float(anc != mem_slot)
   101	        margin = float(a[anc] - a[mem_slot])
   102	        x = np.array([dis, margin, 1.0 - float(cosA[mem_slot]), float(zl.max() - zl[mem_slot]), dis * margin])
   103	        self._last = (cosA, zl)                                      # per-candidate view (offline ablations)
   104	        return x, anc
   105	
   106	    def increment(self, x):
   107	        if self.mode == "learned":
   108	            z = (x - self.mu) / self.sd
   109	            return float(z @ self.w + self.b - self.prior_logit)      # log-likelihood ratio (wrong vs right)
   110	        return float(x[0] * min(x[1] / self.tau, 2.0) - self.kappa)  # rule: disagreement weighted by margin
   111	
   112	    # ------------------------------------------------------------------ main
   113	    def step(self, feats, aidx, mem_slot, mem_conf=None, lang=None, true_slot=None, t=None):
   114	        out = {"fire": False, "slot": mem_slot}
   115	        if mem_slot is None or mem_slot < 0 or len(aidx) == 0:
   116	            return out
   117	        if self.mode == "filter":
   118	            return self._filter_step(aidx, mem_slot, mem_conf, true_slot, t)
   119	        feats = np.asarray(feats, np.float64)
   120	        if self.anchor_mode == "first" and len(self.anchor) < self.k_anchor:   # window: anchor = M's early picks
   121	            self._lang_z(aidx, lang)
   122	            self.anchor.append(feats[mem_slot].copy())
   123	            self.tick += 1
   124	            self._log(t, aidx, mem_slot, mem_conf, true_slot, None, None, False)
   125	            return out
   126	        if self.anchor_mode == "spec" and not self.anchor:                  # window: integrate spec evidence
   127	            self._lang_z(aidx, lang)
   128	            for s_, a_ in enumerate(aidx):
   129	                self.win_feats.setdefault(int(a_), []).append(feats[s_].copy())
   130	            self.win_ticks += 1
   131	            self.tick += 1
   132	            fire = False
   133	            if self.win_ticks >= self.k_anchor:
   134	                seen = [a_ for a_ in self.lang_score if len(self.win_feats.get(a_, [])) >= max(1, self.win_ticks // 2)]
   135	                best = max(seen or list(self.lang_score), key=lambda a_: self.lang_score[a_])
   136	                self.anchor = self.win_feats[best][-self.k_anchor:]
   137	                if best in [int(a_) for a_ in aidx] and int(aidx[mem_slot]) != best and self.mode != "observe":
   138	                    fire = True; self.fires += 1; self.cool = self.refractory
   139	                    out = {"fire": True, "slot": [int(a_) for a_ in aidx].index(best)}
   140	                self.win_feats = {}
   141	            self._log(t, aidx, mem_slot, mem_conf, true_slot, None, None, fire)
   142	            return out
   143	        x, anc = self.stats(feats, aidx, mem_slot, lang)
   144	        g = self.increment(x)
   145	        fire = False
   146	        # Multi-hypothesis CUSUM: evidence accumulates only for the SPECIFIC identity the anchor prefers over M.
   147	        # Noise-driven disagreements scatter over different look-alikes and decay; a true drift concentrates
   148	        # on one identity (the real target) → that hypothesis crosses h.
   149	        ca = int(aidx[anc]) if anc != mem_slot else None
   150	        for k in list(self.S):
   151	            if k != ca:
   152	                self.S[k] = max(0.0, self.S[k] - self.kappa)
   153	        if ca is not None:
   154	            self.S[ca] = max(0.0, self.S.get(ca, 0.0) + g)
   155	        if self.cool > 0:
   156	            self.cool -= 1
   157	        elif self.mode != "observe" and ca is not None and self.S[ca] > self.h:
   158	            fire = True
   159	            self.S, self.cool, self.fires = {}, self.refractory, self.fires + 1
   160	            out = {"fire": True, "slot": anc}
   161	        self.tick += 1
   162	        self._log(t, aidx, mem_slot, mem_conf, true_slot, x, anc, fire)
   163	        return out
   164	
   165	    def step_multi(self, aidx, obs, true_slot=None, t=None):
   166	        """V3 fusion. obs = [(slot|None, conf, source), ...] from heterogeneous memories + language. Tempered,
   167	        rank-weighted per-source votes into ONE tracklet evidence; naive=True -> per-tick vote (ensemble control).
   168	        Returns {"slot": MAP slot or None, "gate": {source: MAP != that source's pick}}."""
   169	        ids = [int(a) for a in aidx]
   170	        b = {} if self.naive else self.belief
   171	        if not self.naive:
   172	            for k in b:
   173	                b[k] *= self.resid_decay
   174	        picks = {}
   175	        for slot, conf, src in obs:
   176	            if slot is None or slot < 0 or slot >= len(ids):
   177	                picks[src] = None; continue
   178	            c = 0.0 if conf is None or conf != conf else float(conf)
   179	            h = self.src_hist.get(src, [])
   180	            pct = float(np.searchsorted(np.sort(h), c)) / len(h) if len(h) >= 5 else 0.5
   181	            self.src_hist[src] = (h + [c])[-self.conf_window:]
   182	            b[ids[slot]] = b.get(ids[slot], 0.0) + float(self.alpha.get(src, 1.0)) * (0.5 + pct)
   183	            picks[src] = int(slot)
   184	        self.belief = b
   185	        vis = [s_ for s_ in range(len(ids)) if b.get(ids[s_], 0.0) > 0]
   186	        map_slot = max(vis, key=lambda s_: b[ids[s_]]) if vis else None
   187	        gate = {src: (map_slot is not None and p != map_slot) for src, p in picks.items()}
   188	        self.tick += 1
   189	        if map_slot is not None and any(gate.values()):
   190	            self.fires += 1
   191	        if self.log_path:
   192	            rec = {"ep": self.ep, "t": t, "n": len(ids), "true": None if true_slot is None else int(true_slot),
   193	                   "map": map_slot, "picks": picks, "gate": gate, "aidx": ids,
   194	                   "conf": {src: (None if c is None or c != c else round(float(c), 4)) for _, c, src in obs}}
   195	            with open(self.log_path, "a") as f:
   196	                f.write(json.dumps(rec) + "\n")
   197	        return {"slot": map_slot, "gate": gate}
   198	
   199	    def override(self, new_actor_id: int, prior: float = 3.0, t=None):
   200	        """1003_dynamic-retarget-design.md §2.3 — event-driven hard reset (S1: GT-driven).
   201	        Not evidence: an external re-designation command bypasses the tempered accumulator
   202	        entirely (a legitimate switch must not have to out-accumulate the old target's
   203	        evidence against the sticky prior that drift-resistance deliberately creates). Wipes
   204	        ALL tracklet evidence (not just the old target's) and seeds the new target with a
   205	        prior equivalent to a few committed ticks, so the very next step() doesn't immediately
   206	        flip back. conf_hist is cleared too (rank-confidence restarts fresh, as at cold-start)."""
   207	        self.belief = {int(new_actor_id): float(prior)}
   208	        self.conf_hist = []
   209	        self.fires += 1
   210	        if self.log_path:
   211	            with open(self.log_path, "a") as f:
   212	                f.write(json.dumps({"ep": self.ep, "t": t, "kind": "override",
   213	                                    "new_actor_id": int(new_actor_id)}) + "\n")
   214	
   215	    def _filter_step(self, aidx, mem_slot, mem_conf, true_slot, t):
   216	        ids = [int(a) for a in aidx]; act = ids[mem_slot]; b = self.belief
   217	        if self.filter_kind in ("resid", "tempered"):
   218	            # TEMPERED evidence accumulator (PGIF main): L_k <- lam*L_k + w_t*1[k = memory pick]. Self-update makes
   219	            # the memory's errors autocorrelated, so per-tick evidence must be tempered (lam ~ 1 - 1/tau_corr)
   220	            # instead of multiplied as if independent (the untempered 'bayes' ablation flips in 1-2 ticks).
   221	            # w_t = 0.5 + rank(conf) (scale-free) for 'tempered'; w_t = 1 for the 'resid' ablation.
   222	            c = 0.0 if mem_conf is None else float(mem_conf); h = self.conf_hist
   223	            pct = float(np.searchsorted(np.sort(h), c)) / len(h) if len(h) >= 5 else 0.5
   224	            self.conf_hist = (h + [c])[-self.conf_window:]
   225	            w = 1.0 if self.filter_kind == "resid" else 0.5 + pct
   226	            for k in b:
   227	                b[k] *= self.resid_decay
   228	            b[act] = b.get(act, 0.0) + w
   229	            map_slot = max(range(len(ids)), key=lambda s_: b.get(ids[s_], 0.0))
   230	            if self.absent_hold:
   231	                for i in ids:
   232	                    self.last_seen[i] = self.tick
   233	                alive = [k for k in b if self.tick - self.last_seen.get(k, -10 ** 9) <= self.absent_max]
   234	                gmap = max(alive, key=lambda k: b[k]) if alive else None
   235	                if gmap is not None and gmap not in ids and b[gmap] > b.get(ids[map_slot], 0.0):
   236	                    self.absents += 1; self.tick += 1
   237	                    self._log(t, aidx, mem_slot, mem_conf, true_slot, None, None, False, absent=int(gmap))
   238	                    return {"fire": False, "slot": None, "kind": "absent", "gate_memory": self.gate_memory,
   239	                            "absent_id": int(gmap)}
   240	            fire = map_slot != mem_slot
   241	            self.fires += int(fire); self.tick += 1
   242	            self._log(t, aidx, mem_slot, mem_conf, true_slot, None, map_slot, fire)
   243	            return {"fire": fire, "slot": map_slot, "kind": "gate", "gate_memory": self.gate_memory}
   244	        for a in ids:                                            # new tracklets enter with a tiny prior
   245	            b.setdefault(a, 1e-3 if b else 1.0)
   246	        tot = sum(b.values()); m = len(b)
   247	        for k in b:                                              # sticky identity transition
   248	            b[k] = (1 - self.eps_switch) * b[k] / tot + self.eps_switch / m
   249	        c = 0.0 if mem_conf is None else float(mem_conf)
   250	        h = self.conf_hist
   251	        pct = float(np.searchsorted(np.sort(h), c)) / len(h) if len(h) >= 5 else 0.5
   252	        self.conf_hist = (h + [c])[-self.conf_window:]
   253	        q = self.q_hi - (self.q_hi - self.q_lo) * pct           # confident pick → lower error rate
   254	        nv = len(ids)
   255	        for k in b:
   256	            b[k] *= (1 - q) if k == act else q / max(nv - 1, 1)
   257	        tot = sum(b.values())
   258	        for k in b:
   259	            b[k] /= tot
   260	        map_slot = max(range(nv), key=lambda s_: b[ids[s_]])

