     1	"""ASD PoC paired statistics: for each (base, arm) pair over common scored seeds → Δ track_correct, Δ max_wrong
     2	(paired bootstrap 95% CI), latch@{2,5}s, SR with Wilson CI + exact McNemar.
     3	  python asd_stats.py base.json:arm.json [...] --json out.json      (stems relative to eval_out/, no .json)
     4	"""
     5	import argparse
     6	import json
     7	
     8	import numpy as np
     9	
    10	from stats_significance import load, wilson, mcnemar_exact, boot_diff
    11	
    12	
    13	def per_seed(e):
    14	    return {"correct": 1 - e["mis_follow_inst"], "max_wrong": e["max_wrong_run_s"],
    15	            "l2": float(e["max_wrong_run_s"] < 2.0), "l5": float(e["max_wrong_run_s"] < 5.0),
    16	            "sr": float(bool(e["success"])), "idsw": e["id_switches"]}
    17	
    18	
    19	def compare(base, arm):
    20	    A, B = load(base), load(arm)
    21	    seeds = sorted(set(A) & set(B))
    22	    a = [per_seed(A[s]) for s in seeds]; b = [per_seed(B[s]) for s in seeds]
    23	    res = {"base": base, "arm": arm, "n": len(seeds)}
    24	    for k in ("correct", "max_wrong", "l2", "l5", "idsw"):
    25	        x = np.array([r[k] for r in b]); y = np.array([r[k] for r in a])
    26	        m, lo, hi = boot_diff(x, y)
    27	        res[k] = {"base": float(y.mean()), "arm": float(x.mean()), "delta": float(m), "ci": [float(lo), float(hi)]}
    28	    sa = np.array([r["sr"] for r in a]); sb = np.array([r["sr"] for r in b])
    29	    res["sr"] = {"base": wilson(int(sa.sum()), len(sa)), "arm": wilson(int(sb.sum()), len(sb)),
    30	                 "mcnemar_p": mcnemar_exact(int(((sb == 1) & (sa == 0)).sum()), int(((sb == 0) & (sa == 1)).sum()))}
    31	    return res
    32	
    33	
    34	def fmt(r):
    35	    c, w = r["correct"], r["max_wrong"]
    36	    return (f"{r['arm']:34s} vs {r['base']:30s} n={r['n']:2d} | correct {c['base']:.3f}→{c['arm']:.3f} "
    37	            f"Δ{c['delta']:+.3f} [{c['ci'][0]:+.3f},{c['ci'][1]:+.3f}] | max_wrong {w['base']:.2f}→{w['arm']:.2f}s "
    38	            f"Δ{w['delta']:+.2f} [{w['ci'][0]:+.2f},{w['ci'][1]:+.2f}] | latch@5 {r['l5']['base']:.2f}→{r['l5']['arm']:.2f} "
    39	            f"| SR {r['sr']['base'][0]:.3f}→{r['sr']['arm'][0]:.3f} (McN p={r['sr']['mcnemar_p']:.2f})")
    40	
    41	
    42	if __name__ == "__main__":
    43	    ap = argparse.ArgumentParser(); ap.add_argument("pairs", nargs="+"); ap.add_argument("--json")
    44	    a = ap.parse_args()
    45	    out = []
    46	    for p in a.pairs:
    47	        b, x = p.split(":")
    48	        r = compare(b, x); out.append(r); print(fmt(r))
    49	    if a.json:
    50	        json.dump(out, open(a.json, "w"), indent=1)
     1	"""Pre-writing statistical rigor (data-completeness #1): Wilson 95% CIs for SR, and PAIRED
     2	same-seed significance tests for TAHRelM vs each key baseline — on SR (McNemar exact) and on the
     3	continuous metrics (paired bootstrap on the per-seed difference). No CARLA; reuses eval_out JSONs.
     4	
     5	Why: SR is binary over n=19 seeds → point estimates are noisy; a headline needs CIs + paired tests
     6	(same seeds → paired, not independent). Continuous metrics (track_correct, max_wrong) are per-frame
     7	aggregates → far less noisy; paired bootstrap gives their difference CIs.
     8	"""
     9	import json
    10	import os
    11	import numpy as np
    12	
    13	ROOT = os.path.join(os.path.dirname(__file__), "eval_out")
    14	ARMS = {
    15	    "TAHRelM":  "paper_ext_tahrelm_gt",
    16	    "borrow#1": "paper_ext_reidmotion03",
    17	    "DeepSORT": "paper_ext_assoc_deepsort",
    18	    "DAM4SAM":  "paper_ext_dam4sam",
    19	    "OC-SORT":  "paper_ext_assoc_motion",
    20	    "l5":       "paper_l5_dino_conf_tavg",
    21	    "xattn":    "paper_l1_xattn",
    22	}
    23	# deterministic bootstrap RNG seed passed in (no Math.random / Date in this env is fine — numpy ok on host)
    24	RNG = np.random.default_rng(20260916)
    25	
    26	
    27	def load(stem):
    28	    d = json.load(open(os.path.join(ROOT, stem + ".json")))
    29	    return {int(e["episode_seed"]): e for e in d["episodes"] if "mis_follow_inst" in e}
    30	
    31	
    32	def wilson(k, n, z=1.96):
    33	    if n == 0:
    34	        return (float("nan"), float("nan"), float("nan"))
    35	    p = k / n
    36	    d = 1 + z * z / n
    37	    c = (p + z * z / (2 * n)) / d
    38	    h = z * np.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / d
    39	    return p, max(0.0, c - h), min(1.0, c + h)
    40	
    41	
    42	def mcnemar_exact(a_win, b_win):
    43	    """exact two-sided binomial p on discordant pairs (a=1,b=0) vs (a=0,b=1)."""
    44	    from math import comb
    45	    b, c = a_win, b_win
    46	    n = b + c
    47	    if n == 0:
    48	        return 1.0
    49	    k = min(b, c)
    50	    p = sum(comb(n, i) for i in range(0, k + 1)) / (2 ** n) * 2
    51	    return min(1.0, p)
    52	
    53	
    54	def boot_diff(x, y, B=20000):
    55	    """paired bootstrap 95% CI of mean(x-y) over seeds."""
    56	    d = x - y
    57	    idx = RNG.integers(0, len(d), size=(B, len(d)))
    58	    means = d[idx].mean(1)
    59	    return d.mean(), np.percentile(means, 2.5), np.percentile(means, 97.5)
    60	
    61	
    62	def main():
    63	    data = {k: load(v) for k, v in ARMS.items()}
    64	    common = sorted(set.intersection(*[set(v) for v in data.values()]))
    65	    n = len(common)
    66	    print(f"paired seeds n={n}\n")
    67	
    68	    print("== SR (latch) with Wilson 95% CI ==")
    69	    print(f"{'arm':<10}{'SR':>7}{'k/n':>8}{'95% CI':>18}")
    70	    for k in ARMS:
    71	        sr = np.array([1 if data[k][s]["success"] else 0 for s in common])
    72	        p, lo, hi = wilson(sr.sum(), n)
    73	        print(f"{k:<10}{p:>7.3f}{str(int(sr.sum()))+'/'+str(n):>8}   [{lo:.3f}, {hi:.3f}]")
    74	    print("  ⚠ n=19 → CIs are WIDE (±~0.20); SR alone is a fragile headline.\n")
    75	
    76	    base = "TAHRelM"
    77	    print(f"== PAIRED tests: {base} vs each baseline (same {n} seeds) ==")
    78	    st = np.array([1 if data[base][s]["success"] else 0 for s in common])
    79	    tc = np.array([1 - data[base][s]["mis_follow_inst"] for s in common])
    80	    mw = np.array([data[base][s]["max_wrong_run_s"] for s in common])
    81	    for k in ARMS:
    82	        if k == base:
    83	            continue
    84	        sb = np.array([1 if data[k][s]["success"] else 0 for s in common])
    85	        a_win = int(((st == 1) & (sb == 0)).sum()); b_win = int(((st == 0) & (sb == 1)).sum())
    86	        pmc = mcnemar_exact(a_win, b_win)
    87	        tcb = np.array([1 - data[k][s]["mis_follow_inst"] for s in common])
    88	        mwb = np.array([data[k][s]["max_wrong_run_s"] for s in common])
    89	        dtc, lo_tc, hi_tc = boot_diff(tc, tcb)
    90	        dmw, lo_mw, hi_mw = boot_diff(mw, mwb)
    91	        sig_tc = "*" if (lo_tc > 0 or hi_tc < 0) else "ns"
    92	        sig_mw = "*" if (lo_mw > 0 or hi_mw < 0) else "ns"
    93	        print(f"\n  {base} vs {k}:")
    94	        print(f"    SR McNemar: win/lose discordant = {a_win}/{b_win}, exact p={pmc:.3f}"
    95	              + (" (SR too sparse to separate)" if pmc > 0.05 else " *"))
    96	        print(f"    Δtrack_correct = {dtc:+.3f}  95%CI [{lo_tc:+.3f},{hi_tc:+.3f}]  {sig_tc}")
    97	        print(f"    Δmax_wrong_s   = {dmw:+.2f}   95%CI [{lo_mw:+.2f},{hi_mw:+.2f}]  {sig_mw}")
    98	    print("\n[* = 95% CI excludes 0 (significant); ns = not separable at n=19]")
    99	    print("READOUT: continuous metrics (track_correct/max_wrong) separate arms far better than binary SR")
   100	    print("→ headline should LEAD with continuous metrics + paired CIs; SR as a conservative operating point.")
   101	
   102	
   103	if __name__ == "__main__":
   104	    main()

