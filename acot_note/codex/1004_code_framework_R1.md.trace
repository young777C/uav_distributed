### runs/tah_v90/gen_fov90.sh
     1	#!/usr/bin/env bash
     2	# B (2026-10-03): faithful 90° replica of mvp_full_v5 — same scenario config (config/scenarios/mvp.yaml on default.yaml,
     3	# output.fov = 90) and the SAME per-episode seeds 42–107 (seed = base + episode id), 4 disjoint shards on GPUs 1/2/4/5 with
     4	# their own rpc / TM ports (24x0 / 84x0: no clash with the closed-loop servers 2050–2250). Output: a NEW directory
     5	# /nvidia/hque/data/carla_data/mvp_full_v5_fov90 (the 70° mvp_full_v5 is kept for cross-FOV tests). Episodes are merged and
     6	# named by seed (episode_s<seed>.h5) so they pair 1:1 with the 70° copy via attrs['seed'].
     7	set -u
     8	OUT=mvp_full_v5_fov90; HOST=/nvidia/hque/data/carla_data/$OUT; LOG=/nvidia/hque/code/cyhe/uav-acot-track/runs/tah_v90/logs
     9	mkdir -p $LOG $HOST
    10	pids=()
    11	for spec in "1 42 17" "2 59 17" "4 76 16" "5 92 16"; do
    12	  set -- $spec; g=$1; sb=$2; n=$3; rpc=$((2400 + g * 10)); tm=$((8400 + g * 10)); k=$g
    13	  echo "[$(date +%H:%M)] worker gpu=$g seeds $sb..$((sb + n - 1)) rpc=$rpc tm=$tm" >> $LOG/gen.log
    14	  docker exec cyh-carla bash -lc "export CARLA_TM_PORT=$tm; cd /workspace && bash scripts/run_resilient.sh config/scenarios/mvp.yaml /data/$OUT/shard_g$g $n $sb 60 $rpc $g" \
    15	    > $LOG/gen_g$g.log 2>&1 &
    16	  pids+=($!); sleep 20
    17	done
    18	for p in "${pids[@]}"; do wait $p; done
    19	echo "[$(date +%H:%M)] all workers done" >> $LOG/gen.log
    20	python3 - <<'PY' >> $LOG/gen.log 2>&1
    21	import glob, os, shutil, h5py
    22	HOST = "/nvidia/hque/data/carla_data/mvp_full_v5_fov90"
    23	n = 0
    24	for p in sorted(glob.glob(f"{HOST}/shard_g*/episode_*.h5")):
    25	    with h5py.File(p, "r") as f:
    26	        s = int(f.attrs["seed"]); fov = f.attrs.get("fov")
    27	    shutil.move(p, f"{HOST}/episode_s{s:03d}.h5"); n += 1
    28	    print("moved", p, "-> seed", s, "fov", fov)
    29	print("merged", n)
    30	PY
    31	echo "[$(date +%H:%M)] merged" >> $LOG/gen.log
### runs/tah_v90/gen_fov90b.sh
     1	#!/usr/bin/env bash
     2	# B v2 (2026-10-03 22:10): faithful 90° replica of mvp_full_v5 — every episode generated with its ORIGINAL episode id
     3	# (seed = 42 + id) and its ORIGINAL town pinned (the sequential run's block-of-10 town schedule, read from the 70° copy:
     4	# runs/tah_v90/seed_town.json). v1 (gen_fov90.sh) sharded with per-shard ids starting at 0 → towns collapsed to
     5	# Town01/02; stopped, the 4 episodes whose town matched (seeds 42, 43, 92, 93) kept.
     6	set -u
     7	R=/nvidia/hque/code/cyhe/uav-acot-track; OUT=mvp_full_v5_fov90; HOST=/nvidia/hque/data/carla_data/$OUT; LOG=$R/runs/tah_v90/logs
     8	pids=()
     9	for spec in "g1 1 2410" "g2 2 2420" "g4 4 2440" "g5 5 2450"; do
    10	  set -- $spec; k=$1; g=$2; rpc=$3; tm=$((8400 + g * 10))
    11	  lst=$(python3 -c "import json;print(json.load(open('$R/runs/tah_v90/worker_lists.json'))['$k'])")
    12	  echo "[$(date +%H:%M)] v2 worker $k gpu=$g rpc=$rpc tm=$tm: $(echo $lst | wc -w) episodes" >> $LOG/gen.log
    13	  docker exec cyh-carla bash -lc "export CARLA_TM_PORT=$tm; cd /workspace && bash scripts/gen_seed_town_list.sh config/scenarios/mvp.yaml /data/$OUT/shard_$k $rpc $g 42 '$lst'" \
    14	    > $LOG/gen_$k.log 2>&1 &
    15	  pids+=($!); sleep 20
    16	done
    17	for p in "${pids[@]}"; do wait $p; done
    18	echo "[$(date +%H:%M)] all v2 workers done" >> $LOG/gen.log
    19	python3 - <<'PY' >> $LOG/gen.log 2>&1
    20	import glob, shutil, h5py
    21	HOST = "/nvidia/hque/data/carla_data/mvp_full_v5_fov90"
    22	n = 0
    23	for p in sorted(glob.glob(f"{HOST}/shard_*/episode_*.h5")):
    24	    if ".tmp." in p or ".rejected." in p:
    25	        continue
    26	    with h5py.File(p, "r") as f:
    27	        s = int(f.attrs["seed"]); t = str(f.attrs["town"]); fov = f.attrs.get("fov")
    28	    shutil.move(p, f"{HOST}/episode_s{s:03d}.h5"); n += 1
    29	    print("moved seed", s, t, "fov", fov)
    30	print("merged", n, "| total", len(glob.glob(f"{HOST}/episode_s*.h5")))
    31	PY
    32	echo "[$(date +%H:%M)] merged" >> $LOG/gen.log
### runs/tah_v90/pipeline.sh
     1	#!/usr/bin/env bash
     2	# TAHRelM FOV-fix retrain pipeline (2026-10-03, B+C). Waits for B (90° replica merged) and C (7 DAgger arms done), then:
     3	#  1. offline cache from mvp_full_v5_fov90 with 90° projection (train/config_v5_fov90.yaml), 4 shards in parallel → merged
     4	#     in the ORIGINAL episode order (tah_cache: train files then val files) → runs/tah_v90/off90.pt
     5	#  2. DAgger v2 per-episode files → runs/tah_v90/dag_v2.pt  (dag_old.pt = the 23 old 90° DAgger episodes, already built)
     6	#  3. train TAHRelM (--motion --aug, 60 epochs, val = first 15% of the offline cache, as before), seeds 0/1/2
     7	#  4. dev gate: final protocol (v1 opening, deploy v2) with the s0 checkpoint on dev 91000–19 (5 servers × 4), paired
     8	#     with the v1 arm zoa_pgif_trk_* (old checkpoint) — python carla_uav_tracking/rollout/opening_ds.py zv90s0_pgif_trk_{a..e}
     9	set -u
    10	R=/nvidia/hque/code/cyhe/uav-acot-track; D=$R/runs/tah_v90; L=$R/runs/asd/iter; LOG=$D/logs/pipeline.log
    11	cd $R; log() { echo "[$(date +%H:%M)] $*" >> $LOG; }
    12	log "waiting for B (merge) and C (7 DAgger arms)"
    13	until grep -q "merged" $D/logs/gen.log 2>/dev/null && [ "$(grep -c 'done  dagv2_' $L/progress.log)" -ge 7 ]; do sleep 60; done
    14	log "B and C done: $(ls /nvidia/hque/data/carla_data/mvp_full_v5_fov90/episode_s*.h5 | wc -l) episodes at 90°, $(ls $D/dag_v2/*.pt | wc -l) DAgger files"
    15	# 1. offline cache (4 shards)
    16	k=0; for g in 1 2 4 5; do
    17	  docker run --rm --network cyh-carla-net --gpus device=$g -e HF_HUB_OFFLINE=1 -e PYTHONPATH=$R/runs/pydeps -v $R:$R -v /nvidia/hque/data:/nvidia/hque/data -v $HOME/.cache/huggingface:/root/.cache/huggingface \
    18	    -v $HOME/.cache/torch:/root/.cache/torch -w $R acot-uav-train:cu118 bash -c "\
    19	    python train/tah_cache.py --config train/config_v5_fov90.yaml --shard $k --nshard 4 --out $D/off90_shard$k.pt" > $D/logs/cache_$k.log 2>&1 &
    20	  k=$((k + 1)); sleep 5
    21	done; wait
    22	log "offline cache shards: $(grep -h 'wrote' $D/logs/cache_*.log | tr '\n' ' ')"
    23	docker run --rm --network cyh-carla-net -v $R:$R -w $R acot-uav-train:cu118 bash -c "python train/tah_merge.py --glob '$D/off90_shard*.pt' --out $D/off90.pt; \
    24	  python train/tah_merge.py --glob '$D/dag_v2/*.pt' --out $D/dag_v2.pt" >> $LOG 2>&1
    25	# 3. train 3 seeds
    26	k=0; for g in 1 2 4; do
    27	  docker run --rm --network cyh-carla-net --gpus device=$g -v $R:$R -w $R acot-uav-train:cu118 python train/tah_train.py --motion --aug --epochs 60 \
    28	    --cache $D/off90.pt $D/dag_old.pt $D/dag_v2.pt --seed $k --out $D/tah_relm_v90_s$k.pt --device cuda:0 > $D/logs/train_s$k.log 2>&1 &
    29	  k=$((k + 1)); sleep 3
    30	done; wait
    31	log "trained: $(for s in 0 1 2; do tail -2 $D/logs/train_s$s.log | head -1; done | tr '\n' ' ')"
    32	# 4. dev gate with s0
    33	TAH="--tid-head tah --tah-ckpt runs/tah_v90/tah_relm_v90_s0.pt --conf-tau 0.5 --gallery-seed committed --reanchor off --occl-cands --tracklets tracker"
    34	H='{"filter_kind":"tempered","resid_decay":0.98,"absent_hold":true,"absent_max":8}'
    35	export VIS_RAYCAST=1 HIRES=3 FIRST_MIN=25 OPENING=attr OPENING_CFG='{"window":3,"ft":0.5}'
    36	export TRK_CFG='{"max_age":8,"w_app":0.85,"gate_px":150,"gate_box":2.0,"min_cos":0.2}'
    37	i=0; for spec in "a 2050 6 9301" "b 2060 7 9331" "c 2070 6 9361" "d 2080 7 9391" "e 2250 0 9421"; do
    38	  set -- $spec
    39	  SEED_BASE=$((91000 + 4 * i)) EPISODES=4 bash $L/launch_wd.sh zv90s0_pgif_trk_$1 $2 $3 $4 Town05 "$TAH --asd filter" "$H" &
    40	  i=$((i + 1)); sleep 2
    41	done; wait
    42	log "dev gate done"
    43	cd $R/carla_uav_tracking/rollout && python3 opening_ds.py zv90s0_pgif_trk_a zv90s0_pgif_trk_b zv90s0_pgif_trk_c zv90s0_pgif_trk_d zv90s0_pgif_trk_e >> $LOG 2>&1
    44	log "pipeline done"
### runs/tah_v90/pipeline_v2.sh
     1	#!/usr/bin/env bash
     2	# TAHRelM FOV-fix retrain pipeline v2 (2026-10-03, B+C). Waits for B FINAL (b_fill.py: retry + same-town substitutes) and C (7 DAgger arms done), then:
     3	#  1. offline cache from mvp_full_v5_fov90 with 90° projection (train/config_v5_fov90.yaml), 4 shards in parallel → merged
     4	#     in the ORIGINAL episode order (tah_cache: train files then val files) → runs/tah_v90/off90.pt
     5	#  2. DAgger v2 per-episode files → runs/tah_v90/dag_v2.pt  (dag_old.pt = the 23 old 90° DAgger episodes, already built)
     6	#  3. train TAHRelM (--motion --aug, 60 epochs, val = first 15% of the offline cache, as before), seeds 0/1/2
     7	#  4. dev gate: final protocol (v1 opening, deploy v2) with the s0 checkpoint on dev 91000–19 (5 servers × 4), paired
     8	#     with the v1 arm zoa_pgif_trk_* (old checkpoint) — python carla_uav_tracking/rollout/opening_ds.py zv90s0_pgif_trk_{a..e}
     9	set -u
    10	R=/nvidia/hque/code/cyhe/uav-acot-track; D=$R/runs/tah_v90; L=$R/runs/asd/iter; LOG=$D/logs/pipeline.log
    11	cd $R; log() { echo "[$(date +%H:%M)] $*" >> $LOG; }
    12	log "v2: waiting for B final (b_fill.py) and C (7 DAgger arms)"
    13	until grep -q "B final" $D/logs/gen.log 2>/dev/null && [ "$(grep -c 'done  dagv2_' $L/progress.log)" -ge 7 ]; do sleep 60; done
    14	log "B and C done: $(ls /nvidia/hque/data/carla_data/mvp_full_v5_fov90/episode_s*.h5 | wc -l) episodes at 90°, $(ls $D/dag_v2/*.pt | wc -l) DAgger files"
    15	# 1. offline cache (4 shards)
    16	k=0; for g in 1 2 4 5; do
    17	  docker run --rm --network cyh-carla-net --gpus device=$g -e HF_HUB_OFFLINE=1 -e PYTHONPATH=$R/runs/pydeps -v $R:$R -v /nvidia/hque/data:/nvidia/hque/data -v $HOME/.cache/huggingface:/root/.cache/huggingface \
    18	    -v $HOME/.cache/torch:/root/.cache/torch -w $R acot-uav-train:cu118 bash -c "\
    19	    python train/tah_cache.py --config train/config_v5_fov90.yaml --shard $k --nshard 4 --out $D/off90_shard$k.pt" > $D/logs/cache_$k.log 2>&1 &
    20	  k=$((k + 1)); sleep 5
    21	done; wait
    22	log "offline cache shards: $(grep -h 'wrote' $D/logs/cache_*.log | tr '\n' ' ')"
    23	docker run --rm --network cyh-carla-net -v $R:$R -w $R acot-uav-train:cu118 bash -c "python train/tah_merge.py --glob '$D/off90_shard*.pt' --out $D/off90.pt; \
    24	  python train/tah_merge.py --glob '$D/dag_v2/*.pt' --out $D/dag_v2.pt" >> $LOG 2>&1
    25	# 3. train 3 seeds
    26	k=0; for g in 1 2 4; do
    27	  docker run --rm --network cyh-carla-net --gpus device=$g -v $R:$R -w $R acot-uav-train:cu118 python train/tah_train.py --motion --aug --epochs 60 \
    28	    --cache $D/off90.pt $D/dag_old.pt $D/dag_v2.pt --seed $k --out $D/tah_relm_v90_s$k.pt --device cuda:0 > $D/logs/train_s$k.log 2>&1 &
    29	  k=$((k + 1)); sleep 3
    30	done; wait
    31	log "trained: $(for s in 0 1 2; do tail -2 $D/logs/train_s$s.log | head -1; done | tr '\n' ' ')"
    32	# 4. dev gate with s0
    33	TAH="--tid-head tah --tah-ckpt runs/tah_v90/tah_relm_v90_s0.pt --conf-tau 0.5 --gallery-seed committed --reanchor off --occl-cands --tracklets tracker"
    34	H='{"filter_kind":"tempered","resid_decay":0.98,"absent_hold":true,"absent_max":8}'
    35	export VIS_RAYCAST=1 HIRES=3 FIRST_MIN=25 OPENING=attr OPENING_CFG='{"window":3,"ft":0.5}'
    36	export TRK_CFG='{"max_age":8,"w_app":0.85,"gate_px":150,"gate_box":2.0,"min_cos":0.2}'
    37	i=0; for spec in "a 2050 6 9301" "b 2060 7 9331" "c 2070 6 9361" "d 2080 7 9391" "e 2250 0 9421"; do
    38	  set -- $spec
    39	  SEED_BASE=$((91000 + 4 * i)) EPISODES=4 bash $L/launch_wd.sh zv90s0_pgif_trk_$1 $2 $3 $4 Town05 "$TAH --asd filter" "$H" &
    40	  i=$((i + 1)); sleep 2
    41	done; wait
    42	log "dev gate done"
    43	cd $R/carla_uav_tracking/rollout && python3 opening_ds.py zv90s0_pgif_trk_a zv90s0_pgif_trk_b zv90s0_pgif_trk_c zv90s0_pgif_trk_d zv90s0_pgif_trk_e >> $LOG 2>&1
    44	log "pipeline done"
### runs/tah_v90/pipeline_v3.sh
     1	#!/usr/bin/env bash
     2	# TAHRelM FOV-fix retrain pipeline v3 (2026-10-04 00:05): caches already built (off90.pt 64 eps 90°, dag_old.pt, dag_v2.pt).
     3	#  3. train TAHRelM (--motion --aug, 60 epochs, val = first 15% of the offline cache as before; --save-last), seeds 0/1/2
     4	#  4. dev gate on dev 91000–19 under the final protocol (v1 opening, deploy v2), paired with the v1 arm zoa_pgif_trk_*:
     5	#     s0 BEST-by-val (zv90s0_*; 4 servers × 5) and s0 LAST-epoch (zv90s0L_*; 3 servers × 7/7/6) — the offline val split
     6	#     saturates at ~0.99 from epoch 1, so best-by-val may be an arbitrary early epoch.
     7	set -u
     8	R=/nvidia/hque/code/cyhe/uav-acot-track; D=$R/runs/tah_v90; L=$R/runs/asd/iter; LOG=$D/logs/pipeline.log
     9	cd $R; log() { echo "[$(date +%H:%M)] $*" >> $LOG; }
    10	log "v3: training 3 seeds (--save-last)"
    11	k=0; for g in 1 2 4; do
    12	  docker run --rm --network cyh-carla-net --gpus device=$g -v $R:$R -w $R acot-uav-train:cu118 python train/tah_train.py --motion --aug --epochs 60 \
    13	    --cache $D/off90.pt $D/dag_old.pt $D/dag_v2.pt --seed $k --save-last --out $D/tah_relm_v90_s$k.pt --device cuda:0 > $D/logs/train_s$k.log 2>&1 &
    14	  k=$((k + 1)); sleep 3
    15	done; wait
    16	log "trained: $(for s in 0 1 2; do grep 'done. best' $D/logs/train_s$s.log | cut -c8-60; done | tr '\n' ' ')"
    17	TRK='{"max_age":8,"w_app":0.85,"gate_px":150,"gate_box":2.0,"min_cos":0.2}'
    18	H='{"filter_kind":"tempered","resid_decay":0.98,"absent_hold":true,"absent_max":8}'
    19	export VIS_RAYCAST=1 HIRES=3 FIRST_MIN=25 OPENING=attr OPENING_CFG='{"window":3,"ft":0.5}' TRK_CFG="$TRK"
    20	arm() {  # name ckpt port gpu tm seed_base n
    21	  TAH="--tid-head tah --tah-ckpt $2 --conf-tau 0.5 --gallery-seed committed --reanchor off --occl-cands --tracklets tracker"
    22	  SEED_BASE=$6 EPISODES=$7 bash $L/launch_wd.sh $1 $3 $4 $5 Town05 "$TAH --asd filter" "$H"
    23	}
    24	B=runs/tah_v90/tah_relm_v90_s0.pt; LST=runs/tah_v90/tah_relm_v90_s0_last.pt
    25	arm zv90s0_pgif_trk_a $B 2050 6 9301 91000 5 & sleep 2
    26	arm zv90s0_pgif_trk_b $B 2060 7 9331 91005 5 & sleep 2
    27	arm zv90s0_pgif_trk_c $B 2070 6 9361 91010 5 & sleep 2
    28	arm zv90s0_pgif_trk_d $B 2080 7 9391 91015 5 & sleep 2
    29	arm zv90s0L_pgif_trk_a $LST 2090 3 9421 91000 7 & sleep 2
    30	arm zv90s0L_pgif_trk_b $LST 2230 3 9451 91007 7 & sleep 2
    31	arm zv90s0L_pgif_trk_c $LST 2250 0 9481 91014 6 &
    32	wait
    33	log "dev gate done"
    34	cd $R/carla_uav_tracking/rollout
    35	{ echo "== s0 BEST-by-val vs v1 (old ckpt)"; python3 opening_ds.py zv90s0_pgif_trk_a zv90s0_pgif_trk_b zv90s0_pgif_trk_c zv90s0_pgif_trk_d | head -6
    36	  echo "== s0 LAST-epoch vs v1 (old ckpt)"; python3 opening_ds.py zv90s0L_pgif_trk_a zv90s0L_pgif_trk_b zv90s0L_pgif_trk_c | head -6; } >> $LOG 2>&1
    37	log "pipeline done"
### runs/tah_v90/ticker.sh
     1	#!/usr/bin/env bash
     2	# Progress ticker (TAHRelM FOV-fix retrain): every 120 s — B: 90° replica episodes written (4 shards, 66 seeds);
     3	# C: DAgger episodes done (7 arms × 15) + tahdag files; immediate lines on new failures. Stops on runs/tah_v90/STOP.
     4	R=/nvidia/hque/code/cyhe/uav-acot-track; D=$R/runs/tah_v90; L=$R/runs/asd/iter; H=/nvidia/hque/data/carla_data/mvp_full_v5_fov90
     5	seen=$(cat $D/logs/gen_g*.log $L/dagv2_*.log 2>/dev/null | grep -cE "Traceback|FAILED|server died|HANG|cannot start")
     6	last=0
     7	while [ ! -e $D/STOP ]; do
     8	  now=$(date +%s)
     9	  e=$(cat $D/logs/gen_g*.log $L/dagv2_*.log 2>/dev/null | grep -cE "Traceback|FAILED|server died|HANG|cannot start")
    10	  [ "$e" -gt "$seen" ] && { echo "[$(date +%H:%M)] ⚠ new failure line(s) — check logs"; seen=$e; }
    11	  if [ $((now - last)) -ge 120 ]; then
    12	    b=""; for g in 1 2 4 5; do b="$b g$g:$(ls $H/shard_g$g/episode_*.h5 2>/dev/null | wc -l)"; done
    13	    bm=$(ls $H/episode_s*.h5 2>/dev/null | wc -l)
    14	    c=$(cat $L/dagv2_*_p*.log 2>/dev/null | grep -cE "ep[0-9]+ seed"); f=$(ls $D/dag_v2/*.pt 2>/dev/null | wc -l)
    15	    echo "[$(date +%H:%M)] B 90°复刻:分片$b(共 66 种子,已合并 $bm)| C DAgger:${c}/105 集,已写 ${f} 个 tahdag 文件"
    16	    last=$now
    17	  fi
    18	  sleep 15
    19	done
### runs/tah_v90/ticker2.sh
     1	#!/usr/bin/env bash
     2	# Progress ticker (TAHRelM FOV-fix retrain): every 120 s — B: 90° replica episodes written (4 shards, 66 seeds);
     3	# C: DAgger episodes done (7 arms × 15) + tahdag files; immediate lines on new failures. Stops on runs/tah_v90/STOP.
     4	R=/nvidia/hque/code/cyhe/uav-acot-track; D=$R/runs/tah_v90; L=$R/runs/asd/iter; H=/nvidia/hque/data/carla_data/mvp_full_v5_fov90
     5	seen=$(cat $D/logs/gen_g*.log $L/dagv2_*.log $L/zv90s0_*.log $D/logs/train_s*.log $D/logs/cache_*.log 2>/dev/null | grep -cE "Traceback|FAILED|server died|HANG|cannot start")
     6	last=0
     7	while [ ! -e $D/STOP ]; do
     8	  now=$(date +%s)
     9	  e=$(cat $D/logs/gen_g*.log $L/dagv2_*.log $L/zv90s0_*.log $D/logs/train_s*.log $D/logs/cache_*.log 2>/dev/null | grep -cE "Traceback|FAILED|server died|HANG|cannot start")
    10	  [ "$e" -gt "$seen" ] && { echo "[$(date +%H:%M)] ⚠ new failure line(s) — check logs"; seen=$e; }
    11	  if [ $((now - last)) -ge 120 ]; then
    12	    b=""; for g in 1 2 4 5; do b="$b g$g:$(ls $H/shard_g$g/episode_*.h5 2>/dev/null | wc -l)"; done
    13	    bm=$(ls $H/episode_s*.h5 2>/dev/null | wc -l)
    14	    c=$(cat $L/dagv2_*_p*.log 2>/dev/null | grep -cE "ep[0-9]+ seed"); f=$(ls $D/dag_v2/*.pt 2>/dev/null | wc -l)
    15	    st=$(tail -1 $D/logs/pipeline.log 2>/dev/null | cut -c9-90); tr=$(for s in 0 1 2; do tail -1 $D/logs/train_s$s.log 2>/dev/null | grep -oE "ep[0-9]+/[0-9]+" ; done | tr "\n" " "); gt=$(cat $L/zv90s0_*_p*.log 2>/dev/null | grep -cE "ep[0-9]+ seed")
    16	    echo "[$(date +%H:%M)] 流水线:${st} | 训练:${tr:-—} | dev 验收 ${gt}/20 | B 90°复刻:分片$b(共 66 种子,已合并 $bm)| C DAgger:${c}/105 集,已写 ${f} 个 tahdag 文件"
    17	    last=$now
    18	  fi
    19	  sleep 15
    20	done
### runs/tah_v90/ticker3.sh
     1	#!/usr/bin/env bash
     2	# Progress ticker (TAHRelM FOV-fix retrain): every 120 s — B: 90° replica episodes written (4 shards, 66 seeds);
     3	# C: DAgger episodes done (7 arms × 15) + tahdag files; immediate lines on new failures. Stops on runs/tah_v90/STOP.
