### runs/opening_dump/launch_fix.sh
     1	#!/usr/bin/env bash
     2	# Fixed opening config (agg=mean, final_reset, reset_asd) on FRESH held-out seeds 93240–93379 (6 CARLA servers).
     3	cd /nvidia/hque/code/cyhe/uav-acot-track/runs/opening_dump
     4	FIX='{"window":3,"ft":0.5,"agg":"mean","final_reset":true,"reset_asd":true}'
     5	i=0
     6	for spec in "2050 1" "2060 1" "2080 2" "2270 5" "2290 7" "2310 0"; do
     7	  set -- $spec; k=$((20 + i)); sb=$((93240 + i * 24)); n=24; [ $i -eq 5 ] && n=20
     8	  bash run_openval.sh fix $k $1 $2 $sb $n attr "$FIX" &
     9	  i=$((i + 1)); sleep 1
    10	done
    11	wait
### runs/opening_dump/launch_v3.sh
     1	#!/usr/bin/env bash
     2	# v3 opening (agg=last + final_reset + reset_asd) — UNBIASED held-out validation on fresh seeds 93380–93519 (n=140).
     3	# Batch 1 on the idle servers now; batch 2 on the six fix-config servers once those jobs are done.
     4	cd /nvidia/hque/code/cyhe/uav-acot-track/runs/opening_dump
     5	V3='{"window":3,"ft":0.5,"agg":"last","final_reset":true,"reset_asd":true}'
     6	bash run_openval.sh v3 40 2070 2 93380 20 attr "$V3" &
     7	bash run_openval.sh v3 41 2250 6 93400 20 attr "$V3" &
     8	until [ $(grep -c "openval fix " logs/progress.log) -ge 6 ]; do sleep 15; done
     9	i=0; sb=93420
    10	for spec in "2050 1 17" "2060 1 17" "2080 2 17" "2270 5 17" "2290 7 16" "2310 0 16"; do
    11	  set -- $spec; bash run_openval.sh v3 $((42 + i)) $1 $2 $sb $3 attr "$V3" &
    12	  sb=$((sb + $3)); i=$((i + 1)); sleep 1
    13	done
    14	wait
### runs/opening_dump/launch_v3p.sh
     1	#!/usr/bin/env bash
     2	# v3 opening on the v1/head seeds 93100–93239 (PAIRED comparison v3 vs v1 vs head; these seeds informed the v3 design,
     3	# so the unbiased v3 number is the fresh-seed run 93380–93519). Starts once the fresh-seed v3 jobs are all done.
     4	cd /nvidia/hque/code/cyhe/uav-acot-track/runs/opening_dump
