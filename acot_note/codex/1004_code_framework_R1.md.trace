    15	
    16	def _mk(world, is_t, idx, campose, W, H, fov, vsz, bmin, bmax):
    17	    pr = project_point((float(world[0]), float(world[1]), float(world[2])), tuple(campose), W, H, fov)
    18	    if pr is None: return None
    19	    u, v, depth = pr
    20	    if not (0 <= u < W and 0 <= v < H): return None
    21	    f = W / (2.0 * np.tan(np.radians(fov) / 2.0)); s = float(np.clip(f * vsz / max(depth, 0.1), bmin, bmax))
    22	    return Candidate(u, v, s, s, depth, is_t, idx)
    23	
    24	
    25	def main():
    26	    ap = argparse.ArgumentParser()
    27	    ap.add_argument("--config", default="train/config_v5.yaml")
    28	    ap.add_argument("--out", default="runs/tah_cache.pt")
    29	    ap.add_argument("--stride", type=int, default=2)
    30	    ap.add_argument("--device", default="cuda:0")
    31	    ap.add_argument("--shard", type=int, default=0); ap.add_argument("--nshard", type=int, default=1)  # parallel build
    32	    a = ap.parse_args()
    33	    import torch
    34	    from train.reid_resolution_probe import _load_dino, _dino_feats
    35	    cfg = yaml.safe_load(open(a.config)); ic = cfg["image"]
    36	    W, H, fov = ic["width"], ic["height"], ic["fov_deg"]
    37	    vsz, bmin, bmax = float(ic["vehicle_size_m"]), float(ic["box_min_px"]), float(ic["box_max_px"])
    38	    dino = _load_dino("vit_small_patch14_dinov2.lvd142m", a.device)
    39	    eps = _select_episodes(cfg, "train") + _select_episodes(cfg, "val")
    40	    episodes, order = [], []
    41	    for ei, ep in enumerate(eps):
    42	        if ei % a.nshard != a.shard:
    43	            continue
    44	        with h5py.File(ep, "r") as fh:
    45	            n = fh["rgb"].shape[0]
    46	            tgt = np.stack([fh["target/tx"][:], fh["target/ty"][:], fh["target/tz"][:]], -1)
    47	            dpos = fh["distractors/positions"][:]                       # (T,D,6)
    48	            cam = np.stack([fh[f"state/cam_{k}"][:] for k in ["x","y","z","pitch","yaw"]], -1)
    49	            frames = []
    50	            for i in range(0, n, a.stride):
    51	                campose = cam[i]
    52	                cands, aidx, tflag = [], [], []
    53	                c = _mk(tgt[i], True, -1, campose, W, H, fov, vsz, bmin, bmax)
    54	                if c is not None: cands.append(c); aidx.append(-1); tflag.append(1)
    55	                for d in range(dpos.shape[1]):
    56	                    c = _mk(dpos[i, d, :3], False, d, campose, W, H, fov, vsz, bmin, bmax)
    57	                    if c is not None: cands.append(c); aidx.append(d); tflag.append(0)
    58	                if not cands: continue
    59	                feats = _dino_feats(dino, np.asarray(fh["rgb"][i]), cands, W, H, 224, 1.3, a.device).astype(np.float32)
    60	                feats = feats / (np.linalg.norm(feats, axis=1, keepdims=True) + 1e-8)
    61	                pos = np.array([[c.u / W, c.v / H, c.depth / 100.0] for c in cands], np.float32)
