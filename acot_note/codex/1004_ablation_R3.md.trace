runs/asd/deploy_all/chains.sh:14:start_dam4sam(){
runs/asd/deploy_all/chains.sh:15:  until grep -q BUILD_DONE $L/build_dam4sam.log 2>/dev/null; do sleep 30; done
runs/asd/deploy_all/chains.sh:16:  docker exec -d dam4sam-svc bash -lc "source \$(conda info --base)/etc/profile.d/conda.sh && conda activate dam4sam && \
runs/asd/deploy_all/chains.sh:17:    python $PWD/$R/dam4sam_service.py --model sam21pp-L --port 5601 > $PWD/$L/dam4sam_service.log 2>&1"
runs/asd/deploy_all/chains.sh:18:  for i in $(seq 1 60); do docker exec dam4sam-svc bash -c 'cat /proc/net/tcp | grep -qi ":15E1 "' && break; sleep 5; done
runs/asd/deploy_all/chains.sh:19:  echo "[$(date +%H:%M)] dam4sam service up" >> $L/progress.log
runs/asd/deploy_all/chains.sh:22: c2000) run ocsort 2000 1 8300 "--tid-head assoc --assoc-mode motion --conf-tau 0.05 $DEP" ""
runs/asd/deploy_all/chains.sh:23:        run tahrelm_pgif 2000 1 8301 "--tid-head tah --tah-ckpt runs/tah_relm_dag.pt --conf-tau 0.5 $DEP --asd filter" '{"filter_kind":"tempered","resid_decay":0.98}'
runs/asd/deploy_all/chains.sh:24:        run l5 2000 1 8302 "$REID --conf-tau 0.05 --reid-tavg 0.4 $DEP" ""
runs/asd/deploy_all/chains.sh:25:        run xattn 2000 1 8303 "--tid-head xattn $DEP" "" ;;
runs/asd/deploy_all/chains.sh:26: c2010) run deepsort 2010 7 8310 "--tid-head assoc --assoc-mode deepsort --conf-tau 0.05 $DEP" ""
runs/asd/deploy_all/chains.sh:27:        run tahrelm 2010 7 8311 "--tid-head tah --tah-ckpt runs/tah_relm_dag.pt --conf-tau 0.5 $DEP" ""
runs/asd/deploy_all/chains.sh:28:        run borrow1 2010 7 8312 "$REID --conf-tau 0.05 --reid-tavg 0.4 --reid-motion 0.3 $DEP" "" ;;
runs/asd/deploy_all/chains.sh:29: c2040) run tahdag 2040 3 8340 "--tid-head tah --tah-ckpt runs/tah_rel_dag.pt --conf-tau 0.5 $DEP" ""
runs/asd/deploy_all/chains.sh:30:        run l4 2040 3 8341 "$REID --conf-tau 0.05 $DEP" ""
runs/asd/deploy_all/chains.sh:31:        start_dam4sam
runs/asd/deploy_all/chains.sh:32:        run dam4sam 2040 3 8342 "--tid-head dam4sam --dam4sam-host dam4sam-svc --dam4sam-port 5601 --conf-tau 0.05 $DEP" "" ;;
