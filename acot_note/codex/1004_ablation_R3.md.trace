   334	    def _asd_gate_memory(self, slot, which=None):
   335	        """Posterior-gated memory update: redo this tick's update with the filter's MAP crop (tah); reid's gallery
   336	        already stores the COMMITTED identity, which is overridden by the caller; dam4sam (V1): re-init SAM2 on the
   337	        filter's MAP candidate box (drops its RAM/DRM), with a pre-registered 3-tick cooldown."""
   338	        which = which or self.tid_head
   339	        if which == "dam4sam" and self._dam4sam_rgb is not None and self._cand_set_cur is not None \
   340	           and self._dam4sam_cool == 0:
   341	            from rollout.bridge import send_msg, recv_msg
   342	            c = self._cand_set_cur.cands[slot]
   343	            send_msg(self._dam4sam_sock, {"cmd": "init", "rgb": np.asarray(self._dam4sam_rgb, np.uint8),
   344	                                          "box": (c.u - c.w / 2.0, c.v - c.h / 2.0, c.w, c.h)})
   345	            recv_msg(self._dam4sam_sock)
   346	            self._dam4sam_cool = 3
   347	            return
   348	        if which in ("tah", "fusion") and self._tah_last is not None:
   349	            feat, pos = self._tah_last
   350	            prev = getattr(self, "_tah_mem_prev", None)
   351	            prev = prev if prev is not None else self._tah.reset(self.device)
   352	            self._tah_mem = self._tah.update(prev, feat[slot], pos[slot])
