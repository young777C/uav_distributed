   288	        import torch as _t
   289	        os.makedirs(self._tahdag_dir, exist_ok=True)
   290	        out = os.path.join(self._tahdag_dir, f"tahdag_ep{self._tahdag_ep:04d}.pt")
   291	        _t.save({"episodes": [self._tahdag_buf], "d_feat": 384}, out)
   292	        print(f"[tahdag] wrote {out}  ({len(self._tahdag_buf)} frames)", flush=True)
   293	        self._tahdag_ep += 1; self._tahdag_buf = []
