    38	# --ex-source: what fills DiT's z_ex slot. 'ear' = the trained EAR (default). The
    39	# rest inject a training-free memory+CV prior (rollout.target_state); '*_gated' only
    40	# during a loss (EAR when visible), bare 'cv'/'zerovel' always (diagnostic).
    41	# 'track' (Plan A): grounding-in-the-loop — z_ex is seeded from the tid-COMMITTED
    42	# candidate (K-frame hysteresis), so tid QUALITY drives control (a wrong pick tracks
    43	# the wrong car). The others seed from the GT target (tid stays scorer-only).
    44	# 'road' (P2a-1): the road-graph WM prior — z_ex during a loss is the env-side
    45	# lane-traversal prediction (gt_candidates[3], WORLD (K,3)) projected into cam frame,
    46	# vs cv_gated's straight-line dead-reckon. Same last-seen anchor+speed → isolates
    47	# follow-the-lane vs go-straight (offline M2 gate: road << cv_frame on turns/junctions).
    48	_EX_MODES = {"ear": (None, None), "cv": ("cv", False), "cv_gated": ("cv", True),
    49	             "zerovel": ("zerovel", False), "zerovel_gated": ("zerovel", True),
    50	             "road": ("road", True), "track": ("cv", False)}
    51	
    52	
    53	@dataclass
    54	class Observation:
    55	    rgb: np.ndarray          # (H,W,3) uint8 — sole perceptual input
    56	    language: str            # fixed per episode (raw; vlm applies the language mode)
    57	    proprio: np.ndarray      # (5,)
    58	    step: int
    59	    target_color: str = ""   # GT target identity (color+blueprint) — for the attrbind tid head
    60	    target_bp: str = ""      # (privileged, same level as GT candidate boxes; = offline attr upper bound)
    61	
    62	
    63	@dataclass
    64	class ActInfo:
    65	    tid_logits: np.ndarray   # (N,) target-id scores over candidates
    66	    pred_slot: int           # argmax candidate slot
    67	    cand_set: CandidateSet | None   # carries true_idx + per-slot identity for the scorer
    68	    z_ex: np.ndarray         # (K,3) EAR waypoint sample (diagnostic)
