    50	def _aggregate(rows):
    51	    done = [r for r in rows if not r.get("skipped")]
    52	    n = max(len(done), 1)
    53	    def mean(key):
    54	        vals = [r[key] for r in done if r.get(key) is not None]
    55	        return sum(vals) / len(vals) if vals else None
    56	    tot_attempts = sum(r.get("reacquire_attempts", 0) for r in done)
    57	    tot_success = sum(round((r.get("reacquire_success_rate") or 0) * r.get("reacquire_attempts", 0))
    58	                      for r in done)
    59	    tot_wrong = sum(round((r.get("reacquire_lock_wrong_rate") or 0) * r.get("reacquire_attempts", 0))
    60	                    for r in done)
    61	    return {
    62	        "episodes": len(rows), "scored": len(done),
    63	        "SR": sum(bool(r.get("success")) for r in done) / n,
    64	        "mis_follow_sustained": mean("mis_follow_sustained"),
    65	        "mis_follow_inst": mean("mis_follow_inst"),
    66	        "id_switches_mean": mean("id_switches"),
    67	        "track_seconds_mean": mean("track_seconds"),
    68	        "centering_rate": mean("centering_rate"),
    69	        # re-acquisition baseline (pooled over ALL attempts, not per-episode mean)
    70	        "reacquire_attempts_total": tot_attempts,
    71	        "reacquire_success_rate": (tot_success / tot_attempts) if tot_attempts else None,
    72	        "reacquire_timeout_rate": (1 - tot_success / tot_attempts) if tot_attempts else None,
    73	        "reacquire_lock_wrong_rate": (tot_wrong / tot_attempts) if tot_attempts else None,
    74	        "reacquire_convergence_s_mean": mean("reacquire_convergence_s_mean"),
    75	        "shortcut_nearest_rate": mean("shortcut_nearest_rate"),
    76	        "shortcut_target_central_rate": mean("shortcut_target_central_rate"),
    77	    }
    78	
    79	
    80	def main() -> int:
    81	    ap = argparse.ArgumentParser()
    82	    ap.add_argument("--policy-host", default="acot-policy-server")
    83	    ap.add_argument("--policy-port", type=int, default=5555)
    84	    ap.add_argument("--carla-port", type=int, default=int(os.environ.get("CARLA_PORT", "2012")))
    85	    ap.add_argument("--episodes", type=int, default=5)
    86	    ap.add_argument("--seed-base", type=int, default=90000)
    87	    ap.add_argument("--steps", type=int, default=1500)
    88	    ap.add_argument("--town", default=None)
    89	    ap.add_argument("--out", default=None)
    90	    ap.add_argument("--expert-control", action="store_true",
    91	                    help="drive the drone with the EXPERT action (well-framed) while still "
    92	                         "scoring the policy's tid — tests the framing→grounding→SR chain")
    93	    ap.add_argument("--predict-road", action="store_true",
    94	                    help="P2a-1: compute env-side road-graph target prediction (carla.Map lane "
    95	                         "traversal) → gt_candidates[3]. MUST pair with the policy server's "
    96	                         "--ex-source road; a no-op for the ear/cv_gated arms.")
    97	    ap.add_argument("--road-oracle", action="store_true",
    98	                    help="P2a-2 positive control: anchor the road prediction at the TRUE CURRENT "
    99	                         "target pos every tick (bounds road's value if last-seen staleness+branch "
   100	                         "error were removed). Implies --predict-road; pair with --ex-source road.")
   101	    a = ap.parse_args()
   102	
   103	    cfg = load_config()
   104	    if a.town:   # evaluation on a town outside the data-gen list (e.g. held-out Town03): keep the scene manager on it
   105	        towns = cfg.setdefault("environment", {}).setdefault("towns", [])
   106	        if a.town not in towns:
   107	            towns.append(a.town)
   108	    client = carla.Client("127.0.0.1", a.carla_port)
   109	    client.set_timeout(60.0)   # first load_world after a fresh CARLA boot is slow (port-open != ready)
   110	    world = client.load_world(a.town) if a.town else client.get_world()
   111	    print(f"[rollout] map={world.get_map().name} policy={a.policy_host}:{a.policy_port} "
   112	          f"episodes={a.episodes}", flush=True)
   113	
   114	    policy = RemotePolicy(a.policy_host, a.policy_port)
   115	    rows = []
   116	    try:
   117	        for ep in range(a.episodes):
   118	            cfg.setdefault("environment", {})["seed"] = a.seed_base + ep
   119	            scene = SceneManager(world, cfg, client)
   120	            scorer = RolloutScorer(fps=10, max_lost_s=cfg["environment"].get("max_lost_seconds", 5))
   121	            env = StudentRolloutEnv(scene, world, policy=policy, scorer=scorer,
   122	                                    fps=10, resolution=(512, 512), expert_control=a.expert_control,
   123	                                    predict_road=a.predict_road or a.road_oracle,
   124	                                    road_oracle=a.road_oracle)
   125	            summary = env.run(max_steps=a.steps)
   126	            rows.append(summary)
   127	            tag = "SKIP" if summary.get("skipped") else (
   128	                "OK" if summary.get("success") else "FAIL")
   129	            print(f"[rollout] ep{ep} seed={a.seed_base+ep} [{tag}] "
   130	                  f"mis_follow_sus={summary.get('mis_follow_sustained')} "
   131	                  f"track_s={summary.get('track_seconds')}", flush=True)
   132	            if a.out:   # incremental save: a simulator crash mid-run no longer loses the finished episodes
   133	                with open(a.out + ".partial", "w") as f:
   134	                    json.dump({"aggregate": _aggregate(rows), "episodes": rows, "partial": True}, f, indent=2, default=str)
   135	    finally:
   136	        policy.close()
   137	
   138	    agg = _aggregate(rows)
   139	    print("\n[rollout] AGGREGATE:")
