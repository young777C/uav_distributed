   267	    def _dagger_flush(self):
   268	        """Write the finished episode's collected frames to DAGGER_DIR (one .npz/episode)."""
   269	        if not self._dagger_dir or not getattr(self, "_dagger_buf", None):
   270	            return
   271	        os.makedirs(self._dagger_dir, exist_ok=True)
   272	        feats = [b[0] for b in self._dagger_buf]           # list of (N_i, C) — ragged
   273	        tgt = np.array([b[1] for b in self._dagger_buf], np.int64)
   274	        col = np.array([b[2] for b in self._dagger_buf])
   275	        mk = np.array([b[3] for b in self._dagger_buf])
   276	        n = np.array([f.shape[0] for f in feats], np.int64)
   277	        out = os.path.join(self._dagger_dir, f"dagger_ep{self._dagger_ep:04d}.npz")
   278	        np.savez_compressed(out, feats=np.concatenate(feats, 0).astype(np.float16),
   279	                            n=n, true_idx=tgt, color=col, make=mk)
   280	        print(f"[dagger] wrote {out}  ({len(feats)} frames)", flush=True)
   281	        self._dagger_ep += 1
   282	
   283	    def _tahdag_flush(self):
   284	        """path-B DAgger: write the finished episode's deployment-distribution TAH frames (one .pt/ep,
   285	        same schema as train/tah_cache.py so tah_train can consume it directly)."""
   286	        if not self._tahdag_dir or not getattr(self, "_tahdag_buf", None):
