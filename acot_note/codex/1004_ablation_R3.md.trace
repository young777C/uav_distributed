   321	    def _asd_feats(self, cset, rgb):
   322	        """ASD appearance view of the candidates: reuse the active memory's frozen crop-DINOv2 feats when it
   323	        computed them this tick (tah / reid-dinov2), else compute them (memory-agnostic)."""
   324	        if self.tid_head == "tah" and self._asd_fe is not None:
   325	            return self._asd_fe
   326	        if self.tid_head == "reid" and self.reid_feature == "dinov2" and self._reid_fn is not None \
   327	           and len(self._reid_fn) == len(cset.cands):
   328	            return self._reid_fn
   329	        from train.reid_resolution_probe import _dino_feats
   330	        W, H = self.image_cfg["width"], self.image_cfg["height"]
   331	        fe = _dino_feats(self._dino, rgb, cset.cands, W, H, 224, 1.3, self.device).astype(np.float64)
   332	        return fe / (np.linalg.norm(fe, axis=1, keepdims=True) + 1e-8)
