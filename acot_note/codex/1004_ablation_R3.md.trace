   141	        print(f"    {k}: {v}")
   142	    if a.out:
   143	        with open(a.out, "w") as f:
   144	            json.dump({"aggregate": agg, "episodes": rows}, f, indent=2, default=str)
   145	        print(f"[rollout] wrote {a.out}")
   146	    return 0
   147	
   148	
   149	if __name__ == "__main__":
   150	    raise SystemExit(main())

