### carla_uav_tracking/rollout/iter_mech.py
     1	"""1003 mechanism diagnostics from the per-tick ASD logs (runs/asd/iter/<arm>[_p<k>].jsonl), aligned to scorer seeds
     2	(skipped episodes never reset the policy → logged episodes map in order onto the NON-skipped seeds of the same part).
     3	Per arm: tick accuracy of every source and of the final output, opening correctness (first logged tick), and the
     4	committed correct-lock ratio stratified by opening correctness. Fusion arms (V3 family): error correlation between
     5	TAHRelM and DAM4SAM picks (pre-registered H3c: measured on V3-ensemble = no feedback), mis-gates (a source that was
     6	RIGHT gets rewritten to a WRONG posterior identity). V1: AUROC of the SAM2 predicted IoU for "DAM4SAM pick is right".
     7	  python iter_mech.py [--json eval_out/iter_mech.json]"""
     8	import argparse
     9	import glob
    10	import json
    11	import os
    12	import re
    13	
    14	import numpy as np
    15	
    16	EO = os.path.join(os.path.dirname(__file__), "eval_out")
    17	LG = os.path.join(os.path.dirname(__file__), "..", "..", "runs", "asd", "iter")
    18	ARMS = ["v1_t05", "v1nog_t05", "v2_t05", "v3_t05", "v3v2_t05", "v3ens_t05", "v3com_t05", "v3gt_t05",
    19	        "v3_t03", "v3_t10", "pgif_t03"]
    20	
    21	
    22	def _json_of(path):
    23	    for f in (path, path + ".partial"):
    24	        if os.path.exists(f):
    25	            return json.load(open(f))["episodes"]
    26	    return []
    27	
    28	
    29	def aligned(arm):
    30	    """→ {seed: (scorer episode, [tick records])}."""
    31	    out = {}
    32	    logs = sorted(glob.glob(os.path.join(LG, f"{arm}_p[0-9].jsonl"))) or [os.path.join(LG, f"{arm}.jsonl")]
    33	    for jl in logs:
    34	        if not os.path.exists(jl):
    35	            continue
    36	        m = re.search(r"_p(\d)\.jsonl$", jl)
    37	        eps = _json_of(os.path.join(EO, f"paper_it_{arm}_p{m.group(1)}.json" if m else f"paper_it_{arm}.json"))
    38	        scored = [e for e in eps if not e.get("skipped")]
    39	        E = {}
    40	        for line in open(jl):
    41	            r = json.loads(line)
    42	            E.setdefault(r["ep"], []).append(r)
    43	        for k, e in zip(sorted(E), scored):
    44	            out.setdefault(int(e["episode_seed"]), (e, E[k]))
    45	    return out
    46	
    47	
    48	def auroc(score, label):
    49	    s, y = np.asarray(score, float), np.asarray(label, bool)
    50	    if y.all() or (~y).all():
    51	        return float("nan")
    52	    r = np.argsort(np.argsort(s)) + 1.0
    53	    return float((r[y].sum() - y.sum() * (y.sum() + 1) / 2) / (y.sum() * (~y).sum()))
    54	
    55	
    56	def arm_stats(arm):
    57	    A = aligned(arm)
    58	    if not A:
    59	        return None
    60	    vis = lambda R: [r for r in R if r.get("true") is not None and r["true"] >= 0]
    61	    fused = any("picks" in r for _, R in A.values() for r in R)
    62	    out_key = "map" if fused else "anc"
    63	    res = {"arm": arm, "n_ep": len(A)}
    64	    T = [r for _, R in A.values() for r in vis(R)]
    65	    res["ticks"] = len(T)
    66	    res["acc_out"] = float(np.mean([r[out_key] == r["true"] for r in T]))
    67	    if fused:
    68	        for s in ("tah", "dam", "lang"):
    69	            P = [r for r in T if r["picks"].get(s) is not None and r["picks"][s] >= 0]
    70	            res[f"acc_{s}"] = float(np.mean([r["picks"][s] == r["true"] for r in P])) if P else float("nan")
    71	            res[f"present_{s}"] = len(P) / max(len(T), 1)
    72	        B = [r for r in T if r["picks"].get("tah") is not None and r["picks"].get("dam") is not None]
    73	        et = np.array([r["picks"]["tah"] != r["true"] for r in B], float)
    74	        ed = np.array([r["picks"]["dam"] != r["true"] for r in B], float)
    75	        res["rho_err"] = float(np.corrcoef(et, ed)[0, 1]) if len(B) > 2 and et.std() > 0 and ed.std() > 0 else float("nan")
    76	        res["p_dam_wrong_given_tah_wrong"] = float(ed[et == 1].mean()) if (et == 1).any() else float("nan")
    77	        res["both_wrong_same_id"] = float(np.mean([r["picks"]["tah"] == r["picks"]["dam"] != r["true"] for r in B]))
    78	        res["tah_eq_dam"] = float(np.mean([r["picks"]["tah"] == r["picks"]["dam"] for r in B]))
    79	        for s in ("tah", "dam"):   # gate events on a source = posterior ≠ its pick → its memory is rewritten
    80	            G = [r for r in T if r.get("gate", {}).get(s) and r["picks"].get(s) is not None]
    81	            res[f"gates_{s}"] = len(G)
    82	            res[f"misgate_{s}"] = float(np.mean([r["picks"][s] == r["true"] for r in G])) if G else float("nan")
    83	    else:
    84	        res["acc_mem"] = float(np.mean([r["mem"] == r["true"] for r in T]))
    85	        res["fires"] = int(sum(bool(r.get("fire")) or r["mem"] != r["anc"] for r in T))
    86	        F = [r for r in T if r["mem"] != r["anc"]]
    87	        res["misgate_mem"] = float(np.mean([r["mem"] == r["true"] for r in F])) if F else float("nan")
    88	        if arm.startswith("v1"):
    89	            res["auroc_iou"] = auroc([r["conf"] for r in T], [r["mem"] == r["true"] for r in T])
    90	    # opening correctness (first logged visible tick) and committed correct-lock ratio by stratum
    91	    op, cr = [], []
    92	    for e, R in A.values():
    93	        V = vis(R)
    94	        if not V:
    95	            continue
    96	        op.append(V[0][out_key] == V[0]["true"]); cr.append(1 - e["mis_follow_sustained"])
    97	    op, cr = np.array(op, bool), np.array(cr, float)
    98	    res["open_ok"] = f"{int(op.sum())}/{len(op)}"
    99	    res["correct_open_ok"] = float(cr[op].mean()) if op.any() else float("nan")
   100	    res["correct_open_wrong"] = float(cr[~op].mean()) if (~op).any() else float("nan")
   101	    return res
   102	
   103	
   104	def main():
   105	    ap = argparse.ArgumentParser(); ap.add_argument("--json"); a = ap.parse_args()
   106	    R = [x for x in (arm_stats(arm) for arm in ARMS) if x]
   107	    keys = ["n_ep", "ticks", "acc_out", "acc_mem", "acc_tah", "acc_dam", "acc_lang", "present_dam", "rho_err",
   108	            "p_dam_wrong_given_tah_wrong", "both_wrong_same_id", "tah_eq_dam", "gates_tah", "misgate_tah", "gates_dam",
   109	            "misgate_dam", "fires", "misgate_mem", "auroc_iou", "open_ok", "correct_open_ok", "correct_open_wrong"]
   110	    print("| 指标 | " + " | ".join(r["arm"] for r in R) + " |\n|---|" + "---|" * len(R))
   111	    for k in keys:
   112	        cells = []
   113	        for r in R:
   114	            v = r.get(k, "")
   115	            cells.append(f"{v:.3f}" if isinstance(v, float) else str(v))
   116	        print(f"| {k} | " + " | ".join(cells) + " |")
   117	    if a.json:
   118	        json.dump(R, open(a.json, "w"), indent=1)
   119	
   120	

### carla_uav_tracking/rollout/tick_align.py
     1	"""Align ASD tick logs (runs/asd/*.jsonl, keyed by policy-reset index `ep`) to scorer episode seeds.
     2	Skipped episodes (e.g. 'target stationary') never reset the policy, so logged episodes map IN ORDER onto the
     3	NON-skipped seeds of the eval json. Verified by step counts (max logged t <= scorer steps, near-equal)."""
     4	import json, os
     5	
     6	EO = os.path.join(os.path.dirname(__file__), "eval_out")
     7	LG = os.path.join(os.path.dirname(__file__), "..", "..", "runs", "asd")
     8	
     9	
    10	def aligned(stem, jsonl):
    11	    """→ {seed: [tick records]} for non-skipped seeds."""
    12	    d = json.load(open(os.path.join(EO, stem + ".json")))
    13	    seeds = [e["episode_seed"] for e in d["episodes"] if not e.get("skipped")]
    14	    E = {}
    15	    for line in open(os.path.join(LG, jsonl + ".jsonl")):
    16	        r = json.loads(line); E.setdefault(r["ep"], []).append(r)
    17	    eps = sorted(E)
    18	    assert len(eps) <= len(seeds), (stem, len(eps), len(seeds))
    19	    return {s: E[e] for e, s in zip(eps, seeds)}
    20	
    21	
    22	def runs(S, field):
    23	    """Longest continuous CORRECT and WRONG run (s) over target-visible ticks (1 tick = 6 frames = 0.6 s); an
    24	    out-of-view tick ends both runs. Final pick = `field` (PGIF output 'anc') or the raw memory pick 'mem'."""
    25	    bc = bw = 0.0; cc = cw = 0; t0c = t0w = 0; ok_n = n = 0
    26	    for r in S:
    27	        if r["true"] is None or r["true"] < 0:
    28	            cc = cw = 0; continue
    29	        pick = r[field] if r.get(field) is not None else r["mem"]
    30	        ok = pick == r["true"]; n += 1; ok_n += ok
    31	        if ok:
    32	            t0c = r["t"] if cc == 0 else t0c; cc += 1; cw = 0; bc = max(bc, (r["t"] - t0c) / 10 + 0.6)
    33	        else:
    34	            t0w = r["t"] if cw == 0 else t0w; cw += 1; cc = 0; bw = max(bw, (r["t"] - t0w) / 10 + 0.6)
    35	    return bc, bw, (ok_n / n if n else float("nan"))

### carla_uav_tracking/rollout/dam_diag.py
     1	"""DAM4SAM abstention diagnosis (runs/asd/iter/damdiag_g<gate>_p<k>.jsonl, written with DAM4SAM_DIAG=1).
     2	Per association gate: share of target-present S2 ticks by outcome (pick / gate = nearest candidate beyond the gate /
     3	empty = SAM2 mask empty / no_init), pick accuracy, and for gate-abstentions whether the nearest candidate WAS the target
     4	and how far the predicted centre was from it (→ how many abstentions a wider gate could turn into correct picks).
     5	Three metrics (committed / lenient / strict + longC / longW) per gate with paired deltas vs gate 160 and vs the original
     6	DAM4SAM deployable run (paper_dep_dam4sam, replication check).
     7	  python dam_diag.py [--json eval_out/dam_diag.json]"""
     8	import argparse
     9	import glob
    10	import json
    11	import os
    12	
    13	import numpy as np
    14	
    15	import iter_gate as g
    16	
    17	LG = os.path.join(os.path.dirname(__file__), "..", "..", "runs", "asd", "iter")
    18	GATES = [160, 240, 320]
    19	
    20	
    21	def ticks(gate):
    22	    out = []
    23	    for f in sorted(glob.glob(os.path.join(LG, f"damdiag_g{gate}_p[0-9].jsonl"))):
    24	        out += [json.loads(line) for line in open(f)]
    25	    return out
    26	
    27	
    28	def tick_stats(T):
    29	    P = [r for r in T if r["true"] >= 0]                     # target in frame (as a candidate)
    30	    if not P:
    31	        return None
    32	    n = len(P); res: dict = {"ticks_present": n}
    33	    for k in ("pick", "gate", "empty", "no_init"):
    34	        res[f"share_{k}"] = sum(r["reason"] == k for r in P) / n
    35	    pk = [r for r in P if r["reason"] == "pick"]
    36	    res["pick_acc"] = float(np.mean([r["nearest_is_true"] for r in pk])) if pk else float("nan")
    37	    gt = [r for r in P if r["reason"] == "gate"]
    38	    if gt:
    39	        res["gate_nearest_is_true"] = float(np.mean([r["nearest_is_true"] for r in gt]))
    40	        dt = np.array([r["d_true"] for r in gt if r.get("d_true") is not None], float)
    41	        res["gate_d_true_median"] = float(np.median(dt))
    42	        for G in (240, 320, 480):
    43	            res[f"gate_recoverable_at_{G}"] = float(np.mean([r["nearest_is_true"] and r["d_min"] < G for r in gt]))
    44	    for k in ("pick", "gate", "empty"):
    45	        I = [r["iou"] for r in P if r["reason"] == k and r["k"] > 0]
    46	        res[f"iou_med_{k}"] = float(np.median(I)) if I else float("nan")
    47	    # empty-mask dynamics: does SAM2 re-acquire after declaring the target absent? and is it size-related?
    48	    # (empty ticks carry no geometry → proxy size = box area at the most recent successful pick in the episode)
    49	    runs, never_back, eps_with_empty = [], 0, 0
    50	    by_size = {"<300": [0, 0], "300-600": [0, 0], ">=600": [0, 0]}
    51	    E = {}
    52	    for r in T:
    53	        E.setdefault(r["ep"], []).append(r)
    54	    for R in E.values():
    55	        R = sorted(R, key=lambda r: r["k"]); cur = 0; last_area = None; seen_empty = False; back = False
    56	        for r in R:
    57	            if r["true"] < 0:
    58	                continue
    59	            if r["reason"] == "empty":
    60	                cur += 1; seen_empty = True
    61	                if last_area is not None:
    62	                    b = "<300" if last_area < 300 else ("300-600" if last_area < 600 else ">=600"); by_size[b][0] += 1; by_size[b][1] += 1
    63	            else:
    64	                if cur:
    65	                    runs.append(cur)
    66	                cur = 0
    67	                if r["reason"] == "pick":
    68	                    back = back or seen_empty
    69	                    last_area = r["box_wh"][0] * r["box_wh"][1]
    70	                    b = "<300" if last_area < 300 else ("300-600" if last_area < 600 else ">=600"); by_size[b][1] += 1
    71	        if cur:
    72	            runs.append(cur)
    73	        if seen_empty:
    74	            eps_with_empty += 1; never_back += not back
    75	    res["empty_run_mean_ticks"] = float(np.mean(runs)) if runs else float("nan")
    76	    res["eps_with_empty"] = eps_with_empty
    77	    res["eps_never_reacquire_after_empty"] = never_back
    78	    for b, (e, t) in by_size.items():
    79	        res[f"empty_rate_lastbox_{b}px2"] = e / t if t else float("nan")
    80	    A = [r for r in T if r["true"] < 0]
    81	    res["absent_ticks"] = len(A)
    82	    res["absent_pick_rate"] = float(np.mean([r["reason"] == "pick" for r in A])) if A else float("nan")
    83	    return res
    84	
    85	
    86	def main():
    87	    ap = argparse.ArgumentParser(); ap.add_argument("--json"); a = ap.parse_args()
    88	    out = {"ticks": {}, "metrics": {}, "paired": []}
    89	    print("## 弃权原因(目标在候选中的 S2 tick)\n")
    90	    rows: dict = {G: tick_stats(ticks(G)) for G in GATES}
    91	    keys = sorted({k for r in rows.values() if r for k in r}, key=lambda k: (not k.startswith("share"), k))
    92	    print("| 指标 | " + " | ".join(f"gate {G}px" for G in GATES) + " |\n|---|" + "---|" * len(GATES))
    93	    for k in keys:
    94	        print(f"| {k} | " + " | ".join(
    95	            (f"{rows[G][k]:.3f}" if isinstance(rows[G].get(k), float) else str(rows[G].get(k, ""))) if rows[G] else "—"
    96	            for G in GATES) + " |")
    97	    out["ticks"] = {str(G): rows[G] for G in GATES}
    98	    print("\n## 三项指标(Town05,deployable)\n")
    99	    D = {"dep(原 05:06 运行)": g.load("dam4sam")}
   100	    D.update({f"g{G}": g.load(f"damdiag_g{G}") for G in GATES})
   101	    print("| 臂 | n | " + " | ".join(g.LABEL.values()) + " |\n|---|---|" + "---|" * len(g.LABEL))
   102	    for name, A in D.items():
   103	        if A is None:
   104	            print(f"| {name} | pending |"); continue
   105	        m = {k: g.ci_mean([f(e) for e in A.values()]) for k, f in g.METRICS.items()}
   106	        out["metrics"][name] = {"n": len(A), **{k: list(v) for k, v in m.items()}}
   107	        print(f"| {name} | {len(A)} | " + " | ".join(f"{v[0]:.3f} [{v[1]:.2f}, {v[2]:.2f}]" for v in m.values()) + " |")
   108	    print("\n## 配对差(同种子)\n\n| 比较 | 指标 | n | Δ [95% CI] |\n|---|---|---|---|")
   109	    pairs = [(f"g{G}", "g160") for G in (240, 320)] + [("g160", "dep(原 05:06 运行)")]
   110	    for x, y in pairs:
   111	        A, B = D.get(x), D.get(y)
   112	        if A is None or B is None:
   113	            continue
   114	        S = sorted(set(A) & set(B))
   115	        for k, f in g.METRICS.items():
   116	            d = np.array([f(A[s]) - f(B[s]) for s in S], float); d = d[np.isfinite(d)]
   117	            if len(d) < 3:
   118	                continue
   119	            mu, lo, hi = g.ci_mean(d)
   120	            out["paired"].append({"a": x, "b": y, "metric": k, "n": len(d), "delta": [mu, lo, hi]})

### carla_uav_tracking/rollout/deploy_compare.py
     1	"""§5.5 WHICH-module comparison — ALL models DEPLOYABLE (GT-free, online closed-loop CARLA), same seeds 91000-19,
     2	three objective metrics from the scorer (frame level): correct-lock ratio, longest continuous correct lock
     3	(max_correct_run_s, committed identity, out-of-frame ends the run), longest wrong lock (max_wrong_run_s).
     4	Per-arm mean with seed-bootstrap 95% CI; paired PGIF − arm with 95% paired-bootstrap CI. Missing arms → "pending".
     5	  python deploy_compare.py --json eval_out/deploy_compare.json"""
     6	import argparse
     7	import json
     8	import os
     9	
    10	import numpy as np
    11	
    12	EO = os.path.join(os.path.dirname(__file__), "eval_out")
    13	ARMS = [  # stem suffix, label, group
    14	    ("xattn", "xattn(单帧语言)", "language"),
    15	    ("l4", "l4(reid+置信门)", "ours"),
    16	    ("l5", "l5(+时序EMA)", "ours"),
    17	    ("borrow1", "borrow#1(+运动共识)", "ours"),
    18	    ("tahdag", "TAH+DAgger", "ours"),
    19	    ("tahrelm", "TAHRelM 无纠偏", "ours"),
    20	    ("ocsort", "OC-SORT", "external"),
    21	    ("deepsort", "DeepSORT", "external"),
    22	    ("dam4sam", "DAM4SAM", "external"),
    23	    ("tahrelm_pgif", "TAHRelM+PGIF(ours)", "pgif"),
    24	]
    25	def _strict(e):
    26	    """per-frame pick == target over target-present frames; ABSTENTION (no pick) counts as NOT correct."""
    27	    nd, bn = e.get("n_dist") or {}, e.get("mis_by_N") or {}
    28	    t = sum(nd.values())
    29	    return 1 - sum(bn[k] * nd[k] for k in nd if k in bn) / t if t else float("nan")
    30	
    31	
    32	# correct-lock ratio (2026-10-02 口径修正): COMMITTED identity == target over target-present frames — the same notion of
    33	# "lock" as longC / longW; an abstaining tracker (DAM4SAM: empty mask / nothing within its gate) holds its last commitment.
    34	# The former definition 1 − mis_follow_inst counted abstention frames as CORRECT (DAM4SAM abstains ~60% → 0.786 vs 0.367);
    35	# it and the strict one (abstention = wrong) are kept as correct_l / correct_s for the appendix.
    36	EXTRA = [("correct_l", lambda e: 1 - e["mis_follow_inst"]), ("correct_s", _strict)]
    37	METRICS = [("correct", "正确锁定比例(承诺)", lambda e: 1 - e["mis_follow_sustained"]),
    38	           ("longC", "最长连续正确锁定(s)", lambda e: e["max_correct_run_s"]),
    39	           ("longW", "最长锁错(s)", lambda e: e["max_wrong_run_s"])]
    40	RNG = np.random.default_rng(20261002)
    41	
    42	
    43	def load(stem):
    44	    p = os.path.join(EO, f"paper_dep_{stem}.json")
    45	    if not os.path.exists(p):
    46	        return None
    47	    d = json.load(open(p))
    48	    return {int(e["episode_seed"]): e for e in d["episodes"] if e.get("mis_follow_inst") is not None}
    49	
    50	
    51	def ci_mean(x):
    52	    x = np.asarray(x, float); x = x[np.isfinite(x)]; b = x[RNG.integers(0, len(x), (20000, len(x)))].mean(1)
    53	    return [float(x.mean()), float(np.percentile(b, 2.5)), float(np.percentile(b, 97.5))]
    54	
    55	
    56	def main():
    57	    ap = argparse.ArgumentParser(); ap.add_argument("--json"); a = ap.parse_args()
    58	    D = {s: load(s) for s, _, _ in ARMS}
    59	    P = D["tahrelm_pgif"]
    60	    out = {"arms": [], "pending": [s for s, _, _ in ARMS if D[s] is None]}
    61	    for s, lab, grp in ARMS:
    62	        A = D[s]
    63	        if A is None:
    64	            out["arms"].append({"stem": s, "label": lab, "group": grp, "pending": True}); continue
    65	        row = {"stem": s, "label": lab, "group": grp, "n": len(A)}
    66	        for k, _, f in METRICS:
    67	            v = [f(e) for e in A.values()]
    68	            row[k] = ci_mean(v); row[k + "_med"] = float(np.median(v))
    69	        for k, f in EXTRA:
    70	            row[k] = ci_mean([f(e) for e in A.values()])
    71	        if s != "tahrelm_pgif":
    72	            S = sorted(set(A) & set(P))
    73	            for k, _, f in METRICS:
    74	                d = np.array([f(P[x]) - f(A[x]) for x in S])
    75	                b = d[RNG.integers(0, len(d), (20000, len(d)))].mean(1)
    76	                row["pgif_minus_" + k] = [float(d.mean()), float(np.percentile(b, 2.5)), float(np.percentile(b, 97.5))]
    77	        out["arms"].append(row)
    78	    for r in out["arms"]:
    79	        if r.get("pending"):
    80	            print(f"{r['label']:22s} pending"); continue
    81	        msg = f"{r['label']:22s} n={r['n']} " + " | ".join(
    82	            f"{k} {r[k][0]:.3f}" if k == "correct" else f"{k} {r[k][0]:.1f}s(med {r[k + '_med']:.1f})" for k, _, _ in METRICS)
    83	        if "pgif_minus_correct" in r:
    84	            msg += " || PGIF−arm: " + "  ".join(f"{k} {r['pgif_minus_' + k][0]:+.2f}[{r['pgif_minus_' + k][1]:+.2f},{r['pgif_minus_' + k][2]:+.2f}]"
    85	                                                for k, _, _ in METRICS)
    86	        print(msg)
    87	    if a.json:
    88	        json.dump(out, open(a.json, "w"), indent=1, ensure_ascii=False)
    89	
    90	
    91	if __name__ == "__main__":
    92	    main()

