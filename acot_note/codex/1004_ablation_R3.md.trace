   170	            h = self.src_hist.get(src, [])
   171	            pct = float(np.searchsorted(np.sort(h), c)) / len(h) if len(h) >= 5 else 0.5
   172	            self.src_hist[src] = (h + [c])[-self.conf_window:]
   173	            b[ids[slot]] = b.get(ids[slot], 0.0) + float(self.alpha.get(src, 1.0)) * (0.5 + pct)
