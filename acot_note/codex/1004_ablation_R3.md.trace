代码索引还漏了一个会影响“外部基线是否同等待遇”的点：`policy_server.py` 的 `--gallery-seed` 默认是 `gt`，而 v3.1 表 1 的 re-ID/assoc/DAM4SAM 配置行没有显式写 `--gallery-seed committed`。如果实际脚本也没传，外部基线会有隐藏真值刷新/初始化特权；如果脚本传了，则预注册表格必须补上，避免复现时跑错。
exec
/bin/sh -lc "nl -ba runs/asd/deploy_all/chains.sh | sed -n '1,260p'" in /nvidia/hque/code/cyhe/uav-acot-track
exec
/bin/sh -lc "nl -ba carla_uav_tracking/rollout/eval_asd.sh | sed -n '1,240p'" in /nvidia/hque/code/cyhe/uav-acot-track
 succeeded in 27ms:
     1	#!/usr/bin/env bash
     2	# ASD (Anchored Sequential Drift-correction) PoC closed-loop eval — parametric, parallel-safe.
     3	# Each run = its own policy-server container (SRV) + its own CARLA server (CARLA_PORT) → many arms in parallel.
     4	#   SRV=asd-a0 CARLA_PORT=2000 GPU=1 OUT_NAME=paper_asd_x HEAD_ARGS="--tid-head tah ..." bash eval_asd.sh
     5	set -uo pipefail
     6	REPO=/nvidia/hque/code/cyhe/uav-acot-track; DATA=/nvidia/hque/data/carla_data
     7	HF=${HF_CACHE:-$HOME/.cache/huggingface}; NET=cyh-carla-net; CONFIG=train/config_v5.yaml
     8	EPISODES=${EPISODES:-20}; SEED_BASE=${SEED_BASE:-91000}; STEPS=${STEPS:-900}
     9	TOWN=${TOWN:-Town05}; S2=${S2_PERIOD:-6}; GPU=${GPU:-1}; SRV=${SRV:-asd-srv}; CARLA_PORT=${CARLA_PORT:-2000}
    10	OUT_NAME=${OUT_NAME:?}; HEAD_ARGS=${HEAD_ARGS:?}; ASD_LOG=${ASD_LOG:-}
    11	OUT=/workspace/rollout/eval_out/${OUT_NAME}.json
    12	docker rm -f $SRV >/dev/null 2>&1 || true
    13	docker run -d --gpus device=$GPU --network "$NET" --name $SRV --shm-size=16g \
    14	  -e NVIDIA_DRIVER_CAPABILITIES=compute,utility -e ASD_LOG="$ASD_LOG" -e ASD_CFG="${ASD_CFG:-}" -e COLD_WINDOW="${COLD_WINDOW:-0}" -e COLD_LAMBDA="${COLD_LAMBDA:-0.9}" -e COLD_SINGLE="${COLD_SINGLE:-0}" -e V1_SELFRESET="${V1_SELFRESET:-0}" -e DAM4SAM_DIAG="${DAM4SAM_DIAG:-0}" -e OMP_NUM_THREADS=${NTHR:-6} -e MKL_NUM_THREADS=${NTHR:-6} \
    15	  -v "$REPO":"$REPO" -v "$DATA":"$DATA":ro -v "$HF":/root/.cache/huggingface -w "$REPO" \
    16	  acot-uav-train:cu118 bash -c "pip install -q timm==1.0.29 2>/dev/null; \
    17	    python carla_uav_tracking/rollout/policy_server.py --config '$CONFIG' \
    18	    --ckpt runs/stage2_v5/stage2_best.pt --language-mode neutral --s2-period '$S2' \
    19	    --ex-source track $HEAD_ARGS --port 5555" >/dev/null
    20	for _ in $(seq 1 150); do
    21	  docker logs $SRV 2>&1 | grep -q "listening" && break
    22	  docker ps --format '{{.Names}}' | grep -q "^$SRV\$" || { echo "server died:"; docker logs $SRV|tail -25; exit 1; }
    23	  sleep 3
    24	done
    25	echo "=== [$OUT_NAME] $EPISODES ep seed=$SEED_BASE town=$TOWN carla=$CARLA_PORT gpu=$GPU :: $HEAD_ARGS ==="
    26	docker exec -e CARLA_PORT=$CARLA_PORT -e CARLA_TM_PORT=${TM_PORT:-$((CARLA_PORT+6000))} cyh-carla python /workspace/rollout/run_rollout.py --policy-host $SRV \
    27	  --policy-port 5555 --episodes "$EPISODES" --seed-base "$SEED_BASE" --steps "$STEPS" --town "$TOWN" --out "$OUT" || echo FAILED
