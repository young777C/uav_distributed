runs/asd/deploy_all/build_dam4sam.sh:5:docker run -d --gpus device=6 --network cyh-carla-net --name dam4sam-svc --shm-size=8g \
runs/asd/deploy_all/build_dam4sam.sh:7:docker exec dam4sam-svc bash -lc '
runs/asd/deploy_all/build_dam4sam.sh:10:$CM create -n dam4sam python=3.10.15 -y >/dev/null
