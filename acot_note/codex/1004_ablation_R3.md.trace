runs/asd/iter/queue3.sh:3:cd /nvidia/hque/code/cyhe/uav-acot-track; L=runs/asd/iter
runs/asd/iter/queue3.sh:4:DEP="--gallery-seed committed --reanchor off"
runs/asd/iter/queue3.sh:5:FUS="--tid-head fusion --tah-ckpt runs/tah_relm_dag.pt --dam4sam-host dam4sam-svc --conf-tau 0.5 $DEP --asd filter"
runs/asd/iter/queue3.sh:7:ENS='{"filter_kind":"tempered","resid_decay":0.98,"naive":true,"gate_tah":false,"gate_dam":false}'
runs/asd/iter/queue3.sh:10: S1) waitdone v1_t05;      bash $L/launch.sh v3_t05 2000 1 8403 Town05 "$FUS --dam4sam-port 5602" "$V3" ;;
runs/asd/iter/queue3.sh:11: S2) waitdone v2_t05;      bash $L/launch.sh v3ens_t05 2010 3 8413 Town05 "$FUS --dam4sam-port 5601" "$ENS" ;;
runs/asd/iter/queue3.sh:12: S3) waitdone dam4sam_t03; COLD_WINDOW=5 COLD_LAMBDA=0.9 bash $L/launch.sh v3v2_t05 2040 4 8443 Town05 "$FUS --dam4sam-port 5603" "$V3" ;;
runs/asd/iter/chains_r2.sh:3:#   usage: chains_r2.sh {S1|S2|S3|S4}
runs/asd/iter/chains_r2.sh:5:# Policy servers on GPUs without CARLA (1/4/7); DAM4SAM services 5601–5604 in dam4sam-svc (GPU6).
runs/asd/iter/chains_r2.sh:6:cd /nvidia/hque/code/cyhe/uav-acot-track; L=runs/asd/iter
runs/asd/iter/chains_r2.sh:7:DEP="--gallery-seed committed --reanchor off"
runs/asd/iter/chains_r2.sh:8:TAH="--tid-head tah --tah-ckpt runs/tah_relm_dag.pt --conf-tau 0.5 $DEP"
runs/asd/iter/chains_r2.sh:9:DAM="--tid-head dam4sam --dam4sam-host dam4sam-svc --conf-tau 0.05 $DEP"
runs/asd/iter/chains_r2.sh:10:FUS="--tid-head fusion --tah-ckpt runs/tah_relm_dag.pt --dam4sam-host dam4sam-svc --conf-tau 0.5 $DEP --asd filter"
runs/asd/iter/chains_r2.sh:13:ENS='{"filter_kind":"tempered","resid_decay":0.98,"naive":true,"gate_tah":false,"gate_dam":false}'
runs/asd/iter/chains_r2.sh:14:COM='{"filter_kind":"tempered","resid_decay":0.98,"gate_tah":false,"gate_dam":false}'
runs/asd/iter/chains_r2.sh:16:L1(){ bash $L/launch.sh "$@"; }   # name carla gpu tm town head [asd_cfg]
runs/asd/iter/chains_r2.sh:18: S1) L1 v1_t05        2000 1 8501 Town05 "$DAM --dam4sam-port 5601 --asd filter" "$T"
runs/asd/iter/chains_r2.sh:19:     L1 v3com_t05     2000 1 8502 Town05 "$FUS --dam4sam-port 5601" "$COM"
runs/asd/iter/chains_r2.sh:20:     L1 v3_t03        2000 1 8503 Town03 "$FUS --dam4sam-port 5601" "$T" ;;
runs/asd/iter/chains_r2.sh:21: S2) COLD_WINDOW=5 COLD_LAMBDA=0.9 L1 v2_t05 2010 4 8511 Town05 "$TAH --asd filter" "$T"
runs/asd/iter/chains_r2.sh:22:     L1 v3gt_t05      2010 4 8512 Town05 "$FUS --dam4sam-port 5602" "$GTO"
runs/asd/iter/chains_r2.sh:23:     L1 v3_t10        2010 4 8513 Town10HD "$FUS --dam4sam-port 5602" "$T" ;;
runs/asd/iter/chains_r2.sh:24: S3) L1 v3_t05        2040 7 8541 Town05 "$FUS --dam4sam-port 5603" "$T"
runs/asd/iter/chains_r2.sh:25:     COLD_WINDOW=5 COLD_LAMBDA=0.9 L1 v3v2_t05 2040 7 8542 Town05 "$FUS --dam4sam-port 5603" "$T"
runs/asd/iter/chains_r2.sh:26:     L1 pgif_t03      2040 7 8543 Town03 "$TAH --asd filter" "$T" ;;
runs/asd/iter/chains_r2.sh:27: S4) L1 v3ens_t05     2020 1 8521 Town05 "$FUS --dam4sam-port 5604" "$ENS"
runs/asd/iter/chains_r2.sh:28:     L1 dam4sam_t03   2020 1 8522 Town03 "$DAM --dam4sam-port 5604" ""
runs/asd/iter/chains_r2.sh:29:     L1 v1nog_t05     2020 1 8523 Town05 "$DAM --dam4sam-port 5604 --asd filter" "$NOG" ;;
