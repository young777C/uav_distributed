/bin/sh -lc 'rg -n "最后一个 epoch|最佳 val|gallery-seed committed|--tid-head reid|--tid-head assoc|--tid-head dam4sam|gate_commit|scorer_committed_key|G[1-9]" acot_note/1004_ablation_design.md' in /nvidia/hque/code/cyhe/uav-acot-track
