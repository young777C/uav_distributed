   501	    def _update_commit(self, cset):
   502	        """Commit the tid-selected candidate IDENTITY with K-frame hysteresis (Plan A).
   503	        A challenger identity must win commit_k consecutive S2 ticks to take over; during
   504	        a loss (no valid pick) the current commitment is held."""
   505	        sel = None
   506	        if cset is not None and 0 <= self._pred_slot < len(cset.cands):
   507	            sel = int(cset.cands[self._pred_slot].idx)          # -1 = target, else distractor idx
   508	        if sel is None:
   509	            return                                              # loss -> hold commitment
   510	        if self._committed_idx is None or sel == self._committed_idx:
   511	            self._committed_idx = sel; self._chal = None; self._chal_n = 0
   512	        else:
   513	            self._chal_n = self._chal_n + 1 if sel == self._chal else 1
   514	            self._chal = sel
   515	            if self._chal_n >= self.commit_k:
   516	                self._committed_idx = sel; self._chal = None; self._chal_n = 0
   517	
   518	    def _committed_slot(self, cset):
   519	        """Candidate slot of the currently committed identity this frame (None if not visible / uncommitted).
   520	        Deployable gallery seeds its template from THIS crop — the identity we believe, never GT."""
   521	        if self._committed_idx is None or cset is None:
   522	            return None
   523	        for s, c in enumerate(cset.cands):
   524	            if int(c.idx) == int(self._committed_idx):
   525	                return s
   526	        return None
   527	
   528	    def _committed_world(self, tpos, dstates):
   529	        """World position of the committed identity (GT position; the IDENTITY is tid's)."""
   530	        if self._committed_idx is None:
   531	            return None
   532	        if self._committed_idx < 0:
   533	            return np.asarray(tpos, np.float64)
   534	        ds = np.asarray(dstates)
   535	        return np.asarray(ds[self._committed_idx][:3], np.float64) if self._committed_idx < ds.shape[0] else None
   536	
   537	    def _in_frame(self, world_xyz, campose):
   538	        from acot_probe.projection import project_point
   539	        W = self.image_cfg["width"]; H = self.image_cfg["height"]; fov = self.image_cfg["fov_deg"]
   540	        pr = project_point(tuple(float(x) for x in world_xyz), tuple(float(x) for x in campose), W, H, fov)
   541	        if pr is None:
   542	            return False
   543	        u, v, _ = pr
   544	        return bool(0 <= u < W and 0 <= v < H)
   545	
   546	    @torch.no_grad()
   547	    def act(self, obs: Observation, gt_candidates) -> tuple[tuple, float, ActInfo]:
   548	        """gt_candidates = (tpos(3,), dstates(D,6), campose(5,)). Returns
   549	        ((dx,dy,dz,dyaw), search_mode, ActInfo)."""
   550	        prop = torch.from_numpy(obs.proprio.astype(np.float32))[None].to(self.device)
   551	
   552	        if obs.step % self.s2_period == 0 or self._z_ex is None:
   553	            # ---- S2 slow stream: VLM → EAR → IAR → target-id ----
   554	            layers, vlm_ctx, grid_last = self.vlm.encode(obs.rgb, obs.language)   # (M,C) float32
   555	            self._vlm_ctx = vlm_ctx[None]                                          # (1,M,C)
   556	            self._ctx_layers = [x[None] for x in layers]
   557	            self._ctx_mask = torch.ones(1, vlm_ctx.shape[0], dtype=torch.bool, device=self.device)
   558	            if self.ablate == "ear":
   559	                self._z_ex = torch.zeros(1, self.K, 3, device=self.device)                # w/o-EAR
   560	            else:
   561	                self._z_ex = flow_matching.sample(self.ear, self._vlm_ctx, self._ctx_mask,
   562	                                                   k=self.K, steps=self.steps, proprio=prop)  # (1,K,3)
   563	            self._z_im, _ = self.iar(self._ctx_layers, self._ctx_mask)                     # (1,n_im,d)
   564	            if self.ablate == "iar":
   565	                self._z_im = torch.zeros_like(self._z_im)                                  # w/o-IAR
   566	
   567	            tpos, dstates, campose = gt_candidates[:3]
   568	            # P2a-1: env-side road-graph prediction (WORLD (K,3)) rides in slot 3 when
   569	            # --ex-source road; None otherwise (or for legacy 3-tuples).
   570	            road_pred_world = gt_candidates[3] if len(gt_candidates) > 3 else None
   571	            cset = build_candidates(grid_last, tpos, dstates, campose, self.image_cfg, self._rng)
   572	            if cset is not None:
   573	                cf = torch.from_numpy(cset.feats)[None].to(self.device)                    # (1,N,C)
   574	                cmask = torch.from_numpy(cset.mask)[None].to(self.device)
   575	                if self.tid_head == "attrbind":
   576	                    if obs.target_color not in self._cvoc or obs.target_bp not in self._mvoc:
   577	                        print(f"[attrbind-attr] <UNK> color='{obs.target_color}' make='{obs.target_bp}'", flush=True)
   578	                    ci = torch.tensor([self._cvoc.get(obs.target_color, self._cvoc["<unk>"])], device=self.device)
   579	                    mi = torch.tensor([self._mvoc.get(obs.target_bp, self._mvoc["<unk>"])], device=self.device)
   580	                    logits = self.tid(cf, ci, mi, cmask)[0]                                # (N,)
   581	                else:
   582	                    logits = self.tid(cf, self._vlm_ctx, self._ctx_mask, cmask)[0]         # (N,)
   583	                self._tid_logits = logits.float().cpu().numpy()
   584	                self._pred_slot = int(logits.argmax().item())
   585	                lang_slot = self._pred_slot   # language grounding pick — saved before any reid override
   586	                lang_logits = self._tid_logits.copy()   # full language logits — for TEMPORAL language re-anchor
   587	                rl = None                     # reid match scores (None = no gallery yet / non-reid head)
   588	                # TEMPORAL language re-anchor: single-frame language picks wrong at re-appearance (H0 ceiling) →
   589	                # accumulate per-actor EMA of the language logit so the re-anchor commits the temporally-integrated
   590	                # language vote, not one noisy frame (mirrors reid_tavg, which fixed single-frame reid).
   591	                if self.reanchor == "lang" and self.reanchor_tavg > 0:
   592	                    a = self.reanchor_tavg
   593	                    for s, c in enumerate(cset.cands):
   594	                        prev = self._lang_score.get(c.idx, float(lang_logits[s]))
   595	                        self._lang_score[c.idx] = a * prev + (1 - a) * float(lang_logits[s])
   596	                # reid override (reframe test): temporal appearance-memory re-ID instead of
   597	                # per-frame language grounding — select the candidate matching the STORED target
   598	                # appearance (built while tracking), not the language description. Tests whether
   599	                # the WHICH wall is the single-frame paradigm. Falls back to tid before a template
   600	                # exists (cold start). See memory acot-uav-reid-reframe.
   601	                if self.tid_head == "reid":
   602	                    # deployable gallery: store the crop of the identity we currently BELIEVE is the
   603	                    # target (prior-frame commitment; language pick at cold-start), never GT (GT-free WHICH).
   604	                    store_slot = None
   605	                    if self.gallery_seed == "committed":
   606	                        store_slot = lang_slot if self._committed_idx is None \
   607	                                     else self._committed_slot(cset)
   608	                    rl = self._reid_select(cset, obs.rgb, store_slot)
   609	                    if rl is not None:
   610	                        if self.reid_motion > 0:                      # borrow#1: fuse motion consensus into rl (pre-EMA)
   611	                            ms = self._reid_motion_score(cset)
   612	                            self._reid_mscore = ms                    # borrow#2: stash for the consensus commit-fly gate
   613	                            rl = rl + self.reid_motion * ms
