   354	    def _cold_vote(self, aidx, lang_logits, lang_slot):
   355	        """V2: one tempered, rank-weighted language vote per tick; returns the slot of argmax_k G_k (visible)."""
   356	        l = np.asarray(lang_logits, np.float64); srt = np.sort(l)
   357	        m = float(srt[-1] - srt[-2]) if l.size >= 2 else 0.0
   358	        h = self._cold_hist; rho = float(np.searchsorted(np.sort(h), m)) / len(h) if len(h) >= 2 else 0.5
   359	        self._cold_hist = h + [m]
   360	        for k in self._cold_G:
   361	            self._cold_G[k] *= self.cold_lambda
   362	        a = int(aidx[lang_slot]); self._cold_G[a] = self._cold_G.get(a, 0.0) + 0.5 + rho
   363	        return max(range(len(aidx)), key=lambda s_: self._cold_G.get(int(aidx[s_]), 0.0))
   364	
   365	    def _asd_reset_memory(self, slot):
   366	        """The ONE hook ASD needs from a memory: reset it to the anchor's pick (drop the drifted state)."""
   367	        if self.tid_head == "tah" and self._tah_last is not None:
   368	            feat, pos = self._tah_last
   369	            self._tah_mem = self._tah.update(self._tah.reset(self.device), feat[slot], pos[slot])
   370	        elif self.tid_head == "reid" and self._reid_fn is not None:
   371	            from train.reid_resolution_probe import bank_update
   372	            self._reid_bank = []
   373	            bank_update(self._reid_bank, self._reid_fn[slot], self.reid_bank, 0.9)
   374	            self._reid_score = {}
   375	            self._reid_mvu = self._reid_mvel = None
   376	
   377	    def _reid_motion_score(self, cset):
   378	        """borrow#1 (DeepSORT): SOFT motion-consistency score to FUSE into the reid appearance score
   379	        (pre-EMA). Predicts the target's next image position (constant velocity) from past state and
   380	        softly penalizes candidates far from it → a look-alike spatially inconsistent with the track
   381	        can't win on appearance alone (fixes ours' pure-appearance weakness; DeepSORT had the highest
   382	        external SR). Returns (N,) ~[-∞,0] (0=at prediction), zeros if no prior. State NOT updated here."""
   383	        cands = cset.cands
   384	        if self._reid_mvu is None:
   385	            return np.zeros(len(cands), np.float64)
   386	        pred = self._reid_mvu + (self._reid_mvel if self._reid_mvel is not None else 0.0)
   387	        uv = np.array([[c.u, c.v] for c in cands], np.float64)
   388	        return -np.linalg.norm(uv - pred[None], axis=1) / self.reid_motion_gate_px
   389	
   390	    def _reid_motion_update(self, cset, slot):
   391	        """Update motion state from the seeding slot's image pos (SELECT used PAST state; same
   392	        GT/committed privilege as the gallery). None/loss → hold + keep predicting with velocity."""
   393	        if slot is None or not (0 <= slot < len(cset.cands)):
   394	            return
   395	        c = cset.cands[slot]; nuv = np.array([c.u, c.v], np.float64)
   396	        self._reid_mvel = (nuv - self._reid_mvu) if self._reid_mvu is not None else np.zeros(2)
   397	        self._reid_mvu = nuv
   398	
   399	    def _assoc_select(self, cset, rgb, init_slot=None):
   400	        """EXTERNAL BASELINE: DeepSORT/OC-SORT-style tracking-by-detection association.
   401	        Motion (constant-velocity image-space prediction + gate) + optional appearance (crop-DINOv2
   402	        cosine to an EMA template). SELECT with the PAST track state, THEN update from the GT-visible
   403	        target (same oracle-seed privilege as reid's gallery → fair). Contrast to reid: an explicit
   404	        motion model + per-frame argmin vs appearance gallery + temporal-EMA. assoc_mode: 'motion'
   405	        (OC-SORT-like, no appearance) | 'deepsort' (motion+appearance). Returns (N,) scores."""
   406	        cands = cset.cands
   407	        uv = np.array([[c.u, c.v] for c in cands], np.float64)          # candidate image positions
   408	        n = len(cands)
   409	        if self._assoc_uv is not None:                                  # motion: predict + gate
   410	            pred = self._assoc_uv + (self._assoc_vel if self._assoc_vel is not None else 0.0)
   411	            dist = np.linalg.norm(uv - pred[None], axis=1)
   412	            score = -dist / self.assoc_gate_px                          # higher = closer
   413	            gate = dist < self.assoc_gate_px
   414	        else:
   415	            score = np.zeros(n); gate = np.ones(n, bool)
   416	        fn = None
   417	        if self.assoc_mode == "deepsort":                              # + appearance cosine
   418	            from train.reid_resolution_probe import _dino_feats
   419	            W, H = self.image_cfg["width"], self.image_cfg["height"]
   420	            feats = _dino_feats(self._dino, rgb, cands, W, H, 224, 1.3, self.device).astype(np.float64)
   421	            fn = feats / (np.linalg.norm(feats, axis=1, keepdims=True) + 1e-8)
   422	            if self._assoc_feat is not None:
   423	                score = score + self.assoc_lambda * (fn @ self._assoc_feat)
   424	        if self._assoc_uv is not None and gate.any():                  # hard motion gate (fall back if empty)
   425	            score = np.where(gate, score, -1e9)
   426	        # UPDATE track state. gallery_seed='gt' (oracle, legacy): from the GT target. 'committed' (DEPLOYABLE, GT-free):
   427	        # from the tracker's OWN association this tick (language pick at cold start, before any track state exists).
   428	        # SELECT always used the PAST state.
   429	        if self.gallery_seed == "committed":
   430	            if self._assoc_uv is None:
   431	                ti = init_slot
   432	            else:
   433	                ti = int(score.argmax()) if float(score.max()) > -1e8 else None   # no gated match → hold state
   434	        else:
   435	            ti = cset.true_idx
   436	        if ti is not None and ti >= 0:
   437	            self._assoc_vel = (uv[ti] - self._assoc_uv) if self._assoc_uv is not None else np.zeros(2)
   438	            self._assoc_uv = uv[ti].copy()
   439	            if fn is not None:
   440	                t = fn[ti]
   441	                self._assoc_feat = t if self._assoc_feat is None else \
   442	                    (0.9 * self._assoc_feat + 0.1 * t) / (np.linalg.norm(0.9 * self._assoc_feat + 0.1 * t) + 1e-8)
   443	        return score.astype(np.float32)
   444	
   445	    def _dam4sam_select(self, cset, rgb, init_slot=None):
   446	        """EXTERNAL BASELINE: DAM4SAM (CVPR'25 SOTA distractor-aware SAM2 memory) as the WHICH module,
   447	        served over a socket bridge (separate torch2.1/SAM2 env). On the first target-visible frame,
   448	        init the tracker with the GT target box (same oracle-seed privilege as reid/assoc); each S2
   449	        tick, track → predicted target box → assign the candidate whose center is nearest (within a
   450	        gate) → pred_slot. Returns (N,) scores (higher=nearer the DAM4SAM box); -1e9 gate for far."""
   451	        from rollout.bridge import send_msg, recv_msg
   452	        cands = cset.cands
   453	        n = len(cands)
   454	        # init box: gallery_seed='gt' (oracle, legacy) = GT target box; 'committed' (DEPLOYABLE) = the language pick's box
   455	        ti = init_slot if self.gallery_seed == "committed" else cset.true_idx
   456	        bbox = None
   457	        if not self._dam4sam_inited:
   458	            if ti is not None and ti >= 0:                              # init from the chosen target box
   459	                c = cands[ti]
   460	                box = (c.u - c.w / 2.0, c.v - c.h / 2.0, c.w, c.h)
   461	                send_msg(self._dam4sam_sock, {"cmd": "init", "rgb": np.asarray(rgb, np.uint8), "box": box})
   462	                bbox = recv_msg(self._dam4sam_sock).get("bbox")
   463	                self._dam4sam_inited = True
   464	                self._dam4sam_iou = 0.5                                 # init frame: no predicted IoU yet
   465	            else:
   466	                self._dam_log(cset, "no_init", None, None)
   467	                return np.full(n, -1e9, np.float32)                     # target never seen yet → no pick
   468	        else:
   469	            send_msg(self._dam4sam_sock, {"cmd": "track", "rgb": np.asarray(rgb, np.uint8)})
   470	            resp = recv_msg(self._dam4sam_sock); bbox = resp.get("bbox")
   471	            iou = resp.get("iou")
   472	            self._dam4sam_iou = float(iou) if iou is not None and iou == iou else 0.0   # SAM2 predicted IoU = confidence
   473	        self._dam4sam_rgb = rgb                                         # for the PGIF reset hook (re-init on ŝ)
   474	        self._dam4sam_cool = max(0, getattr(self, "_dam4sam_cool", 0) - 1)
   475	        if bbox is None:
   476	            self._dam_log(cset, "empty", None, None)
   477	            return np.full(n, -1e9, np.float32)                         # lost (empty mask) → hold
   478	        bx, by, bw, bh = bbox
   479	        pc = np.array([bx + bw / 2.0, by + bh / 2.0])                   # DAM4SAM predicted center
   480	        uv = np.array([[c.u, c.v] for c in cands], np.float64)
   481	        dist = np.linalg.norm(uv - pc[None], axis=1)
   482	        gate = float(self.assoc_gate_px)
   483	        self._dam_log(cset, "pick" if float(dist.min()) < gate else "gate", dist, bbox)
   484	        return np.where(dist < gate, -dist / gate, -1e9).astype(np.float32)
   485	
   486	    def _dam_log(self, cset, reason, dist, bbox):
   487	        """DAM4SAM abstention diagnosis record (offline scoring only: true_idx is NOT used by any decision)."""
   488	        if self._dam_diag is None:
   489	            return
   490	        ti = cset.true_idx if cset.true_idx is not None else -1
   491	        rec = {"ep": self._dam_ep, "k": self._dam_k, "reason": reason, "n": len(cset.cands), "true": int(ti),
   492	               "inited": bool(self._dam4sam_inited), "iou": round(float(self._dam4sam_iou), 4)}
   493	        if dist is not None:
   494	            j = int(dist.argmin())
   495	            rec.update(nearest=j, d_min=round(float(dist[j]), 1), nearest_is_true=bool(j == ti),
   496	                       d_true=round(float(dist[ti]), 1) if ti >= 0 else None,
   497	                       box_wh=[round(float(bbox[2]), 1), round(float(bbox[3]), 1)])
   498	        self._dam_diag.write(json.dumps(rec) + "\n"); self._dam_diag.flush()
   499	        self._dam_k += 1
