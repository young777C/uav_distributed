    71	def load_policy_modules(ckpt_path: str, cfg: dict, device: str = "cuda:0"):
    72	    """Reconstruct EAR/IAR/DiT/TargetIDHead from a stage2 ckpt (guide §4).
    73	
    74	    Returns (ear, iar, dit, tid, dims, meta), all on `device` in eval mode. Hidden
    75	    dims come from cfg["model"]; tensor dims from the ckpt's `dims` block.
    76	    """
    77	    ck = torch.load(ckpt_path, map_location=device, weights_only=False)
    78	    d, m = ck["dims"], cfg["model"]
    79	    ear = EAR(d["cond_dim"], k=d["K"], d_model=m["ear"]["d_model"],
    80	              n_layers=m["ear"]["n_layers"], n_heads=m["ear"]["n_heads"],
    81	              proprio_dim=d["pdim"])
    82	    iar = IAR(d["cond_dim"], d["n_layers_in"], d=m["iar"]["d"],
    83	              n_im=m["iar"]["n_im"], n_heads=m["iar"]["n_heads"])
    84	    dit = DiT(d["A"], d["H"], d["cond_dim"], d_ex=3, d_im=m["iar"]["d"],
    85	              proprio_dim=d["pdim"], d=m["dit"]["d_model"],
    86	              n_layers=m["dit"]["n_layers"], n_heads=m["dit"]["n_heads"])
    87	    tid = TargetIDHead(d["cand_dim"], d["cond_dim"], d=m.get("tid_d", 256))
    88	    ear.load_state_dict(ck["ear"]); iar.load_state_dict(ck["iar"])
    89	    dit.load_state_dict(ck["dit"]); tid.load_state_dict(ck["tid"])
    90	    mods = tuple(mod.to(device).eval() for mod in (ear, iar, dit, tid))
    91	    meta = {k: ck.get(k) for k in ("epoch", "metrics")}
    92	    return (*mods, d, meta)
    93	
    94	
