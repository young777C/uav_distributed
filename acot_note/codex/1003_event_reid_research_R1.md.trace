    94	class PostProcessor:
    95	    """Add training annotations to raw recording data."""
    96	
    97	    def __init__(self, output_dir: Path, fov: float | None = None, allow_legacy_fov: bool = False):
    98	        self._output_dir = Path(output_dir)
    99	        # v6: the episode's own attrs['fov'] (written by the recorder) is authoritative; `fov` is only
   100	        # a cross-check. Files without the attr are refused unless allow_legacy_fov (then `fov`/90 used).
   101	        self._allow_legacy_fov = bool(allow_legacy_fov)
   102	        # §10: the sensor FOV was narrowed 90→70; bbox/off_screen projection MUST use the
   103	        # SAME fov as the camera (else off_screen under-reports — the target leaves the real
   104	        # 70° frame but a 90° projection still counts it in-frame). Caller passes output.fov.
   105	        self._fov = None if fov is None else float(fov)
   106	
   107	    def process_episode(self, episode_path: Path) -> None:
   108	        """Add annotations to one episode HDF5 file."""
   109	        with h5py.File(episode_path, "r+") as f:
   110	            n_steps = f["rgb"].shape[0]
   111	            if "fov" in f.attrs:
   112	                fov = float(f.attrs["fov"])
   113	                if self._fov is not None and abs(fov - self._fov) > 1e-6:
   114	                    raise ValueError(f"{episode_path}: attrs fov={fov} != expected {self._fov}")
   115	            elif self._allow_legacy_fov:
   116	                fov = self._fov if self._fov is not None else _FOV_DEG
   117	            else:
   118	                raise ValueError(f"{episode_path}: no attrs['fov'] — refusing to guess the camera FOV")
   119	            self._fov = fov
   120	
   121	            # 1. Correct-projection 2D bboxes: TARGET + ALL DISTRACTORS
   122	            bboxes = self._compute_bboxes(f, n_steps, self._fov)               # (n, 4)
   123	            dbboxes = self._compute_distractor_bboxes(f, n_steps, self._fov)   # (n, D, 4)
   124	
   125	            # 2. Occlusion (from the correct target bbox)
   126	            occlusions = self._compute_occlusions(f, n_steps, bboxes)
   127	
   128	            # 2b. Separated occlusion labels (A1c ②): structural (in-frame, hidden by
   129	            #     geometry) vs off-screen vs the "occluded" action-loss mask.
   130	            H, W = int(f["rgb"].shape[1]), int(f["rgb"].shape[2])
   131	            ray = (f["state/occ_raycast"][:n_steps].astype(np.float32)
   132	                   if "state/occ_raycast" in f else None)
   133	            occ_struct, off_screen, occluded = compute_occlusion_labels(
   134	                bboxes[:, 0], bboxes[:, 1], bboxes[:, 2], ray, W, H)
   135	
   136	            # 3. Compute EAR waypoint ground truth (unchanged — no recompute needed)
   137	            waypoints, wp_sigmas = self._compute_waypoints(f, n_steps)
   138	
   139	            # 4. Compute search_mode ground truth (from corrected occlusion)
   140	            search_modes = self._compute_search_modes(occlusions, n_steps)
   141	
   142	            # Write annotations
   143	            self._write_dataset(f, "annotation/bbox_u", bboxes[:, 0])
   144	            self._write_dataset(f, "annotation/bbox_v", bboxes[:, 1])
   145	            self._write_dataset(f, "annotation/bbox_w", bboxes[:, 2])
   146	            self._write_dataset(f, "annotation/bbox_h", bboxes[:, 3])
   147	            self._write_dataset(f, "annotation/occlusion", occlusions)
   148	            # A1c ② — separated, non-overlapping occlusion signals.
   149	            self._write_dataset(f, "annotation/occ_structural", occ_struct)
   150	            self._write_dataset(f, "annotation/off_screen", off_screen)
   151	            self._write_dataset(f, "annotation/occluded", occluded)
   152	            self._write_dataset(f, "annotation/search_mode", search_modes)
   153	            # Distractor 2D bboxes (n, D, 4) [u,v,w,h] for Stage-2 target-ID loss.
   154	            self._write_dataset(f, "distractors/bbox", dbboxes)
   155	
   156	            # Waypoints: shape (n_steps, 3, 3) → (n_steps, 9)
   157	            wp_flat = waypoints.reshape(n_steps, -1)
   158	            self._write_dataset(f, "annotation/waypoints", wp_flat)
   159	            self._write_dataset(f, "annotation/waypoint_sigma", wp_sigmas)
