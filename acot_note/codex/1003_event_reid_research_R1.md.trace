codex
我会把统计口径讲清楚：v5 只能用目标的 `off_screen/occ` 和干扰车的投影 bbox 做近似；v6 smoke 才有逐车实例可见像素与断开 tracklet。所以下面的数会分成“v5 可用近似统计”和“v6 标签口径小样本 sanity check”。
exec
/bin/sh -lc "python3 - <<'PY'
import glob, os, json, math
import h5py, numpy as np
from collections import Counter, defaultdict

def runs_bool(x):
    x=np.asarray(x,dtype=bool)
    n=len(x); out=[]; i=0
    while i<n:
        val=x[i]; j=i+1
        while j<n and x[j]==val: j+=1
        out.append((val,i,j))
        i=j
    return out

def gap_events(vis):
    # return gaps where actor invisible. has_prev/has_next visible tells nonreturn vs reentry.
    ev=[]
    for val,s,e in runs_bool(~vis): # True means invisible
        if not val: continue
        has_prev = s>0 and vis[s-1]
        has_next = e<len(vis) and vis[e]
        ev.append((s,e,e-s,has_prev,has_next))
    return ev

def q(vals):
    if not vals: return 'n/a'
    a=np.array(vals,dtype=float)
    return f\"mean={a.mean()/10:.2f}s med={np.median(a)/10:.2f}s p90={np.percentile(a,90)/10:.2f}s max={a.max()/10:.2f}s\"

def summarize_events(rows, label):
    # rows: dict with role,is_reentry,gap,covis_sim,covis_any,target_visible_at_start,loss_window_frac
    print('\\n===',label,'===')
    print('episodes', len(set(r['ep'] for r in rows)) if rows else 0, 'events_total', len(rows))
    for role in ['target','similar','other','distractor','all_non_target','all']:
        if role=='all': rr=rows
        elif role=='distractor': rr=[r for r in rows if r['role'] in ('similar','other')]
        elif role=='all_non_target': rr=[r for r in rows if r['actor']"'!=0]
        else: rr=[r for r in rows if r['"'role']==role]
        if not rr: continue
        print(role, 'n',len(rr), 'gap', q([r['gap'] for r in rr]),
              'reentry', sum(r['reentry'] for r in rr),
              'nonreturn', sum(r['nonreturn'] for r in rr),
              'covis>=1sim@reentry', sum(r['reentry'] and r.get('covis_sim',0)>=1 for r in rr),
              'covis>=2sim@reentry', sum(r['reentry'] and r.get('covis_sim',0)>=2 for r in rr))
        if role"'!='"'target':
            starts=[r for r in rr if r.get('target_vis_start') is not None]
            if starts:
                print(' ', 'target_visible_at_gap_start', f\"{sum(r['target_vis_start'] for r in starts)}/{len(starts)}={sum(r['target_vis_start'] for r in starts)/len(starts):.1%}\")

def v5():
    files=sorted(glob.glob('/nvidia/hque/data/carla_data/mvp_full_v5/*.h5'))
    rows_by_thr={thr:[] for thr in [10,30,50,100]}
    ep_stats=[]
    frame_counts=Counter()
    for p in files:
        with h5py.File(p,'r') as f:
            T=f['annotation/off_screen'].shape[0]
            fps=int(f.attrs.get('fps',10)) if 'fps' in f.attrs else 10
            # target visible by off_screen==0. Structural occlusion separately for target not comparable to distractors.
            tvis=(f['annotation/off_screen'][:]==0)
            db=f['distractors/bbox'][:] if 'distractors/bbox' in f else np.zeros((T,0,4))
            if db.shape[1]:
                u,v,w,h = db[...,0],db[...,1],db[...,2],db[...,3]
                dvis=(w>0)&(u>=0)&(u<512)&(v>=0)&(v<512)
            else:
                dvis=np.zeros((T,0),bool)
            vis=np.concatenate([tvis[:,None],dvis],axis=1)
            sim=np.array(f['distractors/similar'][:] if 'distractors/similar' in f else [], dtype=bool)
            roles=['target']+['similar' if s else 'other' for s in sim]
            frame_counts['frames']+=T; frame_counts['actors']+=vis.shape[1]
            frame_counts['visible_actor_frames']+=int(vis.sum()); frame_counts['actor_frames']+=vis.size
            for a in range(vis.shape[1]):
                evs=gap_events(vis[:,a])
                for s,e,g,has_prev,has_next in evs:
                    if not has_prev: continue # ignore initially absent before first sighting
                    for thr in rows_by_thr:
                        if g>=thr:
                            re=bool(has_next)
                            # covis at reentry frame e if reentry, excluding actor itself; similar count includes role similar visible.
                            covis_sim=int(((vis[e] if re else np.zeros(vis.shape[1],bool))[1:] & sim).sum()) if re else 0
                            covis_any=int((vis[e].sum()-int(vis[e,a])) if re else 0)
                            rows_by_thr[thr].append(dict(ep=os.path.basename(p),actor=a,role=roles[a],gap=g,
                                reentry=re,nonreturn=not re,covis_sim=covis_sim,covis_any=covis_any,
                                target_vis_start=bool(tvis[s-1]) if a"'!=0 and s>0 else None))
            ep_stats.append((os.path.basename(p),T,vis.shape[1],int(tvis.sum()),int(vis[:,1:].sum())))
    print('"'V5 files',len(files),'frames',frame_counts['frames'],'actor_frames',frame_counts['actor_frames'], 'visible_actor_frame_rate', frame_counts['visible_actor_frames']/frame_counts['actor_frames'])
    print('V5 actors/episode mean',np.mean([x[2] for x in ep_stats]), 'distractors mean', np.mean([x[2]-1 for x in ep_stats]))
    for thr,rows in rows_by_thr.items(): summarize_events(rows, f'v5 center-in-frame gaps >= {thr/10:.0f}s')

def v6(pattern, label):
    files=sorted(glob.glob(pattern))
    rows_by_thr={thr:[] for thr in [10,30,50,100]}
    frame_counts=Counter(); ep_meta=[]
    for p in files:
        try:
            with h5py.File(p,'r') as f:
                if 'actors/visible' not in f: continue
                vis=f['actors/visible'][:].astype(bool)
                T,A=vis.shape
                role_arr=f['actors/role'][:]
                roles=['target' if r==0 else ('similar' if r==1 else 'other') for r in role_arr]
                loss=f['state/loss_window'][:] if 'state/loss_window' in f else np.zeros(T)
                frame_counts['frames']+=T; frame_counts['actor_frames']+=vis.size; frame_counts['visible_actor_frames']+=int(vis.sum())
                evtab=f['events/target_reentry'][:] if 'events/target_reentry' in f else np.zeros((0,5),int)
                ep_meta.append((os.path.basename(p),T,A,str(f.attrs.get('dataset_version','?')),str(f.attrs.get('subset','?')),len(evtab)))
                for a in range(A):
                    for s,e,g,has_prev,has_next in gap_events(vis[:,a]):
                        if not has_prev: continue
                        for thr in rows_by_thr:
                            if g>=thr:
                                re=bool(has_next)
                                covis_sim=int(((vis[e] if re else np.zeros(A,bool)) & (role_arr==1)).sum()) if re else 0
                                covis_any=int(vis[e].sum()-int(vis[e,a])) if re else 0
                                rows_by_thr[thr].append(dict(ep=os.path.basename(p),actor=a,role=roles[a],gap=g,
                                    reentry=re,nonreturn=not re,covis_sim=covis_sim,covis_any=covis_any,
                                    target_vis_start=bool(vis[s-1,0]) if a"'!=0 and s>0 else None,
                                    loss_frac=float(loss[s:e].mean()) if e>s else 0.0))
        except OSError as e:
            print('"'skip',p,e)
    print('\\nV6 set', label, 'files_used', len(ep_meta), 'frames',frame_counts['frames'], 'visible_actor_frame_rate', (frame_counts['visible_actor_frames']/frame_counts['actor_frames'] if frame_counts['actor_frames'] else float('nan')))
    if ep_meta:
        print('actors/episode mean',np.mean([x[2] for x in ep_meta]), 'target_reentry table total', sum(x[5] for x in ep_meta), 'versions', Counter(x[3] for x in ep_meta), 'subsets', Counter(x[4] for x in ep_meta))
        print('episodes', ep_meta[:10])
    for thr,rows in rows_by_thr.items(): summarize_events(rows, f'{label} visible-px gaps >= {thr/10:.0f}s')

v5()
v6('/nvidia/hque/data/carla_data/uavtrack_v6_smoke*/episode_*.h5','v6 formal smoke')
v6('/nvidia/hque/data/carla_data/uavtrack_v6_smoke*/episode_*.rejected.h5','v6 rejected smoke')
