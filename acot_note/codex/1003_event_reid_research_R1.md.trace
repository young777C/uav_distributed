   904	            tloc = self._target.transform.location
   905	            tyaw = np.radians(self._target.transform.rotation.yaw)
   906	        except (RuntimeError, AttributeError):
   907	            return
   908	        fwd = np.array([np.cos(tyaw), np.sin(tyaw)])   # target's forward (+ = ahead / farther)
   909	        tp = np.array([tloc.x, tloc.y])
   910	        for obj, meta in zip(self._distractors, self._distractor_meta):
   911	            desired = meta.get("desired_off")
