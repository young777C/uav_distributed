    31	def project_world(points: np.ndarray, cam_inv: np.ndarray, W: int, H: int, f: float):
    32	    """points (N,3) world → (u, v, depth) arrays; CARLA camera frame x fwd, y right, z up."""
    33	    P = np.concatenate([points, np.ones((len(points), 1))], 1) @ cam_inv.T
    34	    d = P[:, 0]
    35	    with np.errstate(divide="ignore", invalid="ignore"):
    36	        u = f * (P[:, 1] / d) + W / 2.0
    37	        v = f * (-P[:, 2] / d) + H / 2.0
    38	    return u, v, d
    39	
    40	
    41	def amodal_box(actor, cam_inv, W, H, f):
    42	    """Tight 2D box of the projected 3D bounding box, clipped to the image.
    43	    Returns ((x0, y0, x1, y1) or None, center_in_frame, depth_of_center)."""
    44	    tf = actor.get_transform()
    45	    verts = actor.bounding_box.get_world_vertices(tf)
    46	    pts = np.array([[v.x, v.y, v.z] for v in verts], np.float64)
    47	    return amodal_box_from_vertices(pts, cam_inv, W, H, f)
    48	
    49	
    50	def amodal_box_from_vertices(pts, cam_inv, W, H, f):
    51	    """Same as amodal_box but from the 8 world vertices (offline re-projection). Vertices behind the
    52	    near plane are replaced by the intersections of every front/behind vertex pair with the plane, so
    53	    the box of a car crossing the image border/near plane does not shrink abruptly."""
    54	    P = np.concatenate([pts, np.ones((len(pts), 1))], 1) @ cam_inv.T          # camera frame (x fwd)
    55	    c = P.mean(0)
    56	    with np.errstate(divide="ignore", invalid="ignore"):
    57	        cu, cv = f * (c[1] / c[0]) + W / 2.0, f * (-c[2] / c[0]) + H / 2.0
    58	    cd = c[0]
    59	    center_in = bool(cd > NEAR and 0 <= cu < W and 0 <= cv < H)
    60	    front = P[:, 0] > NEAR
    61	    if not front.any():
    62	        return None, False, float(cd)
    63	    Q = [P[front, :3]]
    64	    for i in np.where(front)[0]:
    65	        for j in np.where(~front)[0]:
    66	            t = (P[i, 0] - NEAR) / (P[i, 0] - P[j, 0])
    67	            Q.append((P[i, :3] + t * (P[j, :3] - P[i, :3]))[None])
    68	    Q = np.concatenate(Q, 0)
    69	    u = f * (Q[:, 1] / Q[:, 0]) + W / 2.0
    70	    v = f * (-Q[:, 2] / Q[:, 0]) + H / 2.0
    71	    x0, x1 = np.clip(u.min(), 0, W - 1), np.clip(u.max(), 0, W - 1)
    72	    y0, y1 = np.clip(v.min(), 0, H - 1), np.clip(v.max(), 0, H - 1)
    73	    if x1 - x0 < 1 or y1 - y0 < 1:
    74	        return None, center_in, float(cd)
    75	    return (float(x0), float(y0), float(x1), float(y1)), center_in, float(cd)
    76	
    77	
    78	def decode_instance(raw: bytes, W: int, H: int):
    79	    """CARLA instance-seg BGRA → (tag (H,W) uint8, iid (H,W) int32). R = semantic tag, G|B<<8 = id."""
    80	    a = np.frombuffer(raw, np.uint8).reshape(H, W, 4)
    81	    tag = a[..., 2].copy()
    82	    iid = a[..., 1].astype(np.int32) | (a[..., 0].astype(np.int32) << 8)
    83	    return tag, iid
    84	
    85	
    86	def view_block_frac(tag) -> float:
    87	    """Fraction of the image tagged Unlabeled/Building/Wall — ≈1 when the camera is inside or pressed
    88	    against geometry (garbage frame)."""
    89	    return float(np.isin(tag, VIEW_BLOCK_TAGS).mean())
    90	
    91	
    92	def associate(boxes, tag, iid, min_inside: float = 0.5, prev=None):
    93	    """Assign instance blobs to scene actors.
    94	
    95	    boxes: list (len A) of amodal boxes (x0,y0,x1,y1) or None.
    96	    Returns per-actor arrays (iid, vis_px, modal box) + uint8 instance mask (0 bg, 1..A scene actors,
    97	    254 other vehicles, 253 pedestrians) + padded traffic table (MAX_TRAFFIC, 7):
    98	    [iid, tag, x0, y0, x1, y1, px] for unmatched vehicle blobs (iid = -1 padding).
    99	    Greedy by overlap; a blob is accepted only if >= min_inside of its pixels lie inside the box
   100	    (so a neighbouring occluder is not taken for the actor). `prev` (A,) = last frame's iid per actor:
   101	    a candidate that keeps the actor's previous iid gets its overlap doubled (temporal consistency)."""
   102	    H, W = tag.shape
   103	    A = len(boxes)
   104	    veh = np.isin(tag, VEHICLE_TAGS)
   105	    out_iid = np.full(A, -1, np.int32)
   106	    out_px = np.zeros(A, np.int32)
   107	    out_box = np.full((A, 4), -1.0, np.float32)
   108	    mask = np.zeros((H, W), np.uint8)
   109	    mask[tag == PEDESTRIAN_TAG] = MASK_PEDESTRIAN
   110	    if veh.any():
   111	        ids, counts = np.unique(iid[veh], return_counts=True)
   112	        total = dict(zip(ids.tolist(), counts.tolist()))
   113	    else:
   114	        total = {}
   115	    cands = []                                   # (overlap, actor, iid)
   116	    for a, b in enumerate(boxes):
   117	        if b is None:
   118	            continue
   119	        x0, y0, x1, y1 = (int(np.floor(b[0])), int(np.floor(b[1])), int(np.ceil(b[2])) + 1, int(np.ceil(b[3])) + 1)
   120	        sub_v = veh[y0:y1, x0:x1]
   121	        if not sub_v.any():
   122	            continue
   123	        ii, cc = np.unique(iid[y0:y1, x0:x1][sub_v], return_counts=True)
   124	        for i_, c_ in zip(ii.tolist(), cc.tolist()):
   125	            if c_ >= min_inside * total.get(i_, 1):
   126	                keep = prev is not None and prev[a] == i_
   127	                cands.append((c_ * (2 if keep else 1), a, i_))
   128	    used_a, used_i = set(), set()
   129	    for c_, a, i_ in sorted(cands, reverse=True):
   130	        if a in used_a or i_ in used_i:
   131	            continue
   132	        used_a.add(a); used_i.add(i_)
   133	        m = veh & (iid == i_)
   134	        ys, xs = np.nonzero(m)
   135	        out_iid[a], out_px[a] = i_, len(xs)
   136	        out_box[a] = (xs.min(), ys.min(), xs.max(), ys.max())
   137	        mask[m] = a + 1
   138	    traffic = np.full((MAX_TRAFFIC, 7), -1.0, np.float32)
   139	    k = 0
   140	    for i_, c_ in sorted(total.items(), key=lambda t: -t[1]):
   141	        if i_ in used_i:
   142	            continue
   143	        m = veh & (iid == i_)
   144	        mask[m] = MASK_OTHER_VEHICLE
   145	        if k < MAX_TRAFFIC:
   146	            ys, xs = np.nonzero(m)
   147	            traffic[k] = (i_, float(np.bincount(tag[m]).argmax()), xs.min(), ys.min(), xs.max(), ys.max(), c_)
   148	            k += 1
   149	    return out_iid, out_px, out_box, mask, traffic
   150	
   151	
   152	# ---------------------------------------------------------------- offline (postprocess)
   153	
   154	def tracklet_ids(visible: np.ndarray, gap_frames: int) -> np.ndarray:
   155	    """visible (T, A) bool → tracklet id (T, A) int32, -1 where invisible. A new id is issued when an
   156	    actor becomes visible after being invisible for >= gap_frames (shorter gaps keep the id).
   157	    Ids are unique within the episode."""
   158	    T, A = visible.shape
   159	    out = np.full((T, A), -1, np.int32)
   160	    nxt = 0
   161	    for a in range(A):
   162	        cur, gap = -1, 10 ** 9
   163	        for t in range(T):
   164	            if visible[t, a]:
   165	                if cur < 0 or gap >= gap_frames:
   166	                    cur = nxt; nxt += 1
   167	                out[t, a] = cur
   168	                gap = 0
   169	            else:
   170	                gap += 1
   171	    return out
   172	
   173	
   174	def reentry_events(visible_t: np.ndarray, off_t: np.ndarray, n_lookalike_vis: np.ndarray,
   175	                   n_vehicle_vis: np.ndarray, min_gap: int) -> np.ndarray:
   176	    """Target re-entry events → (K, 5) int32: [frame, gap_frames, cause (0 off-screen, 1 occlusion,
   177	    2 mixed), n_lookalikes_visible, n_scene_vehicles_visible] at the first visible frame after an
   178	    invisible run of >= min_gap frames."""
   179	    ev, run, n_off = [], 0, 0
   180	    for t in range(len(visible_t)):
   181	        if not visible_t[t]:
   182	            run += 1; n_off += int(off_t[t])
   183	            continue
   184	        if run >= min_gap:
   185	            cause = 0 if n_off == run else (1 if n_off == 0 else 2)
   186	            ev.append((t, run, cause, int(n_lookalike_vis[t]), int(n_vehicle_vis[t])))
   187	        run, n_off = 0, 0
   188	    return np.array(ev, np.int32).reshape(-1, 5)

