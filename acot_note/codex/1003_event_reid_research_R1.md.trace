codex
初步统计结果很鲜明：如果只问“有没有跨间隔可见-不可见-再可见”，多标注车辆确实把 v5 的事件数从目标车的几十个放大到几百个；但其中 90% 以上的非目标离画面发生时目标仍可见，强烈提示它们主要是相机跟着目标导致的被动离场。这个放大是真实的，但不是无代价的。
exec
/bin/sh -lc "python3 - <<'PY'
import glob, os, h5py, numpy as np
from collections import Counter

def runs_invisible(vis):
    x=~np.asarray(vis,bool); n=len(x); i=0
    while i<n:
        j=i+1
        while j<n and x[j]==x[i]: j+=1
        if x[i]: yield i,j,j-i,(i>0 and vis[i-1]),(j<n and vis[j])
        i=j

def summarize(files,label):
    files=[p for p in files if not (p.endswith('.rejected.h5') or p.endswith('.tmp.h5'))]
    print('\\n',label,'clean files',len(files))
    if not files: return
    allrows=[]; evtab=0; subsets=Counter(); versions=Counter(); epids=[]
    for p in files:
        with h5py.File(p,'r') as f:
            if 'actors/visible' not in f: continue
            vis=f['actors/visible'][:].astype(bool); role=f['actors/role'][:]
            evtab += (f['events/target_reentry'].shape[0] if 'events/target_reentry' in f else 0)
            subsets[str(f.attrs.get('subset','?'))]+=1; versions[str(f.attrs.get('dataset_version','?'))]+=1
            epids.append((p,vis.shape, f['events/target_reentry'][:] if 'events/target_reentry' in f else np.zeros((0,5),int)))
            for a in range(vis.shape[1]):
                for s,e,g,hp,hn in runs_invisible(vis[:,a]):
                    if not hp or g<30: continue
                    allrows.append((a,int(role[a]),g,hn, bool(vis[s-1,0]) if a"'!=0 else None))
    print('"'versions',versions,'subsets',subsets,'target_reentry_rows',evtab)
    print('episodes sample')
    for p,shape,ev in epids[:12]: print(os.path.basename(p),shape,'target_events',ev.tolist())
    for name,fil in [('target',lambda r:r[0]==0),('similar',lambda r:r[1]==1),('other',lambda r:r[1]==2),('non-target',lambda r:r[0]"'!=0),('"'all',lambda r:True)]:
        rr=[r for r in allrows if fil(r)]
        if not rr: continue
        print(name,'>=3s gaps',len(rr),'reentry',sum(r[3] for r in rr),'nonreturn',sum(not r[3] for r in rr),'target_vis_start', (sum(r[4] for r in rr if r[4] is not None), sum(1 for r in rr if r[4] is not None)))

