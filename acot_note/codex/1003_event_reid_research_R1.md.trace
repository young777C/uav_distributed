     1	"""Temporal Association Head (TAH) — path-B: ONE learned module replacing the heuristic WHICH stack
     2	(K-view gallery + top-m + temporal-EMA + motion-consensus fusion + consensus-gate). Given per-frame
     3	candidates {crop-DINOv2 appearance ⊕ image position} and a recurrent target MEMORY, learn to associate
     4	the tracked target across time (appearance + position + memory) → identity logits + a confidence.
     5	
     6	Subsumes: gallery/EMA = the GRU memory (learned recurrence); motion-consensus = position is an input
     7	feature the model learns to weight vs appearance; consensus-gate = the confidence output. No hand-tuned
     8	knobs (RMOT / conf-tau / gate-px). Trained SUPERVISED on GT identity (the WHICH signal is learnable —
     9	DINOv2 separates look-alikes; unlike the failed BC/RL control)."""
    10	from __future__ import annotations
    11	import torch
    12	import torch.nn as nn
    13	import torch.nn.functional as F
    14	
    15	
    16	class TAH(nn.Module):
    17	    def __init__(self, d_feat=384, d_pos=3, d=256):
    18	        super().__init__()
    19	        self.enc = nn.Sequential(nn.Linear(d_feat + d_pos, d), nn.GELU(), nn.Linear(d, d))
    20	        self.q = nn.Linear(d, d)                       # query from memory
    21	        self.k = nn.Linear(d, d)                       # key from candidate
    22	        self.gru = nn.GRUCell(d, d)                    # learned memory update (replaces gallery+EMA)
    23	        self.m0 = nn.Parameter(torch.zeros(d))         # learned initial memory
    24	        self.conf = nn.Sequential(nn.Linear(d, d // 2), nn.GELU(), nn.Linear(d // 2, 1))  # learned confidence
    25	        self.d = d
    26	
    27	    def reset(self, device):
    28	        return self.m0.to(device).clone()
    29	
    30	    def step(self, feat, pos, m):
    31	        """One frame. feat:(n,d_feat) pos:(n,d_pos) m:(d,). Returns logits:(n,), conf:scalar, emb:(n,d)."""
    32	        e = self.enc(torch.cat([feat, pos], dim=-1))                    # (n,d)
    33	        logits = (self.k(e) @ self.q(m)) / (self.d ** 0.5)             # (n,) attention target↔candidates
    34	        conf = torch.sigmoid(self.conf(m)).squeeze(-1)                 # learned confidence for control gating
    35	        return logits, conf, e
    36	
    37	    def update(self, m, target_emb):
    38	        """Recurrent memory update from the (GT-teacher-forced or committed) target embedding."""
    39	        return self.gru(target_emb.unsqueeze(0), m.unsqueeze(0)).squeeze(0)
    40	
    41	
    42	class TAHRel(nn.Module):
    43	    """TAH v2 (Tier-1 generalization fix): consume RELATIVE / vehicle-INVARIANT features instead of
    44	    absolute candidate embeddings — the root-cause fix for the 64-episode open-set overfitting (CE on
    45	    absolute embeddings memorizes training vehicles). The ONLY learned parts are (a) a scalar appearance-
    46	    memory update gate and (b) a TINY MLP that WEIGHTS relative signals — a vehicle-agnostic gating
    47	    function (learn the DeepSORT gating, not the encoder). Appearance comparison is offloaded to the
    48	    frozen DINOv2 cosine (generalizes to any vehicle). Memory is a dict{app(384),pos(2),vel(2)}.
    49	    ~5K params → cannot overfit 64 episodes."""
    50	    def __init__(self, d_feat=384):
    51	        super().__init__()
    52	        self.gate = nn.Parameter(torch.tensor(-1.0))          # learned appearance-memory EMA gate (sigmoid)
    53	        self.mlp = nn.Sequential(nn.Linear(5, 64), nn.GELU(), nn.Linear(64, 64), nn.GELU(), nn.Linear(64, 1))
    54	
    55	    def reset(self, device):
    56	        return {"app": None, "pos": None, "vel": None}
    57	
    58	    def step(self, feat, pos, mem):
    59	        """feat:(n,384) L2-normed; pos:(n,3)=[u/W,v/H,depth]; mem dict. Returns logits:(n,), conf, None."""
    60	        n = feat.shape[0]; dev = feat.device
    61	        if mem["app"] is None:                                # cold start: no target memory yet
    62	            cos = torch.zeros(n, device=dev); relp = torch.zeros(n, 2, device=dev); rank = torch.zeros(n, device=dev)
    63	        else:
    64	            cos = feat @ mem["app"]                           # relative appearance (vehicle-agnostic cosine)
    65	            pred = mem["pos"] + (mem["vel"] if mem["vel"] is not None else torch.zeros(2, device=dev))
    66	            relp = pos[:, :2] - pred[None]                    # relative motion (candidate vs CV-predicted target)
    67	            rank = torch.softmax(cos * 5.0, dim=0)            # relative-to-neighbors (star-topology, GNN-style)
    68	        x = torch.stack([cos, relp[:, 0], relp[:, 1], pos[:, 2], rank], dim=-1)  # (n,5) ALL vehicle-invariant
    69	        logits = self.mlp(x).squeeze(-1)
    70	        srt = torch.sort(logits, descending=True).values
    71	        conf = torch.sigmoid(srt[0] - srt[1]) if n >= 2 else torch.tensor(1.0, device=dev)
    72	        return logits, conf, None
    73	
    74	    def update(self, mem, target_feat, target_pos):
    75	        g = torch.sigmoid(self.gate)
    76	        m = dict(mem)
    77	        if m["app"] is None:
    78	            m["app"] = target_feat.clone()
    79	        else:
    80	            a = (1 - g) * m["app"] + g * target_feat
    81	            m["app"] = a / (a.norm() + 1e-8)
    82	        npos = target_pos[:2]
    83	        m["vel"] = (npos - m["pos"]) if m["pos"] is not None else torch.zeros(2, device=target_feat.device)
    84	        m["pos"] = npos
    85	        return m
    86	
    87	
    88	class TAHRelM(nn.Module):
    89	    """TAHRel + LEARNED motion-consensus (path-A upgrade, distills borrow#1). TAHRel already had a raw
    90	    relative-displacement feature but (a) fed the MLP only unbounded relp_x/relp_y — not a well-scaled
    91	    distance/gated consensus — and (b) used a noisy single-step velocity. This adds the two things
    92	    borrow#1's hand-tuned motion gate supplies, but LEARNED: an explicit gate-normalized soft motion
    93	    score msoft = exp(−‖relp‖/gate) (bounded 0–1, learned radius) + the raw distance ‖relp‖, and an EMA
    94	    velocity (learned decay) robust across losses. Targets the ONE metric TAHRel loses (q_reacq / re-
    95	    acquisition), where DeepSORT & borrow#1 win via an explicit motion prior. 7 vehicle-invariant
    96	    features; ~4.7K params (still cannot overfit). Same step/update signature → train & deploy unchanged."""
    97	    def __init__(self, d_feat=384):
    98	        super().__init__()
    99	        self.gate = nn.Parameter(torch.tensor(-1.0))          # appearance-memory EMA gate (sigmoid)
   100	        self.vbeta = nn.Parameter(torch.tensor(0.0))          # EMA velocity decay (sigmoid)
   101	        self.mgate = nn.Parameter(torch.tensor(-2.3))         # soft motion-gate radius (softplus, img-frac)
   102	        self.mlp = nn.Sequential(nn.Linear(7, 64), nn.GELU(), nn.Linear(64, 64), nn.GELU(), nn.Linear(64, 1))
   103	
   104	    def reset(self, device):
   105	        return {"app": None, "pos": None, "vel": None}
   106	
   107	    def step(self, feat, pos, mem):
   108	        """feat:(n,384) L2-normed; pos:(n,3)=[u/W,v/H,depth]; mem dict. Returns logits:(n,), conf, None."""
   109	        n = feat.shape[0]; dev = feat.device
   110	        if mem["app"] is None:                                # cold start: no target memory yet
   111	            cos = torch.zeros(n, device=dev); relp = torch.zeros(n, 2, device=dev)
   112	            rank = torch.zeros(n, device=dev); dmot = torch.zeros(n, device=dev); msoft = torch.zeros(n, device=dev)
   113	        else:
   114	            cos = feat @ mem["app"]                           # relative appearance (vehicle-agnostic cosine)
   115	            pred = mem["pos"] + (mem["vel"] if mem["vel"] is not None else torch.zeros(2, device=dev))
   116	            relp = pos[:, :2] - pred[None]                    # relative motion (candidate vs CV-predicted target)
   117	            rank = torch.softmax(cos * 5.0, dim=0)            # relative-to-neighbors (star-topology, GNN-style)
   118	            dmot = relp.norm(dim=-1)                          # distance from CV prediction
   119	            gate = F.softplus(self.mgate) + 1e-3
   120	            msoft = torch.exp(-dmot / gate)                   # borrow#1-style bounded soft motion consensus (learned radius)
   121	        x = torch.stack([cos, relp[:, 0], relp[:, 1], pos[:, 2], rank, dmot, msoft], dim=-1)  # (n,7) all invariant
   122	        logits = self.mlp(x).squeeze(-1)
   123	        srt = torch.sort(logits, descending=True).values
   124	        conf = torch.sigmoid(srt[0] - srt[1]) if n >= 2 else torch.tensor(1.0, device=dev)
   125	        return logits, conf, None
   126	
   127	    def update(self, mem, target_feat, target_pos):
   128	        g = torch.sigmoid(self.gate); m = dict(mem)
   129	        if m["app"] is None:
   130	            m["app"] = target_feat.clone()
   131	        else:
   132	            a = (1 - g) * m["app"] + g * target_feat
   133	            m["app"] = a / (a.norm() + 1e-8)
   134	        npos = target_pos[:2]
   135	        step_v = (npos - m["pos"]) if m["pos"] is not None else torch.zeros(2, device=target_feat.device)
   136	        if m["vel"] is None:
   137	            m["vel"] = step_v
   138	        else:
   139	            b = torch.sigmoid(self.vbeta)
   140	            m["vel"] = (1 - b) * m["vel"] + b * step_v        # EMA velocity — robust across losses
   141	        m["pos"] = npos
   142	        return m

