import glob, h5py, os
for pattern in ['/nvidia/hque/data/carla_data/mvp_full_v5/*.h5','/nvidia/hque/data/carla_data/uavtrack_v6_smoke*/episode_*.h5','/nvidia/hque/data/carla_data/uavtrack_v6_smoke*/episode_*.rejected.h5']:
    fs=sorted(glob.glob(pattern))[:3]
    print('\\nPATTERN', pattern, 'Nsample', len(fs))
    for p in fs:
        print('FILE', p)
        with h5py.File(p,'r') as f:
            def walk(name, obj):
                if isinstance(obj, h5py.Dataset):
                    print(' ', name, obj.shape, obj.dtype)
            f.visititems(walk)
            print(' attrs', {k:f.attrs[k] for k in list(f.attrs)[:12]})
        break
