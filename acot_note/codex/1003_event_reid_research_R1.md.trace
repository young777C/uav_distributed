     1	"""Build per-frame candidate boxes + cand_feats for the target-id head (§5, Option A).
     2	
     3	At rollout time the target-id head needs a candidate SET (target + distractors as
     4	image boxes) to argmax over. Training used GT-projected boxes (dataset_stage2.py:273
     5	via acot_probe.projection); we reproduce that ONLINE from live CARLA GT positions +
     6	the current camera pose.
     7	
     8	H0 honesty (guide §5): the boxes are UNLABELED and SHUFFLED every frame — they give
     9	the policy a candidate set (positions), never target identity. The tid head must
    10	still pick the referred car via language. `true_idx` (the shuffled slot of the true
    11	target) is returned for the SCORER only, never fed to the policy. Only IN-FRAME
    12	vehicles become candidates (a detector sees only what's in frame); if the target is
    13	off-screen, `true_idx == -1` and that frame is a "target-absent" (re-acquisition)
    14	frame for scoring.
    15	
    16	Swap this module for a real detector to remove all GT from the control path (Option B).
    17	"""
    18	
    19	from __future__ import annotations
    20	
    21	from dataclasses import dataclass
    22	
    23	import numpy as np
    24	
    25	from acot_probe.projection import Candidate, project_point
    26	from acot_probe.backbones import pool_box
    27	
    28	
    29	@dataclass
    30	class CandidateSet:
    31	    feats: np.ndarray          # (N, C) pooled VLM features, shuffled order
    32	    cands: list[Candidate]     # length N, same shuffled order (carries is_target/idx)
    33	    true_idx: int              # slot of the true target in this set, or -1 if target off-screen
    34	    mask: np.ndarray           # (N,) bool, all True (no padding for a single frame)
    35	
    36	
    37	def _pseudo_box(depth, W, fov_deg, vehicle_size_m, box_min_px, box_max_px):
    38	    import math
    39	    f = W / (2.0 * math.tan(math.radians(fov_deg) / 2.0))
    40	    size = f * vehicle_size_m / max(depth, 0.1)
    41	    return float(np.clip(size, box_min_px, box_max_px))
    42	
    43	
    44	def build_candidates(grid_last: np.ndarray, tpos, dstates, campose,
    45	                     image_cfg: dict, rng: np.random.Generator) -> CandidateSet | None:
    46	    """grid_last: (Gh,Gw,C) VLM grid. tpos: (3,) target world xyz.
    47	    dstates: (D,6) distractor [x,y,z,vx,vy,vz]. campose: (cx,cy,cz,pitch,yaw).
    48	    Returns None if NO vehicle is in frame (nothing to select)."""
    49	    W, H, fov = int(image_cfg["width"]), int(image_cfg["height"]), float(image_cfg["fov_deg"])
    50	    vsz = float(image_cfg["vehicle_size_m"])
    51	    bmin, bmax = float(image_cfg["box_min_px"]), float(image_cfg["box_max_px"])
    52	
    53	    def _mk(world_xyz, is_target, idx):
    54	        pr = project_point(world_xyz, campose, W, H, fov)
    55	        if pr is None:
    56	            return None
    57	        u, v, depth = pr
    58	        if not (0 <= u < W and 0 <= v < H):
    59	            return None
    60	        s = _pseudo_box(depth, W, fov, vsz, bmin, bmax)
    61	        return Candidate(u, v, s, s, depth, is_target, idx)
    62	
    63	    cands = []
    64	    tgt = _mk((float(tpos[0]), float(tpos[1]), float(tpos[2])), True, -1)
    65	    if tgt is not None:
    66	        cands.append(tgt)
    67	    dstates = np.asarray(dstates)
    68	    for d in range(dstates.shape[0]):
    69	        c = _mk((dstates[d, 0], dstates[d, 1], dstates[d, 2]), False, d)
    70	        if c is not None:
    71	            cands.append(c)
    72	
    73	    if not cands:
    74	        return None                                   # nothing in frame
    75	
    76	    # Shuffle so the true target is not at a fixed slot (metric-honesty, §5 / [[tid-metric-artifact]]).
    77	    order = rng.permutation(len(cands))
    78	    cands = [cands[o] for o in order]
    79	    true_idx = next((i for i, c in enumerate(cands) if c.is_target), -1)
    80	
    81	    frac_boxes = [c.frac_box(W, H) for c in cands]
    82	    feats = np.stack([pool_box(grid_last, fb) for fb in frac_boxes]).astype(np.float32)
    83	    mask = np.ones(len(cands), dtype=bool)
    84	    return CandidateSet(feats=feats, cands=cands, true_idx=true_idx, mask=mask)
     1	"""Cache per-episode candidate SEQUENCES for the Temporal Association Head (TAH, path-B: replace the
     2	heuristic WHICH stack with ONE learned module). Per frame: crop-DINOv2 appearance + image position +
     3	GT identity, in temporal order (stable actor idx). Offline from mvp_full_v5. Runs in container (GPU)."""
     4	from __future__ import annotations
     5	import argparse, os, sys, glob
     6	import numpy as np, yaml, h5py
     7	
     8	_CARLA = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "carla_uav_tracking")
     9	for _p in (os.path.dirname(_CARLA), _CARLA):
    10	    if _p not in sys.path: sys.path.insert(0, _p)
    11	from acot_probe.projection import project_point
    12	from rollout.candidates import Candidate
    13	from train.dataset import _select_episodes
    14	
    15	
    16	def _mk(world, is_t, idx, campose, W, H, fov, vsz, bmin, bmax):
    17	    pr = project_point((float(world[0]), float(world[1]), float(world[2])), tuple(campose), W, H, fov)
    18	    if pr is None: return None
    19	    u, v, depth = pr
    20	    if not (0 <= u < W and 0 <= v < H): return None
    21	    f = W / (2.0 * np.tan(np.radians(fov) / 2.0)); s = float(np.clip(f * vsz / max(depth, 0.1), bmin, bmax))
    22	    return Candidate(u, v, s, s, depth, is_t, idx)
    23	
    24	
    25	def main():
    26	    ap = argparse.ArgumentParser()
    27	    ap.add_argument("--config", default="train/config_v5.yaml")
    28	    ap.add_argument("--out", default="runs/tah_cache.pt")
    29	    ap.add_argument("--stride", type=int, default=2)
    30	    ap.add_argument("--device", default="cuda:0")
    31	    a = ap.parse_args()
    32	    import torch
    33	    from train.reid_resolution_probe import _load_dino, _dino_feats
    34	    cfg = yaml.safe_load(open(a.config)); ic = cfg["image"]
    35	    W, H, fov = ic["width"], ic["height"], ic["fov_deg"]
    36	    vsz, bmin, bmax = float(ic["vehicle_size_m"]), float(ic["box_min_px"]), float(ic["box_max_px"])
    37	    dino = _load_dino("vit_small_patch14_dinov2.lvd142m", a.device)
    38	    eps = _select_episodes(cfg, "train") + _select_episodes(cfg, "val")
    39	    episodes = []
    40	    for ei, ep in enumerate(eps):
    41	        with h5py.File(ep, "r") as fh:
    42	            n = fh["rgb"].shape[0]
    43	            tgt = np.stack([fh["target/tx"][:], fh["target/ty"][:], fh["target/tz"][:]], -1)
    44	            dpos = fh["distractors/positions"][:]                       # (T,D,6)
    45	            cam = np.stack([fh[f"state/cam_{k}"][:] for k in ["x","y","z","pitch","yaw"]], -1)
    46	            frames = []
    47	            for i in range(0, n, a.stride):
    48	                campose = cam[i]
    49	                cands, aidx, tflag = [], [], []
    50	                c = _mk(tgt[i], True, -1, campose, W, H, fov, vsz, bmin, bmax)
    51	                if c is not None: cands.append(c); aidx.append(-1); tflag.append(1)
    52	                for d in range(dpos.shape[1]):
    53	                    c = _mk(dpos[i, d, :3], False, d, campose, W, H, fov, vsz, bmin, bmax)
    54	                    if c is not None: cands.append(c); aidx.append(d); tflag.append(0)
    55	                if not cands: continue
    56	                feats = _dino_feats(dino, np.asarray(fh["rgb"][i]), cands, W, H, 224, 1.3, a.device).astype(np.float32)
    57	                feats = feats / (np.linalg.norm(feats, axis=1, keepdims=True) + 1e-8)
    58	                pos = np.array([[c.u / W, c.v / H, c.depth / 100.0] for c in cands], np.float32)
    59	                tidx = tflag.index(1) if 1 in tflag else -1
    60	                frames.append({"feat": feats.astype(np.float16), "pos": pos,
    61	                               "aidx": np.array(aidx, np.int16), "tidx": tidx})
    62	            if frames: episodes.append(frames)
    63	        print(f"[tah_cache] ep{ei} {os.path.basename(ep)}: {len(frames)} frames (total eps={len(episodes)})", flush=True)
    64	    torch.save({"episodes": episodes, "d_feat": 384}, a.out)
    65	    nf = sum(len(e) for e in episodes)
    66	    print(f"[tah_cache] wrote {a.out}: {len(episodes)} episodes, {nf} frames", flush=True)
    67	
    68	
    69	if __name__ == "__main__":
    70	    main()

