/bin/sh -lc "nl -ba carla_uav_tracking/rollout/policy.py | sed -n '640,760p'" in /nvidia/hque/code/cyhe/uav-acot-track
 succeeded in 0ms:
   640	            layers, vlm_ctx, grid_last = self.vlm.encode(obs.rgb, obs.language)   # (M,C) float32
   641	            self._vlm_ctx = vlm_ctx[None]                                          # (1,M,C)
   642	            self._ctx_layers = [x[None] for x in layers]
   643	            self._ctx_mask = torch.ones(1, vlm_ctx.shape[0], dtype=torch.bool, device=self.device)
   644	            if self.ablate == "ear":
   645	                self._z_ex = torch.zeros(1, self.K, 3, device=self.device)                # w/o-EAR
   646	            else:
   647	                self._z_ex = flow_matching.sample(self.ear, self._vlm_ctx, self._ctx_mask,
   648	                                                   k=self.K, steps=self.steps, proprio=prop)  # (1,K,3)
   649	            self._z_im, _ = self.iar(self._ctx_layers, self._ctx_mask)                     # (1,n_im,d)
   650	            if self.ablate == "iar":
   651	                self._z_im = torch.zeros_like(self._z_im)                                  # w/o-IAR
   652	
   653	            tpos, dstates, campose = gt_candidates[:3]
   654	            # P2a-1: env-side road-graph prediction (WORLD (K,3)) rides in slot 3 when
   655	            # --ex-source road; None otherwise (or for legacy 3-tuples).
   656	            road_pred_world = gt_candidates[3] if len(gt_candidates) > 3 else None
   657	            cset = build_candidates(grid_last, tpos, dstates, campose, self.image_cfg, self._rng)
   658	            vis = gt_candidates[4] if len(gt_candidates) > 4 else None
   659	            if cset is not None and self.occl_cands and vis is not None:
   660	                # occlusion-aware detector: a vehicle the env's ray-cast marks occluded produces no box this tick
   661	                t_vis, d_vis = vis
   662	                keep = [i for i, c in enumerate(cset.cands)
   663	                        if (t_vis if c.is_target else (c.idx < len(d_vis) and d_vis[c.idx]))]
   664	                if not keep:
   665	                    cset = None
   666	                else:
   667	                    cands = [cset.cands[i] for i in keep]
   668	                    cset = type(cset)(feats=cset.feats[keep], cands=cands,
   669	                                      true_idx=next((j for j, c in enumerate(cands) if c.is_target), -1),
   670	                                      mask=cset.mask[keep])
   671	            if cset is not None and self._tracker is not None:
   672	                # GT-free identity keys: re-key every candidate with the tracker's id; keep the simulator actor index
   673	                # in gt_idx (scorer / ideal localisation of the CURRENTLY matched visible box only).
   674	                from train.reid_resolution_probe import _dino_feats
   675	                Wt, Ht = self.image_cfg["width"], self.image_cfg["height"]
   676	                ft = _dino_feats(self._dino, obs.rgb, cset.cands, Wt, Ht, 224, 1.3, self.device).astype(np.float64)
   677	                ft = ft / (np.linalg.norm(ft, axis=1, keepdims=True) + 1e-8)
   678	                tids = self._tracker.update([(c.u, c.v) for c in cset.cands], [c.w for c in cset.cands], ft)
   679	                for c, t in zip(cset.cands, tids):
   680	                    c.gt_idx = int(c.idx); c.idx = int(t)
   681	                if self._trk_log is not None:
   682	                    self._trk_log.write(json.dumps({"ep": self._trk_ep, "k": self._trk_k, "t": int(obs.step),
   683	                                                    "tid": [int(c.idx) for c in cset.cands],
   684	                                                    "gt": [int(c.gt_idx) for c in cset.cands],
   685	                                                    # replay data for offline tracker tuning on dev (perception only)
   686	                                                    "uv": [[round(float(c.u), 1), round(float(c.v), 1)] for c in cset.cands],
   687	                                                    "sz": [round(float(c.w), 1) for c in cset.cands],
   688	                                                    "f": np.round(ft, 3).astype(np.float16).tolist()}) + "\n")
   689	                    self._trk_log.flush()
   690	                self._trk_k += 1
   691	            if cset is not None:
   692	                cf = torch.from_numpy(cset.feats)[None].to(self.device)                    # (1,N,C)
   693	                cmask = torch.from_numpy(cset.mask)[None].to(self.device)
   694	                if self.tid_head == "attrbind":
   695	                    if obs.target_color not in self._cvoc or obs.target_bp not in self._mvoc:
   696	                        print(f"[attrbind-attr] <UNK> color='{obs.target_color}' make='{obs.target_bp}'", flush=True)
   697	                    ci = torch.tensor([self._cvoc.get(obs.target_color, self._cvoc["<unk>"])], device=self.device)
   698	                    mi = torch.tensor([self._mvoc.get(obs.target_bp, self._mvoc["<unk>"])], device=self.device)
   699	                    logits = self.tid(cf, ci, mi, cmask)[0]                                # (N,)
   700	                else:
   701	                    logits = self.tid(cf, self._vlm_ctx, self._ctx_mask, cmask)[0]         # (N,)
   702	                self._tid_logits = logits.float().cpu().numpy()
   703	                self._pred_slot = int(logits.argmax().item())
   704	                lang_slot = self._pred_slot   # language grounding pick — saved before any reid override
   705	                lang_logits = self._tid_logits.copy()   # full language logits — for TEMPORAL language re-anchor
   706	                if self._zoom is not None and self._open_k < self._open_window and len(cset.cands) > 0:
   707	                    zs = self._zoom.scores(obs.rgb, cset.cands, str(obs.language), getattr(obs, "rgb_hi", None))
   708	                    if self._open_agg != "mean":
   709	                        zs = zs - zs.max()
   710	                    for c, z in zip(cset.cands, zs):                       # accumulate over the opening window by id
   711	                        self._open_acc[int(c.idx)] = self._open_acc.get(int(c.idx), 0.0) + float(z)
   712	                        self._open_cnt[int(c.idx)] = self._open_cnt.get(int(c.idx), 0) + 1
   713	                    _den = (lambda i_: self._open_cnt[i_]) if self._open_agg == "mean" else (lambda i_: 1)
   714	                    if self._open_agg == "last":     # this tick's scores only — immune to tracker id swaps in the window
   715	                        lang_slot = int(np.argmax(zs))
   716	                    else:
   717	                        lang_slot = max(range(len(cset.cands)),
   718	                                        key=lambda s_: self._open_acc[int(cset.cands[s_].idx)] / _den(int(cset.cands[s_].idx)))
   719	                    self._pred_slot = lang_slot; self._open_k += 1
   720	                    if self._open_window > 1 and (self._open_k < self._open_window or self._open_final_reset) \
   721	                       and self._tah is not None:
   722	                        self._tah_mem = self._tah.reset(self.device)       # keep the memory seeded by the FINAL pick
   723	                    if self._open_reset_asd and self._asd is not None and getattr(self._asd, "mode", "") == "filter":
   724	                        self._asd.belief = {}; self._asd.conf_hist = []   # PGIF restarts from this opening pick
   725	                    if self._open_k >= self._open_window:                  # last opening tick
   726	                        self._open_force = self._open_force_final
   727	                        if self._open_seed_asd > 0 and self._asd is not None and getattr(self._asd, "mode", "") == "filter":
   728	                            self._asd.belief = {int(cset.cands[lang_slot].idx): self._open_seed_asd}; self._asd.conf_hist = []
   729	                if os.environ.get("OPENING_DUMP") and obs.step in (0, 6, 12):
   730	                    # opening benchmark snapshot (offline scorer development): frame + candidate boxes + language +
   731	                    # current grounding logits; is_target / gt ids are saved ONLY for offline scoring
   732	                    _d = os.environ["OPENING_DUMP"]; os.makedirs(_d, exist_ok=True)
   733	                    np.savez_compressed(
   734	                        os.path.join(_d, f"{os.environ.get('HOSTNAME', 'x')}_{self._dump_ep:03d}_t{int(obs.step):03d}.npz"),
   735	                        rgb=np.asarray(obs.rgb, np.uint8), language=str(obs.language),
   736	                        rgb_hi=(np.zeros((0,), np.uint8) if getattr(obs, "rgb_hi", None) is None
   737	                                else np.asarray(obs.rgb_hi, np.uint8)),
   738	                        target_color=str(getattr(obs, "target_color", "")), target_bp=str(getattr(obs, "target_bp", "")),
   739	                        u=np.array([c.u for c in cset.cands], np.float32), v=np.array([c.v for c in cset.cands], np.float32),
   740	                        w=np.array([c.w for c in cset.cands], np.float32), h=np.array([c.h for c in cset.cands], np.float32),
   741	                        depth=np.array([c.depth for c in cset.cands], np.float32),
   742	                        is_target=np.array([bool(c.is_target) for c in cset.cands]),
   743	                        gt_idx=np.array([int(getattr(c, "gt_idx", c.idx)) for c in cset.cands], np.int32),
   744	                        lang_logits=np.asarray(lang_logits, np.float32), step=int(obs.step), ep=int(self._dump_ep))
   745	                rl = None                     # reid match scores (None = no gallery yet / non-reid head)
   746	                # TEMPORAL language re-anchor: single-frame language picks wrong at re-appearance (H0 ceiling) →
   747	                # accumulate per-actor EMA of the language logit so the re-anchor commits the temporally-integrated
