   150	    def _fire_retarget(self, cam_t, step: int) -> bool:
   151	        """1003_dynamic-retarget-design.md §2.2 S1: pick a currently-visible distractor (similar
   152	        ones preferred — the hard case) and swap it in as the target via SceneManager.retarget().
   153	        GT-driven (no language): the chosen slot IS the new ground truth, so there is nothing to
   154	        "get wrong" here — this only tests the retarget+override plumbing, not grounding."""
