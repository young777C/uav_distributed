 succeeded in 0ms:
     1	"""Offline projection of 3D vehicle centers -> image pixels, using the camera
     2	pose stored per frame by the recorder (state/cam_*), reproducing CARLA's camera
     3	convention (see carla_uav_tracking/recording/recorder.py:_point_in_frame).
     4	
     5	This lets the layer-16 grounding probe build its candidate set (the target +
     6	every distractor as a box in the image) WITHOUT running CARLA — we only need the
     7	3D positions and camera pose already in the HDF5 file.
     8	
     9	Convention (matches CARLA):
    10	  - camera local frame: x=forward, y=right, z=up
    11	  - a world point p projects to  u = f*(y/x) + W/2 ,  v = f*(-z/x) + H/2
    12	    with f = W / (2*tan(fov/2)),  and is visible iff x>~0 and (u,v) in frame.
    13	  - camera world->local matrix = inverse of CARLA's Transform.get_matrix().
    14	
    15	NOTE: the data stores 3D CENTERS only (no true 2D bbox extents), so each vehicle
    16	becomes a distance-scaled square pseudo-box. If you later record true actor
    17	bounding boxes at generation time, store them as annotation/cand_uv + extents and
    18	`extract_candidates` will prefer them (see `_candidates_from_annotation`).
    19	"""
    20	
    21	from __future__ import annotations
    22	
    23	import math
    24	from dataclasses import dataclass
    25	
    26	import numpy as np
    27	
    28	
    29	# ---------------------------------------------------------------------------
    30	# CARLA transform matrix
    31	# ---------------------------------------------------------------------------
    32	def carla_matrix(x, y, z, pitch, yaw, roll=0.0) -> np.ndarray:
    33	    """CARLA Transform.get_matrix() (local->world), angles in DEGREES."""
    34	    p, yw, r = math.radians(pitch), math.radians(yaw), math.radians(roll)
    35	    cp, sp = math.cos(p), math.sin(p)
    36	    cy, sy = math.cos(yw), math.sin(yw)
    37	    cr, sr = math.cos(r), math.sin(r)
    38	    m = np.eye(4, dtype=np.float64)
    39	    m[0, 0] = cp * cy
    40	    m[0, 1] = cy * sp * sr - sy * cr
    41	    m[0, 2] = -cy * sp * cr - sy * sr
    42	    m[0, 3] = x
    43	    m[1, 0] = cp * sy
    44	    m[1, 1] = sy * sp * sr + cy * cr
    45	    m[1, 2] = -sy * sp * cr + cy * sr
    46	    m[1, 3] = y
    47	    m[2, 0] = sp
    48	    m[2, 1] = -cp * sr
    49	    m[2, 2] = cp * cr
    50	    m[2, 3] = z
    51	    return m
    52	
    53	
    54	def inverse_pose_matrix(x, y, z, pitch, yaw, roll=0.0) -> np.ndarray:
    55	    """World->local (CARLA get_inverse_matrix())."""
    56	    return np.linalg.inv(carla_matrix(x, y, z, pitch, yaw, roll))
    57	
    58	
    59	@dataclass
    60	class Candidate:
    61	    """One projected vehicle in a frame."""
    62	    u: float          # pixel center (in ORIGINAL image space, e.g. 336)
    63	    v: float
    64	    w: float          # pseudo-box width/height (px)
    65	    h: float
    66	    depth: float      # forward distance (m)
    67	    is_target: bool
    68	    idx: int          # -1 for target, else distractor index
    69	
    70	    def frac_box(self, W: int, H: int) -> tuple[float, float, float, float]:
    71	        """(fu0, fv0, fu1, fv1) fractional box in [0,1], clipped to frame."""
    72	        fu0 = max(0.0, (self.u - self.w / 2) / W)
    73	        fv0 = max(0.0, (self.v - self.h / 2) / H)
    74	        fu1 = min(1.0, (self.u + self.w / 2) / W)
    75	        fv1 = min(1.0, (self.v + self.h / 2) / H)
    76	        return fu0, fv0, fu1, fv1
    77	
    78	
    79	def project_point(world_xyz, campose, W, H, fov_deg=90.0):
    80	    """Project a world point. campose=(x,y,z,pitch,yaw[,roll]).
    81	
    82	    Returns (u, v, depth) in pixels, or None if behind the camera.
    83	    """
    84	    if len(campose) == 5:
    85	        campose = (*campose, 0.0)
    86	    M = inverse_pose_matrix(*campose)
    87	    q = M @ np.array([world_xyz[0], world_xyz[1], world_xyz[2], 1.0])
    88	    depth = q[0]
    89	    if depth <= 0.1:
    90	        return None
    91	    f = W / (2.0 * math.tan(math.radians(fov_deg) / 2.0))
    92	    u = f * (q[1] / depth) + W / 2.0
    93	    v = f * (-q[2] / depth) + H / 2.0
    94	    return u, v, depth
    95	
    96	
    97	def _pseudo_box(depth, W, fov_deg, vehicle_size_m, box_min_px, box_max_px):
    98	    """Distance-scaled square box (px) for a vehicle of ~vehicle_size_m."""
    99	    f = W / (2.0 * math.tan(math.radians(fov_deg) / 2.0))
   100	    size = f * vehicle_size_m / max(depth, 0.1)
   101	    return float(np.clip(size, box_min_px, box_max_px))
   102	
   103	
   104	def extract_candidates(ep, i: int, cfg: dict) -> list[Candidate]:
   105	    """Build the candidate list for frame `i` of an open h5 file `ep`.
   106	
   107	    Target from target/{tx,ty,tz}; distractors from distractors/positions[i] (D,6).
   108	    Only in-frame, in-front candidates are returned. Requires the target to be
   109	    in-frame (else returns [] — that frame is unusable for selection).
   110	    """
   111	    img = cfg["image"]
   112	    W, H, fov = img["width"], img["height"], img["fov_deg"]
   113	    campose = (
   114	        float(ep["state/cam_x"][i]), float(ep["state/cam_y"][i]),
   115	        float(ep["state/cam_z"][i]), float(ep["state/cam_pitch"][i]),
   116	        float(ep["state/cam_yaw"][i]),
   117	    )
   118	
   119	    def _mk(world_xyz, is_target, idx):
   120	        pr = project_point(world_xyz, campose, W, H, fov)
   121	        if pr is None:
   122	            return None
   123	        u, v, depth = pr
   124	        if not (0 <= u < W and 0 <= v < H):
   125	            return None
   126	        s = _pseudo_box(depth, W, fov, img["vehicle_size_m"],
   127	                        img["box_min_px"], img["box_max_px"])
   128	        return Candidate(u, v, s, s, depth, is_target, idx)
   129	
   130	    target = _mk(
   131	        (float(ep["target/tx"][i]), float(ep["target/ty"][i]), float(ep["target/tz"][i])),
   132	        True, -1,
   133	    )
   134	    if target is None:                       # target off-screen -> unusable frame
   135	        return []
   136	
   137	    cands = [target]
   138	    if "distractors/positions" in ep:
   139	        dpos = ep["distractors/positions"][i]     # (D, 6)
   140	        for d in range(dpos.shape[0]):

