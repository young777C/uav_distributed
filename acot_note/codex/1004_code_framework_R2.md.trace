    33	
    34	@dataclass
    35	class Observation:
    36	    """Everything the student policy is allowed to see. NO ground truth here."""
    37	    rgb: np.ndarray          # (H, W, 3) uint8 — the ONLY perceptual input
    38	    language: str            # fixed per episode (target identity)
    39	    proprio: np.ndarray      # (5,) [cam_z/30, cam_pitch/90, vx/15, vy/15, vz/15]
    40	    step: int                # tick index → drives the policy's S1/S2 scheduler
    41	    target_color: str = ""   # GT target identity (color, blueprint) for the attrbind tid head —
    42	    target_bp: str = ""      # privileged like the GT candidate boxes; = the offline attr upper bound
    43	    rgb_hi: np.ndarray | None = None   # 1004 opening fix: k× resolution frame of the SAME camera, opening ticks only
    44	    retarget_event: bool = False   # 1003_dynamic-retarget-design.md §2.1: True on the exact tick
    45	                                    # the scene's target was just reassigned (scripted, S1 GT-driven)
    46	
    47	
    48	def _ray_visible(world, cam_loc, xyz, dz=(0.7, 1.4), start_off=1.0, margin=3.0) -> bool:
    49	    """Occlusion check (1004 G13): is a vehicle at ground position `xyz` visible from the camera? Cast rays from the
    50	    camera to points `dz` metres above the vehicle origin (body centre, roof); the vehicle counts as VISIBLE if at
    51	    least one ray reaches within `margin` m of the point unobstructed (hits on the vehicle's own body lie inside the
    52	    margin; buildings, vegetation and OTHER vehicles in front of it occlude). Partial visibility = visible."""
    53	    import carla
    54	    if xyz is None or not np.all(np.isfinite(np.asarray(xyz[:3], float))):
    55	        return False
    56	    c = np.array([cam_loc.x, cam_loc.y, cam_loc.z], float)
    57	    for h in dz:
    58	        p = np.array([float(xyz[0]), float(xyz[1]), float(xyz[2]) + h])
    59	        d = float(np.linalg.norm(p - c))
    60	        if d < start_off + margin:
    61	            return True
    62	        s0 = c + (p - c) / d * start_off
    63	        hits = world.cast_ray(carla.Location(*s0), carla.Location(*p))
    64	        if not any(float(np.linalg.norm(np.array([q.location.x, q.location.y, q.location.z]) - s0)) < d - start_off - margin
    65	                   for q in hits):
    66	            return True
    67	    return False
    68	
    69	
    70	def _build_proprio(drone_state, cam_pitch: float) -> np.ndarray:
    71	    """Replicate dataset_stage2.py:253 proprio (camera frame, 5-D — NOT 8)."""
    72	    v = drone_state.velocity
    73	    return np.array([
    74	        drone_state.position[2] / 30.0,
    75	        cam_pitch / 90.0,
    76	        v[0] / 15.0, v[1] / 15.0, v[2] / 15.0,
    77	    ], dtype=np.float32)
    78	
    79	
    80	def _campose(cam_t) -> tuple:
    81	    return (cam_t.location.x, cam_t.location.y, cam_t.location.z,
    82	            cam_t.rotation.pitch, cam_t.rotation.yaw)
    83	
    84	
    85	class StudentRolloutEnv:
    86	    """Run one closed-loop episode driven by an injected policy (.reset()/.act())."""
    87	
    88	    def __init__(self, scene: SceneManager, world, *, policy, scorer,
    89	                 fps: int = 10, resolution=(512, 512), central_frac: float = 0.3,
    90	                 fov_deg: float = 90.0, expert_control: bool = False,
    91	                 predict_road: bool = False, road_oracle: bool = False,
    92	                 waypoint_offsets_s=(1, 2, 4, 6), vis_raycast: bool = False,
    93	                 retarget_tick: int | None = None, hires_k: int = 1):
    94	        self._scene = scene
    95	        # 1004 G13: ray-cast occlusion flags for target + distractors (shipped to the policy as gt_candidates[4] for
    96	        # occlusion-aware candidates; target visibility also goes to the scorer). Off = legacy frustum-only behaviour.
    97	        self._vis_raycast = bool(vis_raycast)
    98	        # 1004 opening fix: a second camera at hires_k× resolution (same pose / FOV) exists only for the opening ticks
    99	        # (0, 6, 12) and is destroyed afterwards — the policy's zoom-and-verify crops candidates from it.
   100	        self._hires_k = int(hires_k)
   101	        self._world = world
   102	        self._policy = policy          # .reset(); .act(obs, gt_candidates) -> (action4, search_mode, info)
   103	        # P2a-1: when True, compute the deployable road-graph target prediction env-side
   104	        # (rollout.road_predictor, needs carla.Map) and ship it as gt_candidates[3] for the
   105	        # policy's --ex-source road. Off by default → no CARLA-map cost for the other arms.
   106	        self._predict_road = bool(predict_road)
   107	        # road_oracle (P2a-2 positive control): update the road anchor from the TRUE CURRENT
   108	        # target pos EVERY tick (not just visible) → traverse from a fresh anchor (loss_s≈0),
   109	        # bounding road's value if the last-seen staleness + branch error were removed. Still
   110	        # gated the same (applied only during a loss). If oracle-road doesn't beat CV, road is
   111	        # not worth a learned which-way head; if it does, the gap is the learnable target.
   112	        self._road_oracle = bool(road_oracle)
   113	        self._road_offsets_s = list(waypoint_offsets_s)
   114	        self._road = None
   115	        # expert_control: still call the policy for tid SCORING (info.pred_slot), but drive
   116	        # the drone with the EXPERT action (GT+PID, centers the target). Isolates "if framing
   117	        # were perfect, does grounding/SR recover?" — tests the framing→grounding→SR chain.
   118	        self._expert_control = bool(expert_control)
   119	        # 1003_dynamic-retarget-design.md §2.2/§5 S1: scripted single-event retarget, GT-driven
   120	        # (no language yet). At this tick, if a visible distractor exists, swap it in as the new
   121	        # target and flag Observation.retarget_event=True for exactly that tick.
   122	        self._retarget_tick = retarget_tick
   123	        self._scorer = scorer          # .reset(meta); .update(...); .should_truncate(); .finalize()
   124	        self._fps = fps
   125	        self._dt = 1.0 / fps
   126	        self._resolution = resolution
   127	        self._central_frac = central_frac
   128	        self._fov = fov_deg
   129	        self._rec = EpisodeRecorder.__new__(EpisodeRecorder)   # borrow pure helpers, don't run its loop
   130	        self._rec._world = world
   131	        self._rec._scene = scene
   132	        self._rec._resolution = resolution
   133	        self._rec._fov = fov_deg                               # _create_attached_sensor reads this
   134	
   135	    def _target_central(self, cam_t, tpos) -> bool:
   136	        """Target projects into the central `central_frac` box (inlined projection,
   137	        same convention as EpisodeRecorder._point_in_frame — keeps env acot_probe-free)."""
   138	        W, H = self._resolution
   139	        M = np.array(cam_t.get_inverse_matrix())
   140	        q = M @ np.array([float(tpos[0]), float(tpos[1]), float(tpos[2]), 1.0])
   141	        if q[0] <= 0.1:
   142	            return False
   143	        f = W / (2.0 * np.tan(np.radians(self._fov) / 2.0))
   144	        u = f * (q[1] / q[0]) + W / 2.0
   145	        v = f * (-q[2] / q[0]) + H / 2.0
   146	        m = self._central_frac
   147	        return (0.5 - m / 2) * W <= u <= (0.5 + m / 2) * W and \
   148	               (0.5 - m / 2) * H <= v <= (0.5 + m / 2) * H
