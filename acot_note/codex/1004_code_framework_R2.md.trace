   442	    def _reid_motion_score(self, cset):
   443	        """borrow#1 (DeepSORT): SOFT motion-consistency score to FUSE into the reid appearance score
   444	        (pre-EMA). Predicts the target's next image position (constant velocity) from past state and
   445	        softly penalizes candidates far from it → a look-alike spatially inconsistent with the track
   446	        can't win on appearance alone (fixes ours' pure-appearance weakness; DeepSORT had the highest
   447	        external SR). Returns (N,) ~[-∞,0] (0=at prediction), zeros if no prior. State NOT updated here."""
   448	        cands = cset.cands
   449	        if self._reid_mvu is None:
   450	            return np.zeros(len(cands), np.float64)
   451	        pred = self._reid_mvu + (self._reid_mvel if self._reid_mvel is not None else 0.0)
   452	        uv = np.array([[c.u, c.v] for c in cands], np.float64)
   453	        return -np.linalg.norm(uv - pred[None], axis=1) / self.reid_motion_gate_px
   454	
   455	    def _reid_motion_update(self, cset, slot):
   456	        """Update motion state from the seeding slot's image pos (SELECT used PAST state; same
   457	        GT/committed privilege as the gallery). None/loss → hold + keep predicting with velocity."""
   458	        if slot is None or not (0 <= slot < len(cset.cands)):
   459	            return
   460	        c = cset.cands[slot]; nuv = np.array([c.u, c.v], np.float64)
   461	        self._reid_mvel = (nuv - self._reid_mvu) if self._reid_mvu is not None else np.zeros(2)
   462	        self._reid_mvu = nuv
