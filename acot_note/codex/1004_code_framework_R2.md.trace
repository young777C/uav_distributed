   120	        # --- off-screen / truncation bookkeeping ---
   121	        if target_present:
   122	            self._off_run = 0
   123	        else:
   124	            self._off_run += 1
   125	
   126	        # --- mis-follow accounting (only over target-present ticks) ---
   127	        if target_present:
   128	            self._present += 1
