    34	  TOWN=$TOWN TM_PORT=$((TM + 10 * (part - 1))) ASD_CFG=$CFG SRV=it-$NAME CARLA_PORT=$CP GPU=$GPU OUT_NAME=$out \
    35	    SEED_BASE=$((B + done_eps)) EPISODES=$((N - done_eps)) ASD_LOG=$PWD/$L/${NAME}_p$part.jsonl HEAD_ARGS="$HEAD" \
    36	    setsid bash $R/eval_asd.sh > $log 2>&1 < /dev/null &
    37	  EV=$!; last=$(date +%s); seen=0; limit=$FIRST; hung=0
    38	  while kill -0 $EV 2>/dev/null; do
    39	    sleep 30; c=$(grep -cE 'ep[0-9]+ seed' $log)
    40	    if [ "$c" -gt "$seen" ]; then seen=$c; last=$(date +%s); limit=$STALL; fi
    41	    if [ $(( $(date +%s) - last )) -gt $limit ]; then hung=1; break; fi
    42	  done
    43	  if [ $hung = 1 ]; then
    44	    echo "[$(date +%H:%M)] HANG $NAME part$part after $seen eps on CARLA $CP → restart + resume" >> $L/progress.log
    45	    pkill -TERM -s $(ps -o sid= -p $EV | tr -d ' ') 2>/dev/null; kill $EV 2>/dev/null
    46	    docker exec cyh-carla pkill -f "policy-host it-$NAME " ; docker rm -f it-$NAME >/dev/null 2>&1
