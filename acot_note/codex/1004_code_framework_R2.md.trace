   360	    def _reid_select(self, cset, rgb, store_slot=None):
   361	        """Temporal appearance-memory re-ID (reframe → offline milestone: crop-DINOv2 feature +
   362	        K-view gallery breaks the 0.5 wall without resolution). Returns (N,) match scores to the
   363	        stored target gallery, or None if empty.
   364	
   365	        Fair-by-construction (no GT leak): SELECT with the PAST gallery, THEN store this view from
   366	        the GT-identified target (future only). Feature = crop-DINOv2 (instance-discriminative,
   367	        `reid_feature=dinov2`) or the coarse VLM pool (`vlmpool`). Matching = top-m mean over a
   368	        K-view diversity gallery (viewpoint-robust). Ported from train.reid_resolution_probe."""
   369	        from train.reid_resolution_probe import _dino_feats, bank_update, bank_score
   370	        if self.reid_feature == "dinov2":
   371	            W, H = self.image_cfg["width"], self.image_cfg["height"]
   372	            feats = _dino_feats(self._dino, rgb, cset.cands, W, H, 224, 1.3, self.device).astype(np.float64)
   373	        else:
   374	            feats = cset.feats.astype(np.float64)
   375	        fn = feats / (np.linalg.norm(feats, axis=1, keepdims=True) + 1e-8)
   376	        logits = bank_score(self._reid_bank, fn, self.reid_topm) if self._reid_bank else None
   377	        self._reid_fn = fn                                                    # stash for deployable re-anchor re-seed
   378	        # gallery update source: 'committed'=deployable (store the believed-target crop passed as store_slot;
   379	        # GT never touches the template) | 'gt'=legacy oracle-seeded (store the GT target view, future only).
   380	        ss = store_slot if self.gallery_seed == "committed" else \
   381	             (cset.true_idx if (cset.true_idx is not None and cset.true_idx >= 0) else None)
   382	        if ss is not None and 0 <= ss < len(fn):
   383	            bank_update(self._reid_bank, fn[ss], self.reid_bank, 0.9)
   384	        return logits
