    92	    # ------------------------------------------------------------------
    93	    def update(self, *, step: int, target_present: bool, target_central: bool,
    94	               in_loss_window: bool, info, uav_target_dist: float | None = None,
    95	               target_visible: bool | None = None):
    96	        """info: policy.ActInfo (cand_set + pred_slot). target_present: target in-frame."""
    97	        self.n = step + 1
    98	        cset = getattr(info, "cand_set", None)
    99	        pred_slot = getattr(info, "pred_slot", -1)
   100	        pred_cand = cset.cands[pred_slot] if (cset is not None and 0 <= pred_slot < len(cset.cands)) else None
   101	        pred_key = _identity_key(pred_cand) if pred_cand is not None else None
   102	
   103	        # --- hysteresis commit ---
   104	        if pred_key is not None:
   105	            if self._committed is None:
   106	                self._committed = pred_key
   107	            elif pred_key == self._committed:
   108	                self._challenger, self._chal_count = None, 0
   109	            else:
   110	                if pred_key == self._challenger:
   111	                    self._chal_count += 1
   112	                else:
   113	                    self._challenger, self._chal_count = pred_key, 1
   114	                if self._chal_count >= self.commit_k:
   115	                    if self._committed == "target" and pred_key != "target":
   116	                        self._id_switches += 1
   117	                    self._committed = pred_key
   118	                    self._challenger, self._chal_count = None, 0
