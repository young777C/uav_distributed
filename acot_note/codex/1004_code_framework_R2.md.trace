   133	                self._inst_wrong += 1
   134	            # per-frame stratified mis_follow (matches offline argmax≠target over target-present)
   135	            ti = getattr(cset, "true_idx", -1) if cset is not None else -1
   136	            if cset is not None and ti >= 0:
   137	                N = len(cset.cands)
   138	                wrong = int(pred_slot != ti)
   139	                nb = min(N, 6)
   140	                b = self._byN.setdefault(nb, [0, 0]); b[0] += wrong; b[1] += 1
   141	                ck = "central" if target_central else "off"
   142	                self._byC[ck][0] += wrong; self._byC[ck][1] += 1
   143	                td = float(cset.cands[ti].depth)
   144	                db = "d<30" if td < 30 else ("d30-60" if td < 60 else "d>=60")
   145	                bd = self._byD.setdefault(db, [0, 0]); bd[0] += wrong; bd[1] += 1
   146	            committed_wrong = self._committed is not None and self._committed != "target"
   147	            if target_visible is not None:
   148	                self._vis_measured = True
   149	                if target_visible:
   150	                    self._present_vis += 1

