   419	    def _cold_vote(self, aidx, lang_logits, lang_slot):
   420	        """V2: one tempered, rank-weighted language vote per tick; returns the slot of argmax_k G_k (visible)."""
   421	        l = np.asarray(lang_logits, np.float64); srt = np.sort(l)
   422	        m = float(srt[-1] - srt[-2]) if l.size >= 2 else 0.0
   423	        h = self._cold_hist; rho = float(np.searchsorted(np.sort(h), m)) / len(h) if len(h) >= 2 else 0.5
   424	        self._cold_hist = h + [m]
   425	        for k in self._cold_G:
   426	            self._cold_G[k] *= self.cold_lambda
   427	        a = int(aidx[lang_slot]); self._cold_G[a] = self._cold_G.get(a, 0.0) + 0.5 + rho
   428	        return max(range(len(aidx)), key=lambda s_: self._cold_G.get(int(aidx[s_]), 0.0))
