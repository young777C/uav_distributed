   399	    def _asd_gate_memory(self, slot, which=None):
   400	        """Posterior-gated memory update: redo this tick's update with the filter's MAP crop (tah); reid's gallery
   401	        already stores the COMMITTED identity, which is overridden by the caller; dam4sam (V1): re-init SAM2 on the
   402	        filter's MAP candidate box (drops its RAM/DRM), with a pre-registered 3-tick cooldown."""
   403	        which = which or self.tid_head
   404	        if which == "dam4sam" and self._dam4sam_rgb is not None and self._cand_set_cur is not None \
   405	           and self._dam4sam_cool == 0:
   406	            from rollout.bridge import send_msg, recv_msg
   407	            c = self._cand_set_cur.cands[slot]
   408	            send_msg(self._dam4sam_sock, {"cmd": "init", "rgb": np.asarray(self._dam4sam_rgb, np.uint8),
   409	                                          "box": (c.u - c.w / 2.0, c.v - c.h / 2.0, c.w, c.h)})
   410	            recv_msg(self._dam4sam_sock)
   411	            self._dam4sam_cool = 3
   412	            return
   413	        if which in ("tah", "fusion") and self._tah_last is not None:
   414	            feat, pos = self._tah_last
   415	            prev = getattr(self, "_tah_mem_prev", None)
   416	            prev = prev if prev is not None else self._tah.reset(self.device)
   417	            self._tah_mem = self._tah.update(prev, feat[slot], pos[slot])
