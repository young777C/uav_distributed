   159	            if not np.all(np.isfinite(dstates[d, :3])):
   160	                continue
   161	            if self._rec._point_in_frame(cam_t, dstates[d, :3]):
   162	                return bool(self._scene.retarget(d, tick=step))
   163	        return False      # no visible distractor at this tick — event does not fire (not retried in S1)
