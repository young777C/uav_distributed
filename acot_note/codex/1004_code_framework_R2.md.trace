    48	  fi
    49	  wait $EV 2>/dev/null
    50	  k=$(count_done $EO/$out.json); done_eps=$((done_eps + k)); part=$((part + 1))
    51	  if [ $hung = 0 ] && [ "$k" = 0 ] && [ $done_eps -lt $N ]; then
    52	    # client died without finishing an episode (e.g. simulator time-out after a mid-tick client death leaves the
    53	    # sync-mode server wedged) → restart the server before the next part instead of reconnecting to a dead one
    54	    echo "[$(date +%H:%M)] FAILED-0ep $NAME part$((part - 1)) on CARLA $CP → restart CARLA + resume" >> $L/progress.log
    55	    docker exec cyh-carla pkill -f "policy-host it-$NAME " ; docker rm -f it-$NAME >/dev/null 2>&1
    56	    restart_carla
    57	  fi
    58	  [ $part -gt $((P0 + 5)) ] && { echo "[$(date +%H:%M)] GIVE UP $NAME after 5 restarts" >> $L/progress.log; break; }
    59	done
    60	python3 - $EO/paper_it_$NAME.json $parts <<'EOF'
    61	import glob, json, os, re, sys
    62	out = sys.argv[1]; eps = []
    63	# merge EVERY part of this arm (incl. parts written by an earlier invocation before a resume), ordered by part number
    64	parts = sorted({re.sub(r"\.partial$", "", p) for p in glob.glob(out[:-5] + "_p[0-9]*.json*")},
    65	               key=lambda p: int(re.search(r"_p(\d+)\.json$", p).group(1)))
    66	for p in parts:
    67	    for f in (p, p + ".partial"):
    68	        if os.path.exists(f):
    69	            eps += json.load(open(f))["episodes"]; break
    70	json.dump({"episodes": eps, "merged_from": parts}, open(out, "w"), indent=2, default=str)
    71	print(f"merged {len(eps)} episodes -> {out}")
    72	EOF
    73	echo "[$(date +%H:%M)] done  $NAME :: $done_eps eps this run (from part $P0), $(cat $L/${NAME}_p*.log | grep -c SKIP) skip total, parts=$((part - 1))" >> $L/progress.log

