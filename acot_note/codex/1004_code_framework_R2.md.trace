   464	    def _assoc_select(self, cset, rgb, init_slot=None):
   465	        """EXTERNAL BASELINE: DeepSORT/OC-SORT-style tracking-by-detection association.
   466	        Motion (constant-velocity image-space prediction + gate) + optional appearance (crop-DINOv2
   467	        cosine to an EMA template). SELECT with the PAST track state, THEN update from the GT-visible
   468	        target (same oracle-seed privilege as reid's gallery → fair). Contrast to reid: an explicit
   469	        motion model + per-frame argmin vs appearance gallery + temporal-EMA. assoc_mode: 'motion'
   470	        (OC-SORT-like, no appearance) | 'deepsort' (motion+appearance). Returns (N,) scores."""
   471	        cands = cset.cands
   472	        uv = np.array([[c.u, c.v] for c in cands], np.float64)          # candidate image positions
   473	        n = len(cands)
   474	        if self._assoc_uv is not None:                                  # motion: predict + gate
   475	            pred = self._assoc_uv + (self._assoc_vel if self._assoc_vel is not None else 0.0)
   476	            dist = np.linalg.norm(uv - pred[None], axis=1)
   477	            score = -dist / self.assoc_gate_px                          # higher = closer
   478	            gate = dist < self.assoc_gate_px
   479	        else:
   480	            score = np.zeros(n); gate = np.ones(n, bool)
   481	        fn = None
   482	        if self.assoc_mode == "deepsort":                              # + appearance cosine
   483	            from train.reid_resolution_probe import _dino_feats
   484	            W, H = self.image_cfg["width"], self.image_cfg["height"]
   485	            feats = _dino_feats(self._dino, rgb, cands, W, H, 224, 1.3, self.device).astype(np.float64)
   486	            fn = feats / (np.linalg.norm(feats, axis=1, keepdims=True) + 1e-8)
   487	            if self._assoc_feat is not None:
   488	                score = score + self.assoc_lambda * (fn @ self._assoc_feat)
   489	        if self._assoc_uv is not None and gate.any():                  # hard motion gate (fall back if empty)
   490	            score = np.where(gate, score, -1e9)
   491	        # UPDATE track state. gallery_seed='gt' (oracle, legacy): from the GT target. 'committed' (DEPLOYABLE, GT-free):
   492	        # from the tracker's OWN association this tick (language pick at cold start, before any track state exists).
   493	        # SELECT always used the PAST state.
   494	        if self.gallery_seed == "committed":
   495	            if self._assoc_uv is None:
   496	                ti = init_slot
   497	            else:
   498	                ti = int(score.argmax()) if float(score.max()) > -1e8 else None   # no gated match → hold state
   499	        else:
   500	            ti = cset.true_idx
   501	        if ti is not None and ti >= 0:
   502	            self._assoc_vel = (uv[ti] - self._assoc_uv) if self._assoc_uv is not None else np.zeros(2)
   503	            self._assoc_uv = uv[ti].copy()
   504	            if fn is not None:
   505	                t = fn[ti]
   506	                self._assoc_feat = t if self._assoc_feat is None else \
   507	                    (0.9 * self._assoc_feat + 0.1 * t) / (np.linalg.norm(0.9 * self._assoc_feat + 0.1 * t) + 1e-8)
   508	        return score.astype(np.float32)
