   510	    def _dam4sam_select(self, cset, rgb, init_slot=None):
   511	        """EXTERNAL BASELINE: DAM4SAM (CVPR'25 SOTA distractor-aware SAM2 memory) as the WHICH module,
   512	        served over a socket bridge (separate torch2.1/SAM2 env). On the first target-visible frame,
   513	        init the tracker with the GT target box (same oracle-seed privilege as reid/assoc); each S2
   514	        tick, track → predicted target box → assign the candidate whose center is nearest (within a
   515	        gate) → pred_slot. Returns (N,) scores (higher=nearer the DAM4SAM box); -1e9 gate for far."""
   516	        from rollout.bridge import send_msg, recv_msg
   517	        cands = cset.cands
   518	        n = len(cands)
   519	        # init box: gallery_seed='gt' (oracle, legacy) = GT target box; 'committed' (DEPLOYABLE) = the language pick's box
   520	        ti = init_slot if self.gallery_seed == "committed" else cset.true_idx
   521	        bbox = None
   522	        if not self._dam4sam_inited:
   523	            if ti is not None and ti >= 0:                              # init from the chosen target box
   524	                c = cands[ti]
   525	                box = (c.u - c.w / 2.0, c.v - c.h / 2.0, c.w, c.h)
   526	                send_msg(self._dam4sam_sock, {"cmd": "init", "rgb": np.asarray(rgb, np.uint8), "box": box})
   527	                bbox = recv_msg(self._dam4sam_sock).get("bbox")
   528	                self._dam4sam_inited = True
   529	                self._dam4sam_iou = 0.5                                 # init frame: no predicted IoU yet
   530	            else:
   531	                self._dam_log(cset, "no_init", None, None)
   532	                return np.full(n, -1e9, np.float32)                     # target never seen yet → no pick
   533	        else:
   534	            send_msg(self._dam4sam_sock, {"cmd": "track", "rgb": np.asarray(rgb, np.uint8)})
   535	            resp = recv_msg(self._dam4sam_sock); bbox = resp.get("bbox")
   536	            iou = resp.get("iou")
   537	            self._dam4sam_iou = float(iou) if iou is not None and iou == iou else 0.0   # SAM2 predicted IoU = confidence
   538	        self._dam4sam_rgb = rgb                                         # for the PGIF reset hook (re-init on ŝ)
   539	        self._dam4sam_cool = max(0, getattr(self, "_dam4sam_cool", 0) - 1)
   540	        if bbox is None:
   541	            self._dam_log(cset, "empty", None, None)
   542	            return np.full(n, -1e9, np.float32)                         # lost (empty mask) → hold
   543	        bx, by, bw, bh = bbox
   544	        pc = np.array([bx + bw / 2.0, by + bh / 2.0])                   # DAM4SAM predicted center
   545	        uv = np.array([[c.u, c.v] for c in cands], np.float64)
   546	        dist = np.linalg.norm(uv - pc[None], axis=1)
   547	        gate = float(self.assoc_gate_px)
   548	        self._dam_log(cset, "pick" if float(dist.min()) < gate else "gate", dist, bbox)
   549	        return np.where(dist < gate, -dist / gate, -1e9).astype(np.float32)
   550	
   551	    def _dam_log(self, cset, reason, dist, bbox):
   552	        """DAM4SAM abstention diagnosis record (offline scoring only: true_idx is NOT used by any decision)."""
   553	        if self._dam_diag is None:
   554	            return
   555	        ti = cset.true_idx if cset.true_idx is not None else -1
   556	        rec = {"ep": self._dam_ep, "k": self._dam_k, "reason": reason, "n": len(cset.cands), "true": int(ti),
   557	               "inited": bool(self._dam4sam_inited), "iou": round(float(self._dam4sam_iou), 4),
   558	               "ef_n": self._dam_ef_n, "ef_empty": self._dam_ef_empty}
   559	        if dist is not None:
   560	            j = int(dist.argmin())
   561	            rec.update(nearest=j, d_min=round(float(dist[j]), 1), nearest_is_true=bool(j == ti),
   562	                       d_true=round(float(dist[ti]), 1) if ti >= 0 else None,
   563	                       box_wh=[round(float(bbox[2]), 1), round(float(bbox[3]), 1)])
   564	        self._dam_diag.write(json.dumps(rec) + "\n"); self._dam_diag.flush()
   565	        self._dam_k += 1
   566	
   567	    def _update_commit(self, cset):
   568	        """Commit the tid-selected candidate IDENTITY with K-frame hysteresis (Plan A).
   569	        A challenger identity must win commit_k consecutive S2 ticks to take over; during
   570	        a loss (no valid pick) the current commitment is held."""
   571	        sel = None
   572	        if cset is not None and 0 <= self._pred_slot < len(cset.cands):
   573	            sel = int(cset.cands[self._pred_slot].idx)          # -1 = target, else distractor idx
   574	        if sel is None:
   575	            return                                              # loss -> hold commitment
   576	        if self._committed_idx is None or sel == self._committed_idx:
   577	            self._committed_idx = sel; self._chal = None; self._chal_n = 0
   578	        else:
   579	            self._chal_n = self._chal_n + 1 if sel == self._chal else 1
   580	            self._chal = sel
   581	            if self._chal_n >= self.commit_k:
   582	                self._committed_idx = sel; self._chal = None; self._chal_n = 0
   583	
   584	    def _committed_slot(self, cset):
   585	        """Candidate slot of the currently committed identity this frame (None if not visible / uncommitted).
   586	        Deployable gallery seeds its template from THIS crop — the identity we believe, never GT."""
   587	        if self._committed_idx is None or cset is None:
   588	            return None
   589	        for s, c in enumerate(cset.cands):
   590	            if int(c.idx) == int(self._committed_idx):
   591	                return s
   592	        return None
   593	
   594	    def _committed_world(self, tpos, dstates):
   595	        """World position of the committed identity (GT position; the IDENTITY is tid's)."""
   596	        if self._committed_idx is None:
   597	            return None
   598	        if self._tracker is not None or self.occl_cands:
   599	            # deployable v2: localise the committed identity ONLY through a box matched to it THIS tick (ideal
   600	            # localisation of a visible box); unmatched / occluded → None (the estimator coasts on CV).
   601	            cs = self._cand_set
   602	            c = next((c for c in (cs.cands if cs is not None else []) if int(c.idx) == int(self._committed_idx)), None)
   603	            if c is None:
   604	                return None
   605	            gi = int(getattr(c, "gt_idx", c.idx))
   606	            if gi < 0:
   607	                return np.asarray(tpos, np.float64)
   608	            ds = np.asarray(dstates)
   609	            return np.asarray(ds[gi][:3], np.float64) if gi < ds.shape[0] else None
   610	        if self._committed_idx < 0:
   611	            return np.asarray(tpos, np.float64)
   612	        ds = np.asarray(dstates)
   613	        return np.asarray(ds[self._committed_idx][:3], np.float64) if self._committed_idx < ds.shape[0] else None
   614	
   615	    def _in_frame(self, world_xyz, campose):
   616	        from acot_probe.projection import project_point
   617	        W = self.image_cfg["width"]; H = self.image_cfg["height"]; fov = self.image_cfg["fov_deg"]
   618	        pr = project_point(tuple(float(x) for x in world_xyz), tuple(float(x) for x in campose), W, H, fov)
   619	        if pr is None:
   620	            return False
   621	        u, v, _ = pr
   622	        return bool(0 <= u < W and 0 <= v < H)
   623	
   624	    @torch.no_grad()
   625	    def act(self, obs: Observation, gt_candidates) -> tuple[tuple, float, ActInfo]:

