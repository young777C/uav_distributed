   332	    def _dagger_flush(self):
   333	        """Write the finished episode's collected frames to DAGGER_DIR (one .npz/episode)."""
   334	        if not self._dagger_dir or not getattr(self, "_dagger_buf", None):
   335	            return
   336	        os.makedirs(self._dagger_dir, exist_ok=True)
   337	        feats = [b[0] for b in self._dagger_buf]           # list of (N_i, C) — ragged
   338	        tgt = np.array([b[1] for b in self._dagger_buf], np.int64)
   339	        col = np.array([b[2] for b in self._dagger_buf])
   340	        mk = np.array([b[3] for b in self._dagger_buf])
   341	        n = np.array([f.shape[0] for f in feats], np.int64)
   342	        out = os.path.join(self._dagger_dir, f"dagger_ep{self._dagger_ep:04d}.npz")
   343	        np.savez_compressed(out, feats=np.concatenate(feats, 0).astype(np.float16),
   344	                            n=n, true_idx=tgt, color=col, make=mk)
   345	        print(f"[dagger] wrote {out}  ({len(feats)} frames)", flush=True)
   346	        self._dagger_ep += 1
