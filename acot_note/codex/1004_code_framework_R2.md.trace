   386	    def _asd_feats(self, cset, rgb):
   387	        """ASD appearance view of the candidates: reuse the active memory's frozen crop-DINOv2 feats when it
   388	        computed them this tick (tah / reid-dinov2), else compute them (memory-agnostic)."""
   389	        if self.tid_head == "tah" and self._asd_fe is not None:
   390	            return self._asd_fe
   391	        if self.tid_head == "reid" and self.reid_feature == "dinov2" and self._reid_fn is not None \
   392	           and len(self._reid_fn) == len(cset.cands):
   393	            return self._reid_fn
   394	        from train.reid_resolution_probe import _dino_feats
   395	        W, H = self.image_cfg["width"], self.image_cfg["height"]
   396	        fe = _dino_feats(self._dino, rgb, cset.cands, W, H, 224, 1.3, self.device).astype(np.float64)
   397	        return fe / (np.linalg.norm(fe, axis=1, keepdims=True) + 1e-8)
