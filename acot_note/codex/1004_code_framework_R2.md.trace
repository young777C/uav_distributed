     3	# one, incl. server start-up), kill the arm, restart its CARLA server and RESUME from the next unfinished seed.
     4	# Parts are saved separately (paper_it_<name>_p<k>.json[.partial], <name>_p<k>.jsonl) and merged into paper_it_<name>.json.
     5	#   usage: launch_wd.sh <name> <carla_port> <gpu> <tm_port> <town> <head_args> [asd_cfg]
     6	# env: SEED_BASE (91000) EPISODES (20) STALL_MIN (12) FIRST_MIN (20) + COLD_*/V1_SELFRESET passthrough
     7	cd /nvidia/hque/code/cyhe/uav-acot-track; R=carla_uav_tracking/rollout; L=runs/asd/iter; EO=$R/eval_out
     8	NAME=$1; CP=$2; GPU=$3; TM=$4; TOWN=$5; HEAD=$6; CFG=${7:-}
     9	B=${SEED_BASE:-91000}; N=${EPISODES:-20}; STALL=$(( ${STALL_MIN:-12} * 60 )); FIRST=$(( ${FIRST_MIN:-20} * 60 ))
    10	declare -A ADAPTER=([2000]=0 [2010]=2 [2020]=3 [2040]=5 [2030]=4 [2050]=6 [2060]=7 [2070]=0 [2080]=3 [2090]=5 [2230]=0 [2250]=3)
    11	restart_carla() {
    12	  docker exec cyh-carla pkill -9 -f "carla-rpc-port=$CP( |$)" ; sleep 5
    13	  docker exec -d cyh-carla bash -c "/home/carla/CarlaUE4.sh -RenderOffScreen -graphicsadapter=${ADAPTER[$CP]} -carla-rpc-port=$CP -nosound -fps=20 > /tmp/carla_$CP.log 2>&1"
    14	  for i in $(seq 1 60); do
    15	    docker exec cyh-carla python -c "import socket;s=socket.socket();s.settimeout(2);s.connect(('127.0.0.1',$CP))" 2>/dev/null && break; sleep 10
    16	  done; sleep 20
    17	  docker exec cyh-carla python -c "import carla;c=carla.Client('127.0.0.1',$CP);c.set_timeout(180);c.load_world('$TOWN')" \
    18	    && echo "[$(date +%H:%M)] CARLA $CP restarted, $TOWN preloaded" >> $L/progress.log
    19	}
    20	count_done() { python3 - "$1" <<'EOF'
    21	import json, os, sys
    22	p = sys.argv[1]
    23	for f in (p, p + ".partial"):
