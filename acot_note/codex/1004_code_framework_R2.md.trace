    80	def main() -> int:
    81	    ap = argparse.ArgumentParser()
    82	    ap.add_argument("--policy-host", default="acot-policy-server")
    83	    ap.add_argument("--policy-port", type=int, default=5555)
    84	    ap.add_argument("--carla-port", type=int, default=int(os.environ.get("CARLA_PORT", "2012")))
    85	    ap.add_argument("--episodes", type=int, default=5)
    86	    ap.add_argument("--seed-base", type=int, default=90000)
    87	    ap.add_argument("--steps", type=int, default=1500)
    88	    ap.add_argument("--town", default=None)
    89	    ap.add_argument("--out", default=None)
    90	    ap.add_argument("--expert-control", action="store_true",
    91	                    help="drive the drone with the EXPERT action (well-framed) while still "
    92	                         "scoring the policy's tid — tests the framing→grounding→SR chain")
    93	    ap.add_argument("--predict-road", action="store_true",
    94	                    help="P2a-1: compute env-side road-graph target prediction (carla.Map lane "
    95	                         "traversal) → gt_candidates[3]. MUST pair with the policy server's "
    96	                         "--ex-source road; a no-op for the ear/cv_gated arms.")
    97	    ap.add_argument("--road-oracle", action="store_true",
    98	                    help="P2a-2 positive control: anchor the road prediction at the TRUE CURRENT "
    99	                         "target pos every tick (bounds road's value if last-seen staleness+branch "
   100	                         "error were removed). Implies --predict-road; pair with --ex-source road.")
   101	    ap.add_argument("--vis-raycast", action="store_true",
   102	                    help="1004 G13: ray-cast occlusion flags (target + distractors) → policy (gt_candidates[4]) and "
   103	                         "scorer (visible-frame metrics)")
   104	    ap.add_argument("--retarget-tick", type=int, default=None,
   105	                    help="1003_dynamic-retarget-design.md S1: at this tick, swap in a currently-visible "
   106	                         "distractor as the new GT target (scripted, single event/episode) and flag "
   107	                         "Observation.retarget_event for that tick. Pair with the policy server's "
   108	                         "--event-override. None=off (default, no behavior change).")
   109	    ap.add_argument("--hires", type=int, default=1,
   110	                    help="1004 opening fix: k× resolution opening camera (ticks 0/6/12) for zoom-and-verify crops")
   111	    a = ap.parse_args()
   112	
   113	    cfg = load_config()
   114	    if a.town:   # evaluation on a town outside the data-gen list (e.g. held-out Town03): keep the scene manager on it
   115	        towns = cfg.setdefault("environment", {}).setdefault("towns", [])
   116	        if a.town not in towns:
   117	            towns.append(a.town)
   118	    client = carla.Client("127.0.0.1", a.carla_port)
   119	    client.set_timeout(60.0)   # first load_world after a fresh CARLA boot is slow (port-open != ready)
   120	    world = client.load_world(a.town) if a.town else client.get_world()
   121	    print(f"[rollout] map={world.get_map().name} policy={a.policy_host}:{a.policy_port} "
   122	          f"episodes={a.episodes}", flush=True)
   123	
   124	    policy = RemotePolicy(a.policy_host, a.policy_port)
   125	    rows = []
   126	    try:
   127	        for ep in range(a.episodes):
   128	            cfg.setdefault("environment", {})["seed"] = a.seed_base + ep
   129	            scene = SceneManager(world, cfg, client)
   130	            scorer = RolloutScorer(fps=10, max_lost_s=cfg["environment"].get("max_lost_seconds", 5))
   131	            env = StudentRolloutEnv(scene, world, policy=policy, scorer=scorer,
   132	                                    fps=10, resolution=(512, 512), expert_control=a.expert_control,
   133	                                    predict_road=a.predict_road or a.road_oracle,
   134	                                    road_oracle=a.road_oracle, vis_raycast=a.vis_raycast, hires_k=a.hires,
   135	                                    retarget_tick=a.retarget_tick)
   136	            summary = env.run(max_steps=a.steps)
   137	            rows.append(summary)
   138	            tag = "SKIP" if summary.get("skipped") else (
   139	                "OK" if summary.get("success") else "FAIL")
   140	            print(f"[rollout] ep{ep} seed={a.seed_base+ep} [{tag}] "
   141	                  f"mis_follow_sus={summary.get('mis_follow_sustained')} "
   142	                  f"track_s={summary.get('track_seconds')}", flush=True)
   143	            if a.out:   # incremental save: a simulator crash mid-run no longer loses the finished episodes
   144	                with open(a.out + ".partial", "w") as f:
   145	                    json.dump({"aggregate": _aggregate(rows), "episodes": rows, "partial": True}, f, indent=2, default=str)
   146	    finally:
   147	        policy.close()
   148	
   149	    agg = _aggregate(rows)
   150	    print("\n[rollout] AGGREGATE:")
   151	    for k, v in agg.items():
   152	        print(f"    {k}: {v}")
   153	    if a.out:
   154	        with open(a.out, "w") as f:
   155	            json.dump({"aggregate": agg, "episodes": rows}, f, indent=2, default=str)
   156	        print(f"[rollout] wrote {a.out}")
   157	    return 0
   158	
   159	
   160	if __name__ == "__main__":
   161	    raise SystemExit(main())
     1	"""RolloutScorer — score a closed-loop episode from GT, per guide §6 / design §7.2.
     2	
     3	The controller never sees GT; the scorer does, every tick. Key rule (§3.4 族B, §7):
     4	closed-loop mis-follow is NOT per-frame argmax (that punishes single-frame flicker
     5	from flow-matching stochasticity). We maintain a COMMITTED target with K-frame
     6	hysteresis; a new candidate only takes over after winning K consecutive ticks.
     7	
     8	Reported:
     9	  mis_follow_inst      per-tick argmax≠target over target-present ticks (diagnostic, strict)
    10	  mis_follow_sustained committed≠target over target-present ticks (main; == MOT ID-switch)
    11	  id_switches          # times the committed target flips to a wrong car (held ≥K)
    12	  success              reached episode end with no committed-wrong run ≥ T_fail_s and
    13	                       never lost the target past truncation
    14	  track_frames         ticks the target stayed in frame
    15	  centering_rate       fraction of in-frame ticks with the target in the central region
    16	  reacquire_*          convergence time (delay OK) vs lock-wrong rate (hard failure, §7)
    17	  shortcut_*           "always nearest car" / "target dead-center" occupancy (捷径 checks, §7)
    18	
    19	The scorer maps the policy's predicted candidate SLOT → identity via the shuffled
    20	CandidateSet (cands[slot].is_target / .idx); it does not read any slot ordering
    21	into the control path.
    22	"""
    23	
    24	from __future__ import annotations
    25	
    26	import numpy as np
    27	
    28	
    29	def _identity_key(cand) -> str:
    30	    # GT identity for SCORING: when the policy re-keys candidates with GT-free tracker ids (1004 deployable v2),
    31	    # the simulator actor index is kept in `gt_idx`; the scorer always judges against the true actor.
    32	    return "target" if cand.is_target else f"distractor_{getattr(cand, 'gt_idx', cand.idx)}"
    33	
    34	
    35	class RolloutScorer:
    36	    def __init__(self, fps: int = 10, commit_k: int = 5, t_fail_s: float = 2.0,
    37	                 max_lost_s: float = 5.0, central_frac: float = 0.3):
    38	        self.fps = fps
    39	        self.commit_k = commit_k
    40	        self.t_fail = int(t_fail_s * fps)
    41	        self.max_lost = int(max_lost_s * fps)
    42	        self.central_frac = central_frac
    43	
    44	    def reset(self, metadata: dict | None = None):
    45	        self.meta = metadata or {}
    46	        self.n = 0
    47	        # committed-target hysteresis
    48	        self._committed = None
    49	        self._challenger = None
    50	        self._chal_count = 0
    51	        self._id_switches = 0
    52	        self._wrong_run = 0          # consecutive committed-wrong ticks (target present)
    53	        self._max_wrong_run = 0
    54	        self._correct_run = 0           # committed==target consecutive in-frame ticks (symmetric to wrong run)
    55	        self._max_correct_run = 0
    56	        self._off_run = 0            # consecutive target-off-screen ticks
    57	        self._failed = False
    58	        # counters
