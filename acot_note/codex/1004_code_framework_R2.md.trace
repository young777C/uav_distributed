   100	
   101	def rel(p):
   102	    return os.path.relpath(p, ROOT)
   103	
   104	
   105	def lit(node):
   106	    if node is None:
   107	        return "REQUIRED"
   108	    try:
   109	        return repr(ast.literal_eval(node))
   110	    except Exception:
   111	        return ast.unparse(node) if hasattr(ast, "unparse") else "<expr>"
   112	
   113	
   114	def classify(name, f=""):
   115	    if name in TEST:
   116	        return "test"
   117	    if name in INJECTED:
   118	        return "injected"
   119	    if name in INFRA:
   120	        return "infra"
   121	    if name in COLLECT:
   122	        return "collection"
   123	    if name in DIAG:
   124	        return "diagnostic"
   125	    if name in DIAG_VALUE:
   126	        return DIAG_VALUE[name]
   127	    if any(k in f for k in OFFLINE_FILES):
   128	        return "offline"
   129	    return "scientific"
   130	
   131	
   132	def argparse_rows():
   133	    rows = []
   134	    for f in ARGPARSE_FILES:
   135	        p = os.path.join(ROOT, f)
   136	        if not os.path.exists(p):
   137	            continue
   138	        for n in ast.walk(ast.parse(open(p).read())):
   139	            if isinstance(n, ast.Call) and getattr(n.func, "attr", "") == "add_argument":
   140	                names = [a.value for a in n.args if isinstance(a, ast.Constant) and isinstance(a.value, str)]
   141	                kw = {k.arg: k.value for k in n.keywords}
   142	                if "default" in kw:
   143	                    d = lit(kw["default"])
   144	                elif "action" in kw and lit(kw["action"]) == "'store_true'":
   145	                    d = "False"
   146	                else:
   147	                    d = "—"
   148	                flag = next((x for x in names if x.startswith("--")), names[0] if names else "?")
   149	                rows.append((f"{f}:{n.lineno}", flag, d, classify(flag, f)))
   150	    return rows
   151	
   152	
   153	def signature_rows():
   154	    rows = []
   155	    for f, cname, meth, src in SIGNATURES:
   156	        for n in ast.walk(ast.parse(open(os.path.join(ROOT, f)).read())):
   157	            if isinstance(n, ast.ClassDef) and n.name == cname:
   158	                for m in n.body:
   159	                    if isinstance(m, ast.FunctionDef) and m.name == meth:
   160	                        pos = m.args.args[1:]
   161	                        pdef = [None] * (len(pos) - len(m.args.defaults)) + list(m.args.defaults)
   162	                        for a, d in list(zip(pos, pdef)) + list(zip(m.args.kwonlyargs, m.args.kw_defaults)):
   163	                            rows.append((f"{f}:{m.lineno}", src, a.arg, lit(d), classify(a.arg, f)))
   164	    p = os.path.join(ROOT, f"{R}/policy.py")
   165	    for i, line in enumerate(open(p), 1):
   166	        for k, d in re.findall(r'ocfg\.pop\("(\w+)",\s*([^)]+)\)', line):
   167	            rows.append((f"{R}/policy.py:{i}", "OPENING_CFG (popped by Policy)", k, d.strip(), "scientific"))
   168	    return rows
   169	
   170	
   171	DYNAMIC = []   # os.environ[<variable>] = ... (key not a literal)
   172	
   173	
   174	def env_rows():
   175	    rows = {}
   176	    rd = re.compile(r"""os\.(?:environ\.get|getenv)\(\s*['"](\w+)['"]\s*(?:,\s*([^)]*))?\)|os\.environ\[\s*['"](\w+)['"]\s*\](?!\s*=[^=])""")
   177	    wr = re.compile(r"""os\.environ\[\s*['"](\w+)['"]\s*\]\s*=[^=]|os\.environ\.setdefault\(\s*['"](\w+)['"]""")
   178	    dyn = re.compile(r"""os\.environ\[\s*([A-Za-z_]\w*)\s*\]\s*=[^=]""")
   179	    for g in ENV_GLOBS:
   180	        for p in sorted(glob.glob(os.path.join(ROOT, g))):
   181	            if "/pydeps/" in p:
   182	                continue
   183	            for i, line in enumerate(open(p, errors="ignore"), 1):
   184	                for m in rd.finditer(line):
   185	                    var = m.group(1) or m.group(3)
   186	                    rows.setdefault(var, []).append((f"{rel(p)}:{i}", "read", (m.group(2) or "").strip() or "—"))
   187	                for m in wr.finditer(line):
   188	                    var = m.group(1) or m.group(2)
   189	                    rows.setdefault(var, []).append((f"{rel(p)}:{i}", "WRITE", "—"))
   190	                for m in dyn.finditer(line):
   191	                    DYNAMIC.append((f"{rel(p)}:{i}", m.group(1)))
   192	    return rows
   193	
   194	
   195	def launcher_rows():
   196	    rows = []
   197	    for g in LAUNCHER_GLOBS:
   198	        for p in sorted(glob.glob(os.path.join(ROOT, g))):
   199	            txt = open(p, errors="ignore").read()
   200	            if "ticker" in os.path.basename(p) or "codex_review" in p:
   201	                continue
   202	            knobs = sorted(set(re.findall(r"\$\{([A-Za-z_]\w*)(?::?[-?+=])", txt)))
   203	            pos = sorted(set(re.findall(r"\$\{?([1-9])\b", txt)))
   204	            me = os.path.basename(p)
   205	            calls = [c for c in ("eval_asd.sh", "eval_tah.sh", "launch_wd.sh", "launch.sh", "policy_server.py",
   206	                                 "run_rollout.py", "generate_batch", "tah_cache.py", "tah_train.py", "tah_merge.py",
   207	                                 "stage2.py", "backbone_kv.py", "opening_", "dam4sam_service.py")
   208	                     if c in txt and c != me]
   209	            docker = [d for d in ("docker run", "docker exec", "docker rm", "docker compose") if d in txt]
   210	            flags = sorted(set(re.findall(r"(--(?:tid-head|tah-ckpt|asd|asd-cfg|tracklets|occl-cands|vis-raycast|hires|"
   211	                                          r"gallery-seed|conf-tau|reanchor|commit-k|s2-period|ex-source|assoc-mode|"
   212	                                          r"reid-[a-z-]+|warmup-oracle-s|event-override)\b)", txt)))
   213	            envs = sorted(set(re.findall(r"\b(ASD_CFG|TRK_CFG|OPENING_CFG|OPENING|ORACLE_ABSENT|TAH_DAGGER_DIR|"
   214	                                         r"COLD_WINDOW|COLD_LAMBDA|COLD_SINGLE|V1_SELFRESET|DAM4SAM_EVERY_FRAME|HIRES|"
   215	                                         r"VIS_RAYCAST|S2_PERIOD|SEED_BASE|EPISODES|STEPS|TOWN)=(?![\"']?\$\{\1\b)", txt)))
   216	            rows.append((rel(p), ", ".join(calls) or "—", ", ".join(docker) or "—", " ".join(flags) or "—",
   217	                         " ".join(envs) or "—", " ".join(knobs) or "—", " ".join(f"${x}" for x in pos) or "—"))
   218	    return rows
   219	
