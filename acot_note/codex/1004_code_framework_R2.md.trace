     1	"""Build per-frame candidate boxes + cand_feats for the target-id head (§5, Option A).
     2	
     3	At rollout time the target-id head needs a candidate SET (target + distractors as
     4	image boxes) to argmax over. Training used GT-projected boxes (dataset_stage2.py:273
     5	via acot_probe.projection); we reproduce that ONLINE from live CARLA GT positions +
     6	the current camera pose.
     7	
     8	H0 honesty (guide §5): the boxes are UNLABELED and SHUFFLED every frame — they give
     9	the policy a candidate set (positions), never target identity. The tid head must
    10	still pick the referred car via language. `true_idx` (the shuffled slot of the true
    11	target) is returned for the SCORER only, never fed to the policy. Only IN-FRAME
    12	vehicles become candidates (a detector sees only what's in frame); if the target is
    13	off-screen, `true_idx == -1` and that frame is a "target-absent" (re-acquisition)
    14	frame for scoring.
    15	
    16	Swap this module for a real detector to remove all GT from the control path (Option B).
    17	"""
    18	
    19	from __future__ import annotations
    20	
    21	from dataclasses import dataclass
    22	
    23	import numpy as np
    24	
    25	from acot_probe.projection import Candidate, project_point
    26	from acot_probe.backbones import pool_box
    27	
    28	
    29	@dataclass
    30	class CandidateSet:
    31	    feats: np.ndarray          # (N, C) pooled VLM features, shuffled order
    32	    cands: list[Candidate]     # length N, same shuffled order (carries is_target/idx)
    33	    true_idx: int              # slot of the true target in this set, or -1 if target off-screen
    34	    mask: np.ndarray           # (N,) bool, all True (no padding for a single frame)
    35	
    36	
    37	def _pseudo_box(depth, W, fov_deg, vehicle_size_m, box_min_px, box_max_px):
    38	    import math
    39	    f = W / (2.0 * math.tan(math.radians(fov_deg) / 2.0))
    40	    size = f * vehicle_size_m / max(depth, 0.1)
    41	    return float(np.clip(size, box_min_px, box_max_px))
    42	
    43	
    44	def build_candidates(grid_last: np.ndarray, tpos, dstates, campose,
    45	                     image_cfg: dict, rng: np.random.Generator) -> CandidateSet | None:
    46	    """grid_last: (Gh,Gw,C) VLM grid. tpos: (3,) target world xyz.
    47	    dstates: (D,6) distractor [x,y,z,vx,vy,vz]. campose: (cx,cy,cz,pitch,yaw).
    48	    Returns None if NO vehicle is in frame (nothing to select)."""
    49	    W, H, fov = int(image_cfg["width"]), int(image_cfg["height"]), float(image_cfg["fov_deg"])
    50	    vsz = float(image_cfg["vehicle_size_m"])
    51	    bmin, bmax = float(image_cfg["box_min_px"]), float(image_cfg["box_max_px"])
    52	
    53	    def _mk(world_xyz, is_target, idx):
    54	        pr = project_point(world_xyz, campose, W, H, fov)
    55	        if pr is None:
    56	            return None
    57	        u, v, depth = pr
    58	        if not (0 <= u < W and 0 <= v < H):
    59	            return None
    60	        s = _pseudo_box(depth, W, fov, vsz, bmin, bmax)
    61	        return Candidate(u, v, s, s, depth, is_target, idx)
    62	
    63	    cands = []
    64	    tgt = _mk((float(tpos[0]), float(tpos[1]), float(tpos[2])), True, -1)
    65	    if tgt is not None:
    66	        cands.append(tgt)
    67	    dstates = np.asarray(dstates)
    68	    for d in range(dstates.shape[0]):
    69	        c = _mk((dstates[d, 0], dstates[d, 1], dstates[d, 2]), False, d)
    70	        if c is not None:
    71	            cands.append(c)
    72	
    73	    if not cands:
    74	        return None                                   # nothing in frame
    75	
    76	    # Shuffle so the true target is not at a fixed slot (metric-honesty, §5 / [[tid-metric-artifact]]).
    77	    order = rng.permutation(len(cands))
    78	    cands = [cands[o] for o in order]
    79	    true_idx = next((i for i, c in enumerate(cands) if c.is_target), -1)
    80	
    81	    frac_boxes = [c.frac_box(W, H) for c in cands]
    82	    feats = np.stack([pool_box(grid_last, fb) for fb in frac_boxes]).astype(np.float32)
    83	    mask = np.ones(len(cands), dtype=bool)
    84	    return CandidateSet(feats=feats, cands=cands, true_idx=true_idx, mask=mask)

