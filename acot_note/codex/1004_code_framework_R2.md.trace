   430	    def _asd_reset_memory(self, slot):
   431	        """The ONE hook ASD needs from a memory: reset it to the anchor's pick (drop the drifted state)."""
   432	        if self.tid_head == "tah" and self._tah_last is not None:
   433	            feat, pos = self._tah_last
   434	            self._tah_mem = self._tah.update(self._tah.reset(self.device), feat[slot], pos[slot])
   435	        elif self.tid_head == "reid" and self._reid_fn is not None:
   436	            from train.reid_resolution_probe import bank_update
   437	            self._reid_bank = []
   438	            bank_update(self._reid_bank, self._reid_fn[slot], self.reid_bank, 0.9)
   439	            self._reid_score = {}
   440	            self._reid_mvu = self._reid_mvel = None
