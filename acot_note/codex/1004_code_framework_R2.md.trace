     1	"""Env-side stub that forwards .act() to the policy server over TCP (bridge.py).
     2	
     3	Implements the same .reset()/.act() contract StudentRolloutEnv expects, so the env
     4	loop is unchanged whether the policy is local or remote. Reconstructs a lightweight
     5	`info` (cand_set with per-slot identity/depth + pred_slot) for the scorer — the big
     6	VLM features never cross the wire.
     7	"""
     8	
     9	from __future__ import annotations
    10	
    11	import socket
    12	from types import SimpleNamespace
    13	
    14	import numpy as np
    15	
    16	from rollout.bridge import send_msg, recv_msg
    17	
    18	
    19	class RemotePolicy:
    20	    def __init__(self, host: str, port: int, timeout: float = 120.0):
    21	        self.sock = socket.create_connection((host, port), timeout=timeout)
    22	
    23	    def reset(self):
    24	        send_msg(self.sock, {"cmd": "reset"})
    25	        recv_msg(self.sock)
    26	
    27	    def act(self, obs, gt_candidates):
    28	        send_msg(self.sock, {"cmd": "act", "rgb": obs.rgb, "language": obs.language,
    29	                             "proprio": np.asarray(obs.proprio), "step": int(obs.step),
    30	                             "target_color": getattr(obs, "target_color", ""),
    31	                             "target_bp": getattr(obs, "target_bp", ""),
    32	                             "rgb_hi": getattr(obs, "rgb_hi", None),
    33	                             "retarget_event": bool(getattr(obs, "retarget_event", False)),
    34	                             "gt_candidates": gt_candidates})
    35	        r = recv_msg(self.sock)
    36	        cl = r.get("cand_lite")
    37	        if cl is None:
    38	            cand_set = None
    39	        else:
    40	            cand_set = SimpleNamespace(
    41	                cands=[SimpleNamespace(**c) for c in cl["cands"]],
    42	                true_idx=cl["true_idx"])
    43	        info = SimpleNamespace(cand_set=cand_set, pred_slot=r["pred_slot"])
    44	        return tuple(r["action"]), r["search_mode"], info
    45	
    46	    def close(self):
    47	        try:
    48	            send_msg(self.sock, {"cmd": "close"})
    49	            recv_msg(self.sock)
    50	        except OSError:
    51	            pass
    52	        self.sock.close()
     1	"""Policy server (training container, py3.11 + torch + VLM).
     2	
     3	Holds the OnlineVLM + 4-module Policy and serves .act() over TCP to the CARLA env
     4	running in the cyh-carla container. Runs on the shared `cyh-carla-net` so the env
     5	can reach it by name. See bridge.py for the wire format.
     6	
     7	    bash train/docker/run.sh  → doesn't attach the shared net; launch explicitly:
     8	    docker run --rm --gpus all --network cyh-carla-net --name acot-policy-server \
     9	      -v $REPO:$REPO -v $DATA:$DATA:ro -v $HF_CACHE:/root/.cache/huggingface -w $REPO \
    10	      acot-uav-train:cu118 python carla_uav_tracking/rollout/policy_server.py \
    11	        --config train/config_v5.yaml --ckpt runs/stage2_v5/stage2_best.pt \
    12	        --language-mode neutral --port 5555
    13	
    14	--language-mode: neutral (M0, matches v5 training) | none (M1 w/o-language ablation).
    15	"""
    16	
    17	from __future__ import annotations
    18	
    19	import argparse
    20	import os
    21	import socket
    22	import sys
    23	
    24	import numpy as np
    25	import yaml
    26	
    27	_CARLA_PKG = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
    28	_REPO = os.path.dirname(_CARLA_PKG)
    29	for _p in (_REPO, _CARLA_PKG):
    30	    if _p not in sys.path:
    31	        sys.path.insert(0, _p)
    32	
    33	from rollout.bridge import send_msg, recv_msg  # noqa: E402
    34	from rollout.online_vlm import OnlineVLM  # noqa: E402
    35	from rollout.policy import Policy, Observation  # noqa: E402
    36	
    37	
    38	def _cand_lite(cand_set):
    39	    """Serialize only what the env-side scorer needs (identities + depth), not feats."""
    40	    if cand_set is None:
    41	        return None
    42	    return {
    43	        "cands": [{"is_target": bool(c.is_target), "idx": int(c.idx), "depth": float(c.depth)}
    44	                  for c in cand_set.cands],
    45	        "true_idx": int(cand_set.true_idx),
    46	    }
    47	
    48	
    49	def serve(policy: Policy, port: int, host: str = "0.0.0.0"):
    50	    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    51	    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    52	    srv.bind((host, port))
    53	    srv.listen(1)
    54	    print(f"[policy-server] listening on {host}:{port} "
    55	          f"(ckpt epoch={policy.ckpt_meta.get('epoch')} "
    56	          f"mis_follow={policy.ckpt_meta.get('metrics', {}).get('mis_follow')})", flush=True)
    57	
    58	    while True:
    59	        conn, addr = srv.accept()
    60	        print(f"[policy-server] client connected: {addr}", flush=True)
    61	        try:
    62	            while True:
    63	                msg = recv_msg(conn)
    64	                cmd = msg.get("cmd")
    65	                if cmd == "reset":
    66	                    policy.reset()
    67	                    send_msg(conn, {"ok": True})
    68	                elif cmd == "close":
    69	                    if hasattr(policy, "_dagger_flush"):
    70	                        policy._dagger_flush()          # flush the LAST episode's DAgger frames
    71	                    if hasattr(policy, "_tahdag_flush"):
    72	                        policy._tahdag_flush()          # ... and the LAST episode's TAH DAgger frames
    73	                    send_msg(conn, {"ok": True})
    74	                    break
    75	                elif cmd == "act":
    76	                    obs = Observation(rgb=np.asarray(msg["rgb"]), language=msg["language"],
    77	                                      proprio=np.asarray(msg["proprio"], dtype=np.float32),
    78	                                      step=int(msg["step"]),
    79	                                      target_color=msg.get("target_color", ""),
    80	                                      target_bp=msg.get("target_bp", ""),
    81	                                      retarget_event=bool(msg.get("retarget_event", False)),
    82	                                      rgb_hi=None if msg.get("rgb_hi") is None else np.asarray(msg["rgb_hi"]))
    83	                    action, search_mode, info = policy.act(obs, gt_candidates=msg["gt_candidates"])
    84	                    send_msg(conn, {"action": [float(x) for x in action],
    85	                                    "search_mode": float(search_mode),
    86	                                    "pred_slot": int(info.pred_slot),
    87	                                    "cand_lite": _cand_lite(info.cand_set)})
    88	                else:
    89	                    send_msg(conn, {"error": f"unknown cmd {cmd}"})
    90	        except (ConnectionError, EOFError) as e:
    91	            print(f"[policy-server] client disconnected: {e}", flush=True)
    92	        finally:
    93	            conn.close()
    94	
    95	
    96	def main():
    97	    ap = argparse.ArgumentParser()
    98	    ap.add_argument("--config", default="train/config_v5.yaml")
    99	    ap.add_argument("--ckpt", default="runs/stage2_v5/stage2_best.pt")
   100	    ap.add_argument("--language-mode", default="neutral", choices=["neutral", "none", "full"])
   101	    ap.add_argument("--device", default="cuda:0")
   102	    ap.add_argument("--s2-period", type=int, default=1)
   103	    ap.add_argument("--ablate", default=None, choices=[None, "ear", "iar"],
   104	                    help="H1/H2: zero EAR/IAR into DiT (must match the ckpt's training ablation)")
   105	    ap.add_argument("--ex-source", default="ear",
   106	                    choices=["ear", "cv", "cv_gated", "zerovel", "zerovel_gated", "road", "track"],
   107	                    help="what fills DiT z_ex: ear (default) | memory+CV prior (*_gated=loss only, "
   108	                         "seeded from GT target) | road (P2a-1 road-graph WM: env-side lane-traversal, "
   109	                         "loss only; needs run_rollout --predict-road) | track (Plan A: seed from "
   110	                         "tid-COMMITTED candidate → grounding drives control). no-WM baseline = cv_gated.")
   111	    ap.add_argument("--commit-k", type=int, default=5, help="track: hysteresis frames to switch committed target")
   112	    ap.add_argument("--tid-head", default="xattn", choices=["xattn", "attrbind", "reid", "oracle", "assoc", "dam4sam", "tah", "fusion", "sticky"],
   113	                    help="xattn=language grounding (default) | attrbind=CLIP-style head (needs --tid-ckpt) "
   114	                         "| reid=temporal appearance-memory re-ID (match the tracked instance, not the "
   115	                         "language; reframe test — no ckpt, falls back to xattn before a template exists)")
   116	    ap.add_argument("--tid-ckpt", default=None, help="attrbind head ckpt (e.g. runs/tid_attrbind.pt)")
   117	    ap.add_argument("--reid-feature", default="vlmpool", choices=["vlmpool", "dinov2"],
   118	                    help="reid appearance feature: vlmpool (coarse Qwen grid) | dinov2 (crop→DINOv2, "
   119	                         "instance-discriminative; offline milestone K2 breaks 0.5)")
   120	    ap.add_argument("--reid-bank", type=int, default=1, help="reid K-view gallery size (sweet spot ~2-3)")
   121	    ap.add_argument("--reid-topm", type=int, default=1, help="reid match = top-m mean cosine to gallery")
   122	    ap.add_argument("--warmup-oracle-s", type=float, default=0.0,
   123	                    help="diag: first N seconds use oracle identity (establish tracking) then hand to reid — "
   124	                         "tests if the deployable gap is cascade-INITIATION vs reid-intrinsic")
   125	    ap.add_argument("--frame-gain", type=float, default=0.0,
   126	                    help="②: yaw-centering gain on the committed target (deg per frac-offset from center; "
   127	                         "breaks the framing→reid cascade). 0=off; sign per camera convention.")
   128	    ap.add_argument("--conf-tau", type=float, default=0.0,
   129	                    help="①: min pick-margin (top1-top2) to commit-fly in track mode; below it, hold "
   130	                         "commitment + dead-reckon (don't chase an ambiguous look-alike). 0=off")
   131	    ap.add_argument("--reid-tavg", type=float, default=0.0,
   132	                    help="temporal re-ID: per-actor EMA decay of the reid match score (0=off=single-frame "
   133	                         "argmax; e.g. 0.7 = integrate evidence over ~3 ticks → robust to off-center frames)")
   134	    ap.add_argument("--conf-consensus", type=float, default=0.0,
   135	                    help="borrow#2: consensus-gated control — commit-fly only if the pick is ALSO motion-"
   136	                         "consistent (dist < conf_consensus·gate), i.e. appearance AND motion agree; on "
   137	                         "disagreement hold+search. 0=off. Needs --reid-motion>0.")
   138	    ap.add_argument("--reid-motion", type=float, default=0.0,
   139	                    help="borrow#1 (DeepSORT): motion-consensus weight fused into the reid score (0=off=pure "
   140	                         "appearance). >0 softly penalizes candidates far from the CV-predicted target image "
   141	                         "position → spatially-inconsistent look-alikes can't win on appearance alone.")
   142	    ap.add_argument("--reid-motion-gate-px", type=float, default=160.0, help="borrow#1 motion soft-gate radius (px)")
   143	    ap.add_argument("--gallery-seed", default="gt", choices=["gt", "committed"],
   144	                    help="reid gallery template source: gt=legacy oracle-seeded (per-frame GT target crop) | "
   145	                         "committed=DEPLOYABLE GT-free (store the believed-target crop; language at cold-start)")
   146	    ap.add_argument("--reanchor", default="off", choices=["off", "lang", "oracle", "anchor"],
   147	                    help="deployable re-anchor: on sustained collapse, re-pick + reset memory/gallery. off | "
   148	                         "lang (language re-pick) | oracle (GT re-anchor = upper bound) | anchor (tah GT-free "
   149	                         "confident-drift: frozen initial-appearance anchor disagrees with drifted memory)")
   150	    ap.add_argument("--reanchor-patience", type=int, default=5,
   151	                    help="consecutive low-margin (<conf-tau) S2 ticks before a re-anchor fires (rate-limit)")
   152	    ap.add_argument("--reanchor-tavg", type=float, default=0.0,
   153	                    help="TEMPORAL language re-anchor: per-actor EMA decay of the language logit so re-anchor "
   154	                         "commits the temporally-integrated language vote (0=off=single-frame; e.g. 0.5)")
   155	    ap.add_argument("--assoc-mode", default="deepsort", choices=["motion", "deepsort"],
   156	                    help="external baseline (--tid-head assoc): motion (OC-SORT-like CV image-space) | "
   157	                         "deepsort (motion gate + crop-DINOv2 appearance) tracking-by-detection association")
   158	    ap.add_argument("--assoc-gate-px", type=float, default=160.0, help="assoc motion gate radius (px)")
   159	    ap.add_argument("--assoc-lambda", type=float, default=1.0, help="assoc appearance weight vs motion")
   160	    ap.add_argument("--dam4sam-host", default="dam4sam-svc", help="external baseline (--tid-head dam4sam) service host")
   161	    ap.add_argument("--tah-ckpt", default="runs/tah_rel.pt", help="path-B: TAHRel learned association ckpt")
   162	    ap.add_argument("--dam4sam-port", type=int, default=5601, help="DAM4SAM service port")
   163	    ap.add_argument("--asd", default="off", choices=["off", "observe", "rule", "learned", "filter"],
   164	                    help="ASD memory-agnostic confident-drift correction (rollout/asd.py)")
   165	    ap.add_argument("--asd-cfg", default="", help="ASD kwargs as JSON, e.g. '{\"h\":2.0}'")
   166	    ap.add_argument("--tracklets", default="sim", choices=["sim", "tracker"],
   167	                    help="identity keys: sim = simulator actor index (legacy, ideal association) | tracker = GT-free "
   168	                         "SORT/DeepSORT-style tracklet ids (rollout/tracklets.py; 1004 deployable v2)")
   169	    ap.add_argument("--occl-cands", action="store_true",
   170	                    help="occlusion-aware candidates: drop vehicles the env ray-cast marks occluded "
   171	                         "(needs run_rollout --vis-raycast)")
   172	    ap.add_argument("--event-override", action="store_true",
   173	                    help="1003_dynamic-retarget-design.md S1: on Observation.retarget_event (needs "
   174	                         "run_rollout --retarget-tick), hard-reset TAHRelM memory + PGIF belief to the "
   175	                         "(GT-driven) new target. tid_head=tah/fusion + --gallery-seed committed only.")
   176	    ap.add_argument("--port", type=int, default=5555)
   177	    a = ap.parse_args()
   178	
   179	    cfg = yaml.safe_load(open(os.path.join(_REPO, a.config)))
   180	    vlm = OnlineVLM(cfg, device=a.device, language_mode=a.language_mode)
   181	    tck = os.path.join(_REPO, a.tid_ckpt) if a.tid_ckpt else None
   182	    policy = Policy(os.path.join(_REPO, a.ckpt), cfg, vlm, device=a.device,
   183	                    s2_period=a.s2_period, ablate=a.ablate, ex_source=a.ex_source, commit_k=a.commit_k,
   184	                    tid_head=a.tid_head, tid_ckpt=tck,
   185	                    reid_feature=a.reid_feature, reid_bank=a.reid_bank, reid_topm=a.reid_topm,
   186	                    conf_tau=a.conf_tau, frame_gain=a.frame_gain, warmup_oracle_s=a.warmup_oracle_s,
   187	                    conf_consensus=a.conf_consensus,
   188	                    reid_tavg=a.reid_tavg, reid_motion=a.reid_motion, reid_motion_gate_px=a.reid_motion_gate_px,
   189	                    gallery_seed=a.gallery_seed, reanchor=a.reanchor,
   190	                    reanchor_patience=a.reanchor_patience, reanchor_tavg=a.reanchor_tavg, assoc_mode=a.assoc_mode,
   191	                    assoc_gate_px=a.assoc_gate_px, assoc_lambda=a.assoc_lambda,
   192	                    dam4sam_host=a.dam4sam_host, dam4sam_port=a.dam4sam_port, tah_ckpt=a.tah_ckpt,
   193	                    asd=a.asd, asd_cfg=a.asd_cfg, tracklets=a.tracklets, occl_cands=a.occl_cands,
   194	                    event_override=a.event_override)
   195	    print(f"[policy-server] loaded policy (language_mode={a.language_mode}, "
   196	          f"s2_period={a.s2_period}, ablate={a.ablate}, ex_source={a.ex_source}, commit_k={a.commit_k}, "
   197	          f"tid_head={a.tid_head})", flush=True)
   198	    serve(policy, a.port)
   199	
   200	
   201	if __name__ == "__main__":
   202	    main()

