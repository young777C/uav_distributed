   769	    def station_keep_lookalikes(self) -> None:
   770	        """§8 depth decorrelation: hold each SIMILAR look-alike at its assigned signed
   771	        along-road offset relative to the target (some BEHIND → nearer camera, some ahead →
   772	        farther) via smooth TM speed nudges, so the target's depth RANK stays ~uniform
   773	        instead of systematically nearest. Speed-based, not teleport: a teleported decoy is
   774	        immediately driven forward again by autopilot; a proportional speed offset keeps it
   775	        stationed. No-op for distractors without a desired_off (fillers)."""
   776	        if self._target is None or self._maneuver_injector is None:
   777	            return
   778	        tm = getattr(self._maneuver_injector, "_tm", None)
   779	        if tm is None:
   780	            return
   781	        try:
   782	            tloc = self._target.transform.location
   783	            tyaw = np.radians(self._target.transform.rotation.yaw)
   784	        except (RuntimeError, AttributeError):
   785	            return
   786	        fwd = np.array([np.cos(tyaw), np.sin(tyaw)])   # target's forward (+ = ahead / farther)
   787	        tp = np.array([tloc.x, tloc.y])
   788	        for obj, meta in zip(self._distractors, self._distractor_meta):
   789	            desired = meta.get("desired_off")
   790	            if desired is None:                 # only stationed fillers carry a desired_off
   791	                continue
   792	            veh = getattr(obj, "_vehicle", None)
   793	            if veh is None:
   794	                continue
   795	            try:
   796	                p = obj.get_state()[0]
   797	            except (RuntimeError, AttributeError):
   798	                continue
   799	            off = float(np.dot(np.array([p[0], p[1]]) - tp, fwd))   # signed along-road offset
   800	            err = off - float(desired)          # >0 → ahead of slot → slow down; <0 → speed up
   801	            # TM convention: +% = drive that % BELOW the speed limit (slower). Proportional,
   802	            # clamped so it never stops dead or races off.
   803	            pct = float(np.clip(err * 5.0, -45.0, 70.0))
   804	            try:
   805	                tm.vehicle_percentage_speed_difference(veh, pct)
   806	            except (RuntimeError, AttributeError):
   807	                pass
