   153	                split["train"].append(r["file"])
   154	        json.dump(split, open(a.split_out, "w"), indent=1)
   155	        print(f"split → {a.split_out}: train {len(split['train'])} val {len(split['val'])} test {len(split['test'])}")
   156	    if a.viz:
   157	        for r in good[: a.viz]:
