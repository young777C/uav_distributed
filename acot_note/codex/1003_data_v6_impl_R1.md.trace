   809	    def get_distractor_states(self) -> np.ndarray:
   810	        """Return (D, 6) array: [x, y, z, vx, vy, vz] for each distractor (order = meta)."""
   811	        out = []
   812	        for d in self._distractors:
   813	            try:
   814	                pos, vel, _, _ = d.get_state()
   815	                out.append([pos[0], pos[1], pos[2], vel[0], vel[1], vel[2]])
   816	            except (RuntimeError, AttributeError):
   817	                out.append([np.nan] * 6)
   818	        arr = np.array(out, dtype=np.float32) if out else np.zeros((0, 6), dtype=np.float32)
   819	        self._distractor_states = arr        # cache for _cluster_centroid (same step)
   820	        return arr
