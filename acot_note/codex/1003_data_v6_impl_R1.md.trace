exec
/bin/sh -lc "python - <<'PY'
import h5py, glob, os, json, numpy as np
root='/nvidia/hque/data/carla_data/uavtrack_v6_smoke'
for p in sorted(glob.glob(root+'/episode_*.h5')):
    with h5py.File(p,'r') as f:
        a=f.attrs
        print('\\n',os.path.basename(p), 'shape', f['rgb'].shape)
        print(' attrs', {k:a.get(k) for k in ['label_version','subset','town','episode_id','seed','fov','rgb_resolution','git_commit','git_dirty_sha256','test_town','train_towns','scenario_file']})
        for name in ['actors/ids','actors/role','actors/amodal_box','actors/visible','actors/tracklet_id','events/target_reentry','traffic/blobs','instance_mask']:
            if name in f: print(' ', name, f[name].shape, f[name].dtype)
            else: print(' MISSING', name)
        if 'events/target_reentry' in f: print(' reentry', f['events/target_reentry'][:10])
        if 'actors/vis_px' in f:
            vis=f['actors/vis_px'][:]>=20; inf=f['actors/in_frame'][:,0]==1
            print(' target vis/off/tiny_occ', int(vis[:,0].sum()), int((~inf).sum()), int((inf & ~vis[:,0]).sum()))
            print(' target tracklets', sorted(set(f['actors/tracklet_id'][:,0].tolist())-{-1})[:10], 'n=', len(set(f['actors/tracklet_id'][:,0].tolist())-{-1}))
PY" in /nvidia/hque/code/cyhe/uav-acot-track
exec
/bin/sh -lc '[ -f /nvidia/hque/data/carla_data/uavtrack_v6_smoke/episode_summaries.jsonl ] && tail -20 /nvidia/hque/data/carla_data/uavtrack_v6_smoke/episode_summaries.jsonl || true' in /nvidia/hque/code/cyhe/uav-acot-track
