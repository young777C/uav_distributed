    39	    # v6 (acot_note/1003_data-regen-v6-spec.md): parallel-safe jobs + provenance
    40	    parser.add_argument("--town", type=str, default=None, help="override environment.towns with ONE town")
    41	    parser.add_argument("--subset", type=str, default="", help="subset tag written to attrs (base/reacq/occ)")
    42	    parser.add_argument("--progress-file", type=str, default=None, help="per-job resume file (default <out>/.attempted)")
    43	    parser.add_argument("--summary-jsonl", type=str, default=None, help="append one summary line per episode")
    44	    parser.add_argument("--provenance", type=str, default=None, help="JSON dict of host-side provenance attrs")
    45	    args = parser.parse_args()
    46	
    47	    # Load config
    48	    cfg = _load_config(args.config)
    49	    if args.town:
    50	        cfg.setdefault("environment", {})["towns"] = [args.town]
    51	    output_dir = Path(args.output)
    52	    output_dir.mkdir(parents=True, exist_ok=True)
    53	    max_bytes = int(args.max_size_gb * 1024**3)
    54	    town_list = cfg.get("environment", {}).get("towns", ["Town01"])
    55	
    56	    # Connect (generous timeout: first map load compiles shaders)
    57	    client = carla.Client(args.host, args.port)
    58	    client.set_timeout(60.0)
    59	
    60	    summaries = []
    61	    postproc = PostProcessor(output_dir, fov=float(cfg.get("output", {}).get("fov", 90.0)))
    62	    prov = json.loads(Path(args.provenance).read_text()) if args.provenance else {}
    63	    prov.update({
    64	        "config_snapshot": json.dumps(cfg, sort_keys=True, default=str),
    65	        "scenario_file": str(args.config or ""),
    66	        "subset": args.subset,
    67	        "seed_base": int(args.seed),
    68	        "carla_server_version": client.get_server_version(),
    69	        "carla_client_version": client.get_client_version(),
    70	    })
    71	
    72	    # Load the scenario's first town up front (skip if the server is already on
    73	    # it — important for crash-resume so we don't reload every restart).
    74	    first_town = town_list[0] if town_list else "Town10HD"
    75	    cur_map = client.get_world().get_map().name.split("/")[-1]
    76	    if cur_map != first_town:
    77	        try:
    78	            print(f"Loading initial map: {first_town}")
    79	            client.load_world(first_town)
    80	            time.sleep(3.0)
    81	        except RuntimeError:
    82	            print("  Initial map load failed; using current map")
    83	
    84	    progress_file = Path(args.progress_file) if args.progress_file else output_dir / ".attempted"
    85	    for ep_id in range(args.start_id, args.start_id + args.num_episodes):
    86	        # Record attempt so a supervisor can resume past a crashing episode.
    87	        progress_file.write_text(str(ep_id))
    88	        # Map switch every 10 episodes (with crash guard)
    89	        if ep_id % 10 == 0 and len(town_list) > 1:
    90	            town = town_list[(ep_id // 10) % len(town_list)]
    91	            print(f"[{ep_id}] Loading map: {town}")
    92	            try:
    93	                client.load_world(town)
    94	                time.sleep(3.0)
    95	            except RuntimeError:
    96	                print(f"  Map load failed, continuing with current map")
    97	
    98	        world = client.get_world()
    99	
   100	        # Update scenario-specific town override
   101	        if "towns" not in cfg.get("environment", {}):
   102	            cfg["environment"]["towns"] = town_list
   103	
   104	        # Per-episode seed for reproducibility (P1-b)
   105	        cfg.setdefault("environment", {})["seed"] = args.seed + ep_id
   106	
   107	        scene = SceneManager(world, cfg, client)
   108	        recorder = EpisodeRecorder(
   109	            scene=scene, world=world, output_dir=output_dir,
   110	            episode_id=ep_id, fps=cfg.get("environment", {}).get("fps", 10),
   111	            resolution=tuple(cfg.get("output", {}).get("rgb_resolution", [336, 336])),
   112	            extra_attrs={**prov, "episode_id": int(ep_id)},
   113	        )
   114	
   115	        print(f"[{ep_id}] Starting...", end=" ", flush=True)
   116	        summary = recorder.run()
   117	        summaries.append(summary)
   118	        if args.summary_jsonl:
   119	            with open(args.summary_jsonl, "a") as fj:
   120	                fj.write(json.dumps({**summary, "subset": args.subset}, default=str) + "\n")
   121	
   122	        n_steps = summary["steps"]
   123	        dur = summary["duration_seconds"]
   124	        if summary.get("skipped"):
   125	            print(f"SKIPPED — {summary.get('reason', 'unknown')}")
   126	            # Remove the empty H5 file
   127	            ep_file = output_dir / f"episode_{ep_id:06d}.h5"
   128	            if ep_file.exists():
   129	                ep_file.unlink()
   130	            continue
   131	        print(f"{n_steps} steps in {dur:.1f}s ({n_steps/max(dur,0.001):.1f} fps)")
   132	
   133	        # Check size limit
   134	        total_size = sum(
   135	            f.stat().st_size for f in output_dir.glob("episode_*.h5")
   136	        )
   137	        print(f"  Total data: {total_size/1024**3:.2f} GB / {args.max_size_gb:.1f} GB")
   138	        if total_size >= max_bytes:
   139	            print(f"  Reached {args.max_size_gb} GB limit. Stopping.")
   140	            break
   141	
   142	        # Post-process
   143	        if args.postprocess:
   144	            ep_path = output_dir / f"episode_{ep_id:06d}.h5"
   145	            if ep_path.exists():
   146	                postproc.process_episode(ep_path)
   147	
   148	    # Save batch summary
   149	    summary_path = (Path(args.summary_jsonl).with_suffix(".last_batch.json") if args.summary_jsonl
   150	                    else output_dir / "batch_summary.json")
   151	    with open(summary_path, "w") as f:
   152	        json.dump(summaries, f, indent=2)
   153	
   154	    total_steps = sum(s["steps"] for s in summaries)
   155	    total_dur = sum(s["duration_seconds"] for s in summaries)
   156	    print(f"\nBatch complete. {len(summaries)} episodes, {total_steps} steps, "
   157	          f"{total_dur/60:.1f} min")
   158	    print(f"Summary: {summary_path}")
   159	
   160	
   161	def _load_config(config_path: str | None) -> dict:
   162	    base_path = Path(__file__).resolve().parent.parent / "config" / "default.yaml"
   163	    with open(base_path) as f:
   164	        cfg = yaml.safe_load(f)
   165	    if config_path:
   166	        with open(config_path) as f:
   167	            override = yaml.safe_load(f)
   168	        _deep_merge(cfg, override)
   169	    return cfg
   170	
   171	
   172	def _deep_merge(base: dict, override: dict) -> None:
   173	    for key, value in override.items():
   174	        if key in base and isinstance(base[key], dict) and isinstance(value, dict):
   175	            _deep_merge(base[key], value)
   176	        else:
   177	            base[key] = value
   178	
   179	
   180	if __name__ == "__main__":
   181	    main()

