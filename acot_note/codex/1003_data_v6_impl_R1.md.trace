   343	    def _create_attached_sensor(self) -> RGBSensor:
   344	        """Create an RGB sensor attached to the world spectator."""
   345	        bp = self._world.get_blueprint_library().find("sensor.camera.rgb")
   346	        bp.set_attribute("image_size_x", str(self._resolution[0]))
   347	        bp.set_attribute("image_size_y", str(self._resolution[1]))
   348	        bp.set_attribute("fov", str(self._fov))
   349	
   350	        cam_transform = self._scene.drone.get_camera_transform()
   351	        sensor = self._world.spawn_actor(bp, cam_transform)
   352	        rgb = RGBSensor.__new__(RGBSensor)
   353	        rgb._sensor = sensor
   354	        rgb._resolution = self._resolution
   355	
   356	        import queue
   357	        rgb._queue = queue.Queue()
   358	        sensor.listen(rgb._queue.put)
   359	        return rgb
   360	
   361	    def _flush_v6(self, f, n0: int, total: int) -> None:
   362	        """Append buffered v6 per-actor labels: actors/*, traffic/blobs, instance_mask."""
   363	        g = f.require_group("actors")
   364	        if "ids" not in g:
   365	            g.create_dataset("ids", data=self._v6_ids)       # (A,) carla actor id; index 0 = target
   366	            g.create_dataset("role", data=self._v6_role)     # (A,) 0 target, 1 look-alike, 2 other distractor
   367	
   368	        def app(grp, name, arr, comp=4, chunks=None):
   369	            if name not in grp:
   370	                grp.create_dataset(name, data=arr, maxshape=(None, *arr.shape[1:]),
   371	                                   chunks=chunks or (min(64, len(arr)), *arr.shape[1:]),
   372	                                   compression="gzip", compression_opts=comp)
   373	            else:
   374	                ds = grp[name]
   375	                ds.resize(total, axis=0)
   376	                ds[n0:total] = arr
   377	
   378	        st = lambda k: np.stack([b[k] for b in self._v6_buf], 0)
   379	        for k in ("in_frame", "amodal_box", "depth", "occ_raycast", "inst_id", "vis_px", "modal_box"):
   380	            app(g, k, st(k))
   381	        app(f.require_group("traffic"), "blobs", st("traffic"))
   382	        app(f, "instance_mask", st("mask"), chunks=(1, self._resolution[1], self._resolution[0]))
   383	
   384	    def _create_raw_sensor(self, bp_name: str):
   385	        """Extra camera with the RGB camera's resolution/fov, repositioned every tick → (sensor, queue)."""
   386	        import queue
   387	        bp = self._world.get_blueprint_library().find(bp_name)
   388	        bp.set_attribute("image_size_x", str(self._resolution[0]))
   389	        bp.set_attribute("image_size_y", str(self._resolution[1]))
   390	        bp.set_attribute("fov", str(self._fov))
   391	        sensor = self._world.spawn_actor(bp, self._scene.drone.get_camera_transform())
   392	        q = queue.Queue()
   393	        sensor.listen(q.put)
   394	        return sensor, q
   395	
   396	    @staticmethod
   397	    def _get_synced(q, frame_id: int, timeout: float = 2.0):
   398	        """Pop sensor data until the one rendered for frame_id (drops stale frames)."""
   399	        while True:
   400	            d = q.get(timeout=timeout)
   401	            if d.frame >= frame_id:
   402	                if d.frame > frame_id:
   403	                    raise RuntimeError(f"sensor frame {d.frame} ahead of world frame {frame_id}")
   404	                return d
   405	
   406	    def _v6_labels(self, cam_t, inst_data, occ_detector, target_occ: float) -> dict:
   407	        """Per-actor (target + distractors) labels for one frame — see recording/labels_v6.py."""
   408	        from recording.labels_v6 import amodal_box, associate, decode_instance, focal
   409	        W, H = self._resolution
   410	        fpx = focal(W, self._fov)
   411	        cam_inv = np.array(cam_t.get_inverse_matrix())
   412	        cam_xyz = np.array([cam_t.location.x, cam_t.location.y, cam_t.location.z])
   413	        A = len(self._v6_handles)
   414	        boxes, inframe = [None] * A, np.zeros(A, np.uint8)
   415	        depth, occ = np.full(A, np.nan, np.float32), np.full(A, np.nan, np.float32)
   416	        amodal = np.full((A, 4), -1.0, np.float32)
   417	        for a, h in enumerate(self._v6_handles):
   418	            if h is None or not h.is_alive:
   419	                continue
   420	            try:
   421	                b, cin, dd = amodal_box(h, cam_inv, W, H, fpx)
   422	            except RuntimeError:
   423	                continue
   424	            boxes[a], inframe[a], depth[a] = b, int(cin), dd
   425	            if b is not None:
   426	                amodal[a] = b
   427	                if a == 0:
   428	                    occ[a] = target_occ
   429	                else:
   430	                    try:
   431	                        occ[a] = float(occ_detector.check(h, cam_xyz)[1])
   432	                    except RuntimeError:
   433	                        pass
   434	        tag, iid = decode_instance(inst_data.raw_data, W, H)
   435	        inst_id, vis_px, modal, mask, traffic = associate(boxes, tag, iid)
   436	        return {"in_frame": inframe, "amodal_box": amodal, "depth": depth, "occ_raycast": occ,
   437	                "inst_id": inst_id, "vis_px": vis_px, "modal_box": modal, "mask": mask, "traffic": traffic}
   438	
   439	    def _target_occluded(self, cam_t, tpos) -> bool:
   440	        """Whether the line of sight from the camera to the target is blocked by
   441	        geometry (building / tunnel roof) — i.e. the target is hidden even if it
   442	        still projects inside the frame. One ray per call."""
   443	        try:
   444	            end = carla.Location(float(tpos[0]), float(tpos[1]), float(tpos[2]) + 0.8)
   445	            d_target = cam_t.location.distance(end)
   446	            for h in self._world.cast_ray(cam_t.location, end):
   447	                if cam_t.location.distance(h.location) < d_target - 3.0:
   448	                    return True   # something substantial between camera and target
   449	        except (RuntimeError, AttributeError):
   450	            return False
   451	        return False
   452	
   453	    def _point_in_frame(self, cam_t, wp) -> bool:
   454	        """Whether a world point projects inside the RGB frame (90° FOV camera)."""
   455	        M = np.array(cam_t.get_inverse_matrix())
   456	        q = M @ np.array([float(wp[0]), float(wp[1]), float(wp[2]), 1.0])
   457	        if q[0] <= 0.1:
   458	            return False
   459	        W, H = self._resolution
   460	        f = W / (2.0 * np.tan(np.radians(self._fov) / 2.0))

