 succeeded in 0ms:
     1	"""Host-side orchestrator for the v6 dataset (acot_note/1003_data-regen-v6-spec.md).
     2	
     3	- writes provenance (git commit, dirty-diff sha256, code patch + untracked-file tarball) into <out>/
     4	- builds the job list (subset × town × chunk), interleaved round-robin so a partial run stays balanced
     5	- runs jobs on dedicated CARLA slots via `docker exec cyh-carla bash scripts/run_job_v6.sh ...`
     6	- stops launching new jobs when free disk < --min-free-gb
     7	
     8	  python3 runs/data_v6/orchestrate.py --plan smoke --out /nvidia/hque/data/carla_data/uavtrack_v6_smoke
     9	  python3 runs/data_v6/orchestrate.py --plan full  --out /nvidia/hque/data/carla_data/uavtrack_v6_fov90
    10	"""
    11	import argparse
    12	import datetime
    13	import hashlib
    14	import json
    15	import os
    16	import queue
    17	import shutil
    18	import subprocess
    19	import sys
    20	import threading
    21	
    22	REPO = "/nvidia/hque/code/cyhe/uav-acot-track"
    23	HOST_DATA, CONT_DATA = "/nvidia/hque/data/carla_data", "/data"
    24	TOWN_IDX = {"Town01": 1, "Town02": 2, "Town03": 3, "Town04": 4, "Town05": 5, "Town10HD": 10}
    25	SUBSETS = {  # subset -> (scenario, id base)
    26	    "base": ("config/scenarios/v6_base.yaml", 100000),
    27	    "reacq": ("config/scenarios/v6_reacq.yaml", 200000),
    28	    "occ": ("config/scenarios/v6_occ.yaml", 300000),
    29	}
    30	TRAIN_TOWNS = ["Town01", "Town02", "Town04", "Town05", "Town10HD"]
    31	TEST_TOWN = "Town03"   # held out: never in any training data (incl. Stage-2's original v5)
    32	PLANS = {
    33	    # subset: {town: n_episodes}
    34	    "smoke": {"base": {"Town01": 1, "Town03": 1}, "reacq": {"Town05": 1}, "occ": {"Town04": 1}},
    35	    "smoke_reacq": {"reacq": {"Town01": 1, "Town04": 1, "Town10HD": 1, "Town02": 1}},   # blind_expert check
    36	    "full": {
    37	        "base": {**{t: 40 for t in TRAIN_TOWNS}, TEST_TOWN: 20},
    38	        "reacq": {**{t: 30 for t in TRAIN_TOWNS}, TEST_TOWN: 20},
    39	        "occ": {"Town05": 30, "Town04": 30, "Town10HD": 30, TEST_TOWN: 20},
    40	    },
    41	}
    42	SLOTS = "2100:1:8100,2110:0:8110,2120:2:8120,2130:3:8130"   # port:vulkan_gpu:tm_port (dedicated)
    43	
    44	
    45	def sh(cmd):
    46	    return subprocess.run(cmd, shell=True, capture_output=True, text=True, cwd=REPO).stdout
    47	
    48	
    49	def provenance(out):
    50	    commit = sh("git rev-parse HEAD").strip()
    51	    patch = sh("git diff HEAD -- carla_uav_tracking train")
    52	    untracked = [p for p in sh("git ls-files --others --exclude-standard -- carla_uav_tracking train").split()
    53	                 if p.endswith((".py", ".yaml", ".sh"))]
    54	    open(os.path.join(out, "code_snapshot.patch"), "w").write(patch)
    55	    if untracked:
    56	        subprocess.run(["tar", "czf", os.path.join(out, "code_untracked.tar.gz")] + untracked, cwd=REPO, check=True)
    57	    h = hashlib.sha256(patch.encode())
    58	    for p in sorted(untracked):
    59	        h.update(p.encode()); h.update(open(os.path.join(REPO, p), "rb").read())
    60	    prov = {"dataset_version": "v6", "git_commit": commit, "git_dirty_sha256": h.hexdigest(),
    61	            "n_untracked_code_files": len(untracked), "generated_by": " ".join(sys.argv),
    62	            "generated_at": datetime.datetime.now().isoformat(timespec="seconds"),
    63	            "docker_container": "cyh-carla", "test_town": TEST_TOWN, "train_towns": json.dumps(TRAIN_TOWNS)}
    64	    json.dump(prov, open(os.path.join(out, "provenance.json"), "w"), indent=2)
    65	    return prov
    66	
    67	
    68	def jobs(plan, chunk):
    69	    per = []   # list of per-(subset,town) chunk lists
    70	    for sub, towns in PLANS[plan].items():
    71	        scen, base = SUBSETS[sub]
    72	        for town, n in towns.items():
    73	            start0 = base + TOWN_IDX[town] * 1000
    74	            per.append([(sub, scen, town, start0 + k, min(chunk, n - k)) for k in range(0, n, chunk)])
    75	    out, i = [], 0
    76	    while any(per):                                  # round-robin interleave across (subset, town)
    77	        for lst in per:
    78	            if i < len(lst):
    79	                out.append(lst[i])
    80	        i += 1
    81	        if all(i >= len(l) for l in per):
    82	            break
    83	    return out
    84	
    85	
    86	def main():
    87	    ap = argparse.ArgumentParser()
    88	    ap.add_argument("--plan", choices=list(PLANS), required=True)
    89	    ap.add_argument("--out", required=True, help="host path under /nvidia/hque/data/carla_data")
    90	    ap.add_argument("--slots", default=SLOTS)
    91	    ap.add_argument("--chunk", type=int, default=5)
    92	    ap.add_argument("--seed-base", type=int, default=0)
    93	    ap.add_argument("--min-free-gb", type=float, default=250.0)
    94	    ap.add_argument("--dry-run", action="store_true")
    95	    a = ap.parse_args()
    96	    assert a.out.startswith(HOST_DATA + "/")
    97	    os.makedirs(a.out, exist_ok=True)
    98	    cont_out = CONT_DATA + a.out[len(HOST_DATA):]
    99	    prov = provenance(a.out)
   100	    js = jobs(a.plan, a.chunk)
   101	    print(f"[orch] {len(js)} jobs, {sum(j[4] for j in js)} episodes -> {a.out}  commit={prov['git_commit'][:8]} dirty={prov['git_dirty_sha256'][:8]}")
   102	    json.dump({"plan": a.plan, "jobs": js, "slots": a.slots}, open(os.path.join(a.out, "plan.json"), "w"), indent=1)
   103	    if a.dry_run:
   104	        for j in js:
   105	            print("  ", j)
   106	        return
   107	    q = queue.Queue()
   108	    for j in js:
   109	        q.put(j)
   110	    stop = threading.Event()
   111	    log = open(os.path.join(a.out, "orchestrate.log"), "a")
   112	    lock = threading.Lock()
   113	
   114	    def say(msg):
   115	        with lock:
   116	            line = f"[{datetime.datetime.now():%m-%d %H:%M:%S}] {msg}"
   117	            print(line, flush=True); log.write(line + "\n"); log.flush()
   118	
   119	    def worker(slot):
   120	        port, gpu, tm = slot.split(":")
   121	        while not stop.is_set():
   122	            try:
   123	                sub, scen, town, start, n = q.get_nowait()
   124	            except queue.Empty:
   125	                return
   126	            free = shutil.disk_usage(a.out).free / 1024 ** 3
   127	            if free < a.min_free_gb:
   128	                say(f"slot {port}: free disk {free:.0f} GB < {a.min_free_gb} → stop launching"); stop.set(); return
   129	            say(f"slot {port}: START {sub} {town} ids {start}..{start + n - 1}")
   130	            cmd = ["docker", "exec", "-w", "/workspace", "cyh-carla", "bash", "scripts/run_job_v6.sh", scen, cont_out,
   131	                   sub, town, str(start), str(n), str(a.seed_base), port, gpu, tm, cont_out + "/provenance.json"]
   132	            with open(os.path.join(a.out, f".job_{sub}_{town}_{start}.log"), "a") as lf:
   133	                rc = subprocess.run(cmd, stdout=lf, stderr=subprocess.STDOUT).returncode
   134	            say(f"slot {port}: DONE  {sub} {town} ids {start}..{start + n - 1} rc={rc}")
   135	
   136	    th = [threading.Thread(target=worker, args=(s,)) for s in a.slots.split(",")]
   137	    for t in th:
   138	        t.start()
   139	    for t in th:
   140	        t.join()
   141	    say("ALL_DONE")
   142	
   143	
   144	if __name__ == "__main__":
   145	    main()

