   270	    def _pick_target_anchor(self) -> "carla.Transform":
   271	        """Target spawn transform. On occlusion-biased episodes, spawn on a map spawn
   272	        point whose forward lane drives under an overhead occluder (A1c③); otherwise a
   273	        random spawn point. Falls back to random if no occluder anchors in this town."""
   274	        if getattr(self, "_occlusion_biased", False):
   275	            anchors = self._occluder_anchors()
   276	            if anchors:
   277	                return random.choice(anchors)
   278	        if self._spawn_points:
   279	            return random.choice(self._spawn_points)
   280	        return carla.Transform(carla.Location(0, 0, 1))
   281	
   282	    def _occluder_anchors(self) -> list:
   283	        """Lazily load (build + cache once) the current town's occluder-leading spawns."""
   284	        town = self._world.get_map().name.split("/")[-1]
   285	        cache = getattr(self, "_occ_anchor_cache", {})
   286	        if town not in cache:
   287	            from scene.occluder_cache import load_or_build, anchors_to_transforms
   288	            occ_cfg = self._config.get("occlusion", {})
   289	            params = {k: occ_cfg[k] for k in
   290	                      ("look_ahead_m", "step_m", "up_ray_m",
   291	                       "min_clearance_m", "max_clearance_m",
   292	                       "min_enter_m", "max_cover_span_m") if k in occ_cfg}
   293	            try:
   294	                data = load_or_build(self._world, town,
   295	                                     occ_cfg.get("cache_dir", "/data/occ_cache"), params)
   296	                cache[town] = anchors_to_transforms(data)
   297	            except RuntimeError:
   298	                cache[town] = []
   299	            self._occ_anchor_cache = cache
   300	            print(f"  [occlusion] {town}: {len(cache[town])} occluder-leading spawns")
   301	        return cache[town]
   302	
   303	    def _pick_target_class(self, scene_cfg: dict) -> str:
   304	        weights = scene_cfg.get("target_class_weights", {"car": 1.0})
   305	        classes = list(weights.keys())
   306	        probs = np.array([weights[c] for c in classes], dtype=float)
   307	        probs = probs / probs.sum()
   308	        return str(np.random.choice(classes, p=probs))
   309	
   310	    def _pick_strategy(self, scene_cfg: dict, target_class: str) -> str:
   311	        if target_class != "car":
   312	            return "same_class"
   313	        weights = scene_cfg.get("similarity_strategy_weights", {
   314	            "same_color_diff_shape": 0.4, "same_shape_diff_color": 0.4, "distinct": 0.2})
   315	        strategies = list(weights.keys())
   316	        probs = np.array([weights[s] for s in strategies], dtype=float)
   317	        probs = probs / probs.sum()
   318	        return str(np.random.choice(strategies, p=probs))
