   496	    def _nav_near(self, center, radius: float, count: int, attempts: int = 120) -> list:
   497	        """Sample navmesh locations within `radius` metres of `center`."""
   498	        out = []
   499	        for _ in range(attempts):
   500	            loc = self._world.get_random_location_from_navigation()
   501	            if loc is not None and loc.distance(center) <= radius:
   502	                out.append(loc)
   503	                if len(out) >= count:
   504	                    break
   505	        return out
