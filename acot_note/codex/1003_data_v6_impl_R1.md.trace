   670	    def recycle_lost_lookalikes(self) -> None:
   671	        """Smooth off-screen recycle (spec §4d): keep >=2 SIMILAR look-alikes co-visible
   672	        with the target by teleporting one that has drifted FAR off-camera back into view
   673	        AHEAD of the target. Robustness guards (the two failure modes that disabled the old
   674	        version): only OFF-screen actors move (real-camera projection → no visible jump);
   675	        the destination slot is on a DRIVING lane and validated CLEAR of every nearby
   676	        vehicle (no collision). Only fires when <2 look-alikes are currently on-screen, so
   677	        it does no work (and no world query) while co-visibility is already fine. Keeping
   678	        the look-alikes near the target also keeps the framing centroid near the target →
   679	        the target stays in-frame (fixes the earlier off-screen instability)."""
   680	        cfg = self._config.get("scene", {}).get("covisibility", {})
   681	        if not cfg.get("enabled", True) or self._target is None or self.drone is None:
   682	            return
   683	        try:
   684	            cam_t = self.drone.get_camera_transform()
   685	            tloc = self._target.transform.location
   686	        except RuntimeError:
   687	            return
   688	        tgt_wp = self._map.get_waypoint(tloc)
   689	        if tgt_wp is None:
   690	            return
   691	        W, H = self._config.get("output", {}).get("rgb_resolution", [336, 336])
   692	        _fov = float(self._config.get("output", {}).get("fov", 90.0))   # §10: match sensor FOV
   693	        M = np.array(cam_t.get_inverse_matrix())
   694	        focal = W / (2.0 * np.tan(np.radians(_fov) / 2.0))
   695	
   696	        def _visible(p) -> bool:
   697	            q = M @ np.array([p[0], p[1], p[2], 1.0])
   698	            if q[0] <= 0.1:
   699	                return False
   700	            u = focal * (q[1] / q[0]) + W / 2.0
   701	            v = focal * (-q[2] / q[0]) + H / 2.0
   702	            return 0 <= u < W and 0 <= v < H
   703	
   704	        far = float(cfg.get("recycle_radius", 55.0))
   705	        clr = float(cfg.get("min_clearance", 6.0))
