    14	import numpy as np
    15	from scipy.ndimage import uniform_filter1d
    16	
    17	# ---------------------------------------------------------------------------
    18	# Correct offline projection (ported verbatim from acot_probe/projection.py so the
    19	# training labels match the layer-16 grounding probe). Uses the per-frame camera
    20	# pose stored by the recorder (state/cam_*) incl. pitch & yaw, and the real image
    21	# size — replaces the old buggy 224-hardcoded / yaw-only projection.
    22	# ---------------------------------------------------------------------------
    23	_FOV_DEG = 90.0
    24	_VEHICLE_SIZE_M = 4.0        # pseudo-box scale (data stores 3D centres only)
    25	_BOX_MIN_PX = 8.0
    26	_BOX_MAX_PX = 140.0
    27	
    28	
    29	def _carla_matrix(x, y, z, pitch, yaw, roll=0.0) -> np.ndarray:
    30	    """CARLA Transform.get_matrix() (local->world), angles in DEGREES."""
    31	    p, yw, r = math.radians(pitch), math.radians(yaw), math.radians(roll)
    32	    cp, sp = math.cos(p), math.sin(p)
    33	    cy, sy = math.cos(yw), math.sin(yw)
    34	    cr, sr = math.cos(r), math.sin(r)
    35	    m = np.eye(4, dtype=np.float64)
    36	    m[0, 0] = cp * cy; m[0, 1] = cy * sp * sr - sy * cr; m[0, 2] = -cy * sp * cr - sy * sr; m[0, 3] = x
    37	    m[1, 0] = cp * sy; m[1, 1] = sy * sp * sr + cy * cr; m[1, 2] = -sy * sp * cr + cy * sr; m[1, 3] = y
    38	    m[2, 0] = sp;      m[2, 1] = -cp * sr;               m[2, 2] = cp * cr;                 m[2, 3] = z
    39	    return m
    40	
    41	
    42	def _project(world_xyz, campose, W, H, fov=_FOV_DEG):
    43	    """Project a world point with campose=(x,y,z,pitch,yaw). Returns (u,v,depth) in
    44	    pixels, or None if behind the camera."""
    45	    M = np.linalg.inv(_carla_matrix(*campose))
    46	    q = M @ np.array([world_xyz[0], world_xyz[1], world_xyz[2], 1.0])
    47	    depth = q[0]
    48	    if depth <= 0.1:
    49	        return None
    50	    f = W / (2.0 * math.tan(math.radians(fov) / 2.0))
    51	    return f * (q[1] / depth) + W / 2.0, f * (-q[2] / depth) + H / 2.0, depth
    52	
    53	
    54	def _pseudo_box(depth, W, fov=_FOV_DEG) -> float:
    55	    f = W / (2.0 * math.tan(math.radians(fov) / 2.0))
    56	    return float(np.clip(f * _VEHICLE_SIZE_M / max(depth, 0.1), _BOX_MIN_PX, _BOX_MAX_PX))
    57	
    58	
    59	# Threshold on structural occlusion above which the target counts as "not usefully
    60	# visible" (majority of target→camera rays blocked) → mask the ACTION imitation loss.
    61	_OCCLUDED_THRESH = 0.5
    62	
    63	
    64	def compute_occlusion_labels(bbox_u, bbox_v, bbox_w, occ_raycast, W, H,
    65	                             occluded_thresh: float = _OCCLUDED_THRESH):
    66	    """Split occlusion into THREE non-overlapping signals (A1c ②), so the IAR
    67	    occlusion head learns structural occlusion and NOT "out of frame":
    68	
    69	      occ_structural [0,1] : target IS in frame but hidden by geometry
    70	                             (occ_raycast gated to in-frame). 0 when off-screen.
    71	      off_screen     {0,1} : target is behind the camera OR projected outside the
    72	                             image — a DISTINCT signal (drives search/re-acquisition).
    73	      occluded       {0,1} : "target not usefully visible" mask =
    74	                             (occ_structural >= thresh) OR off_screen. Use it to MASK
    75	                             the action imitation loss (expert used privileged GT the
    76	                             policy can't see); the EAR waypoint loss stays UNmasked so
    77	                             the model still learns to predict the re-emergence point.
    78	
    79	    All inputs/outputs are 1-D arrays of length n; outputs are float32 (0/1 or [0,1]).
    80	    """
    81	    bbox_u = np.asarray(bbox_u, dtype=np.float32)
    82	    bbox_v = np.asarray(bbox_v, dtype=np.float32)
    83	    bbox_w = np.asarray(bbox_w, dtype=np.float32)
    84	    behind = bbox_w == 0.0                                   # (-1,-1,0,0) sentinel
    85	    in_frame = (bbox_u >= 0) & (bbox_u < W) & (bbox_v >= 0) & (bbox_v < H) & ~behind
    86	    off_screen = (~in_frame).astype(np.float32)              # behind OR outside frame
    87	    ray = (np.asarray(occ_raycast, dtype=np.float32)
    88	           if occ_raycast is not None else np.zeros_like(bbox_u))
    89	    occ_structural = np.where(in_frame, ray, 0.0).astype(np.float32)
    90	    occluded = ((occ_structural >= occluded_thresh) | (off_screen > 0)).astype(np.float32)
    91	    return occ_structural, off_screen, occluded
    92	
    93	
    94	class PostProcessor:
    95	    """Add training annotations to raw recording data."""
    96	
    97	    def __init__(self, output_dir: Path, fov: float | None = None, allow_legacy_fov: bool = False):
    98	        self._output_dir = Path(output_dir)
    99	        # v6: the episode's own attrs['fov'] (written by the recorder) is authoritative; `fov` is only
   100	        # a cross-check. Files without the attr are refused unless allow_legacy_fov (then `fov`/90 used).
   101	        self._allow_legacy_fov = bool(allow_legacy_fov)
   102	        # §10: the sensor FOV was narrowed 90→70; bbox/off_screen projection MUST use the
   103	        # SAME fov as the camera (else off_screen under-reports — the target leaves the real
   104	        # 70° frame but a 90° projection still counts it in-frame). Caller passes output.fov.
   105	        self._fov = None if fov is None else float(fov)
   106	
   107	    def process_episode(self, episode_path: Path) -> None:
   108	        """Add annotations to one episode HDF5 file."""
   109	        with h5py.File(episode_path, "r+") as f:
   110	            n_steps = f["rgb"].shape[0]
   111	            if "fov" in f.attrs:
   112	                fov = float(f.attrs["fov"])
   113	                if self._fov is not None and abs(fov - self._fov) > 1e-6:
   114	                    raise ValueError(f"{episode_path}: attrs fov={fov} != expected {self._fov}")
   115	            elif self._allow_legacy_fov:
   116	                fov = self._fov if self._fov is not None else _FOV_DEG
   117	            else:
   118	                raise ValueError(f"{episode_path}: no attrs['fov'] — refusing to guess the camera FOV")
   119	            self._fov = fov
   120	
   121	            # 1. Correct-projection 2D bboxes: TARGET + ALL DISTRACTORS
   122	            bboxes = self._compute_bboxes(f, n_steps, self._fov)               # (n, 4)
   123	            dbboxes = self._compute_distractor_bboxes(f, n_steps, self._fov)   # (n, D, 4)
   124	
   125	            # 2. Occlusion (from the correct target bbox)
   126	            occlusions = self._compute_occlusions(f, n_steps, bboxes)
   127	
   128	            # 2b. Separated occlusion labels (A1c ②): structural (in-frame, hidden by
   129	            #     geometry) vs off-screen vs the "occluded" action-loss mask.
   130	            H, W = int(f["rgb"].shape[1]), int(f["rgb"].shape[2])
   131	            ray = (f["state/occ_raycast"][:n_steps].astype(np.float32)
   132	                   if "state/occ_raycast" in f else None)
   133	            occ_struct, off_screen, occluded = compute_occlusion_labels(
   134	                bboxes[:, 0], bboxes[:, 1], bboxes[:, 2], ray, W, H)
   135	
   136	            # 3. Compute EAR waypoint ground truth (unchanged — no recompute needed)
   137	            waypoints, wp_sigmas = self._compute_waypoints(f, n_steps)
   138	
   139	            # 4. Compute search_mode ground truth (from corrected occlusion)
   140	            search_modes = self._compute_search_modes(occlusions, n_steps)
   141	
   142	            # Write annotations
   143	            self._write_dataset(f, "annotation/bbox_u", bboxes[:, 0])
   144	            self._write_dataset(f, "annotation/bbox_v", bboxes[:, 1])
   145	            self._write_dataset(f, "annotation/bbox_w", bboxes[:, 2])
   146	            self._write_dataset(f, "annotation/bbox_h", bboxes[:, 3])
   147	            self._write_dataset(f, "annotation/occlusion", occlusions)
   148	            # A1c ② — separated, non-overlapping occlusion signals.
   149	            self._write_dataset(f, "annotation/occ_structural", occ_struct)
   150	            self._write_dataset(f, "annotation/off_screen", off_screen)
   151	            self._write_dataset(f, "annotation/occluded", occluded)
   152	            self._write_dataset(f, "annotation/search_mode", search_modes)
   153	            # Distractor 2D bboxes (n, D, 4) [u,v,w,h] for Stage-2 target-ID loss.
   154	            self._write_dataset(f, "distractors/bbox", dbboxes)
   155	
   156	            # Waypoints: shape (n_steps, 3, 3) → (n_steps, 9)
   157	            wp_flat = waypoints.reshape(n_steps, -1)
   158	            self._write_dataset(f, "annotation/waypoints", wp_flat)
   159	            self._write_dataset(f, "annotation/waypoint_sigma", wp_sigmas)
   160	
   161	            # v6 per-actor labels (recorded live) → visibility, gap-breaking tracklet ids, re-entry events
   162	            if "actors" in f:
   163	                self._v6_post(f)
   164	
   165	            # Finalize the language with the target's ACTUAL early motion (accurate
   166	            # "about to turn left / stop / accelerate"), derived from the trajectory.
   167	            self._finalize_language(f, n_steps)
   168	
   169	    # ------------------------------------------------------------------
   170	    # Annotation computation
   171	    # ------------------------------------------------------------------
   172	
   173	    # v6 postprocess constants (also written to attrs so consumers never guess)
   174	    V6_VIS_MIN_PX = 20          # an actor counts as visible if >= this many instance pixels
   175	    V6_TRACKLET_GAP = 10        # frames (1 s @10 fps) of invisibility after which a tracklet id breaks
   176	    V6_REENTRY_MIN_GAP = 10     # frames; target re-entry events are logged after gaps >= this
   177	
   178	    def _v6_post(self, f: h5py.File) -> None:
   179	        from recording.labels_v6 import reentry_events, tracklet_ids
   180	        g = f["actors"]
   181	        vis = g["vis_px"][:] >= self.V6_VIS_MIN_PX                       # (T, A)
   182	        role = g["role"][:]
   183	        trk = tracklet_ids(vis, self.V6_TRACKLET_GAP)
   184	        off_t = g["in_frame"][:, 0] == 0
   185	        n_look = (vis[:, 1:] & (role[1:] == 1)[None]).sum(1)
   186	        n_veh = vis[:, 1:].sum(1)
   187	        ev = reentry_events(vis[:, 0], off_t, n_look, n_veh, self.V6_REENTRY_MIN_GAP)
   188	        self._write_dataset(f, "actors/visible", vis, np.uint8)
   189	        self._write_dataset(f, "actors/tracklet_id", trk, np.int32)
   190	        self._write_dataset(f, "events/target_reentry", ev, np.int32)
   191	        f.attrs["v6_vis_min_px"] = self.V6_VIS_MIN_PX
   192	        f.attrs["v6_tracklet_gap_frames"] = self.V6_TRACKLET_GAP
   193	        f.attrs["v6_reentry_min_gap_frames"] = self.V6_REENTRY_MIN_GAP
   194	        f.attrs["v6_reentry_columns"] = "frame,gap_frames,cause(0 off/1 occ/2 mixed),n_lookalike_vis,n_scene_vehicle_vis"
   195	
   196	    @staticmethod
   197	    def _campose(f, i):
   198	        return (float(f["state/cam_x"][i]), float(f["state/cam_y"][i]),
   199	                float(f["state/cam_z"][i]), float(f["state/cam_pitch"][i]),
   200	                float(f["state/cam_yaw"][i]))
   201	
   202	    @staticmethod
   203	    def _compute_bboxes(f: h5py.File, n: int, fov: float = _FOV_DEG) -> np.ndarray:
   204	        """TARGET 2D pseudo-bbox [u, v, w, h] (px) via the CORRECT projection (real
   205	        camera pose incl. pitch/yaw + actual W,H + sensor fov). [-1,-1,0,0] if behind."""
   206	        H, W = int(f["rgb"].shape[1]), int(f["rgb"].shape[2])
   207	        tx, ty, tz = f["target/tx"][:], f["target/ty"][:], f["target/tz"][:]
   208	        out = np.zeros((n, 4), dtype=np.float32)
   209	        for i in range(n):
   210	            pr = _project((tx[i], ty[i], tz[i]), PostProcessor._campose(f, i), W, H, fov)
   211	            if pr is None:
   212	                out[i] = (-1, -1, 0, 0)
   213	                continue
   214	            u, v, depth = pr
   215	            s = _pseudo_box(depth, W, fov)
   216	            out[i] = (u, v, s, s)
   217	        return out
   218	
   219	    @staticmethod
   220	    def _compute_distractor_bboxes(f: h5py.File, n: int, fov: float = _FOV_DEG) -> np.ndarray:

 succeeded in 37ms:
   221	        """ALL distractors' 2D pseudo-bbox → (n, D, 4) [u,v,w,h] (px) for Stage-2
   222	        L_target_id. [-1,-1,0,0] where a distractor is behind the camera."""
   223	        if "distractors/positions" not in f:
   224	            return np.zeros((n, 0, 4), dtype=np.float32)
   225	        H, W = int(f["rgb"].shape[1]), int(f["rgb"].shape[2])
   226	        dpos = f["distractors/positions"][:, :, :3]      # (n, D, 3)
   227	        D = dpos.shape[1]
   228	        out = np.zeros((n, D, 4), dtype=np.float32)
   229	        out[..., 0:2] = -1.0
   230	        for i in range(n):
   231	            cp = PostProcessor._campose(f, i)
   232	            for d in range(D):
   233	                pr = _project((dpos[i, d, 0], dpos[i, d, 1], dpos[i, d, 2]), cp, W, H, fov)
   234	                if pr is None:
   235	                    continue
   236	                u, v, depth = pr
   237	                s = _pseudo_box(depth, W, fov)
   238	                out[i, d] = (u, v, s, s)
   239	        return out
   240	
   241	    @staticmethod
   242	    def _compute_occlusions(f: h5py.File, n: int, bboxes: np.ndarray) -> np.ndarray:
   243	        """Occlusion in [0,1], combining:
   244	          - view geometry from the correct bbox: 1.0 behind camera (w==0), 0.5 in-front
   245	            but out-of-frame, 0.0 in-frame; and
   246	          - STRUCTURAL occlusion (state/occ_raycast): graded fraction of target→camera
   247	            rays blocked by buildings/tunnel roof while the target is still in frame
   248	            (A1b — the label §6.2/§6.4/H2 need). Absent on pre-A1b data → geometry only.
   249	        """
   250	        H, W = int(f["rgb"].shape[1]), int(f["rgb"].shape[2])
   251	        u, v, w = bboxes[:, 0], bboxes[:, 1], bboxes[:, 2]
   252	        behind = w == 0.0                       # (-1,-1,0,0) sentinel
   253	        in_frame = (u >= 0) & (u < W) & (v >= 0) & (v < H) & ~behind
   254	        occ = np.zeros(n, dtype=np.float32)
   255	        occ[behind] = 1.0
   256	        occ[~in_frame & ~behind] = 0.5
   257	        if "state/occ_raycast" in f:
   258	            occ = np.maximum(occ, f["state/occ_raycast"][:n].astype(np.float32))
   259	        return occ
   260	
   261	    @staticmethod
   262	    def _compute_waypoints(f: h5py.File, n: int) -> tuple[np.ndarray, np.ndarray]:
   263	        """Compute EAR waypoint ground truth: future target positions at +2s, +4s, +6s.
   264	
   265	        Returns:
   266	            waypoints: (n, 3, 3) → [t+2s, t+4s, t+6s] × [x, y, z]
   267	            sigmas: (n, 3) → uncertainty per waypoint
   268	        """
   269	        fps = 10
   270	        offsets = [2 * fps, 4 * fps, 6 * fps]  # 20, 40, 60 steps
   271	
   272	        waypoints = np.zeros((n, 3, 3), dtype=np.float32)
   273	        sigmas = np.zeros((n, 3), dtype=np.float32)
   274	
   275	        for i in range(n):
   276	            for j, offset in enumerate(offsets):
   277	                future_idx = min(i + offset, n - 1)
   278	                tx = f["target/tx"][future_idx]
   279	                ty = f["target/ty"][future_idx]
   280	                tz = f["target/tz"][future_idx]
   281	
   282	                # Add Kalman-style smoothing
   283	                if i > 0 and future_idx < n - 1:
   284	                    window = f["target/tx"][i:future_idx+1]
   285	                    tx = float(np.mean(window))
   286	                    window = f["target/ty"][i:future_idx+1]
   287	                    ty = float(np.mean(window))
   288	                    window = f["target/tz"][i:future_idx+1]
   289	                    tz = float(np.mean(window))
   290	
   291	                waypoints[i, j] = [tx, ty, tz]
   292	                # Uncertainty grows with prediction horizon
   293	                sigmas[i, j] = 1.0 + 2.0 * (j + 1)
   294	
   295	        return waypoints, sigmas
   296	
   297	    @staticmethod
   298	    def _compute_search_modes(occlusions: np.ndarray, n: int) -> np.ndarray:
   299	        """Compute search_mode ground truth from occlusion level + time-since-lost.
   300	
   301	        search_mode ∈ [0, 1]:
   302	          0 = precise tracking (target fully visible)
   303	          1 = wide-area search (target lost for long duration)
   304	        """
   305	        search_modes = np.zeros(n, dtype=np.float32)
   306	        time_since_lost = 0.0
   307	
   308	        for i in range(n):
   309	            if occlusions[i] > 0.8:
   310	                time_since_lost += 0.1  # dt = 0.1s
   311	            else:
   312	                time_since_lost = max(0.0, time_since_lost - 0.2)  # decay
   313	
   314	            search_modes[i] = float(np.clip(
   315	                occlusions[i] * (1.0 + time_since_lost / 5.0), 0.0, 1.0
   316	            ))
   317	
   318	        return search_modes
   319	
   320	    @staticmethod
   321	    def _detect_maneuvers(f: h5py.File, n: int) -> list[dict]:
   322	        """Detect maneuver events from target velocity/acceleration changes."""
   323	        events = []
   324	        tspeed = f["target/tspeed"][:]
   325	        tyaw = f["target/tyaw"][:]
   326	
   327	        for i in range(1, n - 1):
   328	            accel = tspeed[i] - tspeed[i - 1]
   329	            yaw_change = abs(tyaw[i] - tyaw[i - 1])
   330	
   331	            if accel > 3.0:
   332	                events.append({"t": i * 0.1, "type": "ACCELERATION", "mag": float(accel)})
   333	            elif accel < -5.0:  # stronger threshold for braking
   334	                events.append({"t": i * 0.1, "type": "SUDDEN_STOP", "mag": float(accel)})
   335	            elif yaw_change > 15.0:  # deg/s
   336	                events.append({"t": i * 0.1, "type": "SHARP_TURN", "mag": float(yaw_change)})
   337	
   338	        return events
   339	
   340	    # ------------------------------------------------------------------
   341	    # Helpers
   342	    # ------------------------------------------------------------------
   343	
   344	    @staticmethod
   345	    def _finalize_language(f, n: int) -> None:
   346	        """Rewrite attrs['language'] using the target's actual early trajectory so the
   347	        motion clause ('about to turn left', 'about to stop', ...) is accurate."""
   348	        import random as _r
   349	        from scene.language_generator import (
   350	            LanguageGenerator, spatial_and_distance, motion_phrase)
   351	        a = f.attrs
   352	        desc = a.get("target_desc", "")
   353	        if not desc:
   354	            return
   355	        num_similar = int(a.get("num_similar", 0))
   356	        w = min(50, n - 1)                          # ~5s @ 10Hz
   357	        start = 10 if w > 15 else 0                 # skip spawn-alignment jitter
   358	        try:
   359	            motion = motion_phrase(f["target/tyaw"][start:w + 1],
   360	                                   f["target/tspeed"][start:w + 1])
   361	        except Exception:
   362	            motion = ""
   363	        try:
   364	            spatial, dist_m = spatial_and_distance(
   365	                float(f["state/uav_x"][0]), float(f["state/uav_y"][0]),
   366	                float(f["state/uav_yaw"][0]),
   367	                float(f["target/tx"][0]), float(f["target/ty"][0]),
   368	                uz=float(f["state/uav_z"][0]), tz=float(f["target/tz"][0]))
   369	        except Exception:
   370	            spatial, dist_m = "", None
   371	        seed_str = str(a.get("seed", "0"))
   372	        seed = int(seed_str) if seed_str.lstrip("-").isdigit() else 0
   373	        a["language"] = LanguageGenerator().build_instruction(
   374	            desc, num_similar, spatial=spatial, motion=motion,
   375	            distance_m=dist_m, rng=_r.Random(seed))
   376	
   377	    @staticmethod
   378	    def _write_dataset(f: h5py.File, name: str, data: np.ndarray, dtype=np.float32) -> None:
   379	        if name in f:
   380	            del f[name]
   381	        f.create_dataset(name, data=data.astype(dtype), compression="gzip",
   382	                         compression_opts=4)

