   320	    def _setup_vehicle_scene(self, plan: dict, scene_cfg: dict) -> None:
   321	        """Spawn a vehicle target + distractors on the same road segment.
   322	
   323	        Position-decorrelation (2026-07-29, per acot_note/data-fix-spec.md): the target
   324	        must NOT sit in a predictable geometric slot, or a pure-geometry classifier
   325	        selects it WITHOUT language (the benchmark leak — position-only MLP ~3-5%). Two
   326	        levers, both config-gated by `scene.decorrelate_position.enabled`:
   327	          L1 slot: the target + its SIMILAR look-alikes are drawn from ONE symmetric
   328	             slot band and the target takes a RANDOM slot (was: target always at the
   329	             anchor, distractors biased ahead) → target's depth/rank == a distractor's.
   330	          L2 framing: the expert servos the {target+similar} CENTROID, not the target
   331	             (`self._frame_centroid`, applied in expert_action + _cluster_centroid), so
   332	             the target is a random cluster member (was: always the framed reference) →
   333	             its image position / depth / rank distribution == a distractor's.
   334	        """
   335	        anchor = self._pick_target_anchor()
   336	        tgt = plan["target"]
   337	        # Positive % = SLOWER than the speed limit (official generate_traffic.py uses
   338	        # +30%). Calm, shared convoy speed so they travel together, not aggressively.
   339	        convoy_speed = random.uniform(0, 18)
   340	        dec_cfg = scene_cfg.get("decorrelate_position", {})
   341	        decorrelate = bool(dec_cfg.get("enabled", True))
   342	
   343	        self._distractors = []
   344	        self._distractor_meta = []
   345	        anchor_wp = self._map.get_waypoint(anchor.location)
   346	        # Candidate lanes = anchor lane + same-direction neighbours, so vehicles spread
   347	        # ACROSS lanes (co-visible) instead of gridlocking one lane.
   348	        lanes = [anchor_wp]
   349	        for getter in ("get_left_lane", "get_right_lane"):
   350	            try:
   351	                cand = getattr(anchor_wp, getter)()
   352	            except RuntimeError:
   353	                cand = None
   354	            if (cand is not None and cand.lane_type == carla.LaneType.Driving
   355	                    and cand.lane_id * anchor_wp.lane_id > 0):
   356	                lanes.append(cand)
   357	
   358	        if decorrelate:
   359	            band = float(dec_cfg.get("cluster_band_m", 24.0))
   360	            # L1 — target gets a RANDOM slot; capture its along-road offset off_t so the
   361	            # distractors can be placed to BRACKET it in depth (§8: the target used to be
   362	            # the depth-nearest candidate ~50% of frames because fillers were pushed forward
   363	            # /farther by the down-forward camera — no candidate was ever nearer than the
   364	            # target. Bracketing off_t makes the target a uniform depth-RANK member).
   365	            off_t = 0.0
   366	            self._target = None
   367	            for _try in range(6):
   368	                off_t = 0.0 if _try == 5 else random.uniform(-band, band)
   369	                sp = (anchor if _try == 5 else
   370	                      self._lane_offset_transform(random.choice(lanes), off_t))
   371	                try:
   372	                    self._target = VehicleTarget(
   373	                        self._world, tgt["bp"], sp, carla_client=self._client,
   374	                        color=COLOR_RGB.get(tgt.get("color") or ""),
   375	                        # SAME speed distribution as distractors so the target does not drift
   376	                        # to a systematic depth within the group (hero-only dynamics leaked).
   377	                        role_name="hero", speed_diff=convoy_speed + random.uniform(-5, 5))
   378	                    break
   379	                except RuntimeError:
   380	                    continue
   381	            for d in plan["distractors"]:
   382	                # Similars share the anchor ±band (INDEPENDENT of the target — they + the
   383	                # target form the framed centroid, so the target stays a random member).
   384	                # NOTE: the residual DEPTH shortcut (target is depth-nearest ~50% of frames)
   385	                # is NOT fixed by any distractor PLACEMENT — the target sits at the back of
   386	                # the followed cluster by tracking geometry; see data-fix-spec §8 follow-up.
   387	                if d.get("similar"):
   388	                    off = random.uniform(-band, band)
   389	                else:
   390	                    off = random.uniform(8, 30) * random.choice([-1, 1])
   391	                self._spawn_distractor(
   392	                    d, self._lane_offset_transform(random.choice(lanes), off), convoy_speed)
   393	            # L2 — the expert servos the CLUSTER CENTROID (target + similar look-alikes),
   394	            # NOT the target (applied in expert_action). The target is then a uniformly
   395	            # random member of a tight co-visible cluster → its image position / depth /
   396	            # rank distribution is IDENTICAL to a distractor's by construction (any
   397	            # deterministic target-centred framing, even an offset one, leaks). The tight
   398	            # ±band cluster + wide FOV keeps every member on-screen.
   399	            self._frame_centroid = True
   400	        else:
   401	            # Legacy layout (leaky): target at the anchor, distractors biased ahead.
   402	            self._frame_centroid = False
   403	            self._target = VehicleTarget(
   404	                self._world, tgt["bp"], anchor, carla_client=self._client,
   405	                color=COLOR_RGB.get(tgt.get("color") or ""),
   406	                role_name="hero", speed_diff=convoy_speed + random.uniform(-3, 3))
   407	            ahead_bias = float(scene_cfg.get("distractor_ahead_bias", 0.7))
   408	            for d in plan["distractors"]:
   409	                near, far = (5, 28) if d.get("similar") else (10, 55)
   410	                off = (random.uniform(near, far) if random.random() < ahead_bias
   411	                       else -random.uniform(6, 18))
   412	                self._spawn_distractor(
   413	                    d, self._lane_offset_transform(random.choice(lanes), off), convoy_speed)
   414	
   415	        self._target_in_frame = True      # updated each step by the recorder (recovery gate)
   416	        self._recovery_mode = False       # hysteresis state for the centroid↔recovery framing switch
   417	        self._reacq = 0
   418	        self._assign_convoy_route()
   419	
   420	    def _lane_offset_transform(self, base_wp, offset_m: float) -> "carla.Transform":
   421	        """Walk `offset_m` along the lane (forward if +, backward if −) from base_wp and
   422	        return a spawn transform with small lateral jitter (raised 0.3 m)."""
   423	        wp = base_wp
   424	        for _ in range(int(abs(offset_m) / 8)):
   425	            nxt = wp.next(8.0) if offset_m > 0 else wp.previous(8.0)
   426	            if not nxt:
   427	                break
   428	            wp = nxt[0]
   429	        loc = wp.transform.location
   430	        return carla.Transform(
   431	            carla.Location(x=loc.x + random.uniform(-1.0, 1.0),
   432	                           y=loc.y + random.uniform(-1.0, 1.0), z=loc.z + 0.3),
   433	            wp.transform.rotation)
   434	
   435	    def _spawn_distractor(self, d: dict, sp: "carla.Transform", convoy_speed: float) -> None:
   436	        """Spawn one distractor (vehicle or pedestrian) at sp; skip on spawn collision."""
   437	        try:
   438	            cls = d["cls"]
   439	            if cls in VEHICLE_CLASSES:
   440	                obj = VehicleTarget(
   441	                    self._world, d["bp"], sp, carla_client=self._client,
   442	                    color=COLOR_RGB.get(d.get("color") or ""),
   443	                    role_name="distractor", speed_diff=convoy_speed + random.uniform(-5, 5))
   444	            else:
   445	                obj = PedestrianTarget(self._world, d["bp"], sp, walk_speed=random.uniform(2.5, 3.5))
   446	            self._distractors.append(obj)
   447	            self._distractor_meta.append({
   448	                "id": obj.id, "bp": d["bp"], "color": d.get("color"),
   449	                "desc": d["desc"], "similar": d.get("similar", False), "cls": cls,
   450	                "desired_off": d.get("_desired_off"),   # §8 depth station-keeping target (or None)
   451	            })
   452	        except RuntimeError:
   453	            pass  # spawn collision — skip this distractor
   454	
   455	    def _cluster_centroid(self, target_pos: np.ndarray) -> np.ndarray:
   456	        """Mean world position of the co-visible cluster = target + its SIMILAR look-alikes,
   457	        used as the expert's framing setpoint so the target is a random cluster member (not
   458	        the framed reference). Reuses the distractor positions the recorder already queried
   459	        this step (`self._distractor_states`, set in get_distractor_states) → no extra CARLA
   460	        RPCs. Falls back to the target if no similar distractor is currently alive."""
   461	        tp = np.asarray(target_pos, dtype=float)
   462	        pts = [tp]
   463	        ds = getattr(self, "_distractor_states", None)
   464	        if ds is not None and len(ds):
   465	            for row, meta in zip(ds, self._distractor_meta):
   466	                if not meta.get("similar"):
   467	                    continue
   468	                p = np.asarray(row[:3], dtype=float)
   469	                if not np.isnan(p).any():
   470	                    pts.append(p)
   471	        return np.mean(pts, axis=0)
   472	
   473	    def _assign_convoy_route(self) -> None:
   474	        """Give the target + vehicle distractors the SAME route (official TM.set_route)
   475	        so they drive together on the same roads → stay co-visible while obeying
   476	        traffic rules, with no teleporting (replaces recycle_lost_lookalikes)."""
   477	        cfg = self._config.get("scene", {}).get("convoy", {})
   478	        if not cfg.get("enabled", True):
   479	            return
   480	        tm = self._client.get_trafficmanager(_tm_port())
   481	        if not hasattr(tm, "set_route"):
   482	            return
   483	        sb = float(cfg.get("straight_bias", 0.7))
   484	        opts = ["Straight"] * max(1, int(sb * 10)) + ["Left", "Right"] * max(1, int((1 - sb) * 5))
   485	        route = [random.choice(opts) for _ in range(int(cfg.get("route_len", 80)))]
   486	        members = ([self._target] if self._target else []) + self._distractors
   487	        for m in members:
   488	            v = getattr(m, "_vehicle", None)
   489	            if v is None:
   490	                continue
   491	            try:
   492	                tm.set_route(v, list(route))
   493	            except (RuntimeError, TypeError):
   494	                pass
