     1	"""PID visual servoing controller for UAV target tracking.
     2	
     3	Three independent PID loops:
     4	  - XY: horizontal position tracking → keeps target at forward projection center
     5	  - Z:  altitude control → maintains desired viewing height above target
     6	  - Yaw: orientation control → faces the target
     7	
     8	With dead-reckoning fallback when target is temporarily lost.
     9	"""
    10	
    11	from __future__ import annotations
    12	
    13	from dataclasses import dataclass, field
    14	from typing import Optional
    15	
    16	import numpy as np
    17	
    18	
    19	@dataclass
    20	class PIDGains:
    21	    """PID gain triplet with anti-windup clamping."""
    22	    kp: float
    23	    ki: float
    24	    kd: float
    25	    integral_max: float = 5.0   # anti-windup clamp
    26	    output_max: float = 15.0     # m/s or deg/s
    27	
    28	
    29	@dataclass
    30	class PIDState:
    31	    """Per-loop PID state (reset each episode)."""
    32	    prev_error: float = 0.0
    33	    integral: float = 0.0
    34	
    35	
    36	@dataclass
    37	class VelocityLimits:
    38	    """Physical velocity constraints for realistic UAV behavior."""
    39	    xy_max: float = 15.0       # m/s horizontal
    40	    z_max: float = 5.0         # m/s vertical
    41	    yaw_rate_max: float = 60.0 # deg/s
    42	
    43	
    44	@dataclass
    45	class PIDVisualServoConfig:
    46	    """Full configuration for the PID visual servoing controller."""
    47	    xy: PIDGains = field(default_factory=lambda: PIDGains(kp=2.0, ki=0.05, kd=0.3))
    48	    z:  PIDGains = field(default_factory=lambda: PIDGains(kp=1.2, ki=0.05, kd=0.2, output_max=5.0))
    49	    yaw: PIDGains = field(default_factory=lambda: PIDGains(kp=1.5, ki=0.02, kd=0.1, output_max=60.0))
    50	    limits: VelocityLimits = field(default_factory=VelocityLimits)
    51	    viewing_height_offset: float = 15.0  # meters above target
    52	    dt: float = 0.1                      # control period (10 Hz)
    53	    dead_reckon_timeout: float = 5.0     # seconds before abandoning prediction
    54	
    55	
    56	class PIDVisualServo:
    57	    """Three-layer PID controller for UAV visual tracking.
    58	
    59	    Usage:
    60	        pid = PIDVisualServo(config)
    61	        for each timestep:
    62	            action = pid.compute(target_position, uav_position, uav_yaw, target_visible, timestamp)
    63	            drone.step(*action)
    64	    """
    65	
    66	    def __init__(self, config: PIDVisualServoConfig):
    67	        self._cfg = config
    68	        self._state_xy = PIDState()
    69	        self._state_z = PIDState()
    70	        self._state_yaw = PIDState()
    71	        self._last_known_target: Optional[np.ndarray] = None
    72	        self._last_known_velocity: np.ndarray = np.zeros(3)
    73	        self._last_seen_at: Optional[float] = None
    74	        self._target_lost_at: Optional[float] = None
    75	
    76	    # ------------------------------------------------------------------
    77	    # Public API
    78	    # ------------------------------------------------------------------
    79	
    80	    def reset(self) -> None:
    81	        """Reset all PID states for a new episode."""
    82	        self._state_xy = PIDState()
    83	        self._state_z = PIDState()
    84	        self._state_yaw = PIDState()
    85	        self._last_known_target = None
    86	        self._last_known_velocity = np.zeros(3)
    87	        self._last_seen_at = None
    88	        self._target_lost_at = None
    89	
    90	    def compute(
    91	        self,
    92	        target_pos: np.ndarray,     # [x, y, z] world POSITION setpoint (may trail the target)
    93	        uav_pos: np.ndarray,        # [x, y, z] world coords
    94	        uav_yaw: float,             # degrees
    95	        target_visible: bool,
    96	        timestamp: float,
    97	        look_pos: np.ndarray | None = None,   # world point the CAMERA faces (yaw); default target_pos
    98	    ) -> tuple[float, float, float, float]:
    99	        """Compute control action: (dx, dy, dz, dyaw) in world frame.
   100	
   101	        Returns zero-vector action if no target has ever been seen.
   102	        """
   103	        if target_visible and target_pos is not None:
   104	            # Update dead-reckoning state
   105	            if self._last_known_target is not None:
   106	                self._last_known_velocity = (
   107	                    (target_pos - self._last_known_target) / self._cfg.dt
   108	                )
   109	            self._last_known_target = target_pos.copy()
   110	            self._last_seen_at = timestamp
   111	            self._target_lost_at = None
   112	            tracking_pos = target_pos
   113	        elif self._last_known_target is not None:
   114	            # Measure elapsed time from when target was last SEEN (not first reported lost)
   115	            if self._target_lost_at is None:
   116	                self._target_lost_at = timestamp
   117	            elapsed = timestamp - (self._last_seen_at
   118	                                  if self._last_seen_at is not None
   119	                                  else self._target_lost_at)
   120	            if elapsed > self._cfg.dead_reckon_timeout:
   121	                # Give up — return zero action (coast)
   122	                return (0.0, 0.0, 0.0, 0.0)
   123	            # Decay velocity over time (target probably slowed down)
   124	            decay = max(0.0, 1.0 - elapsed / self._cfg.dead_reckon_timeout)
   125	            tracking_pos = self._last_known_target + self._last_known_velocity * elapsed * decay
   126	        else:
   127	            # No target has ever been seen
   128	            return (0.0, 0.0, 0.0, 0.0)
   129	
   130	        # --- Layer 1: XY horizontal tracking ---
   131	        error_xy = tracking_pos[:2] - uav_pos[:2]
   132	        desired_xy_vel = self._pid_step(
   133	            np.linalg.norm(error_xy),
   134	            self._cfg.xy,
   135	            self._state_xy,
   136	        )
   137	        # Convert scalar speed to direction vector
   138	        if np.linalg.norm(error_xy) > 0.01:
   139	            direction_xy = error_xy / np.linalg.norm(error_xy)
   140	        else:
   141	            direction_xy = np.zeros(2)
   142	        vx_des = direction_xy[0] * desired_xy_vel
   143	        vy_des = direction_xy[1] * desired_xy_vel
   144	
   145	        # --- Layer 2: Altitude control ---
   146	        desired_z = tracking_pos[2] + self._cfg.viewing_height_offset
   147	        error_z = desired_z - uav_pos[2]
   148	        vz_des = self._pid_step(error_z, self._cfg.z, self._state_z)
   149	
   150	        # --- Layer 3: Yaw control ---
   151	        # Only yaw when there's a meaningful HORIZONTAL offset. Near-nadir (target almost
   152	        # directly under the UAV, as when it flies overhead to re-acquire) the atan2 heading
   153	        # is ill-conditioned — tiny target motion flips it wildly → the camera shakes. Hold
   154	        # the yaw inside that deadband instead of chasing the singular heading.
   155	        yaw_ref = look_pos if (look_pos is not None and target_visible) else tracking_pos
   156	        horiz = float(np.hypot(yaw_ref[0] - uav_pos[0], yaw_ref[1] - uav_pos[1]))
   157	        if horiz < 5.0:
   158	            yaw_rate = 0.0
   159	        else:
   160	            desired_yaw = np.degrees(
   161	                np.arctan2(yaw_ref[1] - uav_pos[1], yaw_ref[0] - uav_pos[0])
   162	            )
   163	            error_yaw = _normalize_angle(desired_yaw - uav_yaw)
   164	            yaw_rate = self._pid_step(error_yaw, self._cfg.yaw, self._state_yaw)
   165	
   166	        # --- Convert velocities to displacements ---
   167	        dx = np.clip(vx_des * self._cfg.dt, -self._cfg.limits.xy_max * self._cfg.dt,
   168	                      self._cfg.limits.xy_max * self._cfg.dt)
   169	        dy = np.clip(vy_des * self._cfg.dt, -self._cfg.limits.xy_max * self._cfg.dt,
   170	                      self._cfg.limits.xy_max * self._cfg.dt)
   171	        dz = np.clip(vz_des * self._cfg.dt, -self._cfg.limits.z_max * self._cfg.dt,
   172	                      self._cfg.limits.z_max * self._cfg.dt)
   173	        dyaw = np.clip(yaw_rate * self._cfg.dt, -self._cfg.limits.yaw_rate_max * self._cfg.dt,
   174	                        self._cfg.limits.yaw_rate_max * self._cfg.dt)
   175	
   176	        return (float(dx), float(dy), float(dz), float(dyaw))
   177	
   178	    # ------------------------------------------------------------------
   179	    # Internal
   180	    # ------------------------------------------------------------------
   181	
   182	    @staticmethod
   183	    def _pid_step(error: float, gains: PIDGains, state: PIDState) -> float:
   184	        """Single PID step with anti-windup clamping.
   185	
   186	        Returns: control output (velocity or rate)
   187	        """
   188	        # Proportional
   189	        p = gains.kp * error
   190	
   191	        # Integral with anti-windup
   192	        state.integral += error
   193	        state.integral = np.clip(state.integral, -gains.integral_max, gains.integral_max)
   194	        i = gains.ki * state.integral
   195	
   196	        # Derivative on measurement (not error) to avoid derivative kick
   197	        d = gains.kd * (error - state.prev_error)
   198	        state.prev_error = error
   199	
   200	        # Clamp total output
   201	        return float(np.clip(p + i + d, -gains.output_max, gains.output_max))
   202	
   203	
   204	def _normalize_angle(angle_deg: float) -> float:
   205	    """Wrap angle to [-180, 180]."""
   206	    return ((angle_deg + 180.0) % 360.0) - 180.0

