     1	#!/bin/bash
     2	# v6 data-generation job (acot_note/1003_data-regen-v6-spec.md). Inside the cyh-carla container.
     3	# Resilient like run_resilient.sh, but PARALLEL-SAFE: per-job progress file + summary jsonl, one town,
     4	# dedicated CARLA port / Vulkan GPU / TrafficManager port.
     5	#   bash scripts/run_job_v6.sh <scenario.yaml> <out_dir> <subset> <town> <start_id> <n> <seed_base> <port> <gpu> <tm_port> <provenance.json>
     6	set -u
     7	CFG="$1"; OUT="$2"; SUBSET="$3"; TOWN="$4"; START="$5"; N="$6"; SEED="$7"; PORT="$8"; GPU="$9"; TM="${10}"; PROV="${11}"
     8	JOB="${SUBSET}_${TOWN}_${START}"
     9	PROG="$OUT/.progress/$JOB"; mkdir -p "$OUT/.progress" "$OUT/.logs"
    10	export CARLA_TM_PORT="$TM"
    11	port_up() { python -c "import socket,sys;s=socket.socket();s.settimeout(1);sys.exit(0 if s.connect_ex(('127.0.0.1',$PORT))==0 else 1)" 2>/dev/null; }
    12	ensure_server() {
    13	    if port_up; then return 0; fi
    14	    echo "  [server] port $PORT down — launching CARLA (gpu $GPU)"
    15	    (cd "${CARLA_ROOT:-/home/carla}" && nohup ./CarlaUE4.sh -RenderOffScreen -carla-rpc-port="$PORT" \
    16	        -quality-level=Epic -nosound -graphicsadapter="$GPU" >/tmp/carla_server_${PORT}.log 2>&1 &)
    17	    for _ in $(seq 1 60); do if port_up; then echo "  [server] up on $PORT"; sleep 20; return 0; fi; sleep 4; done
    18	    echo "  [server] FAILED on $PORT"; return 1
    19	}
    20	END=$((START + N))
    21	for attempt in $(seq 1 100); do
    22	    next=$START
    23	    if [ -f "$PROG" ]; then next=$(( $(cat "$PROG") + 1 )); fi
    24	    remaining=$(( END - next ))
    25	    if [ "$remaining" -le 0 ]; then echo "=== [$JOB] all attempted ==="; break; fi
    26	    ensure_server || exit 1
    27	    echo "=== [$JOB] attempt $attempt: start-id=$next remaining=$remaining ==="
    28	    python scripts/generate_batch.py --num-episodes "$remaining" --start-id "$next" --config "$CFG" \
    29	        --output "$OUT" --seed "$SEED" --port "$PORT" --max-size-gb 100000 --town "$TOWN" --subset "$SUBSET" \
    30	        --progress-file "$PROG" --summary-jsonl "$OUT/episode_summaries.jsonl" --provenance "$PROV"
    31	    code=$?
    32	    if [ "$code" = 0 ]; then echo "=== [$JOB] finished cleanly ==="; break; fi
    33	    echo "=== [$JOB] exited $code; recovering in 5s ==="; sleep 5
    34	done
    35	# Top-up: skipped episodes (e.g. stationary target) are replaced from a private id block START+500+j,
    36	# so every job delivers N recorded episodes without colliding with the next chunk's ids.
    37	count_ok() { n=0; for id in "$@"; do [ -f "$OUT/episode_$(printf %06d $id).h5" ] && n=$((n+1)); done; echo $n; }
    38	ids_main=$(seq $START $((END-1)))
    39	for round in $(seq 1 3); do
    40	    ids_top=$(seq $((START+500)) $((START+500+N-1)))
    41	    have=$(count_ok $ids_main $ids_top)
    42	    [ "$have" -ge "$N" ] && break
    43	    tstart=$((START+500)); TPROG="$OUT/.progress/${JOB}_topup"
    44	    tnext=$tstart; [ -f "$TPROG" ] && tnext=$(( $(cat "$TPROG") + 1 ))
    45	    need=$(( N - have )); tend=$(( START + 500 + N ))
    46	    [ $((tnext + need)) -gt $tend ] && need=$(( tend - tnext ))
    47	    [ "$need" -le 0 ] && break
    48	    ensure_server || exit 1
    49	    echo "=== [$JOB] top-up round $round: have=$have need=$need from id $tnext ==="
    50	    python scripts/generate_batch.py --num-episodes "$need" --start-id "$tnext" --config "$CFG" \
    51	        --output "$OUT" --seed "$SEED" --port "$PORT" --max-size-gb 100000 --town "$TOWN" --subset "$SUBSET" \
    52	        --progress-file "$TPROG" --summary-jsonl "$OUT/episode_summaries.jsonl" --provenance "$PROV"
    53	done
    54	echo "=== [$JOB] delivered $(count_ok $ids_main $(seq $((START+500)) $((START+500+N-1))))/$N ==="

