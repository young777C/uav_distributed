   129	            self._tracking_standoff = float(random.uniform(float(sr[0]), float(sr[1])))
   130	            # §9: smooth per-episode camera-AIM offset so the target is NOT locked at image
   131	            # centre → decorrelates 'most-central'. The aim point = target + a ground-plane
   132	            # offset from two low-freq sinusoids (random per-episode phase/freq) whose
   133	            # amplitude scales with viewing distance (constant IMAGE spread ~aim_frac,
   134	            # target stays in frame). Smooth + independent of maneuver/loss events (§9.3.5).
   135	            self._aim_frac = float(_dec.get("aim_offset_frac", 0.32))
   136	            self._aim_fx = random.uniform(0.04, 0.11); self._aim_px = random.uniform(0.0, 6.283)
   137	            self._aim_fy = random.uniform(0.04, 0.11); self._aim_py = random.uniform(0.0, 6.283)
