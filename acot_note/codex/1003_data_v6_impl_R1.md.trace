     1	# ACoT-UAV-Track Data Generation — Default Configuration
     2	# All values can be overridden per-scenario
     3	
     4	environment:
     5	  fps: 10
     6	  max_duration_seconds: 180
     7	  seed: null                       # set per-episode by generate_batch (seed + episode_id)
     8	  max_lost_seconds: 18             # OFF-screen tolerated this long — the UAV flies to re-acquire
     9	                                   # (aerial tracking: no road constraint → cut to re-appearance);
    10	                                   # truncate only if recovery genuinely fails. Was 5 (too eager).
    11	  max_occluded_seconds: 12         # in-frame but structurally occluded → tolerated this long (A1c③)
    12	  loss_events:                     # (c) deliberate SUSTAINED target-loss for predict-intercept.
    13	    enabled: false                 #     scenarios enable it (mvp). Blind-predict window + forced
    14	    per_episode: 2                 #     target evade → target leaves frame >=3s → expert intercepts.
    15	    dur_range: [5, 12]          #     window length (s); < max_lost_seconds so it re-acquires.
    16	    min_start_s: 12.0              #     let lock-on settle before the first loss.
    17	    end_margin_s: 12.0             #     leave room after the last loss to re-acquire + settle.
    18	  towns: ["Town01", "Town02", "Town04", "Town05", "Town10HD"]  # Town06 not in this image
    19	  carla:
    20	    host: "127.0.0.1"  # server runs in the same container (docker: cyh-carla)
    21	    port: 2000
    22	    timeout: 20.0
    23	
    24	# Multi-actor scene composition (design §5.1/§6.3): >=2 look-alike distractors,
    25	# co-located with the target so language must carry the discriminating attribute.
    26	scene:
    27	  num_distractors: [4, 8]
    28	  min_similar_distractors: 3        # >=3 look-alikes so >=2 stay co-visible
    29	  distractor_ahead_bias: 0.75       # (legacy layout only; ignored when decorrelate_position on)
    30	  decorrelate_position:             # break the target's geometric-position shortcut (data-fix-spec.md)
    31	    enabled: true                   # L1: target + similar drawn from one symmetric slot band (target random slot)
    32	    standoff_range: [8, 32]         # §8 (redo): per-episode HORIZONTAL trail distance (UAV behind target).
    33	                                    #     §10: capped 40→32 so viewing distance stays ~30-40 m (target close).
    34	                                    #     Randomises the target's forward/depth position in frame → nearer
    35	                                    #     distractors between UAV & target → decorrelates depth RANK (`nearest`).
    36	    aim_offset_frac: 0.25           # §9: smooth camera-aim offset as a fraction of viewing distance →
    37	                                    #     target's IMAGE position spreads like a distractor's (not locked
    38	                                    #     centre) → decorrelates 'most-central'. 0 = aim exactly at target.
    39	    cluster_band_m: 10.0            # L1: target + look-alikes share this ± slot band (position-decorrelated,
    40	                                    #     ~44% geometry floor — accepted; language-ablation E1 is the real test).
    41	                                    #     10 keeps co-visibility ~64% (6 collided too much → 40%).
    42	                                    #     cluster (incl. target) stays near the framed centroid → target
    43	                                    #     mostly IN-frame (occasional loss+recovery, not constant edge-flicker);
    44	                                    #     still exchangeable → decorrelated. (24 m put the target at the edge.)
    45	                                    # L2: expert frames the {target+similar} CENTROID (not the target), so the
    46	                                    #     target is a random cluster member → position/depth/rank == a distractor's.
    47	  ambient:                          # background traffic density (official generate_traffic style)
    48	    vehicles: 80                    # background traffic
    49	    walkers: 0                      # pedestrians removed (spec §4: all-vehicle scene, no walkers)
    50	    cars_only: true                 # only 4-wheel cars (no bikes/motos) — cleaner all-sedan scene
    51	    radius: 70                      # tighter → more of them land in the camera view
    52	  convoy:                           # set_route can force bad turns (off-road) — off.
    53	    enabled: false
    54	    straight_bias: 0.7
    55	    route_len: 80
    56	  covisibility:                     # smooth off-screen recycle keeps >=2 look-alikes co-visible (spec §4d)
    57	    enabled: true                   # robust version: on-road + collision-checked slots, only when <2 on-screen
    58	    recycle_radius: 55.0            # recycle a similar look-alike once it drifts this far off-camera
    59	    min_clearance: 6.0              # destination slot must be this clear of every nearby vehicle
    60	  target_class_weights:            # tracked target = vehicles only; pedestrians are
    61	    car: 0.65                       # background distractors (ambient), never targets
    62	    motorcycle: 0.18
    63	    bicycle: 0.10                  # 非机动车
    64	    scooter: 0.07                  # 电动 / 踏板
    65	    pedestrian: 0.0                # 行人 — 仅背景干扰,不作目标
    66	  similarity_strategy_weights:     # only applies when target class == car
    67	    same_color_diff_shape: 0.40    # look-alikes share COLOR, differ in MODEL → name the model
    68	    same_shape_diff_color: 0.40    # look-alikes share MODEL, differ in COLOR → name the color
    69	    distinct: 0.20                 # easy tail (distractors visually distinct)
    70	
    71	# Tracking-distance tiers: the UAV maintains ~this altitude (≈ slant distance), which
    72	# drives the numeric distance in the language ("about 15/30/45 m").
    73	distance_tiers:                    # §10: LOWERED (was 20-60) so viewing distance =
    74	  close:    {weight: 0.34, altitude: [16, 22]}   # sqrt(standoff²+alt²) lands ~26-42 m →
    75	  suitable: {weight: 0.33, altitude: [22, 28]}   # a 4 m car projects to ~36-49 px at 512/FOV70
    76	  long:     {weight: 0.33, altitude: [28, 34]}   # (was ~12 px @ 336/FOV90/54 m → make unreadable)
    77	
    78	# Camera depression angle (A1c③). Default steep top-down; a fraction of episodes may
    79	# use a shallower, lower-altitude oblique view to surface urban side-wall occlusion.
    80	camera:
    81	  pitch_deg: -50.0
    82	  oblique:
    83	    fraction: 0.0                  # scenarios override (occlusion_heavy → 0.30)
    84	    pitch_deg: -38.0
    85	    altitude_range: [16, 24]       # lower altitude
    86	    behind_range: [22, 30]         # MUST match pitch: depression=atan(alt/behind)≈38° so
    87	                                   # the target starts frame-centred (else it drops off-screen)
    88	
    89	weather:
    90	  cloudiness: [10, 60]
    91	  precipitation: [0, 30]
    92	  precipitation_deposits: [0, 20]
    93	  sun_altitude: [15, 70]   # daytime only
    94	  fog_density: [0, 0]      # no fog — clear visibility
    95	  wetness: [0, 30]
    96	
    97	uav:
    98	  # Start geometry corrected so the target lands in-frame: camera pitch is -30°
    99	  # (drone.get_camera_transform) with 90° FOV → keep depression atan(alt/dist)
   100	  # roughly ≤ 65°, i.e. alt/dist ≲ 2.1.
   101	  start:
   102	    distance_range: [12, 22]      # behind the target
   103	    altitude_range: [16, 26]      # above buildings but target stays in frame
   104	    viewing_angle_range: [-15, 15] # behind the target
   105	    lateral_offset_range: [6, 14]  # to the side, avoid tree line
   106	
   107	  perturbation:                    # APF recovery-trajectory injection (design §5.1)
   108	    # Gentler than the original 20-50m pushes: those exceed the ~17m tracking
   109	    # distance and threw the target out of frame for whole recovery windows.
   110	    probability: 0.015
   111	    min_interval: 10.0
   112	    push_aside_range: [5, 15]
   113	    lag_behind_range: [8, 20]
   114	    overshoot_range: [5, 15]
   115	    altitude_drop_range: [4, 10]
   116	    recovery_time_range: [1.5, 4.0]
   117	
   118	  expert_policy:
   119	    type: "pid"                   # "pid" or "pid_with_injection"
   120	    pid_params:
   121	      kp_xy: [0.5, 0.8]          # moderate proportional gain
   122	      ki_xy: [0.0, 0.0]          # NO integral — teleport drone has no inertia to overcome
   123	      kd_xy: [0.0, 0.0]          # NO derivative — no oscillation risk with P-only
   124	      kp_z:  [0.3, 0.5]          # gentle altitude
   125	      ki_z:  [0.0, 0.0]
   126	      kd_z:  [0.0, 0.0]
   127	      kp_yaw: [0.3, 0.5]
   128	      ki_yaw: [0.0, 0.0]
   129	      kd_yaw: [0.0, 0.0]
   130	    velocity_limits:
   131	      xy_max: 12.0                # m/s (fast enough to catch target)
   132	      z_max: 2.0                  # m/s
   133	      yaw_rate_max: 30.0          # deg/s
   134	    noise_scale: [0.01, 0.15]    # expert action noise → driving style diversity
   135	    dead_reckon_timeout: 5.0      # seconds before giving up on lost target
   136	
   137	target:
   138	  types:
   139	    vehicles:
   140	      - "vehicle.audi.a2"
   141	      - "vehicle.tesla.model3"
   142	      - "vehicle.bmw.grandtourer"
   143	      - "vehicle.mercedes.coupe"
   144	      - "vehicle.mini.cooper_s"
   145	      - "vehicle.nissan.patrol"
   146	      - "vehicle.carlamotors.carlacola"
   147	    pedestrians:
   148	      - "walker.pedestrian.0001"
   149	      - "walker.pedestrian.0005"
   150	      - "walker.pedestrian.0007"
   151	  speed_range: [5, 25]           # m/s for vehicles, pedestrians ~1-3
   152	  maneuver:                        # OFF by default → target on pure autopilot (smooth,
   153	    sudden_stop_prob: 0.0          # rule-abiding). Motion-intent labels come from the
   154	    sharp_turn_prob: 0.0           # target's NATURAL turns/stops at junctions & lights.
   155	    acceleration_prob: 0.0         # (maneuver_heavy.yaml can enable the TM-smooth version)
   156	    u_turn_prob: 0.0
   157	
   158	occlusion:
   159	  heavy_occlusion_target: true
   160	  min_occlusion_ratio: 0.3        # episode must have ≥30% partial occlusion
   161	  raycast:
   162	    num_rays: 8                   # from target bbox corners to UAV
   163	    min_hit_ratio: 0.5            # ≥50% rays blocked → occluded
   164	  # A1c③ in-frame structural-occlusion routing. Off by default; occlusion scenarios
   165	  # enable it to spawn the target so it drives under overhead structures.
   166	  enabled: false
   167	  bias_fraction: 0.0              # scenarios override (occlusion_heavy → 0.6)
   168	  cache_dir: /data/occ_cache      # per-town occluder-anchor cache (built once)
   169	  look_ahead_m: 60.0              # search this far forward from a spawn point
   170	  step_m: 4.0
   171	  up_ray_m: 45.0
   172	  min_clearance_m: 2.0            # overhead structure must be within this clearance band
   173	  max_clearance_m: 22.0           # (UAV-reachable — a 20-60 m UAV sees it occlude)
   174	  min_enter_m: 12.0               # lane must be clear for this long first (drive INTO it)
   175	  max_cover_span_m: 26.0          # covered span must be short (bridge, not tunnel/elevated hwy)
   176	
   177	output:
   178	  rgb_resolution: [512, 512]      # §10: 336→512 so small aerial targets get enough pixels
   179	  fov: 90.0                       # 2026-10-03: 70→90 to match what Stage-2 v5 was actually trained on (the original v5
   180	                                  # recorder hard-coded 90°) and the closed-loop camera (env.py fov_deg=90). The 09-04 regen
   181	                                  # rendered a true 70° → misaligned with config_v5 projections. See acot_note/1003_data-check.md §5.1
   182	  save_depth: false
   183	  save_segmentation: false
   184	  compression: "jpeg85"           # PIL JPEG quality
   185	  format: "hdf5"                  # "hdf5" or "directory"
   186	  data_dir: "/data/"                # host /nvidia/hque/data/carla_data (docker bind mount)
   187	  max_size_gb: 10.0               # Stop generation when total data exceeds this

codex
到这里已经出现两个值得警惕的方向：一是调度/恢复路径可能让 episode id 不再满足预注册分布，二是 QC 现在更像“单集标签形状检查”，还没有把 reacq/occ 的有效事件作为硬门。继续看 smoke 数据，我想确认这些风险是否已经在冒烟里显现。
exec
/bin/sh -lc "find /nvidia/hque/data/carla_data/uavtrack_v6_smoke -maxdepth 2 -type f | sort | sed -n '1,120p'" in /nvidia/hque/code/cyhe/uav-acot-track
