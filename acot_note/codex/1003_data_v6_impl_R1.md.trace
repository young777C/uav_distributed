   261	    def _pick_camera(self, cam_cfg: dict) -> tuple[float, bool]:
   262	        """(camera_pitch, is_oblique). A1c③: a fraction of episodes use a shallower
   263	        pitch (+ lower altitude, set by the caller) to expose side-wall occlusion."""
   264	        default_pitch = float(cam_cfg.get("pitch_deg", -50.0))
   265	        ob = cam_cfg.get("oblique", {})
   266	        if ob and random.random() < float(ob.get("fraction", 0.0)):
   267	            return float(ob.get("pitch_deg", -38.0)), True
   268	        return default_pitch, False
