/bin/sh -lc "python - <<'PY'
import h5py,glob,os,numpy as np
root='/nvidia/hque/data/carla_data/uavtrack_v6_smoke'
for p in sorted(glob.glob(root+'/episode_*.h5')):
  with h5py.File(p,'r') as f:
    print(os.path.basename(p), 'T',f['rgb'].shape[0], 'subset',f.attrs.get('subset'), 'town',f.attrs.get('town'), 'post',('actors/visible' in f and 'events/target_reentry' in f))
    if 'actors/visible' in f:
      g=f['actors']; vis=g['visible'][:].astype(bool); inf=g['in_frame'][:,0]==1; occ=np.nan_to_num(g['occ_raycast'][:,0],nan=0)
      ev=f['events/target_reentry'][:]
      print('  target vis/off/tiny_or_occ/occ>0.5',vis[:,0].sum(), (~inf).sum(), (inf & ~vis[:,0]).sum(), (occ>0.5).sum(), 'ev',ev.tolist())
      role=g['role'][:]
      print('  lookvis frac', ((vis[:,1:] & (role[1:]==1)[None]).any(1)&vis[:,0]).sum()/max(vis[:,0].sum(),1), 'tracklets', len(set(g['tracklet_id'][:,0].tolist())-{-1}))
PY" in /nvidia/hque/code/cyhe/uav-acot-track
