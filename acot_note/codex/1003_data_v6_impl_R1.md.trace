     1	"""Automated QC + split manifest for the v6 dataset (acot_note/1003_data-regen-v6-spec.md §QC).
     2	
     3	  python3 runs/data_v6/qc_v6.py <dataset_dir> [--split-out train/splits/v6_fov90_split.json] [--viz N]
     4	
     5	Per-episode gates (FAIL → episode excluded from the manifest):
     6	  G1 attrs: fov/rgb_resolution/label_version/git_commit/subset/config_snapshot present; fov == 90
     7	  G2 rgb shape (T,512,512,3), T >= 300, no all-black frame among 16 sampled frames
     8	  G3 projection ↔ instance alignment: for actor-frames with vis_px >= 50, the instance (modal) box lies
     9	     inside the projected 3D (amodal) box (≥ 90 % of its area, 3 px margin) in ≥ 95 % of cases
    10	     → catches any FOV / pose mismatch between rendering and projection automatically
    11	  G4 association: clearly visible actors (amodal box ≥ 12 px, occ_raycast < 0.2, center in frame) get an
    12	     instance blob in ≥ 85 % of cases
    13	  G5 postprocess done: actors/visible, actors/tracklet_id, events/target_reentry present
    14	Dataset-level report: per subset × town counts, target frame classes, re-entry events, look-alike
    15	co-visibility, box sizes. Split: train = training towns minus val (every 10th episode id per town),
    16	test = held-out town (attrs test_town)."""
    17	import argparse
    18	import collections
    19	import glob
    20	import json
    21	import os
    22	
    23	import h5py
    24	import numpy as np
    25	
    26	REQ_ATTRS = ("fov", "rgb_resolution", "label_version", "git_commit", "subset", "config_snapshot", "town", "seed")
    27	
    28	
    29	def check_episode(p):
    30	    r = {"file": os.path.basename(p), "fails": []}
    31	    with h5py.File(p, "r") as f:
    32	        a = dict(f.attrs)
    33	        miss = [k for k in REQ_ATTRS if k not in a]
    34	        if miss or float(a.get("fov", -1)) != 90.0:
    35	            r["fails"].append(f"G1 attrs missing={miss} fov={a.get('fov')}")
    36	        for k in ("town", "subset", "episode_id", "test_town", "language", "strategy", "num_similar"):
    37	            v = a.get(k)
    38	            r[k] = v.item() if hasattr(v, "item") else v
    39	        T = f["rgb"].shape[0]; r["T"] = int(T)
    40	        if f["rgb"].shape[1:] != (512, 512, 3) or T < 300:
    41	            r["fails"].append(f"G2 rgb shape {f['rgb'].shape}")
    42	        idx = np.linspace(0, T - 1, 16).astype(int)
    43	        if any(f["rgb"][i].max() < 5 for i in idx):
    44	            r["fails"].append("G2 black frame")
    45	        if "actors" not in f:
    46	            r["fails"].append("no actors group"); return r
    47	        g = f["actors"]
    48	        am, mo, px = g["amodal_box"][:], g["modal_box"][:], g["vis_px"][:]
    49	        occ, inf_ = g["occ_raycast"][:], g["in_frame"][:]
    50	        role = g["role"][:]
    51	        # G3 containment of modal in amodal
    52	        sel = px >= 50
    53	        mx0, my0, mx1, my1 = (mo[..., i][sel] for i in range(4))
    54	        ax0, ay0, ax1, ay1 = (am[..., i][sel] for i in range(4))
    55	        ix = np.clip(np.minimum(mx1, ax1 + 3) - np.maximum(mx0, ax0 - 3) + 1, 0, None)
    56	        iy = np.clip(np.minimum(my1, ay1 + 3) - np.maximum(my0, ay0 - 3) + 1, 0, None)
    57	        area = (mx1 - mx0 + 1) * (my1 - my0 + 1)
    58	        cont = ix * iy / np.maximum(area, 1)
    59	        r["g3_n"], r["g3_ok"] = int(sel.sum()), float((cont >= 0.9).mean()) if sel.any() else float("nan")
    60	        if sel.sum() >= 50 and r["g3_ok"] < 0.95:
    61	            r["fails"].append(f"G3 alignment {r['g3_ok']:.3f}")
    62	        # G4 association
    63	        w = am[..., 2] - am[..., 0]; h = am[..., 3] - am[..., 1]
    64	        clear = (am[..., 0] >= 0) & (np.minimum(w, h) >= 12) & (np.nan_to_num(occ, nan=1) < 0.2) & (inf_ == 1)
    65	        r["g4_n"], r["g4_ok"] = int(clear.sum()), float((px[clear] > 0).mean()) if clear.any() else float("nan")
    66	        if clear.sum() >= 50 and r["g4_ok"] < 0.85:
    67	            r["fails"].append(f"G4 association {r['g4_ok']:.3f}")
    68	        if not all(k in g for k in ("visible", "tracklet_id")) or "events/target_reentry" not in f:
    69	            r["fails"].append("G5 postprocess missing"); return r
    70	        vis = g["visible"][:].astype(bool)
    71	        tv, toff = vis[:, 0], inf_[:, 0] == 0
    72	        tocc = (~toff) & (~tv)
    73	        r["frames"] = {"visible": int(tv.sum()), "occluded_or_tiny": int(tocc.sum()), "off_screen": int(toff.sum())}
    74	        r["target_partial_occ"] = int(((np.nan_to_num(occ[:, 0]) > 0) & tv).sum())
    75	        ev = f["events/target_reentry"][:]
    76	        r["reentry"] = {"n": int(len(ev)), "gap>=30": int((ev[:, 1] >= 30).sum()) if len(ev) else 0,
    77	                        "gap>=30_lookalike": int(((ev[:, 1] >= 30) & (ev[:, 3] >= 1)).sum()) if len(ev) else 0,
    78	                        "cause_occ": int((ev[:, 2] >= 1).sum()) if len(ev) else 0}
    79	        look = vis[:, 1:] & (role[1:] == 1)[None]
    80	        r["lookalike_covis"] = float((look.any(1) & tv).sum() / max(tv.sum(), 1))
    81	        tb = am[tv, 0]
    82	        r["target_box_px_median"] = float(np.median(np.maximum(tb[:, 2] - tb[:, 0], tb[:, 3] - tb[:, 1]))) if tv.any() else float("nan")
    83	        r["n_tracklets_target"] = int(len(set(g["tracklet_id"][:, 0].tolist()) - {-1}))
    84	    return r
    85	
    86	
    87	def viz(p, out_png, n=3):
    88	    from PIL import Image, ImageDraw
    89	    with h5py.File(p, "r") as f:
    90	        T = f["rgb"].shape[0]; g = f["actors"]; tiles = []
    91	        vis = g["vis_px"][:]
    92	        cand = np.where((vis[:, 0] > 50) & ((vis[:, 1:] > 50).sum(1) >= 2))[0]
    93	        idx = cand[np.linspace(0, len(cand) - 1, n).astype(int)] if len(cand) >= n else np.linspace(0, T - 1, n).astype(int)
    94	        for i in idx:
    95	            im = Image.fromarray(f["rgb"][i]); d = ImageDraw.Draw(im)
    96	            m = f["instance_mask"][i]
    97	            tint = np.array(im).copy(); tint[m == 1] = (255, 0, 0); tint[(m >= 2) & (m < 253)] = (0, 128, 255)
    98	            im = Image.blend(im, Image.fromarray(tint), 0.35); d = ImageDraw.Draw(im)
    99	            for a in range(g["amodal_box"].shape[1]):
   100	                b = g["amodal_box"][i, a]
   101	                if b[0] >= 0:
   102	                    d.rectangle(list(b), outline="lime" if a == 0 else "white", width=1)
   103	                mb = g["modal_box"][i, a]
   104	                if mb[0] >= 0:
   105	                    d.rectangle(list(mb), outline="yellow", width=1)
   106	            d.text((4, 4), f"t={i}", fill="white")
   107	            tiles.append(im)
   108	        W = Image.new("RGB", (512 * len(tiles), 512))
   109	        for k, t in enumerate(tiles):
   110	            W.paste(t, (512 * k, 0))
   111	        W.save(out_png)
   112	
   113	
   114	def main():
   115	    ap = argparse.ArgumentParser()
   116	    ap.add_argument("root"); ap.add_argument("--split-out"); ap.add_argument("--viz", type=int, default=0)
   117	    a = ap.parse_args()
   118	    files = sorted(glob.glob(os.path.join(a.root, "episode_*.h5")))
   119	    rows = [check_episode(p) for p in files]
   120	    good = [r for r in rows if not r["fails"]]
   121	    print(f"episodes {len(rows)}  pass {len(good)}  fail {len(rows) - len(good)}")
   122	    for r in rows:
   123	        if r["fails"]:
   124	            print("  FAIL", r["file"], r["fails"])
   125	    agg = collections.defaultdict(lambda: collections.Counter())
   126	    for r in good:
   127	        k = (r["subset"], r["town"])
   128	        c = agg[k]; c["eps"] += 1; c["frames"] += r["T"]
   129	        for kk, vv in r["frames"].items():
   130	            c[kk] += vv
   131	        for kk, vv in r["reentry"].items():
   132	            c["re_" + kk] += vv
   133	    print(f"\n{'subset':6s} {'town':9s} {'eps':>4s} {'frames':>7s} {'vis%':>6s} {'occ%':>6s} {'off%':>6s} {'re>=3s':>7s} {'re>=3s+look':>11s} {'re_occ':>6s}")
   134	    for (s, t), c in sorted(agg.items()):
   135	        F = c["frames"]
   136	        print(f"{s:6s} {t:9s} {c['eps']:4d} {F:7d} {c['visible'] / F:6.1%} {c['occluded_or_tiny'] / F:6.1%} {c['off_screen'] / F:6.1%} "
   137	              f"{c['re_gap>=30']:7d} {c['re_gap>=30_lookalike']:11d} {c['re_cause_occ']:6d}")
   138	    g3 = [r["g3_ok"] for r in rows if r.get("g3_n", 0) > 0]; g4 = [r["g4_ok"] for r in rows if r.get("g4_n", 0) > 0]
   139	    print(f"\nG3 alignment (median over eps) {np.median(g3) if g3 else float('nan'):.3f}   G4 association {np.median(g4) if g4 else float('nan'):.3f}")
   140	    print(f"target box px median {np.nanmedian([r.get('target_box_px_median', np.nan) for r in good]) if good else float('nan'):.1f}  "
   141	          f"look-alike co-visibility {np.mean([r['lookalike_covis'] for r in good]) if good else float('nan'):.2f}")
   142	    json.dump(rows, open(os.path.join(a.root, "qc_report.json"), "w"), indent=1, default=str)
   143	    if a.split_out:
   144	        test_town = next((r.get("test_town") for r in good if r.get("test_town")), "Town03")
   145	        split = {"train": [], "val": [], "test": [], "test_town": test_town, "dataset": a.root,
   146	                 "rule": "test = held-out town; val = episode_id % 10 == 9 within training towns; QC-failed excluded"}
   147	        for r in good:
   148	            if r["town"] == test_town:
