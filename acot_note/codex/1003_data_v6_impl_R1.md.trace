   879	
   880	    def expert_action(
   881	        self, target_pos: np.ndarray, uav_pos: np.ndarray, uav_yaw: float,
   882	        target_visible: bool, timestamp: float,
   883	    ) -> tuple[tuple[float, float, float, float], Any]:
   884	        assert self.expert is not None
   885	        # L2 (position-decorrelation) + RECOVERY:
   886	        #  - WHILE the target is co-visible with the group, servo the CLUSTER CENTROID so
   887	        #    the target is a random group member (not the framed reference → no position
   888	        #    leak).
   889	        #  - ONCE the target has drifted OFF-screen, servo the TRUE target instead, so the
   890	        #    UAV flies to re-acquire it (aerial tracking has no road constraint → it cuts
   891	        #    straight to where the target re-appears). The episode then continues through
   892	        #    the loss and generates recovery demonstrations, rather than being truncated.
   893	        servo_pos = target_pos
   894	        # During a deliberate loss window the expert is flown BLIND: target_visible=False
   895	        # makes the PID dead-reckon (predict) instead of re-centering, so the forced-evading
   896	        # target genuinely leaves frame and stays off — the predict-intercept loss arc.
   897	        if target_visible and target_pos is not None and getattr(self, "_frame_centroid", False):
   898	            # HYSTERESIS on the centroid↔recovery switch: once the target is lost, stay in
   899	            # target-recovery framing until it is STABLY back (in-frame ≥8 consecutive frames).
   900	            # Without this, a target flickering at the frame edge flips the servo setpoint
   901	            # between the cluster centroid and the (far) target every frame → the camera shakes.
   902	            if not getattr(self, "_target_in_frame", True):
   903	                self._recovery_mode = True
   904	                self._reacq = 0
