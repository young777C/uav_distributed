    33	    viewing_offset: float       # meters above target
    34	
    35	
    36	class ExpertPolicy:
    37	    """PID-based expert with per-episode style randomization.
    38	
    39	    Usage:
    40	        expert = ExpertPolicy(config_dict)
    41	        expert.reset_episode()  # randomize style for new episode
    42	        for each step:
    43	            action = expert.act(target_pos, uav_pos, uav_yaw, target_visible, t)
    44	    """
    45	
    46	    def __init__(self, config: dict[str, Any]):
    47	        self._cfg = config
    48	        self._pid: PIDVisualServo | None = None
    49	        self._current_style: ExpertStyle | None = None
    50	
    51	    # ------------------------------------------------------------------
    52	    # Public API
    53	    # ------------------------------------------------------------------
    54	
    55	    def reset_episode(self) -> None:
    56	        """Randomize expert style for a new episode."""
    57	        pid = self._cfg.get("pid_params", {})
    58	
    59	        def _sample(key: str, default: float) -> float:
    60	            val = pid.get(key, [default, default])
    61	            if isinstance(val, (int, float)):
    62	                return float(val)
    63	            return random.uniform(val[0], val[1])
    64	
    65	        limits_cfg = self._cfg.get("velocity_limits", {})
    66	        limits = VelocityLimits(
    67	            xy_max=limits_cfg.get("xy_max", 15.0),
    68	            z_max=limits_cfg.get("z_max", 5.0),
    69	            yaw_rate_max=limits_cfg.get("yaw_rate_max", 60.0),
    70	        )
    71	
    72	        pid_config = PIDVisualServoConfig(
    73	            xy=PIDGains(kp=_sample("kp_xy", 2.0), ki=_sample("ki_xy", 0.05), kd=_sample("kd_xy", 0.3)),
    74	            z=PIDGains(kp=_sample("kp_z", 1.2), ki=_sample("ki_z", 0.05), kd=_sample("kd_z", 0.2), output_max=5.0),
    75	            yaw=PIDGains(kp=_sample("kp_yaw", 1.5), ki=_sample("ki_yaw", 0.02), kd=_sample("kd_yaw", 0.1), output_max=60.0),
    76	            limits=limits,
    77	            # Tracking altitude ≈ maintained slant distance; set per distance tier.
    78	            viewing_height_offset=random.uniform(
    79	                *self._cfg.get("viewing_height_range", [20.0, 30.0])),
    80	            dead_reckon_timeout=self._cfg.get("dead_reckon_timeout", 5.0),
    81	        )
    82	
    83	        noise_range = self._cfg.get("noise_scale", [0.02, 0.10])
    84	        noise_scale = random.uniform(noise_range[0], noise_range[1])
    85	
    86	        self._current_style = ExpertStyle(
    87	            pid_config=pid_config,
    88	            noise_scale=noise_scale,
    89	            viewing_offset=pid_config.viewing_height_offset,
    90	        )
    91	
    92	        self._pid = PIDVisualServo(pid_config)
    93	
    94	    def act(
    95	        self,
    96	        target_pos: np.ndarray | None,
    97	        uav_pos: np.ndarray,
