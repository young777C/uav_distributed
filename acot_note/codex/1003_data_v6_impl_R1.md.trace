   140	            self._aim_frac = 0.0
   141	
   142	        # A1c③ — decide per-episode whether to (a) spawn the target so it drives into an
   143	        # overhead occluder (in-frame structural occlusion), and (b) use an oblique,
   144	        # lower-altitude camera (surfaces urban side-wall occlusion). Both default OFF.
