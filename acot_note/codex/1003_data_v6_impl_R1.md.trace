   254	    def _pick_distance_tier(self, tier_cfg: dict) -> str:
   255	        if not tier_cfg:
   256	            return "suitable"
   257	        names = list(tier_cfg.keys())
   258	        w = np.array([float(tier_cfg[n].get("weight", 1.0)) for n in names])
   259	        return str(np.random.choice(names, p=w / w.sum()))
