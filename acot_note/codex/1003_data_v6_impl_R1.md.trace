     1	"""v6 per-actor labels (acot_note/1003_data-regen-v6-spec.md).
     2	
     3	Live (recorder, per frame): amodal 2D box from the actor's 3D bounding box, structural-occlusion
     4	raycast, and pixel-level visibility from the instance-segmentation camera. CARLA 0.9.15 instance
     5	ids are unique and stable per object but are NOT actor ids, so blobs are associated to scene
     6	actors by overlap with the projected amodal box.
     7	Offline (postprocess): tracklet ids that BREAK after a visibility gap, and target re-entry events.
     8	"""
     9	from __future__ import annotations
    10	
    11	import numpy as np
    12	
    13	VEHICLE_TAGS = (14, 15, 16, 18, 19)     # Car, Truck, Bus, Motorcycle, Bicycle (CARLA 0.9.14+ palette)
    14	PEDESTRIAN_TAG = 12
    15	MASK_OTHER_VEHICLE = 254                # instance_mask value for non-scene vehicles
    16	MASK_PEDESTRIAN = 253
    17	MAX_TRAFFIC = 32                        # padded per-frame list of non-scene vehicle blobs
    18	
    19	
    20	def actor_handle(obj):
    21	    """carla.Actor behind a scene target/distractor wrapper (VehicleTarget / PedestrianTarget)."""
    22	    return getattr(obj, "_vehicle", None) or getattr(obj, "_walker", None)
    23	
    24	
    25	def focal(W: int, fov_deg: float) -> float:
    26	    return W / (2.0 * np.tan(np.radians(fov_deg) / 2.0))
    27	
    28	
    29	def project_world(points: np.ndarray, cam_inv: np.ndarray, W: int, H: int, f: float):
    30	    """points (N,3) world → (u, v, depth) arrays; CARLA camera frame x fwd, y right, z up."""
    31	    P = np.concatenate([points, np.ones((len(points), 1))], 1) @ cam_inv.T
    32	    d = P[:, 0]
    33	    with np.errstate(divide="ignore", invalid="ignore"):
    34	        u = f * (P[:, 1] / d) + W / 2.0
    35	        v = f * (-P[:, 2] / d) + H / 2.0
    36	    return u, v, d
    37	
    38	
    39	def amodal_box(actor, cam_inv, W, H, f):
    40	    """Tight 2D box of the projected 3D bounding box, clipped to the image.
    41	    Returns ((x0, y0, x1, y1) or None, center_in_frame, depth_of_center)."""
    42	    tf = actor.get_transform()
    43	    verts = actor.bounding_box.get_world_vertices(tf)
    44	    pts = np.array([[v.x, v.y, v.z] for v in verts], np.float64)
    45	    u, v, d = project_world(np.vstack([pts, pts.mean(0, keepdims=True)]), cam_inv, W, H, f)
    46	    cu, cv, cd = u[-1], v[-1], d[-1]
    47	    center_in = bool(cd > 0.1 and 0 <= cu < W and 0 <= cv < H)
    48	    front = d[:-1] > 0.1
    49	    if not front.any():
    50	        return None, False, float(cd)
    51	    x0, x1 = np.clip(u[:-1][front].min(), 0, W - 1), np.clip(u[:-1][front].max(), 0, W - 1)
    52	    y0, y1 = np.clip(v[:-1][front].min(), 0, H - 1), np.clip(v[:-1][front].max(), 0, H - 1)
    53	    if x1 - x0 < 1 or y1 - y0 < 1:
    54	        return None, center_in, float(cd)
    55	    return (float(x0), float(y0), float(x1), float(y1)), center_in, float(cd)
    56	
    57	
    58	def decode_instance(raw: bytes, W: int, H: int):
    59	    """CARLA instance-seg BGRA → (tag (H,W) uint8, iid (H,W) int32). R = semantic tag, G|B<<8 = id."""
    60	    a = np.frombuffer(raw, np.uint8).reshape(H, W, 4)
    61	    tag = a[..., 2].copy()
    62	    iid = a[..., 1].astype(np.int32) | (a[..., 0].astype(np.int32) << 8)
    63	    return tag, iid
    64	
    65	
    66	def associate(boxes, tag, iid, min_inside: float = 0.5):
    67	    """Assign instance blobs to scene actors.
    68	
    69	    boxes: list (len A) of amodal boxes (x0,y0,x1,y1) or None.
    70	    Returns per-actor arrays (iid, vis_px, modal box) + uint8 instance mask (0 bg, 1..A scene actors,
    71	    254 other vehicles, 253 pedestrians) + padded traffic table (MAX_TRAFFIC, 7):
    72	    [iid, tag, x0, y0, x1, y1, px] for unmatched vehicle blobs (iid = -1 padding).
    73	    Greedy by overlap; a blob is accepted only if >= min_inside of its pixels lie inside the box
    74	    (so a neighbouring occluder is not taken for the actor)."""
    75	    H, W = tag.shape
    76	    A = len(boxes)
    77	    veh = np.isin(tag, VEHICLE_TAGS)
    78	    out_iid = np.full(A, -1, np.int32)
    79	    out_px = np.zeros(A, np.int32)
    80	    out_box = np.full((A, 4), -1.0, np.float32)
    81	    mask = np.zeros((H, W), np.uint8)
    82	    mask[tag == PEDESTRIAN_TAG] = MASK_PEDESTRIAN
    83	    if veh.any():
    84	        ids, counts = np.unique(iid[veh], return_counts=True)
    85	        total = dict(zip(ids.tolist(), counts.tolist()))
    86	    else:
    87	        total = {}
    88	    cands = []                                   # (overlap, actor, iid)
    89	    for a, b in enumerate(boxes):
    90	        if b is None:
    91	            continue
    92	        x0, y0, x1, y1 = (int(np.floor(b[0])), int(np.floor(b[1])), int(np.ceil(b[2])) + 1, int(np.ceil(b[3])) + 1)
    93	        sub_v = veh[y0:y1, x0:x1]
    94	        if not sub_v.any():
    95	            continue
    96	        ii, cc = np.unique(iid[y0:y1, x0:x1][sub_v], return_counts=True)
    97	        for i_, c_ in zip(ii.tolist(), cc.tolist()):
    98	            if c_ >= min_inside * total.get(i_, 1):
    99	                cands.append((c_, a, i_))
   100	    used_a, used_i = set(), set()
   101	    for c_, a, i_ in sorted(cands, reverse=True):
   102	        if a in used_a or i_ in used_i:
   103	            continue
   104	        used_a.add(a); used_i.add(i_)
   105	        m = veh & (iid == i_)
   106	        ys, xs = np.nonzero(m)
   107	        out_iid[a], out_px[a] = i_, len(xs)
   108	        out_box[a] = (xs.min(), ys.min(), xs.max(), ys.max())
   109	        mask[m] = a + 1
   110	    traffic = np.full((MAX_TRAFFIC, 7), -1.0, np.float32)
   111	    k = 0
   112	    for i_, c_ in sorted(total.items(), key=lambda t: -t[1]):
   113	        if i_ in used_i:
   114	            continue
   115	        m = veh & (iid == i_)
   116	        mask[m] = MASK_OTHER_VEHICLE
   117	        if k < MAX_TRAFFIC:
   118	            ys, xs = np.nonzero(m)
   119	            traffic[k] = (i_, float(np.bincount(tag[m]).argmax()), xs.min(), ys.min(), xs.max(), ys.max(), c_)
   120	            k += 1
   121	    return out_iid, out_px, out_box, mask, traffic
   122	
   123	
   124	# ---------------------------------------------------------------- offline (postprocess)
   125	
   126	def tracklet_ids(visible: np.ndarray, gap_frames: int) -> np.ndarray:
   127	    """visible (T, A) bool → tracklet id (T, A) int32, -1 where invisible. A new id is issued when an
   128	    actor becomes visible after being invisible for >= gap_frames (shorter gaps keep the id).
   129	    Ids are unique within the episode."""
   130	    T, A = visible.shape
   131	    out = np.full((T, A), -1, np.int32)
   132	    nxt = 0
   133	    for a in range(A):
   134	        cur, gap = -1, 10 ** 9
   135	        for t in range(T):
   136	            if visible[t, a]:
   137	                if cur < 0 or gap >= gap_frames:
   138	                    cur = nxt; nxt += 1
   139	                out[t, a] = cur
   140	                gap = 0
   141	            else:
   142	                gap += 1
   143	    return out
   144	
   145	
   146	def reentry_events(visible_t: np.ndarray, off_t: np.ndarray, n_lookalike_vis: np.ndarray,
   147	                   n_vehicle_vis: np.ndarray, min_gap: int) -> np.ndarray:
   148	    """Target re-entry events → (K, 5) int32: [frame, gap_frames, cause (0 off-screen, 1 occlusion,
   149	    2 mixed), n_lookalikes_visible, n_scene_vehicles_visible] at the first visible frame after an
   150	    invisible run of >= min_gap frames."""
   151	    ev, run, n_off = [], 0, 0
   152	    for t in range(len(visible_t)):
   153	        if not visible_t[t]:
   154	            run += 1; n_off += int(off_t[t])
   155	            continue
   156	        if run >= min_gap:
   157	            cause = 0 if n_off == run else (1 if n_off == 0 else 2)
   158	            ev.append((t, run, cause, int(n_lookalike_vis[t]), int(n_vehicle_vis[t])))
   159	        run, n_off = 0, 0
   160	    return np.array(ev, np.int32).reshape(-1, 5)

