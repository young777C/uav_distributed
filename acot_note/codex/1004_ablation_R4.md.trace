    49	def serve(policy: Policy, port: int, host: str = "0.0.0.0"):
    50	    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    51	    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    52	    srv.bind((host, port))
    53	    srv.listen(1)
    54	    print(f"[policy-server] listening on {host}:{port} "
    55	          f"(ckpt epoch={policy.ckpt_meta.get('epoch')} "
    56	          f"mis_follow={policy.ckpt_meta.get('metrics', {}).get('mis_follow')})", flush=True)
    57	
    58	    while True:
    59	        conn, addr = srv.accept()
    60	        print(f"[policy-server] client connected: {addr}", flush=True)
    61	        try:
    62	            while True:
    63	                msg = recv_msg(conn)
    64	                cmd = msg.get("cmd")
    65	                if cmd == "reset":
    66	                    policy.reset()
    67	                    send_msg(conn, {"ok": True})
    68	                elif cmd == "close":
    69	                    if hasattr(policy, "_dagger_flush"):
    70	                        policy._dagger_flush()          # flush the LAST episode's DAgger frames
    71	                    send_msg(conn, {"ok": True})
    72	                    break
    73	                elif cmd == "act":
    74	                    obs = Observation(rgb=np.asarray(msg["rgb"]), language=msg["language"],
    75	                                      proprio=np.asarray(msg["proprio"], dtype=np.float32),
    76	                                      step=int(msg["step"]),
    77	                                      target_color=msg.get("target_color", ""),
    78	                                      target_bp=msg.get("target_bp", ""))
    79	                    action, search_mode, info = policy.act(obs, gt_candidates=msg["gt_candidates"])
    80	                    send_msg(conn, {"action": [float(x) for x in action],
    81	                                    "search_mode": float(search_mode),
    82	                                    "pred_slot": int(info.pred_slot),
    83	                                    "cand_lite": _cand_lite(info.cand_set)})
    84	                else:
    85	                    send_msg(conn, {"error": f"unknown cmd {cmd}"})
