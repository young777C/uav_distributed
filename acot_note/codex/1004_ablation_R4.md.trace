     1	"""Simulated power for paired arm comparisons under the BIMODAL episode outcome observed in CARLA closed loop
     2	(1004_ablation_design.md §3.5). Per seed: opening correct ~ Bernoulli(p); open-right → hold (U[0.9,1]) w.p. h else
     3	drift (U[0,0.6]); open-wrong → recover (U[0.3,0.9]) w.p. r else stay (U[0,0.1]). Full: h=0.95, r=0.05; the ablated arm
     4	lowers h so that the total mean difference is Δ. Natural opening: each arm flips the reference opening independently
     5	w.p. `flip`. Hold events of the two arms are independent within a seed (conservative). Test = the pre-registered
     6	paired SIGN-FLIP permutation test, via its large-sample form z = Σd / sqrt(Σd²) (the permutation null of Σ±d_i has
     7	variance Σd_i²), two-sided at α (0.025 / 0.0125 = strictest Holm step for 2 / 4 comparisons).
     8	`--sens` prints the pessimistic sensitivity grid (p, flip, h_full).
     9	  python power_sim.py"""
    10	import numpy as np
    11	
    12	RNG = np.random.default_rng(0)
    13	Z = {0.05: 1.96, 0.025: 2.24, 0.0125: 2.50}
    14	
    15	
    16	def arm(open_ok, h, r):
    17	    n = len(open_ok); u = RNG.random(n)
    18	    hold, drift = RNG.uniform(0.9, 1.0, n), RNG.uniform(0.0, 0.6, n)
    19	    rec, stay = RNG.uniform(0.3, 0.9, n), RNG.uniform(0.0, 0.1, n)
    20	    return np.where(open_ok, np.where(u < h, hold, drift), np.where(u < r, rec, stay))
    21	
    22	
    23	def power(n, dtot, natural, alpha, p=0.55, h_full=0.95, r=0.05, flip=0.10, sims=4000):
    24	    mean_right = lambda h: h * 0.95 + (1 - h) * 0.3
    25	    h_abl = (mean_right(h_full) - dtot / p - 0.3) / 0.65
    26	    hits = 0
    27	    for _ in range(sims):
    28	        o = RNG.random(n) < p
    29	        o_f = o ^ (RNG.random(n) < flip) if natural else o
    30	        o_a = o ^ (RNG.random(n) < flip) if natural else o
    31	        d = arm(o_f, h_full, r) - arm(o_a, h_abl, r)
    32	        hits += d.sum() / np.sqrt((d ** 2).sum() + 1e-12) > Z[alpha]
    33	    return hits / sims
    34	
    35	
    36	if __name__ == "__main__":
    37	    import sys
    38	    if "--sens" in sys.argv:
    39	        print("setting  n   Δ     p     flip  h_full  power(α)")
    40	        for nat, n, a in ((True, 80, 0.025), (False, 60, 0.0125)):
    41	            for dt in (0.15, 0.20):
    42	                for p in (0.45, 0.55):
    43	                    for fl in ((0.10, 0.15) if nat else (0.0,)):
    44	                        for hf in (0.85, 0.95):
    45	                            print(f"{'natural' if nat else 'shared '} {n:3d} {dt:.2f}  {p:.2f}  {fl:.2f}  {hf:.2f}   "
    46	                                  f"{power(n, dt, nat, a, p=p, h_full=hf, flip=fl):.2f} (α={a})")
    47	        raise SystemExit
    48	    print("n   Δ     setting   α=0.05  α=0.025  α=0.0125")
    49	    for n in (40, 60, 80):
    50	        for dt in (0.10, 0.15, 0.20):
    51	            for nat in (False, True):
    52	                print(f"{n:3d} {dt:.2f}  {'natural' if nat else 'shared '}   "
    53	                      + "  ".join(f"{power(n, dt, nat, a):.2f}" for a in (0.05, 0.025, 0.0125)))

