    21	def _tm_port() -> int:
    22	    """TrafficManager port. Distinct per parallel worker (set via CARLA_TM_PORT) so
    23	    concurrent generators on the same host don't share/clobber one TM on port 8000."""
    24	    return int(os.environ.get("CARLA_TM_PORT", "8000"))
