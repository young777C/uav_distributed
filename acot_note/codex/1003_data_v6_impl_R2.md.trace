    34	                           # regressed offscreen+recovery+leak). Sustained loss is created
    35	                           # deliberately by environment.loss_events (blind-predict window)
    36	                           # instead. See acot-uav-review-loop / data-fix-spec (c).
    37	    sudden_stop_prob: 0.0
    38	    sharp_turn_prob: 0.0
    39	    acceleration_prob: 0.0
    40	    u_turn_prob: 0.0
    41	
    42	uav:
