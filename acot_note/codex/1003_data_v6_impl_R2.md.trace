   121	def viz(p, out_png, n=3):
   122	    from PIL import Image, ImageDraw
   123	    with h5py.File(p, "r") as f:
   124	        T = f["rgb"].shape[0]; g = f["actors"]; tiles = []
   125	        vis = g["vis_px"][:]
   126	        cand = np.where((vis[:, 0] > 50) & ((vis[:, 1:] > 50).sum(1) >= 2))[0]
   127	        idx = cand[np.linspace(0, len(cand) - 1, n).astype(int)] if len(cand) >= n else np.linspace(0, T - 1, n).astype(int)
   128	        for i in idx:
   129	            im = Image.fromarray(f["rgb"][i]); d = ImageDraw.Draw(im)
   130	            m = f["instance_mask"][i]
   131	            tint = np.array(im).copy(); tint[m == 1] = (255, 0, 0); tint[(m >= 2) & (m < 253)] = (0, 128, 255)
   132	            im = Image.blend(im, Image.fromarray(tint), 0.35); d = ImageDraw.Draw(im)
   133	            for a in range(g["amodal_box"].shape[1]):
   134	                b = g["amodal_box"][i, a]
   135	                if b[0] >= 0:
   136	                    d.rectangle(list(b), outline="lime" if a == 0 else "white", width=1)
   137	                mb = g["modal_box"][i, a]
   138	                if mb[0] >= 0:
   139	                    d.rectangle(list(mb), outline="yellow", width=1)
   140	            d.text((4, 4), f"t={i}", fill="white")
   141	            tiles.append(im)
   142	        W = Image.new("RGB", (512 * len(tiles), 512))
   143	        for k, t in enumerate(tiles):
   144	            W.paste(t, (512 * k, 0))
   145	        W.save(out_png)
