   918	        L = carla.CityObjectLabel
   919	        block = {getattr(L, n) for n in ("Buildings", "Walls", "Fences", "Poles", "Vegetation", "Bridge",
   920	                                         "Static", "GuardRail", "TrafficLight", "TrafficSigns") if hasattr(L, n)}
   921	        dx, dy, dz, dyaw = action
   922	        p = carla.Location(float(uav_pos[0]), float(uav_pos[1]), float(uav_pos[2]))
   923	
   924	        def hit(b):
   925	            try:
   926	                return any(h.label in block for h in self._world.cast_ray(p, b))
   927	            except RuntimeError:
   928	                return False
   929	        # clearance ring: 8 horizontal 5 m rays at camera height and 2 m below — structures beside the
   930	        # drone (e.g. an elevated highway it flies parallel to) would otherwise slowly swallow the camera
   931	        push = np.zeros(2)
   932	        for k in range(8):
   933	            ang = k * math.pi / 4.0
   934	            ux, uy = math.cos(ang), math.sin(ang)
   935	            for zoff in (0.0, -2.0):
   936	                if hit(carla.Location(p.x + 5.0 * ux, p.y + 5.0 * uy, p.z + zoff)):
   937	                    push -= (ux, uy)
   938	                    break
   939	        if np.any(push != 0.0):
   940	            n = float(np.linalg.norm(push)) or 1.0
   941	            return ((0.5 * push[0] / n), (0.5 * push[1] / n), 0.6, dyaw), ObstacleEvent(timestamp, "geom_clear", 5.0)
   942	        hz = math.hypot(dx, dy)
   943	        if hz > 1e-3:
   944	            look = max(8.0, 30.0 * hz)
   945	            ux, uy = dx / hz, dy / hz
   946	            for zoff in (0.0, -3.0):
   947	                if hit(carla.Location(p.x + ux * look, p.y + uy * look, p.z + zoff)):
   948	                    return (0.0, 0.0, 0.8, dyaw), ObstacleEvent(timestamp, "geom_climb", look)
   949	        if dz < 0 and hit(carla.Location(p.x, p.y, p.z + dz - 4.0)):
   950	            return (dx, dy, 0.0, dyaw), ObstacleEvent(timestamp, "geom_hold_alt", -dz)
   951	        return action, None
   952	
   953	    def expert_action(
   954	        self, target_pos: np.ndarray, uav_pos: np.ndarray, uav_yaw: float,
   955	        target_visible: bool, timestamp: float,
   956	    ) -> tuple[tuple[float, float, float, float], Any]:
   957	        assert self.expert is not None
   958	        # L2 (position-decorrelation) + RECOVERY:
   959	        #  - WHILE the target is co-visible with the group, servo the CLUSTER CENTROID so
   960	        #    the target is a random group member (not the framed reference → no position
   961	        #    leak).
   962	        #  - ONCE the target has drifted OFF-screen, servo the TRUE target instead, so the
   963	        #    UAV flies to re-acquire it (aerial tracking has no road constraint → it cuts
   964	        #    straight to where the target re-appears). The episode then continues through
   965	        #    the loss and generates recovery demonstrations, rather than being truncated.
   966	        servo_pos = target_pos
   967	        # During a deliberate loss window the expert is flown BLIND: target_visible=False
   968	        # makes the PID dead-reckon (predict) instead of re-centering, so the forced-evading
   969	        # target genuinely leaves frame and stays off — the predict-intercept loss arc.
   970	        if target_visible and target_pos is not None and getattr(self, "_frame_centroid", False):
   971	            # HYSTERESIS on the centroid↔recovery switch: once the target is lost, stay in
   972	            # target-recovery framing until it is STABLY back (in-frame ≥8 consecutive frames).
   973	            # Without this, a target flickering at the frame edge flips the servo setpoint
   974	            # between the cluster centroid and the (far) target every frame → the camera shakes.
   975	            if not getattr(self, "_target_in_frame", True):
   976	                self._recovery_mode = True
   977	                self._reacq = 0
   978	            elif getattr(self, "_recovery_mode", False):
   979	                self._reacq = getattr(self, "_reacq", 0) + 1
   980	                if self._reacq >= 8:
   981	                    self._recovery_mode = False
   982	            if not getattr(self, "_recovery_mode", False):
   983	                servo_pos = self._cluster_centroid(np.asarray(target_pos, dtype=float))
   984	        # §8 (redo): TRAIL the target by a per-episode random HORIZONTAL standoff so the
   985	        # target sits at a random forward/depth position in the frame (near the bottom when
   986	        # the UAV trails close, higher/farther when it trails far) → the ground BETWEEN the
   987	        # UAV and the target holds distractors NEARER than the target → the target's depth
   988	        # RANK is decorrelated (was systematically nearest because the UAV hovered ~over the
   989	        # target). The camera still FACES the target (look_pos), only its POSITION trails.
   990	        # Skip during loss/recovery so re-acquisition still cuts straight to the target.
   991	        pos_setpoint, look_pos = servo_pos, None
   992	        standoff = getattr(self, "_tracking_standoff", 0.0)
   993	        aim_frac = getattr(self, "_aim_frac", 0.0)
   994	        if (target_visible and target_pos is not None
   995	                and not getattr(self, "_recovery_mode", False)
   996	                and (standoff > 0.0 or aim_frac > 0.0)):
   997	            try:
   998	                tyaw = np.radians(self._target.transform.rotation.yaw)
   999	                fwd = np.array([np.cos(tyaw), np.sin(tyaw)])
  1000	                aim = np.asarray(servo_pos, dtype=float).copy()
  1001	                if aim_frac > 0.0:
  1002	                    # §9: LATERAL-only AIM offset (perpendicular to the target's heading) → the
  1003	                    # target's horizontal image position (u) spreads like a distractor's, killing
  1004	                    # the 'most-central' shortcut. Lateral ONLY (not forward/back) so it does NOT
  1005	                    # move the target in DEPTH → leaves the §8 `nearest` decorrelation intact
  1006	                    # (a forward/back aim component pushed the target far → nearest collapsed).
  1007	                    # Vertical (v) spread is already provided by the per-episode standoff.
  1008	                    # Amplitude ∝ viewing distance → constant image spread, target stays in frame.
  1009	                    depth = float(np.linalg.norm(aim - np.asarray(uav_pos, dtype=float)))
  1010	                    perp = np.array([-fwd[1], fwd[0]])
  1011	                    lat = aim_frac * depth * np.sin(2 * np.pi * self._aim_fx * timestamp + self._aim_px)
  1012	                    aim[:2] = aim[:2] + lat * perp
  1013	                look_pos = aim                                # camera FACES the shifted aim point
  1014	                pos_setpoint = aim.copy()
  1015	                pos_setpoint[:2] = pos_setpoint[:2] - standoff * fwd   # §8: trail the aim point
  1016	            except (RuntimeError, AttributeError):
  1017	                pos_setpoint, look_pos = servo_pos, None
  1018	        action = self.expert.act(pos_setpoint, uav_pos, uav_yaw, target_visible, timestamp,
  1019	                                 look_pos=look_pos)
