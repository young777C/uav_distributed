   331	    def _pick_target_class(self, scene_cfg: dict) -> str:
   332	        weights = scene_cfg.get("target_class_weights", {"car": 1.0})
   333	        classes = list(weights.keys())
   334	        probs = np.array([weights[c] for c in classes], dtype=float)
   335	        probs = probs / probs.sum()
   336	        return str(np.random.choice(classes, p=probs))
   337	
   338	    def _pick_strategy(self, scene_cfg: dict, target_class: str) -> str:
   339	        if target_class != "car":
   340	            return "same_class"
   341	        weights = scene_cfg.get("similarity_strategy_weights", {
   342	            "same_color_diff_shape": 0.4, "same_shape_diff_color": 0.4, "distinct": 0.2})
   343	        strategies = list(weights.keys())
   344	        probs = np.array([weights[s] for s in strategies], dtype=float)
   345	        probs = probs / probs.sum()
   346	        return str(np.random.choice(strategies, p=probs))
