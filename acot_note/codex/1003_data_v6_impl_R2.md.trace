    61	
    62	def provenance(out):
    63	    commit = sh("git rev-parse HEAD").strip()
    64	    patch = sh("git diff HEAD -- carla_uav_tracking train")
    65	    untracked = [p for p in sh("git ls-files --others --exclude-standard -- carla_uav_tracking train").split()
    66	                 if p.endswith((".py", ".yaml", ".sh"))]
    67	    open(os.path.join(out, "code_snapshot.patch"), "w").write(patch)
