   148	def main():
   149	    ap = argparse.ArgumentParser()
   150	    ap.add_argument("root"); ap.add_argument("--split-out"); ap.add_argument("--viz", type=int, default=0)
   151	    a = ap.parse_args()
   152	    files = sorted(glob.glob(os.path.join(a.root, "episode_*.h5")))
   153	    rows = [check_episode(p) for p in files]
   154	    good = [r for r in rows if not r["fails"]]
   155	    print(f"episodes {len(rows)}  pass {len(good)}  fail {len(rows) - len(good)}")
   156	    for r in rows:
   157	        if r["fails"]:
   158	            print("  FAIL", r["file"], r["fails"])
   159	    agg = collections.defaultdict(lambda: collections.Counter())
   160	    for r in good:
   161	        k = (r["subset"], r["town"])
   162	        c = agg[k]; c["eps"] += 1; c["frames"] += r["T"]
   163	        for kk, vv in r["frames"].items():
   164	            c[kk] += vv
