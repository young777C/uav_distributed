codex
接下来我用 `check_episode()` 直接读 smoke2–4 的 H5，而不是跑 `qc_v6.py` 主程序，因为主程序会写 `qc_report.json`，当前只读审稿环境不该改数据目录。这样可以拿到每集失败原因和通过率。
exec
/bin/sh -lc "python - <<'PY'
import glob, json, os, sys
sys.path.insert(0, '/nvidia/hque/code/cyhe/uav-acot-track/carla_uav_tracking')
from scripts.qc_v6 import check_episode
roots = [f'/nvidia/hque/data/carla_data/uavtrack_v6_smoke{i}' for i in (2,3,4)]
for root in roots:
    files = sorted(glob.glob(root+'/episode_*.h5') + glob.glob(root+'/episode_*.rejected.h5') + glob.glob(root+'/episode_*.tmp.h5'))
    print('\\nROOT', root, 'files', len(files))
    passn=0
    for p in files:
        try:
            r=check_episode(p)
        except Exception as e:
            print(os.path.basename(p), 'ERROR', repr(e)); continue
        ok=not r['fails']
        passn += ok and p.endswith('.h5') and not p.endswith('.tmp.h5') and not p.endswith('.rejected.h5')
        print(os.path.basename(p), 'OK' if ok else 'FAIL', 'T', r.get('T'), 'subset', r.get('subset'), 'town', r.get('town'), 'fails', r.get('fails'), 'move', r.get('target_moving_frac'), 're', r.get('reentry'), 'occ_frames', r.get('target_struct_occ_frames'), 'block', r.get('view_blocked_frames'), 'iid_sw', r.get('target_iid_switches'))
    print('official-pass-final-count', passn)
