    19	class EpisodeRecorder:
    20	    """Records one tracking episode in CARLA synchronous mode.
    21	
    22	    Output: an HDF5 file with all frames + a metadata JSON sidecar.
    23	    """
    24	
    25	    def __init__(
    26	        self,
    27	        scene: SceneManager,
    28	        world: carla.World,
    29	        output_dir: Path,
    30	        episode_id: int,
    31	        fps: int = 10,
    32	        resolution: tuple[int, int] = (336, 336),
    33	        extra_attrs: dict | None = None,
    34	        out_name: str | None = None,
    35	    ):
    36	        self._scene = scene
    37	        self._world = world
    38	        self._output_dir = output_dir
    39	        self._episode_id = episode_id
    40	        self._fps = fps
    41	        self._resolution = resolution
    42	        # Horizontal FOV (deg) from output.fov — drives the sensor AND every projection; written to attrs.
    43	        # v6 / Stage-2 standard is 90° (acot_note/1003_data-check.md §5.1; the 09-04 70° regen was a mismatch).
    44	        self._fov = float(scene._config.get("output", {}).get("fov", 90.0))
    45	        self._dt = 1.0 / fps
    46	        # v6 (acot_note/1003_data-regen-v6-spec.md): provenance attrs + per-actor labels from an
    47	        # instance-segmentation camera rendered from the SAME pose/fov as the RGB camera.
    48	        self._extra_attrs = dict(extra_attrs or {})
    49	        self._inst_enabled = bool(scene._config.get("output", {}).get("instance_seg", False))
    50	        self._v6_buf: list[dict] = []
    51	        le = scene._config.get("environment", {}).get("loss_events", {}) or {}
    52	        # expert behaviour inside a deliberate loss window: intercept (default, privileged servo) |
    53	        # blind (dead-reckon) | hover (hold position → the evading target really leaves the frame)
    54	        self._loss_mode = str(le.get("expert_mode", "blind" if le.get("blind_expert") else "intercept"))
    55	        self._out_path = output_dir / (out_name or f"episode_{episode_id:06d}.h5")
    56	        self._v6_prev_iid = None
    57	        self._target_track: list[tuple[float, float]] = []   # whole-episode target xy (stuck detector)
    58	
    59	        # Buffers (flushed every N frames)
    60	        self._buffer_size = 100
    61	        self._frames: list[np.ndarray] = []
    62	        self._actions: list[list[float]] = []
    63	        self._states: list[dict] = []
    64	        self._bboxes: list[dict] = []
    65	        self._occlusions: list[float] = []
    66	        self._maneuvers: list[dict] = []
    67	        self._target_positions: list[list[float]] = []  # for waypoint GT
    68	        self._distractor_positions: list[np.ndarray] = []  # each (D, 6): xyz + vxyz
    69	        self._episode_attrs: dict = {}                     # written once on file create
    70	
    71	    # ------------------------------------------------------------------
    72	    # Public API
    73	    # ------------------------------------------------------------------
    74	
    75	    def run(self, max_steps: int | None = None) -> dict[str, Any]:
