/bin/sh -lc "rg -n \"postprocess|tracklet|target_reentry|actors/visible|events/target_reentry\" carla_uav_tracking/recording carla_uav_tracking/scripts -g '*.py'" in /nvidia/hque/code/cyhe/uav-acot-track
 succeeded in 166ms:
     1	"""Deliberate SUSTAINED target-loss events for predict-intercept recovery data.
     2	
     3	Round-2 lesson: stochastic TM maneuvers only fragment the loss into sub-second
     4	blips (the expert re-frames the privileged true target too fast) AND re-correlate
     5	the target's geometry (hurting the benchmark-leak floor). Instead, schedule a few
     6	BOUNDED windows per episode where:
     7	
     8	  1. the target is forced to deviate (accel + lane change) at window onset, and
     9	  2. the expert is flown BLIND (target_visible=False → PID dead-reckons on the
    10	     last-seen velocity) for the whole window, so it does NOT instantly re-center.
    11	
    12	The target genuinely leaves frame and STAYS off for ~the window length (>=3s),
    13	then at window end the expert regains the true target and flies to intercept →
    14	a clean, controllable "loss → predict → re-acquire" arc. Because loss is confined
    15	to these bounded windows (and co-visible time keeps centroid framing), the leak
    16	floor is not re-correlated the way continuous chasing did in round 2.
    17	"""
    18	
    19	from __future__ import annotations
    20	
    21	import random
    22	
    23	
    24	class LossEventScheduler:
    25	    """Places K non-overlapping blind-predict windows per episode (by wall time)."""
    26	
    27	    def __init__(self, cfg_env: dict, fps: int = 10):
    28	        le = (cfg_env or {}).get("loss_events", {}) or {}
    29	        self.enabled = bool(le.get("enabled", False))
    30	        self.per_episode = int(le.get("per_episode", 2))
    31	        self.dur_range = tuple(le.get("dur_range", [3.5, 6.0]))
    32	        self.min_start_s = float(le.get("min_start_s", 12.0))   # let lock-on settle first
    33	        self.end_margin_s = float(le.get("end_margin_s", 12.0)) # leave room to re-acquire
    34	        self.duration_s = float(cfg_env.get("max_duration_seconds", 150))
    35	        self._windows: list[tuple[float, float]] = []
    36	        self._fired: set[int] = set()
    37	        self._fired_off: set[int] = set()
    38	
    39	    def reset(self, seed: int | None = None) -> None:
    40	        rng = random.Random(seed)
    41	        self._windows = []
    42	        self._fired = set()
    43	        self._fired_off = set()
    44	        if not self.enabled or self.per_episode <= 0:
    45	            return
    46	        lo = self.min_start_s
    47	        hi = self.duration_s - self.end_margin_s
    48	        if hi - lo < self.dur_range[1]:
    49	            return                                   # episode too short for any event
    50	        # One window per equal-width slot → guarantees non-overlap + spacing.
    51	        slot = (hi - lo) / self.per_episode
    52	        for k in range(self.per_episode):
    53	            d = rng.uniform(*self.dur_range)
    54	            s_lo = lo + k * slot
    55	            s_hi = lo + (k + 1) * slot - d
    56	            start = rng.uniform(s_lo, s_hi) if s_hi > s_lo else s_lo
    57	            self._windows.append((start, start + d))
    58	
    59	    def in_predict(self, elapsed: float) -> bool:
    60	        """True while inside a loss window → the expert should fly blind (predict)."""
    61	        return any(s <= elapsed < e for s, e in self._windows)
    62	
    63	    def onset(self, elapsed: float) -> float | None:
    64	        """Return the window duration exactly ONCE, at the first step inside it
    65	        (so the caller triggers the target's forced deviation); else None."""
    66	        for i, (s, e) in enumerate(self._windows):
    67	            if s <= elapsed < e and i not in self._fired:
    68	                self._fired.add(i)
    69	                return e - s
    70	        return None
    71	
    72	    def offset(self, elapsed: float) -> bool:
    73	        """True exactly ONCE, on the first step AFTER a (started) window ends — the target
    74	        is re-appearing → caller forces >=2 look-alikes co-visible for language re-acquisition."""
    75	        for i, (s, e) in enumerate(self._windows):
    76	            if i in self._fired and i not in self._fired_off and elapsed >= e:
    77	                self._fired_off.add(i)
    78	                return True
    79	        return False
    80	
    81	    @property
    82	    def windows(self) -> list[tuple[float, float]]:
    83	        return self._windows

