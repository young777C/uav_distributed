   589	    def _flush_buffer(self) -> None:
   590	        """Write buffered frames to HDF5 file."""
   591	        if not self._frames:
   592	            return
   593	
   594	        output_path = self._out_path
   595	        mode = "a" if output_path.exists() else "w"
   596	
   597	        with h5py.File(output_path, mode) as f:
   598	            # Determine offset for appending
   599	            n_existing = f["rgb"].shape[0] if "rgb" in f else 0
   600	            n_new = len(self._frames)
   601	            total = n_existing + n_new
   602	
   603	            # Create or resize datasets
   604	            if "rgb" not in f:
   605	                f.create_dataset(
   606	                    "rgb", shape=(n_new, *self._resolution, 3),
   607	                    maxshape=(None, *self._resolution, 3),
   608	                    dtype=np.uint8, chunks=(1, *self._resolution, 3),
   609	                    compression="gzip", compression_opts=9,
   610	                )
   611	                # Episode-level attributes (language, target/distractor meta, seed...)
   612	                for k, v in self._episode_attrs.items():
   613	                    f.attrs[k] = v
   614	            else:
   615	                f["rgb"].resize(total, axis=0)
   616	
   617	            # Write RGB frames
   618	            for i, frame in enumerate(self._frames):
   619	                f["rgb"][n_existing + i] = frame
   620	
   621	            # Write state/action data as JSON string attribute (updated each flush)
   622	            # For large datasets, use separate HDF5 datasets instead
   623	            state_group = f.require_group("state")
   624	            for key in ["t", "uav_x", "uav_y", "uav_z", "uav_vx", "uav_vy",
   625	                         "uav_vz", "uav_yaw", "uav_energy",
   626	                         "is_turning", "perturbation", "obstacle_avoid", "maneuver",
   627	                         "cam_x", "cam_y", "cam_z", "cam_pitch", "cam_yaw", "occ_raycast",
   628	                         "loss_window", "action_valid"]:
   629	                vals = [s[key] for s in self._states]
   630	                if key not in state_group:
   631	                    state_group.create_dataset(
   632	                        key, data=np.array(vals, dtype=np.float32),
   633	                        maxshape=(None,), chunks=True,
   634	                    )
   635	                else:
   636	                    ds = state_group[key]
   637	                    ds.resize(total, axis=0)
   638	                    ds[n_existing:] = np.array(vals, dtype=np.float32)
   639	
   640	            # Actions
   641	            act_group = f.require_group("action")
   642	            act_arr = np.array(self._actions, dtype=np.float32)
   643	            for j, key in enumerate(["dx", "dy", "dz", "dyaw"]):
   644	                if key not in act_group:
   645	                    act_group.create_dataset(
   646	                        key, data=act_arr[:, j],
   647	                        maxshape=(None,), chunks=True,
   648	                    )
   649	                else:
   650	                    ds = act_group[key]
   651	                    ds.resize(total, axis=0)
   652	                    ds[n_existing:] = act_arr[:, j]
   653	
   654	            # Target positions (for waypoint GT)
   655	            tgt_arr = np.array(self._target_positions, dtype=np.float32)
   656	            tgt_group = f.require_group("target")
   657	            tgt_keys = ["tx", "ty", "tz", "tvx", "tvy", "tvz", "tspeed", "tyaw"]
   658	            for j, key in enumerate(tgt_keys):
   659	                if key not in tgt_group:
   660	                    tgt_group.create_dataset(
   661	                        key, data=tgt_arr[:, j],
   662	                        maxshape=(None,), chunks=True,
   663	                    )
   664	                else:
   665	                    ds = tgt_group[key]
   666	                    ds.resize(total, axis=0)
   667	                    ds[n_existing:] = tgt_arr[:, j]
