   376	    def _create_attached_sensor(self) -> RGBSensor:
   377	        """Create an RGB sensor attached to the world spectator."""
   378	        bp = self._world.get_blueprint_library().find("sensor.camera.rgb")
   379	        bp.set_attribute("image_size_x", str(self._resolution[0]))
   380	        bp.set_attribute("image_size_y", str(self._resolution[1]))
   381	        bp.set_attribute("fov", str(self._fov))
   382	
   383	        cam_transform = self._scene.drone.get_camera_transform()
   384	        sensor = self._world.spawn_actor(bp, cam_transform)
   385	        rgb = RGBSensor.__new__(RGBSensor)
   386	        rgb._sensor = sensor
   387	        rgb._resolution = self._resolution
   388	
   389	        import queue
   390	        rgb._queue = queue.Queue()
   391	        sensor.listen(rgb._queue.put)
   392	        return rgb
   393	
   394	    def _flush_v6(self, f, n0: int, total: int) -> None:
   395	        """Append buffered v6 labels: actors/*, traffic/blobs, instance_mask, seg/{iid,semantic}, view/*."""
   396	        g = f.require_group("actors")
   397	        if "ids" not in g:
   398	            g.create_dataset("ids", data=self._v6_ids)       # (A,) carla actor id; index 0 = target
   399	            g.create_dataset("role", data=self._v6_role)     # (A,) 0 target, 1 look-alike, 2 other distractor
   400	            ext = np.full((len(self._v6_ids), 3), np.nan, np.float32)
   401	            loc = np.full((len(self._v6_ids), 3), np.nan, np.float32)
   402	            for a, h in enumerate(self._v6_handles):
   403	                try:
   404	                    bb = h.bounding_box
   405	                    ext[a] = (bb.extent.x, bb.extent.y, bb.extent.z)
   406	                    loc[a] = (bb.location.x, bb.location.y, bb.location.z)
   407	                except (RuntimeError, AttributeError):
   408	                    pass
   409	            g.create_dataset("extent", data=ext)              # (A,3) half-sizes (m) of the 3D bbox
   410	            g.create_dataset("bbox_loc", data=loc)            # (A,3) bbox centre offset in the actor frame
   411	
   412	        def app(grp, name, arr, comp=4, chunks=None):
   413	            if name not in grp:
   414	                grp.create_dataset(name, data=arr, maxshape=(None, *arr.shape[1:]),
   415	                                   chunks=chunks or (min(64, len(arr)), *arr.shape[1:]),
   416	                                   compression="gzip", compression_opts=comp)
   417	            else:
   418	                ds = grp[name]
   419	                ds.resize(total, axis=0)
   420	                ds[n0:total] = arr
   421	
   422	        st = lambda k: np.stack([b[k] for b in self._v6_buf], 0)
   423	        for k in ("in_frame", "amodal_box", "depth", "occ_raycast", "inst_id", "vis_px", "modal_box", "yaw", "pos"):
   424	            app(g, k, st(k))
   425	        app(f.require_group("traffic"), "blobs", st("traffic"))
   426	        img_chunks = (1, self._resolution[1], self._resolution[0])
   427	        app(f, "instance_mask", st("mask"), chunks=img_chunks)
   428	        sg = f.require_group("seg")
   429	        app(sg, "iid", st("seg_iid"), chunks=img_chunks)            # raw instance id on vehicle/pedestrian px
   430	        app(sg, "semantic", st("seg_semantic"), chunks=img_chunks)  # CARLA semantic tag per pixel
   431	        vg = f.require_group("view")
   432	        app(vg, "block_frac", np.array([b["view_block_frac"] for b in self._v6_buf], np.float32))
   433	        app(vg, "mean_rgb", np.array([fr.reshape(-1, 3).mean(0) for fr in self._frames], np.float32))
   434	
   435	    def _create_raw_sensor(self, bp_name: str):
   436	        """Extra camera with the RGB camera's resolution/fov, repositioned every tick → (sensor, queue)."""
   437	        import queue
   438	        bp = self._world.get_blueprint_library().find(bp_name)
   439	        bp.set_attribute("image_size_x", str(self._resolution[0]))
   440	        bp.set_attribute("image_size_y", str(self._resolution[1]))
   441	        bp.set_attribute("fov", str(self._fov))
   442	        sensor = self._world.spawn_actor(bp, self._scene.drone.get_camera_transform())
   443	        q = queue.Queue()
   444	        sensor.listen(q.put)
   445	        return sensor, q
   446	
   447	    @staticmethod
   448	    def _get_synced(q, frame_id: int, timeout: float = 10.0):
   449	        """Pop sensor data until the one rendered for frame_id (drops stale frames)."""
   450	        while True:
   451	            d = q.get(timeout=timeout)
   452	            if d.frame >= frame_id:
   453	                if d.frame > frame_id:
   454	                    raise RuntimeError(f"sensor frame {d.frame} ahead of world frame {frame_id}")
   455	                return d
   456	
   457	    def _v6_labels(self, cam_t, inst_data, occ_detector, target_occ: float) -> dict:
   458	        """Per-actor (target + distractors) labels for one frame — see recording/labels_v6.py."""
   459	        from recording.labels_v6 import (PEDESTRIAN_TAG, VEHICLE_TAGS, amodal_box_from_vertices,
   460	                                         associate, decode_instance, focal, view_block_frac)
   461	        W, H = self._resolution
   462	        fpx = focal(W, self._fov)
   463	        cam_inv = np.array(cam_t.get_inverse_matrix())
   464	        cam_xyz = np.array([cam_t.location.x, cam_t.location.y, cam_t.location.z])
   465	        A = len(self._v6_handles)
   466	        boxes, inframe = [None] * A, np.zeros(A, np.uint8)
   467	        depth, occ = np.full(A, np.nan, np.float32), np.full(A, np.nan, np.float32)
   468	        amodal = np.full((A, 4), -1.0, np.float32)
   469	        yaw, pos = np.full(A, np.nan, np.float32), np.full((A, 3), np.nan, np.float32)
   470	        for a, h in enumerate(self._v6_handles):
   471	            if h is None or not h.is_alive:
   472	                continue
   473	            try:
   474	                tf = h.get_transform()
   475	                verts = h.bounding_box.get_world_vertices(tf)
   476	            except RuntimeError:
   477	                continue
   478	            yaw[a] = tf.rotation.yaw
   479	            pos[a] = (tf.location.x, tf.location.y, tf.location.z)
   480	            pts = np.array([[v.x, v.y, v.z] for v in verts], np.float64)
   481	            b, cin, dd = amodal_box_from_vertices(pts, cam_inv, W, H, fpx)
   482	            boxes[a], inframe[a], depth[a] = b, int(cin), dd
   483	            if b is not None:
   484	                amodal[a] = b
   485	                if a == 0:
   486	                    occ[a] = target_occ
   487	                else:
   488	                    try:
   489	                        occ[a] = float(occ_detector.check(h, cam_xyz)[1])
   490	                    except RuntimeError:
   491	                        pass
   492	        tag, iid = decode_instance(inst_data.raw_data, W, H)
   493	        inst_id, vis_px, modal, mask, traffic = associate(boxes, tag, iid, prev=self._v6_prev_iid)
   494	        if self._v6_prev_iid is None:
   495	            self._v6_prev_iid = np.full(A, -1, np.int32)
   496	        self._v6_prev_iid = np.where(inst_id >= 0, inst_id, self._v6_prev_iid)
   497	        dyn = np.isin(tag, VEHICLE_TAGS + (PEDESTRIAN_TAG,))
   498	        return {"in_frame": inframe, "amodal_box": amodal, "depth": depth, "occ_raycast": occ,
   499	                "inst_id": inst_id, "vis_px": vis_px, "modal_box": modal, "yaw": yaw, "pos": pos,
   500	                "mask": mask, "traffic": traffic,
   501	                "seg_iid": np.where(dyn, iid, 0).astype(np.uint16), "seg_semantic": tag.astype(np.uint8),
   502	                "view_block_frac": view_block_frac(tag)}
   503	
   504	    def _target_occluded(self, cam_t, tpos) -> bool:
   505	        """Whether the line of sight from the camera to the target is blocked by
   506	        geometry (building / tunnel roof) — i.e. the target is hidden even if it
   507	        still projects inside the frame. One ray per call."""
   508	        try:
   509	            end = carla.Location(float(tpos[0]), float(tpos[1]), float(tpos[2]) + 0.8)
   510	            d_target = cam_t.location.distance(end)
   511	            for h in self._world.cast_ray(cam_t.location, end):
   512	                if cam_t.location.distance(h.location) < d_target - 3.0:
   513	                    return True   # something substantial between camera and target
   514	        except (RuntimeError, AttributeError):
   515	            return False
   516	        return False
   517	
   518	    def _point_in_frame(self, cam_t, wp) -> bool:
   519	        """Whether a world point projects inside the RGB frame (90° FOV camera)."""
