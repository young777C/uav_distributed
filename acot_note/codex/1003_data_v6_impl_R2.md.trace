    91	
    92	def associate(boxes, tag, iid, min_inside: float = 0.5, prev=None):
    93	    """Assign instance blobs to scene actors.
    94	
    95	    boxes: list (len A) of amodal boxes (x0,y0,x1,y1) or None.
    96	    Returns per-actor arrays (iid, vis_px, modal box) + uint8 instance mask (0 bg, 1..A scene actors,
    97	    254 other vehicles, 253 pedestrians) + padded traffic table (MAX_TRAFFIC, 7):
    98	    [iid, tag, x0, y0, x1, y1, px] for unmatched vehicle blobs (iid = -1 padding).
    99	    Greedy by overlap; a blob is accepted only if >= min_inside of its pixels lie inside the box
   100	    (so a neighbouring occluder is not taken for the actor). `prev` (A,) = last frame's iid per actor:
   101	    a candidate that keeps the actor's previous iid gets its overlap doubled (temporal consistency)."""
   102	    H, W = tag.shape
   103	    A = len(boxes)
   104	    veh = np.isin(tag, VEHICLE_TAGS)
   105	    out_iid = np.full(A, -1, np.int32)
   106	    out_px = np.zeros(A, np.int32)
   107	    out_box = np.full((A, 4), -1.0, np.float32)
   108	    mask = np.zeros((H, W), np.uint8)
   109	    mask[tag == PEDESTRIAN_TAG] = MASK_PEDESTRIAN
   110	    if veh.any():
   111	        ids, counts = np.unique(iid[veh], return_counts=True)
   112	        total = dict(zip(ids.tolist(), counts.tolist()))
   113	    else:
   114	        total = {}
   115	    cands = []                                   # (overlap, actor, iid)
   116	    for a, b in enumerate(boxes):
   117	        if b is None:
   118	            continue
   119	        x0, y0, x1, y1 = (int(np.floor(b[0])), int(np.floor(b[1])), int(np.ceil(b[2])) + 1, int(np.ceil(b[3])) + 1)
   120	        sub_v = veh[y0:y1, x0:x1]
   121	        if not sub_v.any():
   122	            continue
   123	        ii, cc = np.unique(iid[y0:y1, x0:x1][sub_v], return_counts=True)
   124	        for i_, c_ in zip(ii.tolist(), cc.tolist()):
   125	            if c_ >= min_inside * total.get(i_, 1):
   126	                keep = prev is not None and prev[a] == i_
   127	                cands.append((c_ * (2 if keep else 1), a, i_))
   128	    used_a, used_i = set(), set()
   129	    for c_, a, i_ in sorted(cands, reverse=True):
   130	        if a in used_a or i_ in used_i:
   131	            continue
   132	        used_a.add(a); used_i.add(i_)
   133	        m = veh & (iid == i_)
   134	        ys, xs = np.nonzero(m)
   135	        out_iid[a], out_px[a] = i_, len(xs)
   136	        out_box[a] = (xs.min(), ys.min(), xs.max(), ys.max())
   137	        mask[m] = a + 1
   138	    traffic = np.full((MAX_TRAFFIC, 7), -1.0, np.float32)
   139	    k = 0
   140	    for i_, c_ in sorted(total.items(), key=lambda t: -t[1]):
   141	        if i_ in used_i:
   142	            continue
   143	        m = veh & (iid == i_)
   144	        mask[m] = MASK_OTHER_VEHICLE
   145	        if k < MAX_TRAFFIC:
   146	            ys, xs = np.nonzero(m)
   147	            traffic[k] = (i_, float(np.bincount(tag[m]).argmax()), xs.min(), ys.min(), xs.max(), ys.max(), c_)
   148	            k += 1
   149	    return out_iid, out_px, out_box, mask, traffic
   150	
