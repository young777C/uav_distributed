     1	# v6 BASE (acot_note/1003_data-regen-v6-spec.md): replicates the original v5 / mvp.yaml distribution at
     2	# FOV 90 (what Stage-2 v5 was trained on) + instance-seg per-actor labels. Daytime, no fog (default weather).
     3	environment:
     4	  max_duration_seconds: 150
     5	  towns: ["Town01", "Town02", "Town04", "Town05", "Town10HD"]
     6	  loss_events:                     # (c) enable deliberate sustained loss → predict-intercept
     7	    enabled: true
     8	    per_episode: 2
     9	    dur_range: [4.5, 6.5]          # >=3s off-frame run after ~1s exit lag → recovery counts
    10	
    11	scene:
    12	  traffic_lights: {green_s: 6.0, yellow_s: 2.0, red_s: 2.0}   # v6.1: short cycles → fewer long queues
    13	  ambient:                        # v6.1: 80 cars within 70 m gridlocked the target (stationary 40-100 %)
    14	    vehicles: 40
    15	    radius: 90
    16	  scene_actors_ignore_lights: 100.0  # v6: target + distractors run lights/signs (target was still 40-70 % of time)
    17	  num_distractors: [4, 8]
    18	  min_similar_distractors: 2
    19	  distractor_ahead_bias: 0.75
    20	  target_class_weights:            # spec §4d: all-sedan scene → rich look-alike pool (21 models × 18
    21	    car: 1.0                        # colours), higher co-visibility; drop sparse moto/bike/scooter
    22	    motorcycle: 0.0                 # (only 1-3 models each → too few look-alikes) + pedestrians (never targets)
    23	    bicycle: 0.0
    24	    scooter: 0.0
    25	    pedestrian: 0.0
    26	  similarity_strategy_weights:
    27	    same_color_diff_shape: 0.40
    28	    same_shape_diff_color: 0.40
    29	    distinct: 0.20
    30	
    31	target:
    32	  maneuver:                # OFF — stochastic TM maneuvers only fragment loss into
