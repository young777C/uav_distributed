     1	"""Automated QC + split manifest for the v6 dataset (acot_note/1003_data-regen-v6-spec.md §QC).
     2	
     3	  python3 carla_uav_tracking/scripts/qc_v6.py <dataset_dir> [--split-out train/splits/v6_fov90_split.json] [--viz N]
     4	  (also imported by generate_batch.py for the per-episode gate before the atomic rename)
     5	
     6	Per-episode gates (FAIL → episode excluded from the manifest):
     7	  G1 attrs: fov/rgb_resolution/label_version/git_commit/subset/config_snapshot present; fov == 90
     8	  G2 rgb shape (T,512,512,3), T >= 300, no all-black frame among 16 sampled frames
     9	  G3 projection ↔ instance alignment: for actor-frames with vis_px >= 50, the instance (modal) box lies
    10	     inside the projected 3D (amodal) box (≥ 90 % of its area, 3 px margin) in ≥ 95 % of cases
    11	     → catches any FOV / pose mismatch between rendering and projection automatically
    12	  G4 association: clearly visible actors (amodal box ≥ 12 px, occ_raycast < 0.2, center in frame) get an
    13	     instance blob in ≥ 85 % of cases
    14	  G5 postprocess done: actors/visible, actors/tracklet_id, events/target_reentry present
    15	  G6 view: frames with the camera inside/pressed against geometry (view/block_frac > 0.8) ≤ 1 % of T
    16	  G7 association stability: target instance-id switches between consecutive visible frames ≤ 3
    17	  G9 motion: the target moves (speed > 1 m/s) in ≥ 40 % of frames
    18	  G8 subset gates: all T ≥ 600 (60 s); reacq ≥ 1 target re-entry after ≥ 3 s with a look-alike visible;
    19	     occ ≥ 20 in-frame structurally-occluded target frames or ≥ 1 occlusion-caused re-entry
    20	Dataset-level report: per subset × town counts, target frame classes, re-entry events, look-alike
    21	co-visibility, box sizes. Split: train = training towns minus val (every 10th episode id per town),
    22	test = held-out town (attrs test_town)."""
    23	import argparse
    24	import collections
    25	import glob
    26	import json
    27	import os
    28	
    29	import h5py
    30	import numpy as np
    31	
    32	REQ_ATTRS = ("fov", "K", "rgb_resolution", "label_version", "git_commit", "subset", "config_snapshot", "town", "seed")
    33	REQ_DS = ("actors/yaw", "actors/pos", "actors/extent", "seg/iid", "seg/semantic", "view/block_frac",
    34	          "state/loss_window", "state/action_valid", "instance_mask", "traffic/blobs")
    35	
    36	
    37	def check_episode(p):
    38	    r = {"file": os.path.basename(p), "fails": []}
    39	    with h5py.File(p, "r") as f:
    40	        a = dict(f.attrs)
    41	        miss = [k for k in REQ_ATTRS if k not in a]
    42	        if miss or float(a.get("fov", -1)) != 90.0:
    43	            r["fails"].append(f"G1 attrs missing={miss} fov={a.get('fov')}")
    44	        for k in ("town", "subset", "episode_id", "test_town", "language", "strategy", "num_similar"):
    45	            v = a.get(k)
    46	            r[k] = v.item() if hasattr(v, "item") else v
    47	        T = f["rgb"].shape[0]; r["T"] = int(T)
    48	        if f["rgb"].shape[1:] != (512, 512, 3) or T < 300:
    49	            r["fails"].append(f"G2 rgb shape {f['rgb'].shape}")
    50	        idx = np.linspace(0, T - 1, 16).astype(int)
    51	        if any(f["rgb"][i].max() < 5 for i in idx):
    52	            r["fails"].append("G2 black frame")
    53	        if "actors" not in f:
    54	            r["fails"].append("no actors group"); return r
    55	        miss_ds = [k for k in REQ_DS if k not in f]
    56	        if miss_ds:
    57	            r["fails"].append(f"G1 datasets missing={miss_ds}")
    58	        if "view/block_frac" in f:
    59	            bf = f["view/block_frac"][:]
    60	            r["view_blocked_frames"] = int((bf > 0.8).sum())
    61	            if r["view_blocked_frames"] > 0.01 * T:
    62	                r["fails"].append(f"G6 view blocked {r['view_blocked_frames']} frames")
    63	        g = f["actors"]
    64	        am, mo, px = g["amodal_box"][:], g["modal_box"][:], g["vis_px"][:]
    65	        occ, inf_ = g["occ_raycast"][:], g["in_frame"][:]
    66	        role = g["role"][:]
    67	        # G3 containment of modal in amodal
    68	        sel = px >= 50
    69	        mx0, my0, mx1, my1 = (mo[..., i][sel] for i in range(4))
    70	        ax0, ay0, ax1, ay1 = (am[..., i][sel] for i in range(4))
    71	        ix = np.clip(np.minimum(mx1, ax1 + 3) - np.maximum(mx0, ax0 - 3) + 1, 0, None)
    72	        iy = np.clip(np.minimum(my1, ay1 + 3) - np.maximum(my0, ay0 - 3) + 1, 0, None)
    73	        area = (mx1 - mx0 + 1) * (my1 - my0 + 1)
    74	        cont = ix * iy / np.maximum(area, 1)
    75	        r["g3_n"], r["g3_ok"] = int(sel.sum()), float((cont >= 0.9).mean()) if sel.any() else float("nan")
    76	        if sel.sum() >= 50 and r["g3_ok"] < 0.95:
    77	            r["fails"].append(f"G3 alignment {r['g3_ok']:.3f}")
    78	        # G4 association
    79	        w = am[..., 2] - am[..., 0]; h = am[..., 3] - am[..., 1]
    80	        clear = (am[..., 0] >= 0) & (np.minimum(w, h) >= 12) & (np.nan_to_num(occ, nan=1) < 0.2) & (inf_ == 1)
    81	        r["g4_n"], r["g4_ok"] = int(clear.sum()), float((px[clear] > 0).mean()) if clear.any() else float("nan")
    82	        if clear.sum() >= 50 and r["g4_ok"] < 0.85:
    83	            r["fails"].append(f"G4 association {r['g4_ok']:.3f}")
    84	        if not all(k in g for k in ("visible", "tracklet_id")) or "events/target_reentry" not in f:
    85	            r["fails"].append("G5 postprocess missing"); return r
    86	        vis = g["visible"][:].astype(bool)
    87	        tv = vis[:, 0]
    88	        toff = (inf_[:, 0] == 0) & ~tv                       # classes are disjoint: visible > off > occluded
    89	        tocc = (inf_[:, 0] == 1) & ~tv
    90	        r["frames"] = {"visible": int(tv.sum()), "occluded_or_tiny": int(tocc.sum()), "off_screen": int(toff.sum())}
    91	        r["target_struct_occ_frames"] = int((tocc & (np.nan_to_num(occ[:, 0]) >= 0.5)).sum())
    92	        ii = g["inst_id"][:, 0]
    93	        both = tv[1:] & tv[:-1] & (ii[1:] >= 0) & (ii[:-1] >= 0)
    94	        r["target_iid_switches"] = int((both & (ii[1:] != ii[:-1])).sum())
    95	        if r["target_iid_switches"] > 3:
    96	            r["fails"].append(f"G7 target iid switches {r['target_iid_switches']}")
    97	        r["target_partial_occ"] = int(((np.nan_to_num(occ[:, 0]) > 0) & tv).sum())
    98	        ev = f["events/target_reentry"][:]
    99	        r["reentry"] = {"n": int(len(ev)), "gap>=30": int((ev[:, 1] >= 30).sum()) if len(ev) else 0,
   100	                        "gap>=30_lookalike": int(((ev[:, 1] >= 30) & (ev[:, 3] >= 1)).sum()) if len(ev) else 0,
   101	                        "cause_occ": int((ev[:, 2] >= 1).sum()) if len(ev) else 0}
   102	        look = vis[:, 1:] & (role[1:] == 1)[None]
   103	        r["lookalike_covis"] = float((look.any(1) & tv).sum() / max(tv.sum(), 1))
   104	        tb = am[tv, 0]
   105	        r["target_box_px_median"] = float(np.median(np.maximum(tb[:, 2] - tb[:, 0], tb[:, 3] - tb[:, 1]))) if tv.any() else float("nan")
   106	        r["n_tracklets_target"] = int(len(set(g["tracklet_id"][:, 0].tolist()) - {-1}))
   107	        sp = f["target/tspeed"][:]
   108	        r["target_moving_frac"] = float((sp > 1.0).mean())
   109	        if r["target_moving_frac"] < 0.4:
   110	            r["fails"].append(f"G9 target moving only {r['target_moving_frac']:.2f}")
   111	        sub = str(r.get("subset") or "")
   112	        if T < 600:
   113	            r["fails"].append(f"G8 short episode T={T}")
   114	        if sub == "reacq" and r["reentry"]["gap>=30_lookalike"] < 1:
   115	            r["fails"].append("G8 reacq: no >=3 s re-entry with look-alike")
   116	        if sub == "occ" and r["target_struct_occ_frames"] < 20 and r["reentry"]["cause_occ"] < 1:
   117	            r["fails"].append(f"G8 occ: struct-occ frames {r['target_struct_occ_frames']}, occ re-entries 0")
   118	    return r
