    50	        self.safety: SafetyMonitor | None = None
    51	        self._target: VehicleTarget | PedestrianTarget | None = None
    52	        self._target_type: str = ""
    53	        self._target_class: str = "car"
    54	        self._maneuver_injector: ManeuverInjector | None = None
    55	        self._distractors: list = []
    56	        self._distractor_meta: list[dict] = []
    57	        self._ambient_walkers: list = []   # background pedestrians (manual control)
    58	        self._perturbation_injector = None
    59	        self._obstacle_avoider = None
    60	        self._language_gen = None
    61	        self.episode_language: str = ""
    62	        self.target_meta: dict = {}
    63	        self.target_plan: dict = {}
    64	        self._tier_alt = [24.0, 32.0]
    65	        self._distance_tier = "suitable"
