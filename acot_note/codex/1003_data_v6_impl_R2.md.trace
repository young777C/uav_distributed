   210	        self.safety = SafetyMonitor()
   211	        self.safety.reset()
   212	
   213	        # -- Perturbation injector (P: honor config) --
   214	        from carla_uav.perturbation import PerturbationInjector, PerturbationConfig
   215	        pert_cfg = self._config.get("uav", {}).get("perturbation", {})
   216	        self._perturbation_injector = PerturbationInjector(
   217	            PerturbationConfig(**{k: v for k, v in pert_cfg.items()
   218	                                  if k in PerturbationConfig.__dataclass_fields__})
   219	        )
   220	        self._perturbation_injector.reset()
   221	
   222	        # -- Maneuver injector (TM-based, smooth — modulates speed/lane, never raw
   223	        #    control, so the target stays on-road and obeys traffic rules) --
   224	        man_cfg = self._config.get("target", {}).get("maneuver", {})
