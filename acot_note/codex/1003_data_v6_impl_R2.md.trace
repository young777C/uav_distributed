  1036	
  1037	    def loss_window_onset(self, elapsed: float) -> float | None:
  1038	        """Window duration once at onset (→ force the target to deviate); else None."""
  1039	        sched = getattr(self, "_loss_scheduler", None)
  1040	        return sched.onset(elapsed) if sched else None
  1041	
  1042	    def _target_tm(self):
  1043	        veh = getattr(self._target, "_vehicle", None) if self._target_type == "vehicle" else None
