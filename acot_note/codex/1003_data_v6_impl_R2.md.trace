  1026	    def check_maneuver(self, timestamp: float) -> Any | None:
  1027	        if self._maneuver_injector is not None and self._target_type == "vehicle":
  1028	            return self._maneuver_injector.maybe_inject(self._target._vehicle, timestamp)
