   797	    def station_keep_lookalikes(self) -> None:
   798	        """§8 depth decorrelation: hold each SIMILAR look-alike at its assigned signed
   799	        along-road offset relative to the target (some BEHIND → nearer camera, some ahead →
   800	        farther) via smooth TM speed nudges, so the target's depth RANK stays ~uniform
   801	        instead of systematically nearest. Speed-based, not teleport: a teleported decoy is
   802	        immediately driven forward again by autopilot; a proportional speed offset keeps it
   803	        stationed. No-op for distractors without a desired_off (fillers)."""
