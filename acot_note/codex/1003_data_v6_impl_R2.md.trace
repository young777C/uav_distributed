    73	    def setup_episode(self) -> dict[str, Any]:
    74	        """Spawn all actors for a new episode. Returns episode metadata."""
    75	        env_cfg = self._config.get("environment", {})
    76	        scene_cfg = self._config.get("scene", {})
    77	
    78	        # -- Seeding (P1-b): make the whole episode reproducible --
    79	        seed = env_cfg.get("seed", None)
    80	        if seed is not None:
    81	            seed = int(seed)
    82	            random.seed(seed)
    83	            np.random.seed(seed % (2**32))
    84	        tm = self._client.get_trafficmanager(_tm_port())
    85	        tm.set_synchronous_mode(True)
    86	        # Official generate_traffic.py settings → calm, rule-abiding traffic.
    87	        tm.set_global_distance_to_leading_vehicle(2.5)
    88	        tm.global_percentage_speed_difference(20.0)  # ambient drives 20% below limit
    89	        if seed is not None and hasattr(tm, "set_random_device_seed"):
    90	            tm.set_random_device_seed(seed)
    91	
    92	        # -- Clean slate: remove any leftover actors from a prior episode so the
    93	        #    TrafficManager never ticks a destroyed vehicle (avoids C++ aborts). --
    94	        self._destroy_all_traffic()
    95	
    96	        # -- Randomize weather --
    97	        self._set_random_weather(self._config.get("weather", {}))
    98	
    99	        # -- Language / scene composer --
   100	        self._language_gen = LanguageGenerator()
   101	
   102	        # -- Select wide-road town (loaded by the batch driver; sanity fallback) --
   103	        wide_road_towns = env_cfg.get("towns", ["Town03", "Town04", "Town05"])
   104	        if self._world.get_map().name.split("/")[-1] not in wide_road_towns:
   105	            try:
   106	                self._client.load_world(random.choice(wide_road_towns))
   107	                time.sleep(2.0)
   108	                self._world = self._client.get_world()
   109	                self._map = self._world.get_map()
   110	            except RuntimeError:
   111	                pass
   112	
   113	        # -- Choose target class + similarity strategy --
   114	        self._target_class = self._pick_target_class(scene_cfg)
   115	        strategy = self._pick_strategy(scene_cfg, self._target_class)
   116	        num_distractors = random.randint(*scene_cfg.get("num_distractors", [4, 8]))
   117	        min_similar = int(scene_cfg.get("min_similar_distractors", 2))
   118	
   119	        # Pick tracking-distance tier → UAV maintained altitude + language distance.
   120	        tier_cfg = self._config.get("distance_tiers", {})
   121	        self._distance_tier = self._pick_distance_tier(tier_cfg)
   122	        self._tier_alt = tier_cfg.get(self._distance_tier, {}).get("altitude", [24, 32])
   123	        # §8 (redo): per-episode HORIZONTAL tracking standoff (metres the UAV TRAILS the
   124	        # target — applied in expert_action) → randomises the target's forward/depth position
   125	        # in the frame → decorrelates its depth RANK. NOT altitude (that only scales absolute
   126	        # depth uniformly, leaving the rank — the actual `nearest` shortcut — unchanged).
   127	        _dec = self._config.get("scene", {}).get("decorrelate_position", {})
   128	        if _dec.get("enabled", False):
   129	            sr = _dec.get("standoff_range", [8.0, 40.0])
   130	            self._tracking_standoff = float(random.uniform(float(sr[0]), float(sr[1])))
   131	            # §9: smooth per-episode camera-AIM offset so the target is NOT locked at image
   132	            # centre → decorrelates 'most-central'. The aim point = target + a ground-plane
   133	            # offset from two low-freq sinusoids (random per-episode phase/freq) whose
   134	            # amplitude scales with viewing distance (constant IMAGE spread ~aim_frac,
   135	            # target stays in frame). Smooth + independent of maneuver/loss events (§9.3.5).
   136	            self._aim_frac = float(_dec.get("aim_offset_frac", 0.32))
   137	            self._aim_fx = random.uniform(0.04, 0.11); self._aim_px = random.uniform(0.0, 6.283)
   138	            self._aim_fy = random.uniform(0.04, 0.11); self._aim_py = random.uniform(0.0, 6.283)
   139	        else:
   140	            self._tracking_standoff = 0.0
   141	            self._aim_frac = 0.0
   142	
   143	        # A1c③ — decide per-episode whether to (a) spawn the target so it drives into an
   144	        # overhead occluder (in-frame structural occlusion), and (b) use an oblique,
   145	        # lower-altitude camera (surfaces urban side-wall occlusion). Both default OFF.
   146	        occ_cfg = self._config.get("occlusion", {})
   147	        cam_cfg = self._config.get("camera", {})
   148	        self._occlusion_biased = (bool(occ_cfg.get("enabled", False))
   149	                                  and random.random() < float(occ_cfg.get("bias_fraction", 0.0)))
   150	        self._camera_pitch, self._camera_oblique = self._pick_camera(cam_cfg)
   151	        if self._camera_oblique:
   152	            self._tier_alt = list(cam_cfg.get("oblique", {}).get("altitude_range", self._tier_alt))
   153	
   154	        plan = self._language_gen.compose_scene(
   155	            target_class=self._target_class,
   156	            num_distractors=num_distractors,
   157	            strategy=strategy,
   158	            min_similar=min_similar,
   159	        )
   160	        self.target_meta = plan["target"]
   161	
   162	        # -- Spawn target + distractors (co-located & co-visible) --
   163	        if self._target_class in VEHICLE_CLASSES:
   164	            self._setup_vehicle_scene(plan, scene_cfg)
   165	        else:
   166	            self._setup_pedestrian_scene(plan, scene_cfg)
   167	
   168	        self._target_type = "vehicle" if self._target_class in VEHICLE_CLASSES else "pedestrian"
   169	        print(f"  [{self._target_class}/{plan['strategy']}] target={plan['target']['desc']} "
   170	              f"| distractors={len(self._distractors)} (similar={plan['num_similar']})")
   171	
   172	        # -- Background traffic (official-style): diverse vehicles + pedestrians --
   173	        self._spawn_ambient_traffic(scene_cfg)
   174	
   175	        # v6: the target sat still 40-70 % of the time (red lights / queues behind 80 ambient cars) →
   176	        # little motion, no real losses. Let the scene actors (target + distractors, so the look-alike
   177	        # group stays together) ignore lights/signs; ambient traffic keeps obeying them.
   178	        # v6.1: queues behind ambient cars waiting at long reds (CARLA default 4-way red ≈ 30-45 s) kept the
   179	        # target still → shorten every light's cycle (set per episode; lights persist on the server).
   180	        tl_cfg = scene_cfg.get("traffic_lights") or {}
   181	        if tl_cfg:
   182	            for tl in self._world.get_actors().filter("traffic.traffic_light"):
   183	                try:
   184	                    tl.set_green_time(float(tl_cfg.get("green_s", 6.0)))
   185	                    tl.set_yellow_time(float(tl_cfg.get("yellow_s", 2.0)))
   186	                    tl.set_red_time(float(tl_cfg.get("red_s", 2.0)))
   187	                except RuntimeError:
   188	                    pass
   189	        ign = float(scene_cfg.get("scene_actors_ignore_lights", 0.0))
   190	        if ign > 0:
   191	            tm = self._client.get_trafficmanager(_tm_port())
   192	            for o in [self._target] + list(self._distractors):
   193	                v = getattr(o, "_vehicle", None)
