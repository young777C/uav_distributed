  1031	    # -- (c) deliberate loss-event hooks (driven by the recorder loop) --
  1032	    def in_loss_window(self, elapsed: float) -> bool:
  1033	        """True while inside a scheduled loss window → fly the expert blind (predict)."""
  1034	        sched = getattr(self, "_loss_scheduler", None)
