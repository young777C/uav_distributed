    21	
    22	def actor_handle(obj):
    23	    """carla.Actor behind a scene target/distractor wrapper (VehicleTarget / PedestrianTarget)."""
    24	    return getattr(obj, "_vehicle", None) or getattr(obj, "_walker", None)
