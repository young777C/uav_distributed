   201	
   202	        # -- Spawn UAV behind & above the target --
   203	        self._spawn_uav(self._config.get("uav", {}))
   204	
   205	        # -- Expert policy / safety (maintain the tier's tracking altitude) --
   206	        exp_cfg = dict(self._config.get("uav", {}).get("expert_policy", {}))
   207	        exp_cfg["viewing_height_range"] = self._tier_alt
   208	        self.expert = ExpertPolicy(exp_cfg)
