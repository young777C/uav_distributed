    78	def jobs(plan, chunk):
    79	    per = []   # list of per-(subset,town) chunk lists
    80	    for sub, towns in PLANS[plan].items():
    81	        scen, base = SUBSETS[sub]
    82	        for town, n in towns.items():
    83	            start0 = base + TOWN_IDX[town] * 1000
    84	            per.append([(sub, scen, town, start0 + k, min(chunk, n - k)) for k in range(0, n, chunk)])
    85	    out, i = [], 0
    86	    while any(per):                                  # round-robin interleave across (subset, town)
    87	        for lst in per:
    88	            if i < len(lst):
    89	                out.append(lst[i])
    90	        i += 1
    91	        if all(i >= len(l) for l in per):
    92	            break
    93	    return out
    94	
