    31	def project_world(points: np.ndarray, cam_inv: np.ndarray, W: int, H: int, f: float):
    32	    """points (N,3) world → (u, v, depth) arrays; CARLA camera frame x fwd, y right, z up."""
    33	    P = np.concatenate([points, np.ones((len(points), 1))], 1) @ cam_inv.T
    34	    d = P[:, 0]
    35	    with np.errstate(divide="ignore", invalid="ignore"):
    36	        u = f * (P[:, 1] / d) + W / 2.0
    37	        v = f * (-P[:, 2] / d) + H / 2.0
    38	    return u, v, d
    39	
    40	
    41	def amodal_box(actor, cam_inv, W, H, f):
    42	    """Tight 2D box of the projected 3D bounding box, clipped to the image.
    43	    Returns ((x0, y0, x1, y1) or None, center_in_frame, depth_of_center)."""
    44	    tf = actor.get_transform()
    45	    verts = actor.bounding_box.get_world_vertices(tf)
    46	    pts = np.array([[v.x, v.y, v.z] for v in verts], np.float64)
    47	    return amodal_box_from_vertices(pts, cam_inv, W, H, f)
    48	
    49	
    50	def amodal_box_from_vertices(pts, cam_inv, W, H, f):
    51	    """Same as amodal_box but from the 8 world vertices (offline re-projection). Vertices behind the
    52	    near plane are replaced by the intersections of every front/behind vertex pair with the plane, so
    53	    the box of a car crossing the image border/near plane does not shrink abruptly."""
    54	    P = np.concatenate([pts, np.ones((len(pts), 1))], 1) @ cam_inv.T          # camera frame (x fwd)
    55	    c = P.mean(0)
    56	    with np.errstate(divide="ignore", invalid="ignore"):
    57	        cu, cv = f * (c[1] / c[0]) + W / 2.0, f * (-c[2] / c[0]) + H / 2.0
    58	    cd = c[0]
    59	    center_in = bool(cd > NEAR and 0 <= cu < W and 0 <= cv < H)
    60	    front = P[:, 0] > NEAR
    61	    if not front.any():
    62	        return None, False, float(cd)
    63	    Q = [P[front, :3]]
    64	    for i in np.where(front)[0]:
    65	        for j in np.where(~front)[0]:
    66	            t = (P[i, 0] - NEAR) / (P[i, 0] - P[j, 0])
    67	            Q.append((P[i, :3] + t * (P[j, :3] - P[i, :3]))[None])
    68	    Q = np.concatenate(Q, 0)
    69	    u = f * (Q[:, 1] / Q[:, 0]) + W / 2.0
    70	    v = f * (-Q[:, 2] / Q[:, 0]) + H / 2.0
    71	    x0, x1 = np.clip(u.min(), 0, W - 1), np.clip(u.max(), 0, W - 1)
    72	    y0, y1 = np.clip(v.min(), 0, H - 1), np.clip(v.max(), 0, H - 1)
    73	    if x1 - x0 < 1 or y1 - y0 < 1:
    74	        return None, center_in, float(cd)
    75	    return (float(x0), float(y0), float(x1), float(y1)), center_in, float(cd)
    76	
    77	
    78	def decode_instance(raw: bytes, W: int, H: int):
    79	    """CARLA instance-seg BGRA → (tag (H,W) uint8, iid (H,W) int32). R = semantic tag, G|B<<8 = id."""
    80	    a = np.frombuffer(raw, np.uint8).reshape(H, W, 4)
    81	    tag = a[..., 2].copy()
    82	    iid = a[..., 1].astype(np.int32) | (a[..., 0].astype(np.int32) << 8)
    83	    return tag, iid
    84	
    85	
    86	def view_block_frac(tag) -> float:
    87	    """Fraction of the image tagged Unlabeled/Building/Wall — ≈1 when the camera is inside or pressed
    88	    against geometry (garbage frame)."""
    89	    return float(np.isin(tag, VIEW_BLOCK_TAGS).mean())
