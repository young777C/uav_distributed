import h5py, glob, os, numpy as np
files = [
'/nvidia/hque/data/carla_data/uavtrack_v6_smoke2/episode_202000.rejected.h5',
'/nvidia/hque/data/carla_data/uavtrack_v6_smoke3/episode_202000.rejected.h5',
'/nvidia/hque/data/carla_data/uavtrack_v6_smoke4/episode_202500.rejected.h5',
]
for p in files:
    if not os.path.exists(p): continue
    with h5py.File(p,'r') as f:
        print('\\n', os.path.basename(p), 'T', f['rgb'].shape[0])
        lw=f['state/loss_window'][:] if 'state/loss_window' in f else None
        av=f['state/action_valid'][:] if 'state/action_valid' in f else None
        vis=f['actors/visible'][:,0].astype(bool) if 'actors/visible' in f else (f['actors/vis_px'][:,0]>=20)
        inf=f['actors/in_frame'][:,0].astype(bool)
        print('loss frames', int(lw.sum()) if lw is not None else None, 'action_valid0', int((av==0).sum()) if av is not None else None, 'vis', int(vis.sum()), 'inframe', int(inf.sum()))
        if lw is not None:
            print('vis during loss', int((vis & (lw>0)).sum()), 'inframe during loss', int((inf & (lw>0)).sum()))
            # runs invisible length
        invisible = ~vis
        runs=[]; s=None
        for i,x in enumerate(invisible):
            if x and s is None: s=i
            if (not x or i==len(invisible)-1) and s is not None:
                e=i-1 if not x else i; runs.append((s,e,e-s+1)); s=None
        print('max invis run', max([r[2] for r in runs], default=0), 'runs>=30', [r for r in runs if r[2]>=30][:5])
        if 'events/target_reentry' in f: print('events', f['events/target_reentry'][:10])
