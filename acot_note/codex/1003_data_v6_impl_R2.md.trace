     1	"""Batch generate multiple tracking episodes on a single CARLA server.
     2	
     3	Usage:
     4	    python scripts/generate_batch.py --num-episodes 100 --config config/scenarios/urban_hard.yaml
     5	"""
     6	
     7	from __future__ import annotations
     8	
     9	import argparse
    10	import json
    11	import os
    12	import sys
    13	import time
    14	from pathlib import Path
    15	
    16	import carla
    17	import yaml
    18	
    19	sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
    20	
    21	from scene.scene_manager import SceneManager
    22	from recording.recorder import EpisodeRecorder
    23	from recording.postprocess import PostProcessor
    24	
    25	
    26	def main():
    27	    parser = argparse.ArgumentParser(description="Batch generate tracking episodes")
    28	    parser.add_argument("--num-episodes", type=int, default=100)
    29	    parser.add_argument("--config", type=str, default=None)
    30	    parser.add_argument("--host", type=str, default="127.0.0.1")
    31	    parser.add_argument("--port", type=int, default=2000)
    32	    parser.add_argument("--output", type=str, default="/data",
    33	                        help="Output dir; container /data == host carla_data mount")
    34	    parser.add_argument("--start-id", type=int, default=0)
    35	    parser.add_argument("--seed", type=int, default=42,
    36	                        help="Base seed; per-episode seed = seed + episode_id")
    37	    parser.add_argument("--max-size-gb", type=float, default=45.0,
    38	                        help="Stop when total data exceeds this")
    39	    parser.add_argument("--postprocess", action="store_true", default=True)
    40	    # v6 (acot_note/1003_data-regen-v6-spec.md): parallel-safe jobs + provenance
    41	    parser.add_argument("--town", type=str, default=None, help="override environment.towns with ONE town")
    42	    parser.add_argument("--subset", type=str, default="", help="subset tag written to attrs (base/reacq/occ)")
    43	    parser.add_argument("--progress-file", type=str, default=None, help="per-job resume file (default <out>/.attempted)")
    44	    parser.add_argument("--summary-jsonl", type=str, default=None, help="append one summary line per episode")
    45	    parser.add_argument("--provenance", type=str, default=None, help="JSON dict of host-side provenance attrs")
    46	    args = parser.parse_args()
    47	
    48	    # Load config
    49	    cfg = _load_config(args.config)
    50	    if args.town:
    51	        cfg.setdefault("environment", {})["towns"] = [args.town]
    52	    output_dir = Path(args.output)
    53	    output_dir.mkdir(parents=True, exist_ok=True)
    54	    max_bytes = int(args.max_size_gb * 1024**3)
    55	    town_list = cfg.get("environment", {}).get("towns", ["Town01"])
    56	
    57	    # Connect (generous timeout: first map load compiles shaders)
    58	    client = carla.Client(args.host, args.port)
    59	    client.set_timeout(60.0)
    60	
    61	    summaries = []
    62	    postproc = PostProcessor(output_dir, fov=float(cfg.get("output", {}).get("fov", 90.0)))
    63	    prov = json.loads(Path(args.provenance).read_text()) if args.provenance else {}
    64	    prov.update({
    65	        "config_snapshot": json.dumps(cfg, sort_keys=True, default=str),
    66	        "scenario_file": str(args.config or ""),
    67	        "subset": args.subset,
    68	        "seed_base": int(args.seed),
    69	        "carla_server_version": client.get_server_version(),
    70	        "carla_client_version": client.get_client_version(),
    71	    })
    72	
    73	    # Load the scenario's first town up front (skip if the server is already on
    74	    # it — important for crash-resume so we don't reload every restart).
    75	    first_town = town_list[0] if town_list else "Town10HD"
    76	    cur_map = client.get_world().get_map().name.split("/")[-1]
    77	    if cur_map != first_town:
    78	        try:
    79	            print(f"Loading initial map: {first_town}")
    80	            client.load_world(first_town)
    81	            time.sleep(3.0)
    82	        except RuntimeError:
    83	            print("  Initial map load failed; using current map")
    84	
    85	    progress_file = Path(args.progress_file) if args.progress_file else output_dir / ".attempted"
    86	    for ep_id in range(args.start_id, args.start_id + args.num_episodes):
    87	        # Record attempt so a supervisor can resume past a crashing episode.
    88	        progress_file.write_text(str(ep_id))
    89	        # Map switch every 10 episodes (with crash guard)
    90	        if ep_id % 10 == 0 and len(town_list) > 1:
    91	            town = town_list[(ep_id // 10) % len(town_list)]
    92	            print(f"[{ep_id}] Loading map: {town}")
    93	            try:
    94	                client.load_world(town)
    95	                time.sleep(3.0)
    96	            except RuntimeError:
    97	                print(f"  Map load failed, continuing with current map")
    98	
    99	        world = client.get_world()
   100	
   101	        # Update scenario-specific town override
   102	        if "towns" not in cfg.get("environment", {}):
   103	            cfg["environment"]["towns"] = town_list
   104	
   105	        # Per-episode seed for reproducibility (P1-b)
   106	        cfg.setdefault("environment", {})["seed"] = args.seed + ep_id
   107	
   108	        scene = SceneManager(world, cfg, client)
   109	        # v6 atomic commit: record to a .tmp.h5, postprocess + per-episode QC, then rename to the final
   110	        # name (or .rejected.h5). Only final names count as delivered (resume / top-up / manifest).
   111	        tmp_path = output_dir / f"episode_{ep_id:06d}.tmp.h5"
   112	        final_path = output_dir / f"episode_{ep_id:06d}.h5"
   113	        if tmp_path.exists():
   114	            tmp_path.unlink()
   115	        recorder = EpisodeRecorder(
   116	            scene=scene, world=world, output_dir=output_dir,
   117	            episode_id=ep_id, fps=cfg.get("environment", {}).get("fps", 10),
   118	            resolution=tuple(cfg.get("output", {}).get("rgb_resolution", [336, 336])),
   119	            extra_attrs={**prov, "episode_id": int(ep_id)}, out_name=tmp_path.name,
   120	        )
   121	
   122	        print(f"[{ep_id}] Starting...", end=" ", flush=True)
   123	        summary = recorder.run()
   124	        summaries.append(summary)
   125	
   126	        n_steps = summary["steps"]
   127	        dur = summary["duration_seconds"]
   128	        if summary.get("skipped"):
   129	            print(f"SKIPPED — {summary.get('reason', 'unknown')}")
   130	            if tmp_path.exists():
   131	                tmp_path.unlink()
   132	            _log_summary(args, {**summary, "status": "skipped"})
   133	            continue
   134	        print(f"{n_steps} steps in {dur:.1f}s ({n_steps/max(dur,0.001):.1f} fps)")
   135	
   136	        # Check size limit
   137	        total_size = sum(
   138	            f.stat().st_size for f in output_dir.glob("episode_*.h5")
   139	        )
   140	        print(f"  Total data: {total_size/1024**3:.2f} GB / {args.max_size_gb:.1f} GB")
   141	        if total_size >= max_bytes:
   142	            print(f"  Reached {args.max_size_gb} GB limit. Stopping.")
   143	            break
   144	
   145	        # Post-process → per-episode QC → atomic rename
   146	        status, fails = "missing", []
   147	        if tmp_path.exists():
   148	            try:
   149	                if args.postprocess:
   150	                    postproc.process_episode(tmp_path)
   151	                if args.subset:                                    # v6 jobs: gate before delivery
   152	                    from scripts.qc_v6 import check_episode
   153	                    fails = check_episode(str(tmp_path))["fails"]
   154	                status = "ok" if not fails else "rejected"
   155	            except Exception as e:  # noqa: BLE001 — a broken file must never be delivered
   156	                status, fails = "rejected", [f"postprocess/qc error: {e}"]
   157	            os.replace(tmp_path, final_path if status == "ok"
   158	                       else output_dir / f"episode_{ep_id:06d}.rejected.h5")
   159	            print(f"  [{status}] {final_path.name} {fails if fails else ''}")
   160	        _log_summary(args, {**summary, "status": status, "qc_fails": fails})
   161	
   162	    # Save batch summary
   163	    summary_path = (Path(args.summary_jsonl).with_suffix(".last_batch.json") if args.summary_jsonl
   164	                    else output_dir / "batch_summary.json")
   165	    with open(summary_path, "w") as f:
   166	        json.dump(summaries, f, indent=2)
   167	
   168	    total_steps = sum(s["steps"] for s in summaries)
   169	    total_dur = sum(s["duration_seconds"] for s in summaries)
   170	    print(f"\nBatch complete. {len(summaries)} episodes, {total_steps} steps, "
   171	          f"{total_dur/60:.1f} min")
   172	    print(f"Summary: {summary_path}")
   173	
   174	
   175	def _log_summary(args, summary: dict) -> None:
   176	    """One json line per attempted episode (per-job file → no cross-process interleaving)."""
   177	    if args.summary_jsonl:
   178	        with open(args.summary_jsonl, "a") as fj:
   179	            fj.write(json.dumps({**summary, "subset": args.subset}, default=str) + "\n")
   180	
   181	
   182	def _load_config(config_path: str | None) -> dict:
   183	    base_path = Path(__file__).resolve().parent.parent / "config" / "default.yaml"
   184	    with open(base_path) as f:
   185	        cfg = yaml.safe_load(f)
   186	    if config_path:
   187	        with open(config_path) as f:
   188	            override = yaml.safe_load(f)
   189	        _deep_merge(cfg, override)
   190	    return cfg
   191	
   192	
   193	def _deep_merge(base: dict, override: dict) -> None:
   194	    for key, value in override.items():
   195	        if key in base and isinstance(base[key], dict) and isinstance(value, dict):
   196	            _deep_merge(base[key], value)
   197	        else:
   198	            base[key] = value
   199	
   200	
   201	if __name__ == "__main__":
   202	    main()

