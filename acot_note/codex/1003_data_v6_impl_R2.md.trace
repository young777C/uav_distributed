    33	
    34	
    35	class SceneManager:
    36	    """Manages the lifecycle of all CARLA actors for one tracking episode."""
    37	
    38	    def __init__(
    39	        self,
    40	        world: carla.World,
    41	        config: dict[str, Any],
    42	        carla_client: carla.Client,
    43	    ):
