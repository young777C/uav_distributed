   348	    def _setup_vehicle_scene(self, plan: dict, scene_cfg: dict) -> None:
   349	        """Spawn a vehicle target + distractors on the same road segment.
   350	
   351	        Position-decorrelation (2026-07-29, per acot_note/data-fix-spec.md): the target
   352	        must NOT sit in a predictable geometric slot, or a pure-geometry classifier
   353	        selects it WITHOUT language (the benchmark leak — position-only MLP ~3-5%). Two
   354	        levers, both config-gated by `scene.decorrelate_position.enabled`:
   355	          L1 slot: the target + its SIMILAR look-alikes are drawn from ONE symmetric
   356	             slot band and the target takes a RANDOM slot (was: target always at the
   357	             anchor, distractors biased ahead) → target's depth/rank == a distractor's.
   358	          L2 framing: the expert servos the {target+similar} CENTROID, not the target
   359	             (`self._frame_centroid`, applied in expert_action + _cluster_centroid), so
   360	             the target is a random cluster member (was: always the framed reference) →
   361	             its image position / depth / rank distribution == a distractor's.
   362	        """
   363	        anchor = self._pick_target_anchor()
   364	        tgt = plan["target"]
   365	        # Positive % = SLOWER than the speed limit (official generate_traffic.py uses
   366	        # +30%). Calm, shared convoy speed so they travel together, not aggressively.
   367	        convoy_speed = random.uniform(0, 18)
   368	        dec_cfg = scene_cfg.get("decorrelate_position", {})
   369	        decorrelate = bool(dec_cfg.get("enabled", True))
   370	
   371	        self._distractors = []
   372	        self._distractor_meta = []
   373	        anchor_wp = self._map.get_waypoint(anchor.location)
   374	        # Candidate lanes = anchor lane + same-direction neighbours, so vehicles spread
   375	        # ACROSS lanes (co-visible) instead of gridlocking one lane.
   376	        lanes = [anchor_wp]
   377	        for getter in ("get_left_lane", "get_right_lane"):
   378	            try:
   379	                cand = getattr(anchor_wp, getter)()
   380	            except RuntimeError:
   381	                cand = None
   382	            if (cand is not None and cand.lane_type == carla.LaneType.Driving
   383	                    and cand.lane_id * anchor_wp.lane_id > 0):
   384	                lanes.append(cand)
   385	
   386	        if decorrelate:
   387	            band = float(dec_cfg.get("cluster_band_m", 24.0))
   388	            # L1 — target gets a RANDOM slot; capture its along-road offset off_t so the
   389	            # distractors can be placed to BRACKET it in depth (§8: the target used to be
   390	            # the depth-nearest candidate ~50% of frames because fillers were pushed forward
   391	            # /farther by the down-forward camera — no candidate was ever nearer than the
   392	            # target. Bracketing off_t makes the target a uniform depth-RANK member).
   393	            off_t = 0.0
   394	            self._target = None
   395	            for _try in range(6):
   396	                off_t = 0.0 if _try == 5 else random.uniform(-band, band)
   397	                sp = (anchor if _try == 5 else
   398	                      self._lane_offset_transform(random.choice(lanes), off_t))
   399	                try:
   400	                    self._target = VehicleTarget(
   401	                        self._world, tgt["bp"], sp, carla_client=self._client,
   402	                        color=COLOR_RGB.get(tgt.get("color") or ""),
   403	                        # SAME speed distribution as distractors so the target does not drift
   404	                        # to a systematic depth within the group (hero-only dynamics leaked).
   405	                        role_name="hero", speed_diff=convoy_speed + random.uniform(-5, 5))
   406	                    break
   407	                except RuntimeError:
   408	                    continue
   409	            for d in plan["distractors"]:
   410	                # Similars share the anchor ±band (INDEPENDENT of the target — they + the
   411	                # target form the framed centroid, so the target stays a random member).
   412	                # NOTE: the residual DEPTH shortcut (target is depth-nearest ~50% of frames)
   413	                # is NOT fixed by any distractor PLACEMENT — the target sits at the back of
   414	                # the followed cluster by tracking geometry; see data-fix-spec §8 follow-up.
   415	                if d.get("similar"):
   416	                    off = random.uniform(-band, band)
   417	                else:
   418	                    off = random.uniform(8, 30) * random.choice([-1, 1])
   419	                self._spawn_distractor(
   420	                    d, self._lane_offset_transform(random.choice(lanes), off), convoy_speed)
   421	            # L2 — the expert servos the CLUSTER CENTROID (target + similar look-alikes),
   422	            # NOT the target (applied in expert_action). The target is then a uniformly
   423	            # random member of a tight co-visible cluster → its image position / depth /
   424	            # rank distribution is IDENTICAL to a distractor's by construction (any
   425	            # deterministic target-centred framing, even an offset one, leaks). The tight
   426	            # ±band cluster + wide FOV keeps every member on-screen.
   427	            self._frame_centroid = True
   428	        else:
   429	            # Legacy layout (leaky): target at the anchor, distractors biased ahead.
   430	            self._frame_centroid = False
   431	            self._target = VehicleTarget(
   432	                self._world, tgt["bp"], anchor, carla_client=self._client,
   433	                color=COLOR_RGB.get(tgt.get("color") or ""),
   434	                role_name="hero", speed_diff=convoy_speed + random.uniform(-3, 3))
   435	            ahead_bias = float(scene_cfg.get("distractor_ahead_bias", 0.7))
   436	            for d in plan["distractors"]:
   437	                near, far = (5, 28) if d.get("similar") else (10, 55)
   438	                off = (random.uniform(near, far) if random.random() < ahead_bias
   439	                       else -random.uniform(6, 18))
   440	                self._spawn_distractor(
   441	                    d, self._lane_offset_transform(random.choice(lanes), off), convoy_speed)
   442	
   443	        self._target_in_frame = True      # updated each step by the recorder (recovery gate)
   444	        self._recovery_mode = False       # hysteresis state for the centroid↔recovery framing switch
   445	        self._reacq = 0
   446	        self._assign_convoy_route()
   447	
   448	    def _lane_offset_transform(self, base_wp, offset_m: float) -> "carla.Transform":
   449	        """Walk `offset_m` along the lane (forward if +, backward if −) from base_wp and
   450	        return a spawn transform with small lateral jitter (raised 0.3 m)."""
   451	        wp = base_wp
   452	        for _ in range(int(abs(offset_m) / 8)):
   453	            nxt = wp.next(8.0) if offset_m > 0 else wp.previous(8.0)
   454	            if not nxt:
   455	                break
   456	            wp = nxt[0]
   457	        loc = wp.transform.location
   458	        return carla.Transform(
   459	            carla.Location(x=loc.x + random.uniform(-1.0, 1.0),
   460	                           y=loc.y + random.uniform(-1.0, 1.0), z=loc.z + 0.3),
   461	            wp.transform.rotation)
   462	
   463	    def _spawn_distractor(self, d: dict, sp: "carla.Transform", convoy_speed: float) -> None:
   464	        """Spawn one distractor (vehicle or pedestrian) at sp; skip on spawn collision."""
   465	        try:
   466	            cls = d["cls"]
   467	            if cls in VEHICLE_CLASSES:
   468	                obj = VehicleTarget(
   469	                    self._world, d["bp"], sp, carla_client=self._client,
   470	                    color=COLOR_RGB.get(d.get("color") or ""),
   471	                    role_name="distractor", speed_diff=convoy_speed + random.uniform(-5, 5))
   472	            else:
   473	                obj = PedestrianTarget(self._world, d["bp"], sp, walk_speed=random.uniform(2.5, 3.5))
   474	            self._distractors.append(obj)
   475	            self._distractor_meta.append({
   476	                "id": obj.id, "bp": d["bp"], "color": d.get("color"),
   477	                "desc": d["desc"], "similar": d.get("similar", False), "cls": cls,
   478	                "desired_off": d.get("_desired_off"),   # §8 depth station-keeping target (or None)
   479	            })
   480	        except RuntimeError:
   481	            pass  # spawn collision — skip this distractor
   482	
   483	    def _cluster_centroid(self, target_pos: np.ndarray) -> np.ndarray:
   484	        """Mean world position of the co-visible cluster = target + its SIMILAR look-alikes,
   485	        used as the expert's framing setpoint so the target is a random cluster member (not
   486	        the framed reference). Reuses the distractor positions the recorder already queried
   487	        this step (`self._distractor_states`, set in get_distractor_states) → no extra CARLA
   488	        RPCs. Falls back to the target if no similar distractor is currently alive."""
   489	        tp = np.asarray(target_pos, dtype=float)
   490	        pts = [tp]
   491	        ds = getattr(self, "_distractor_states", None)
   492	        if ds is not None and len(ds):
   493	            for row, meta in zip(ds, self._distractor_meta):
   494	                if not meta.get("similar"):
   495	                    continue
   496	                p = np.asarray(row[:3], dtype=float)
   497	                if not np.isnan(p).any():
   498	                    pts.append(p)
   499	        return np.mean(pts, axis=0)
   500	
   501	    def _assign_convoy_route(self) -> None:
   502	        """Give the target + vehicle distractors the SAME route (official TM.set_route)
   503	        so they drive together on the same roads → stay co-visible while obeying
   504	        traffic rules, with no teleporting (replaces recycle_lost_lookalikes)."""
   505	        cfg = self._config.get("scene", {}).get("convoy", {})
   506	        if not cfg.get("enabled", True):
   507	            return
   508	        tm = self._client.get_trafficmanager(_tm_port())
   509	        if not hasattr(tm, "set_route"):
   510	            return
   511	        sb = float(cfg.get("straight_bias", 0.7))
   512	        opts = ["Straight"] * max(1, int(sb * 10)) + ["Left", "Right"] * max(1, int((1 - sb) * 5))
   513	        route = [random.choice(opts) for _ in range(int(cfg.get("route_len", 80)))]
   514	        members = ([self._target] if self._target else []) + self._distractors
   515	        for m in members:
   516	            v = getattr(m, "_vehicle", None)
   517	            if v is None:
   518	                continue
   519	            try:
   520	                tm.set_route(v, list(route))
   521	            except (RuntimeError, TypeError):
   522	                pass
   523	
   524	    def _nav_near(self, center, radius: float, count: int, attempts: int = 120) -> list:
   525	        """Sample navmesh locations within `radius` metres of `center`."""
   526	        out = []
   527	        for _ in range(attempts):
   528	            loc = self._world.get_random_location_from_navigation()
   529	            if loc is not None and loc.distance(center) <= radius:
   530	                out.append(loc)
   531	                if len(out) >= count:
   532	                    break
   533	        return out
   534	
   535	    def _spawn_ambient_traffic(self, scene_cfg: dict) -> None:
   536	        """Populate background traffic CONCENTRATED NEAR THE TARGET the official way:
   537	        diverse vehicles (cars/bus/trucks/motos/bikes) via batch SpawnActor+SetAutopilot,
   538	        kept near the hero (target) by hybrid-physics + respawn_dormant_vehicles; plus
   539	        manually-controlled background pedestrians on the nearby navmesh."""
   540	        amb = scene_cfg.get("ambient", {})
   541	        n_veh = int(amb.get("vehicles", 0))
   542	        n_walk = int(amb.get("walkers", 0))
   543	        radius = float(amb.get("radius", 90.0))
   544	        if self._target is None:
   545	            return
   546	        try:
   547	            tloc = self._target.transform.location
   548	        except RuntimeError:
   549	            return
   550	        tm = self._client.get_trafficmanager(_tm_port())
   551	
   552	        # Official mechanism: hybrid physics around the hero (target) + respawn dormant
   553	        # vehicles → ambient traffic auto-concentrates near the moving target.
   554	        if self._target_class in VEHICLE_CLASSES:
   555	            try:
   556	                tm.set_hybrid_physics_mode(True)
   557	                tm.set_hybrid_physics_radius(radius)
   558	                tm.set_respawn_dormant_vehicles(True)
   559	            except (RuntimeError, AttributeError):
   560	                pass
   561	
   562	        # --- vehicles: batch spawn at the spawn points NEAREST the target ---
   563	        if n_veh > 0:
   564	            SpawnActor = carla.command.SpawnActor
   565	            SetAutopilot = carla.command.SetAutopilot
   566	            FutureActor = carla.command.FutureActor
   567	            vbps = list(self._world.get_blueprint_library().filter("vehicle.*"))
   568	            if amb.get("cars_only", False):        # 4-wheel cars only (no bikes/motos) — spec §4d
   569	                cars = [b for b in vbps if b.has_attribute("number_of_wheels")
   570	                        and int(b.get_attribute("number_of_wheels")) == 4]
   571	                if cars:
   572	                    vbps = cars
   573	            sps = sorted(self._world.get_map().get_spawn_points(),
   574	                         key=lambda sp: sp.location.distance(tloc))
   575	            batch = []
   576	            for sp in sps[1:n_veh + 1]:    # nearest points (skip target's own)
   577	                bp = random.choice(vbps)
   578	                if bp.has_attribute("color"):
   579	                    try:
   580	                        bp.set_attribute("color", random.choice(
   581	                            bp.get_attribute("color").recommended_values))
   582	                    except (RuntimeError, ValueError, IndexError):
   583	                        pass
   584	                bp.set_attribute("role_name", "ambient")
   585	                batch.append(SpawnActor(bp, sp)
   586	                             .then(SetAutopilot(FutureActor, True, tm.get_port())))
   587	            try:
   588	                self._client.apply_batch_sync(batch, True)
   589	            except RuntimeError:
   590	                pass
   591	
   592	        # --- pedestrians: manual WalkerControl on the navmesh NEAR the target ---
   593	        self._ambient_walkers = []
   594	        wbps = [b.id for b in self._world.get_blueprint_library().filter("walker.pedestrian.*")]
   595	        for loc in self._nav_near(tloc, radius, n_walk):
   596	            if not wbps:
   597	                break
   598	            try:
   599	                self._ambient_walkers.append(PedestrianTarget(
   600	                    self._world, random.choice(wbps), carla.Transform(loc),
   601	                    walk_speed=random.uniform(1.2, 2.2), snap_to_road=False,
   602	                    role_name="ambient_walker"))
   603	            except RuntimeError:
   604	                pass
   605	
   606	    def _setup_pedestrian_scene(self, plan: dict, scene_cfg: dict) -> None:
   607	        """Spawn a pedestrian target + nearby distractors on a road (manual walkers)."""
   608	        anchor = random.choice(self._spawn_points) if self._spawn_points else \
   609	            carla.Transform(carla.Location(0, 0, 1))
   610	        tgt = plan["target"]
   611	        self._target = PedestrianTarget(
   612	            self._world, tgt["bp"], anchor, walk_speed=random.uniform(1.4, 2.4))
   613	        self._distractors = []
   614	        self._distractor_meta = []
   615	        anchor_wp = self._map.get_waypoint(anchor.location)
   616	        for d in plan["distractors"]:
   617	            try:
   618	                offset_m = random.uniform(5, 30) if random.random() < 0.7 \
   619	                    else -random.uniform(5, 15)
   620	                d_wp = anchor_wp
   621	                for _ in range(int(abs(offset_m) / 8)):
   622	                    nxt = d_wp.next(8.0) if offset_m > 0 else d_wp.previous(8.0)
   623	                    if nxt:
   624	                        d_wp = nxt[0]
   625	                dsp = carla.Transform(
   626	                    carla.Location(
   627	                        d_wp.transform.location.x + random.uniform(-2, 2),
   628	                        d_wp.transform.location.y + random.uniform(-2, 2),
   629	                        d_wp.transform.location.z + 0.5),
   630	                    d_wp.transform.rotation)
   631	                if d["cls"] == "pedestrian":
   632	                    obj = PedestrianTarget(self._world, d["bp"], dsp,
   633	                                           walk_speed=random.uniform(1.4, 2.4))
   634	                else:
   635	                    obj = VehicleTarget(self._world, d["bp"], dsp, carla_client=self._client,
   636	                                        color=COLOR_RGB.get(d.get("color") or ""),
   637	                                        role_name="distractor")
   638	                self._distractors.append(obj)
   639	                self._distractor_meta.append({
   640	                    "id": obj.id, "bp": d["bp"], "color": d.get("color"),
   641	                    "desc": d["desc"], "similar": d.get("similar", False), "cls": d["cls"],
   642	                })
   643	            except RuntimeError:
   644	                pass
   645	
   646	    def _spawn_uav(self, uav_cfg: dict) -> None:
   647	        start = uav_cfg.get("start", {})
   648	        t = self._target.transform
   649	        target_loc = t.location
   650	        target_yaw_rad = np.radians(t.rotation.yaw)
   651	
   652	        # Oblique episodes need more standoff so the camera's shallower depression aims
   653	        # at the target (depression = atan(alt/behind) ≈ |pitch|); else it drops off-screen.
   654	        if getattr(self, "_camera_oblique", False):
   655	            ob = self._config.get("camera", {}).get("oblique", {})
   656	            behind_dist = random.uniform(*ob.get("behind_range", [22, 30]))
   657	        else:
   658	            behind_dist = random.uniform(*start.get("distance_range", [12, 22]))
   659	        lateral_offset = random.uniform(*start.get("lateral_offset_range", [6, 14]))
   660	        lateral_side = random.choice([-1, 1])
   661	        alt = random.uniform(*self._tier_alt)   # tier-controlled tracking altitude
   662	
   663	        fwd_x, fwd_y = np.cos(target_yaw_rad), np.sin(target_yaw_rad)
   664	        right_x, right_y = -fwd_y, fwd_x
   665	        uav_loc = carla.Location(
   666	            x=target_loc.x - fwd_x * behind_dist + right_x * lateral_offset * lateral_side,
   667	            y=target_loc.y - fwd_y * behind_dist + right_y * lateral_offset * lateral_side,
   668	            z=target_loc.z + alt,
   669	        )
   670	        look_yaw = np.degrees(np.arctan2(target_loc.y - uav_loc.y, target_loc.x - uav_loc.x))
   671	        uav_transform = carla.Transform(uav_loc, carla.Rotation(pitch=-10, yaw=look_yaw, roll=0))
   672	        self.drone = KinematicDrone(self._world, uav_transform,
   673	                                    camera_pitch=getattr(self, "_camera_pitch", -50.0))
   674	
   675	    def _distance_category(self) -> str:
   676	        """Map the UAV↔target horizontal standoff to close / suitable / long, so the
   677	        language distance constraint matches the actual tracking distance."""
   678	        try:
   679	            u = self.drone.transform.location
   680	            t = self._target.transform.location
   681	            d = ((u.x - t.x) ** 2 + (u.y - t.y) ** 2) ** 0.5
   682	        except (RuntimeError, AttributeError):
   683	            return "suitable"
   684	        if d <= 16.0:
   685	            return "close"
   686	        if d <= 26.0:
   687	            return "suitable"
   688	        return "long"
   689	
   690	    # ------------------------------------------------------------------
   691	    # Per-step API
   692	    # ------------------------------------------------------------------
   693	
   694	    def get_target_state(self) -> tuple[np.ndarray, np.ndarray, float, float]:
   695	        assert self._target is not None
   696	        return self._target.get_state()
   697	
   698	    def recycle_lost_lookalikes(self) -> None:
   699	        """Smooth off-screen recycle (spec §4d): keep >=2 SIMILAR look-alikes co-visible
   700	        with the target by teleporting one that has drifted FAR off-camera back into view
   701	        AHEAD of the target. Robustness guards (the two failure modes that disabled the old
   702	        version): only OFF-screen actors move (real-camera projection → no visible jump);
   703	        the destination slot is on a DRIVING lane and validated CLEAR of every nearby
   704	        vehicle (no collision). Only fires when <2 look-alikes are currently on-screen, so
   705	        it does no work (and no world query) while co-visibility is already fine. Keeping
   706	        the look-alikes near the target also keeps the framing centroid near the target →
   707	        the target stays in-frame (fixes the earlier off-screen instability)."""
   708	        cfg = self._config.get("scene", {}).get("covisibility", {})
   709	        if not cfg.get("enabled", True) or self._target is None or self.drone is None:
   710	            return
   711	        try:
   712	            cam_t = self.drone.get_camera_transform()
   713	            tloc = self._target.transform.location
   714	        except RuntimeError:
   715	            return
   716	        tgt_wp = self._map.get_waypoint(tloc)
   717	        if tgt_wp is None:
   718	            return
   719	        W, H = self._config.get("output", {}).get("rgb_resolution", [336, 336])
   720	        _fov = float(self._config.get("output", {}).get("fov", 90.0))   # §10: match sensor FOV
   721	        M = np.array(cam_t.get_inverse_matrix())
   722	        focal = W / (2.0 * np.tan(np.radians(_fov) / 2.0))
   723	
   724	        def _visible(p) -> bool:
   725	            q = M @ np.array([p[0], p[1], p[2], 1.0])
   726	            if q[0] <= 0.1:
   727	                return False
   728	            u = focal * (q[1] / q[0]) + W / 2.0
   729	            v = focal * (-q[2] / q[0]) + H / 2.0
   730	            return 0 <= u < W and 0 <= v < H
   731	
   732	        far = float(cfg.get("recycle_radius", 55.0))
   733	        clr = float(cfg.get("min_clearance", 6.0))
   734	        tpos = np.array([tloc.x, tloc.y, tloc.z])
   735	        # Cheap pass: how many similar are on-screen; which off-screen ones drifted far.
   736	        on_screen, needy = 0, []
   737	        for obj, meta in zip(self._distractors, self._distractor_meta):
   738	            if not meta.get("similar"):
   739	                continue
   740	            try:
   741	                p, _, _, _ = obj.get_state()
   742	            except RuntimeError:
   743	                continue
   744	            if _visible(p):
   745	                on_screen += 1
   746	            elif np.linalg.norm(np.asarray(p)[:2] - tpos[:2]) > far:
   747	                needy.append(obj)
   748	        if on_screen >= 2 or not needy:
   749	            return                               # co-visibility already fine → do nothing
   750	
   751	        # Candidate driving lanes = target lane + same-direction neighbours.
   752	        lanes = [tgt_wp]
   753	        for g in ("get_left_lane", "get_right_lane"):
   754	            try:
   755	                c = getattr(tgt_wp, g)()
   756	            except RuntimeError:
   757	                c = None
   758	            if (c is not None and c.lane_type == carla.LaneType.Driving
   759	                    and c.lane_id * tgt_wp.lane_id > 0):
   760	                lanes.append(c)

