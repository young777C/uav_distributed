  1059	        except (RuntimeError, AttributeError):
  1060	            pass
  1061	
  1062	    def sustain_target_evade(self, elapsed: float) -> None:
  1063	        """§11: keep the target moving at a moderate speed through its forced turns for the
  1064	        whole window (TM can otherwise reset it at a light), so it stays off the forward view
  1065	        while the expert flies to INTERCEPT the true target."""
  1066	        veh, tm = self._target_tm()
  1067	        if veh is None or tm is None:
  1068	            return
  1069	        try:
  1070	            tm.set_desired_speed(veh, 16.0)
  1071	        except (RuntimeError, AttributeError):
  1072	            pass
  1073	
  1074	    def restore_target_speed(self) -> None:
  1075	        """§11: at loss-window end, drop the target back to normal traffic speed so the
  1076	        intercepting UAV catches up and re-acquires."""
  1077	        veh, tm = self._target_tm()
  1078	        if veh is None or tm is None:
  1079	            return
  1080	        try:
  1081	            tm.set_desired_speed(veh, 9.0)
  1082	        except (RuntimeError, AttributeError):
  1083	            pass
  1084	
  1085	    def loss_window_offset(self, elapsed: float) -> bool:
  1086	        """True once when a loss window just ended (target re-appearing)."""
  1087	        sched = getattr(self, "_loss_scheduler", None)
  1088	        return bool(sched and sched.offset(elapsed))
