   254	        heading = getattr(self._target, "direction", "")
   255	        self.episode_language = self._language_gen.build_instruction(
   256	            plan["target"]["desc"], plan.get("num_similar", 0),
   257	            spatial=spatial, motion=(f"heading {heading}" if heading else ""),
   258	            distance_m=dist_m)
   259	
   260	        return {
   261	            "target_type": self._target_type,
   262	            "target_class": self._target_class,
   263	            "target_blueprint": plan["target"]["bp"],
   264	            "target_color": plan["target"].get("color"),
   265	            "target_desc": plan["target"]["desc"],
   266	            "strategy": plan["strategy"],
   267	            "num_similar": plan["num_similar"],
   268	            "num_distractors": len(self._distractors),
   269	            "distractors": self._distractor_meta,
   270	            "seed": seed,
   271	            "uav_start_altitude": float(self.drone.transform.location.z) if self.drone else None,
   272	            "weather": self._get_current_weather_dict(),
   273	            "language": self.episode_language,
   274	            "occlusion_biased": bool(getattr(self, "_occlusion_biased", False)),
   275	            "camera_pitch": float(getattr(self, "_camera_pitch", -50.0)),
   276	        }
   277	
   278	    # ------------------------------------------------------------------
   279	    # Spawning helpers
   280	    # ------------------------------------------------------------------
   281	
   282	    def _pick_distance_tier(self, tier_cfg: dict) -> str:
   283	        if not tier_cfg:
   284	            return "suitable"
   285	        names = list(tier_cfg.keys())
   286	        w = np.array([float(tier_cfg[n].get("weight", 1.0)) for n in names])
   287	        return str(np.random.choice(names, p=w / w.sum()))
   288	
   289	    def _pick_camera(self, cam_cfg: dict) -> tuple[float, bool]:
   290	        """(camera_pitch, is_oblique). A1c③: a fraction of episodes use a shallower
   291	        pitch (+ lower altitude, set by the caller) to expose side-wall occlusion."""
   292	        default_pitch = float(cam_cfg.get("pitch_deg", -50.0))
   293	        ob = cam_cfg.get("oblique", {})
   294	        if ob and random.random() < float(ob.get("fraction", 0.0)):
   295	            return float(ob.get("pitch_deg", -38.0)), True
   296	        return default_pitch, False
   297	
   298	    def _pick_target_anchor(self) -> "carla.Transform":
   299	        """Target spawn transform. On occlusion-biased episodes, spawn on a map spawn
   300	        point whose forward lane drives under an overhead occluder (A1c③); otherwise a
   301	        random spawn point. Falls back to random if no occluder anchors in this town."""
   302	        if getattr(self, "_occlusion_biased", False):
   303	            anchors = self._occluder_anchors()
   304	            if anchors:
   305	                return random.choice(anchors)
   306	        if self._spawn_points:
   307	            return random.choice(self._spawn_points)
   308	        return carla.Transform(carla.Location(0, 0, 1))
   309	
   310	    def _occluder_anchors(self) -> list:
   311	        """Lazily load (build + cache once) the current town's occluder-leading spawns."""
   312	        town = self._world.get_map().name.split("/")[-1]
   313	        cache = getattr(self, "_occ_anchor_cache", {})
   314	        if town not in cache:
   315	            from scene.occluder_cache import load_or_build, anchors_to_transforms
   316	            occ_cfg = self._config.get("occlusion", {})
   317	            params = {k: occ_cfg[k] for k in
   318	                      ("look_ahead_m", "step_m", "up_ray_m",
   319	                       "min_clearance_m", "max_clearance_m",
   320	                       "min_enter_m", "max_cover_span_m") if k in occ_cfg}

