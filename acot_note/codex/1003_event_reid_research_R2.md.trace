"""Event census: how many loss→re-entry events exist per vehicle if ALL scene actors are annotated.
v5 (mvp_full_v5, 64 eps, FOV70 labels): target + scene distractors, off-screen only (no distractor occlusion).
Re-entry = invisible run >= g frames that ends with the vehicle back in frame; 'exit' = run reaching episode end."""
import glob, collections, json
import numpy as np, h5py
W = H = 512
def runs(vis):
    out, n = [], 0
    for t, v in enumerate(vis):
        if not v: n += 1
        else:
            if n: out.append((t, n, False))   # re-entry at t after n invisible frames
            n = 0
    if n: out.append((len(vis), n, True))    # never came back
    return out
agg = collections.Counter(); per_ep = []; reentry_ctx = collections.defaultdict(list)
for p in sorted(glob.glob("/nvidia/hque/data/carla_data/mvp_full_v5/episode_*.h5")):
    f = h5py.File(p, "r"); T = f["rgb"].shape[0]
    tvis = f["annotation/off_screen"][:] < 0.5
    bb = f["distractors/bbox"][:]; sim = f["distractors/similar"][:].astype(bool)
    dvis = (bb[..., 0] >= 0) & (bb[..., 0] < W) & (bb[..., 1] >= 0) & (bb[..., 1] < H) & (bb[..., 2] > 0)
    allvis = np.concatenate([tvis[:, None], dvis], 1)          # (T, 1+D)
    role = np.array([0] + [1 if s else 2 for s in sim])
    n_seen = int(allvis.any(0).sum())
    ep = {"n_vehicles_seen": n_seen, "D": len(sim)}
    for a in range(allvis.shape[1]):
        if not allvis[:, a].any():
            continue
        first = int(np.argmax(allvis[:, a]))
        for t, n, never in runs(allvis[first:, a]):
            t += first
            key = "target" if a == 0 else ("lookalike" if role[a] == 1 else "distractor")
            if never:
                agg[f"{key}_exit_noreturn"] += 1
                continue
            for g, lab in ((10, ">=1s"), (30, ">=3s"), (50, ">=5s")):
                if n >= g:
                    agg[f"{key}_reentry_{lab}"] += 1
            if n >= 30:
                others = [b for b in range(allvis.shape[1]) if b != a and allvis[t, b]]
                n_look = sum(1 for b in others if (role[b] == 1 or (a != 0 and b == 0)))
                reentry_ctx[key].append({"gap": n, "n_visible_others": len(others), "n_lookalike_or_target": n_look,
                                         "u": float(bb[t, a - 1, 0]) if a else float(f["annotation/bbox_u"][t]),
                                         "target_visible": bool(allvis[t, 0]) if a else True})
    per_ep.append(ep)
print("v5 (64 eps): vehicles seen per ep mean %.1f (scene actors only; ambient not recorded)" % np.mean([e["n_vehicles_seen"] for e in per_ep]))
for k in ["target", "lookalike", "distractor"]:
    print(f"  {k:10s} re-entry >=1s {agg[k+'_reentry_>=1s']:4d}  >=3s {agg[k+'_reentry_>=3s']:4d}  >=5s {agg[k+'_reentry_>=5s']:4d}  exit-no-return {agg[k+'_exit_noreturn']:4d}")
for k, L in reentry_ctx.items():
    if L:
        u = np.array([x["u"] for x in L]); edge = ((u < 60) | (u > 452)).mean()
        print(f"  {k:10s} >=3s re-entries: median gap {np.median([x['gap'] for x in L])/10:.1f}s, others visible {np.mean([x['n_visible_others'] for x in L]):.1f}, "
              f"with >=1 look-alike(or target) {np.mean([x['n_lookalike_or_target']>=1 for x in L]):.0%}, target visible at that moment {np.mean([x['target_visible'] for x in L]):.0%}, re-entry at L/R edge {edge:.0%}")
json.dump({"agg": agg, "ctx": reentry_ctx}, open("runs/data_audit/event_census_v5.json", "w"), default=str)

