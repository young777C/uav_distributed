/bin/sh -lc "python - <<'PY'
import glob, h5py, numpy as np, collections, os, json
W=H=512
G=30
TH=5.0
paths=sorted(glob.glob('/nvidia/hque/data/carla_data/mvp_full_v5/episode_*.h5'))

def runs(vis):
    n=0
    for t,v in enumerate(vis):
        if not v:
            n+=1
        else:
            if n:
                yield t,n,False
            n=0
    if n:
        yield len(vis),n,True

stats=collections.Counter()
examples=[]
per_ep=[]
for p in paths:
    with h5py.File(p,'r') as f:
        T=f['rgb'].shape[0]
        bb=f['distractors/bbox'][:]
        sim=f['distractors/similar'][:].astype(bool)
        pos=f['distractors/positions'][:,:, :3]
        dvis=(bb[...,0]>=0)&(bb[...,0]<W)&(bb[...,1]>=0)&(bb[...,1]<H)&(bb[...,2]>0)&(bb[...,3]>0)
        tvis=f['annotation/off_screen'][:] < 0.5
        # target pos for target stats
        tpos=np.stack([f['target/tx'][:], f['target/ty'][:], f['target/tz'][:]],1)
        # covis: target visible and >=1/2 similar visible per frame
        simvis=dvis[:,sim] if sim.any() else np.zeros((T,0),bool)
        per_ep.append({
            'frames':T,
            'target_vis_frames': int(tvis.sum()),
            'look1_covis_frames': int((tvis & (simvis.sum(1)>=1)).sum()),
            'look2_covis_frames': int((tvis & (simvis.sum(1)>=2)).sum()),
            'sim_vis_frames': int(simvis.any(1).sum()),
        })
        for j,is_sim in enumerate(sim):
            if not is_sim or not dvis[:,j].any():
                continue
            first=int(np.argmax(dvis[:,j]))
            for t,n,never in runs(dvis[first:,j]):
                t += first
                if never or n < G: continue
                stats['look_reentry_ge3'] += 1
                gs=t-n
                # adjacent jumps that touch gap/reentry: previous visible -> gap start ... -> reentry
                diffs=np.linalg.norm(np.diff(pos[max(0,gs-1):t+1,j,:2],axis=0),axis=1)
                jump_any=bool((diffs>TH).any())
                # strictly during invis frames excluding prev visible->gap_start? all hidden->hidden plus hidden->reentry
                diffs2=np.linalg.norm(np.diff(pos[gs:t+1,j,:2],axis=0),axis=1) if t-gs>=1 else np.array([])
                jump_in_gap=bool((diffs2>TH).any())
                # jump specifically at reentry edge (last invisible -> visible)
                jump_at_reentry = bool(np.linalg.norm(pos[t,j,:2]-pos[t-1,j,:2])>TH) if t>0 else False
                for name,val in [('jump_any_touch_gap',jump_any),('jump_strict_gap_to_reentry',jump_in_gap),('jump_at_reentry',jump_at_reentry)]:
                    if val: stats[name]+=1
                if jump_any and len(examples)<12:
                    k0=max(0,gs-1)
                    k_rel=int(np.argmax(diffs>TH)) if len(diffs) else -1
                    k=k0+k_rel+1
                    examples.append((os.path.basename(p), j, t, n, k, float(diffs[k_rel]), bool(dvis[k,j]), bool(dvis[k-1,j]) if k>0 else None, float(bb[t,j,0]), float(bb[t,j,1])))
        # all distractor roles stats perhaps ordinary jumps
        for j,is_sim in enumerate(sim):
            role='look' if is_sim else 'dist'
            if not dvis[:,j].any(): continue
            first=int(np.argmax(dvis[:,j]))
            for t,n,never in runs(dvis[first:,j]):
                t+=first
                if never or n<G: continue
                gs=t-n
                diffs=np.linalg.norm(np.diff(pos[max(0,gs-1):t+1,j,:2],axis=0),axis=1)
                if (diffs>TH).any(): stats[f'{role}_jump_any']+=1
                stats[f'{role}_reentry']+=1

print('paths', len(paths))
print('stats')
for k in sorted(stats): print(k, stats[k])
if stats['look_reentry_ge3']:
    print('look jump_any_touch_gap pct', stats['jump_any_touch_gap'], '/', stats['look_reentry_ge3'], stats['jump_any_touch_gap']/stats['look_reentry_ge3'])
    print('strict gap_to_reentry pct', stats['jump_strict_gap_to_reentry']/stats['look_reentry_ge3'])
    print('at_reentry pct', stats['jump_at_reentry']/stats['look_reentry_ge3'])
print('examples', examples[:8])
frames=sum(x['frames'] for x in per_ep); tv=sum(x['target_vis_frames'] for x in per_ep)
print('covis frame rates over target-visible: >=1 sim %.3f >=2 sim %.3f (target-visible frames %d / frames %d)' % (sum(x['look1_covis_frames'] for x in per_ep)/tv, sum(x['look2_covis_frames'] for x in per_ep)/tv, tv, frames))
