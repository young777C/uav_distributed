   295	    def _reid_select(self, cset, rgb, store_slot=None):
   296	        """Temporal appearance-memory re-ID (reframe → offline milestone: crop-DINOv2 feature +
   297	        K-view gallery breaks the 0.5 wall without resolution). Returns (N,) match scores to the
