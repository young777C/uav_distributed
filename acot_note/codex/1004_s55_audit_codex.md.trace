    95	class Policy:
    96	    def __init__(self, ckpt_path: str, cfg: dict, vlm, *, device: str = "cuda:0",
    97	                 s2_period: int = 1, shuffle_seed: int = 0, ablate: str | None = None,
    98	                 ex_source: str = "ear", commit_k: int = 5,
    99	                 tid_head: str = "xattn", tid_ckpt: str | None = None,
   100	                 reid_feature: str = "vlmpool", reid_bank: int = 1, reid_topm: int = 1,
   101	                 conf_tau: float = 0.0, conf_consensus: float = 0.0, frame_gain: float = 0.0, warmup_oracle_s: float = 0.0,
   102	                 reid_tavg: float = 0.0, reid_motion: float = 0.0, reid_motion_gate_px: float = 160.0,
   103	                 gallery_seed: str = "gt", reanchor: str = "off",
   104	                 reanchor_patience: int = 5, reanchor_tavg: float = 0.0, assoc_mode: str = "deepsort",
   105	                 assoc_gate_px: float = 160.0, assoc_lambda: float = 1.0,
   106	                 dam4sam_host: str = "dam4sam-svc", dam4sam_port: int = 5601,
   107	                 tah_ckpt: str = "runs/tah_rel.pt", asd: str = "off", asd_cfg: str = ""):
   108	        self.device = device
   109	        self.cfg = cfg
   110	        self.vlm = vlm                              # OnlineVLM (owns the frozen backbone + language mode)
   111	        self.image_cfg = cfg["image"]
   112	        self.a_scale = float(cfg["action"]["scale"])
   113	        self.steps = int(cfg["flow"]["sample_steps"])
   114	        self.s2_period = int(s2_period)
   115	        self._shuffle_seed = int(shuffle_seed)
   116	        # H1/H2 module ablation: zero the EAR/IAR stream into the DiT, matching a ckpt
   117	        # trained with the same ablation (train/config_v5_no{ear,iar}.yaml). None = full.
   118	        self.ablate = ablate                        # None | "ear" | "iar"
