   354	    def _cold_vote(self, aidx, lang_logits, lang_slot):
   355	        """V2: one tempered, rank-weighted language vote per tick; returns the slot of argmax_k G_k (visible)."""
   356	        l = np.asarray(lang_logits, np.float64); srt = np.sort(l)
   357	        m = float(srt[-1] - srt[-2]) if l.size >= 2 else 0.0
   358	        h = self._cold_hist; rho = float(np.searchsorted(np.sort(h), m)) / len(h) if len(h) >= 2 else 0.5
   359	        self._cold_hist = h + [m]
   360	        for k in self._cold_G:
   361	            self._cold_G[k] *= self.cold_lambda
   362	        a = int(aidx[lang_slot]); self._cold_G[a] = self._cold_G.get(a, 0.0) + 0.5 + rho
   363	        return max(range(len(aidx)), key=lambda s_: self._cold_G.get(int(aidx[s_]), 0.0))
   364	
   365	    def _asd_reset_memory(self, slot):
   366	        """The ONE hook ASD needs from a memory: reset it to the anchor's pick (drop the drifted state)."""
   367	        if self.tid_head == "tah" and self._tah_last is not None:
   368	            feat, pos = self._tah_last
   369	            self._tah_mem = self._tah.update(self._tah.reset(self.device), feat[slot], pos[slot])
   370	        elif self.tid_head == "reid" and self._reid_fn is not None:
   371	            from train.reid_resolution_probe import bank_update
   372	            self._reid_bank = []
   373	            bank_update(self._reid_bank, self._reid_fn[slot], self.reid_bank, 0.9)
   374	            self._reid_score = {}
   375	            self._reid_mvu = self._reid_mvel = None
   376	
   377	    def _reid_motion_score(self, cset):
   378	        """borrow#1 (DeepSORT): SOFT motion-consistency score to FUSE into the reid appearance score
   379	        (pre-EMA). Predicts the target's next image position (constant velocity) from past state and
   380	        softly penalizes candidates far from it → a look-alike spatially inconsistent with the track
   381	        can't win on appearance alone (fixes ours' pure-appearance weakness; DeepSORT had the highest
   382	        external SR). Returns (N,) ~[-∞,0] (0=at prediction), zeros if no prior. State NOT updated here."""
   383	        cands = cset.cands
   384	        if self._reid_mvu is None:
   385	            return np.zeros(len(cands), np.float64)
   386	        pred = self._reid_mvu + (self._reid_mvel if self._reid_mvel is not None else 0.0)
   387	        uv = np.array([[c.u, c.v] for c in cands], np.float64)
   388	        return -np.linalg.norm(uv - pred[None], axis=1) / self.reid_motion_gate_px
   389	
   390	    def _reid_motion_update(self, cset, slot):
   391	        """Update motion state from the seeding slot's image pos (SELECT used PAST state; same
   392	        GT/committed privilege as the gallery). None/loss → hold + keep predicting with velocity."""
   393	        if slot is None or not (0 <= slot < len(cset.cands)):
   394	            return
   395	        c = cset.cands[slot]; nuv = np.array([c.u, c.v], np.float64)
   396	        self._reid_mvel = (nuv - self._reid_mvu) if self._reid_mvu is not None else np.zeros(2)
   397	        self._reid_mvu = nuv
