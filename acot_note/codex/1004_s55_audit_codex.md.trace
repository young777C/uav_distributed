     1	"""§5.5 WHICH-module comparison — ALL models DEPLOYABLE (GT-free, online closed-loop CARLA), same seeds 91000-19,
     2	three objective metrics from the scorer (frame level): correct-lock ratio, longest continuous correct lock
     3	(max_correct_run_s, committed identity, out-of-frame ends the run), longest wrong lock (max_wrong_run_s).
     4	Per-arm mean with seed-bootstrap 95% CI; paired PGIF − arm with 95% paired-bootstrap CI. Missing arms → "pending".
     5	  python deploy_compare.py --json eval_out/deploy_compare.json"""
     6	import argparse
     7	import json
     8	import os
     9	
    10	import numpy as np
    11	
    12	EO = os.path.join(os.path.dirname(__file__), "eval_out")
    13	ARMS = [  # stem suffix, label, group
    14	    ("xattn", "xattn(单帧语言)", "language"),
    15	    ("l4", "l4(reid+置信门)", "ours"),
    16	    ("l5", "l5(+时序EMA)", "ours"),
    17	    ("borrow1", "borrow#1(+运动共识)", "ours"),
    18	    ("tahdag", "TAH+DAgger", "ours"),
    19	    ("tahrelm", "TAHRelM 无纠偏", "ours"),
    20	    ("ocsort", "OC-SORT", "external"),
    21	    ("deepsort", "DeepSORT", "external"),
    22	    ("dam4sam", "DAM4SAM", "external"),
    23	    ("tahrelm_pgif", "TAHRelM+PGIF(ours)", "pgif"),
    24	]
    25	def _strict(e):
    26	    """per-frame pick == target over target-present frames; ABSTENTION (no pick) counts as NOT correct."""
    27	    nd, bn = e.get("n_dist") or {}, e.get("mis_by_N") or {}
    28	    t = sum(nd.values())
    29	    return 1 - sum(bn[k] * nd[k] for k in nd if k in bn) / t if t else float("nan")
    30	
    31	
    32	# correct-lock ratio (2026-10-02 口径修正): COMMITTED identity == target over target-present frames — the same notion of
    33	# "lock" as longC / longW; an abstaining tracker (DAM4SAM: empty mask / nothing within its gate) holds its last commitment.
    34	# The former definition 1 − mis_follow_inst counted abstention frames as CORRECT (DAM4SAM abstains ~60% → 0.786 vs 0.367);
    35	# it and the strict one (abstention = wrong) are kept as correct_l / correct_s for the appendix.
    36	EXTRA = [("correct_l", lambda e: 1 - e["mis_follow_inst"]), ("correct_s", _strict)]
    37	METRICS = [("correct", "正确锁定比例(承诺)", lambda e: 1 - e["mis_follow_sustained"]),
    38	           ("longC", "最长连续正确锁定(s)", lambda e: e["max_correct_run_s"]),
    39	           ("longW", "最长锁错(s)", lambda e: e["max_wrong_run_s"])]
    40	RNG = np.random.default_rng(20261002)
    41	
    42	
    43	def load(stem):
    44	    p = os.path.join(EO, f"paper_dep_{stem}.json")
    45	    if not os.path.exists(p):
    46	        return None
    47	    d = json.load(open(p))
    48	    return {int(e["episode_seed"]): e for e in d["episodes"] if e.get("mis_follow_inst") is not None}
    49	
    50	
    51	def ci_mean(x):
    52	    x = np.asarray(x, float); x = x[np.isfinite(x)]; b = x[RNG.integers(0, len(x), (20000, len(x)))].mean(1)
    53	    return [float(x.mean()), float(np.percentile(b, 2.5)), float(np.percentile(b, 97.5))]
    54	
    55	
    56	def main():
    57	    ap = argparse.ArgumentParser(); ap.add_argument("--json"); a = ap.parse_args()
    58	    D = {s: load(s) for s, _, _ in ARMS}
    59	    P = D["tahrelm_pgif"]
    60	    out = {"arms": [], "pending": [s for s, _, _ in ARMS if D[s] is None]}
    61	    for s, lab, grp in ARMS:
    62	        A = D[s]
    63	        if A is None:
    64	            out["arms"].append({"stem": s, "label": lab, "group": grp, "pending": True}); continue
    65	        row = {"stem": s, "label": lab, "group": grp, "n": len(A)}
    66	        for k, _, f in METRICS:
    67	            v = [f(e) for e in A.values()]
    68	            row[k] = ci_mean(v); row[k + "_med"] = float(np.median(v))
    69	        for k, f in EXTRA:
    70	            row[k] = ci_mean([f(e) for e in A.values()])
    71	        if s != "tahrelm_pgif":
    72	            S = sorted(set(A) & set(P))
    73	            for k, _, f in METRICS:
    74	                d = np.array([f(P[x]) - f(A[x]) for x in S])
    75	                b = d[RNG.integers(0, len(d), (20000, len(d)))].mean(1)
    76	                row["pgif_minus_" + k] = [float(d.mean()), float(np.percentile(b, 2.5)), float(np.percentile(b, 97.5))]
    77	        out["arms"].append(row)
    78	    for r in out["arms"]:
    79	        if r.get("pending"):
    80	            print(f"{r['label']:22s} pending"); continue
    81	        msg = f"{r['label']:22s} n={r['n']} " + " | ".join(
    82	            f"{k} {r[k][0]:.3f}" if k == "correct" else f"{k} {r[k][0]:.1f}s(med {r[k + '_med']:.1f})" for k, _, _ in METRICS)
    83	        if "pgif_minus_correct" in r:
    84	            msg += " || PGIF−arm: " + "  ".join(f"{k} {r['pgif_minus_' + k][0]:+.2f}[{r['pgif_minus_' + k][1]:+.2f},{r['pgif_minus_' + k][2]:+.2f}]"
    85	                                                for k, _, _ in METRICS)
    86	        print(msg)
    87	    if a.json:
    88	        json.dump(out, open(a.json, "w"), indent=1, ensure_ascii=False)
    89	
    90	
    91	if __name__ == "__main__":
    92	    main()

