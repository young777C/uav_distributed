   399	    def _assoc_select(self, cset, rgb, init_slot=None):
   400	        """EXTERNAL BASELINE: DeepSORT/OC-SORT-style tracking-by-detection association.
   401	        Motion (constant-velocity image-space prediction + gate) + optional appearance (crop-DINOv2
   402	        cosine to an EMA template). SELECT with the PAST track state, THEN update from the GT-visible
   403	        target (same oracle-seed privilege as reid's gallery → fair). Contrast to reid: an explicit
   404	        motion model + per-frame argmin vs appearance gallery + temporal-EMA. assoc_mode: 'motion'
   405	        (OC-SORT-like, no appearance) | 'deepsort' (motion+appearance). Returns (N,) scores."""
   406	        cands = cset.cands
   407	        uv = np.array([[c.u, c.v] for c in cands], np.float64)          # candidate image positions
   408	        n = len(cands)
   409	        if self._assoc_uv is not None:                                  # motion: predict + gate
   410	            pred = self._assoc_uv + (self._assoc_vel if self._assoc_vel is not None else 0.0)
   411	            dist = np.linalg.norm(uv - pred[None], axis=1)
   412	            score = -dist / self.assoc_gate_px                          # higher = closer
   413	            gate = dist < self.assoc_gate_px
   414	        else:
   415	            score = np.zeros(n); gate = np.ones(n, bool)
   416	        fn = None
   417	        if self.assoc_mode == "deepsort":                              # + appearance cosine
   418	            from train.reid_resolution_probe import _dino_feats
   419	            W, H = self.image_cfg["width"], self.image_cfg["height"]
   420	            feats = _dino_feats(self._dino, rgb, cands, W, H, 224, 1.3, self.device).astype(np.float64)
   421	            fn = feats / (np.linalg.norm(feats, axis=1, keepdims=True) + 1e-8)
   422	            if self._assoc_feat is not None:
   423	                score = score + self.assoc_lambda * (fn @ self._assoc_feat)
   424	        if self._assoc_uv is not None and gate.any():                  # hard motion gate (fall back if empty)
   425	            score = np.where(gate, score, -1e9)
   426	        # UPDATE track state. gallery_seed='gt' (oracle, legacy): from the GT target. 'committed' (DEPLOYABLE, GT-free):
   427	        # from the tracker's OWN association this tick (language pick at cold start, before any track state exists).
   428	        # SELECT always used the PAST state.
   429	        if self.gallery_seed == "committed":
   430	            if self._assoc_uv is None:
   431	                ti = init_slot
   432	            else:
   433	                ti = int(score.argmax()) if float(score.max()) > -1e8 else None   # no gated match → hold state
   434	        else:
   435	            ti = cset.true_idx
   436	        if ti is not None and ti >= 0:
   437	            self._assoc_vel = (uv[ti] - self._assoc_uv) if self._assoc_uv is not None else np.zeros(2)
   438	            self._assoc_uv = uv[ti].copy()
   439	            if fn is not None:
   440	                t = fn[ti]
   441	                self._assoc_feat = t if self._assoc_feat is None else \
   442	                    (0.9 * self._assoc_feat + 0.1 * t) / (np.linalg.norm(0.9 * self._assoc_feat + 0.1 * t) + 1e-8)
   443	        return score.astype(np.float32)
