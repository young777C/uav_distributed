   501	    def _update_commit(self, cset):
   502	        """Commit the tid-selected candidate IDENTITY with K-frame hysteresis (Plan A).
   503	        A challenger identity must win commit_k consecutive S2 ticks to take over; during
   504	        a loss (no valid pick) the current commitment is held."""
   505	        sel = None
   506	        if cset is not None and 0 <= self._pred_slot < len(cset.cands):
   507	            sel = int(cset.cands[self._pred_slot].idx)          # -1 = target, else distractor idx
   508	        if sel is None:
   509	            return                                              # loss -> hold commitment
   510	        if self._committed_idx is None or sel == self._committed_idx:
   511	            self._committed_idx = sel; self._chal = None; self._chal_n = 0
   512	        else:
   513	            self._chal_n = self._chal_n + 1 if sel == self._chal else 1
   514	            self._chal = sel
   515	            if self._chal_n >= self.commit_k:
   516	                self._committed_idx = sel; self._chal = None; self._chal_n = 0
   517	
   518	    def _committed_slot(self, cset):
   519	        """Candidate slot of the currently committed identity this frame (None if not visible / uncommitted).
   520	        Deployable gallery seeds its template from THIS crop — the identity we believe, never GT."""
   521	        if self._committed_idx is None or cset is None:
   522	            return None
   523	        for s, c in enumerate(cset.cands):
   524	            if int(c.idx) == int(self._committed_idx):
   525	                return s
   526	        return None
   527	
   528	    def _committed_world(self, tpos, dstates):
   529	        """World position of the committed identity (GT position; the IDENTITY is tid's)."""
   530	        if self._committed_idx is None:
   531	            return None
   532	        if self._committed_idx < 0:
   533	            return np.asarray(tpos, np.float64)
   534	        ds = np.asarray(dstates)
   535	        return np.asarray(ds[self._committed_idx][:3], np.float64) if self._committed_idx < ds.shape[0] else None
   536	
   537	    def _in_frame(self, world_xyz, campose):
   538	        from acot_probe.projection import project_point
   539	        W = self.image_cfg["width"]; H = self.image_cfg["height"]; fov = self.image_cfg["fov_deg"]
   540	        pr = project_point(tuple(float(x) for x in world_xyz), tuple(float(x) for x in campose), W, H, fov)
   541	        if pr is None:
   542	            return False
   543	        u, v, _ = pr
   544	        return bool(0 <= u < W and 0 <= v < H)
   545	

