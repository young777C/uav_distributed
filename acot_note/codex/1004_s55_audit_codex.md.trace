   226	        fire = map_slot != mem_slot
   227	        if fire:
   228	            self.fires += 1
   229	        self.tick += 1
   230	        self._log(t, aidx, mem_slot, mem_conf, true_slot, None, map_slot, fire)
   231	        return {"fire": fire, "slot": map_slot, "kind": "gate", "post": round(b[ids[map_slot]], 4),
   232	                "gate_memory": self.gate_memory}
   233	
   234	    def _log(self, t, aidx, mem_slot, mem_conf, true_slot, x, anc, fire):
   235	        if not self.log_path:
   236	            return
   237	        rec = {"ep": self.ep, "t": t, "n": len(aidx), "mem": int(mem_slot),
   238	               "true": None if true_slot is None else int(true_slot),
   239	               "conf": None if mem_conf is None else float(mem_conf),
   240	               "anc": anc, "S": round(max(self.S.values(), default=0.0), 4), "fire": fire,
   241	               "x": None if x is None else [round(float(v), 5) for v in x],
   242	               "aidx": [int(a) for a in aidx]}
