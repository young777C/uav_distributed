     1	#!/usr/bin/env bash
     2	# path-B DAgger collection: run tah gt-seeded on COLLECTION seeds (92000+, disjoint from eval 91000-19),
     3	# log deployment-distribution TAH frames to TAH_DAGGER_DIR for on-policy retraining.
     4	set -uo pipefail
     5	REPO=/nvidia/hque/code/cyhe/uav-acot-track; DATA=/nvidia/hque/data/carla_data
     6	HF=${HF_CACHE:-$HOME/.cache/huggingface}; NET=cyh-carla-net
     7	EPISODES=${EPISODES:-24}; SEED_BASE=${SEED_BASE:-92000}; STEPS=${STEPS:-900}; GPU=${GPU:-2}
     8	docker rm -f acot-policy-server >/dev/null 2>&1 || true
     9	docker run -d --gpus "\"device=$GPU\"" --network "$NET" --name acot-policy-server --shm-size=16g \
    10	  -e NVIDIA_DRIVER_CAPABILITIES=compute,utility -e TAH_DAGGER_DIR=runs/tahdag \
    11	  -v "$REPO":"$REPO" -v "$DATA":"$DATA":ro -v "$HF":/root/.cache/huggingface -w "$REPO" \
    12	  acot-uav-train:cu118 bash -c "pip install -q timm==1.0.29 2>/dev/null; \
    13	    python carla_uav_tracking/rollout/policy_server.py --config train/config_v5.yaml \
    14	    --ckpt runs/stage2_v5/stage2_best.pt --language-mode neutral --s2-period 6 \
    15	    --ex-source track --tid-head tah --tah-ckpt runs/tah_rel.pt --gallery-seed gt --conf-tau 0.5 --port 5555" >/dev/null
    16	for _ in $(seq 1 120); do docker logs acot-policy-server 2>&1 | grep -q listening && break
    17	  docker ps --format '{{.Names}}'|grep -q acot-policy-server || { echo died; docker logs acot-policy-server|tail; exit 1; }; sleep 3; done
    18	echo "=== collect $EPISODES ep from seed $SEED_BASE ==="
    19	docker exec cyh-carla python /workspace/rollout/run_rollout.py --policy-host acot-policy-server \
    20	  --policy-port 5555 --episodes "$EPISODES" --seed-base "$SEED_BASE" --steps "$STEPS" --town Town05 \
    21	  --out /workspace/rollout/eval_out/tahdag_collect.json || echo FAILED
    22	docker rm -f acot-policy-server >/dev/null 2>&1 || true
    23	echo "=== DONE collect. tahdag files: $(ls $REPO/runs/tahdag/*.pt 2>/dev/null | wc -l) ==="
