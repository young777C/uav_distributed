import json, glob, os, collections
# Count target id -1 presence/order stats from PGIF jsonl? Need logs include aidx true not cands is_target only. Check aidx contains -1 and true slot points to -1.
p='runs/asd/deploy_all/tahrelm_pgif.jsonl'
n=hit=present=0
bad=[]
for line in open(p):
    r=json.loads(line); n+=1
    if r.get('true') is not None and r['true']>=0:
        present+=1
        if r['aidx'][r['true']] == -1: hit+=1
        else: bad.append((r['ep'],r['t'],r['true'],r['aidx']))
print('pgif log records',n,'target-present',present,'true_slot_has_idx_minus1',hit,'bad',len(bad),bad[:3])
# slot distribution for true slot
cnt=collections.Counter()
for line in open(p):
    r=json.loads(line)
    if r.get('true') is not None and r['true']>=0: cnt[r['true']]+=1
print('true slot dist',cnt)
