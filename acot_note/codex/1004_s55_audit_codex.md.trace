   129	                         "argmax; e.g. 0.7 = integrate evidence over ~3 ticks → robust to off-center frames)")
   130	    ap.add_argument("--conf-consensus", type=float, default=0.0,
   131	                    help="borrow#2: consensus-gated control — commit-fly only if the pick is ALSO motion-"
   132	                         "consistent (dist < conf_consensus·gate), i.e. appearance AND motion agree; on "
