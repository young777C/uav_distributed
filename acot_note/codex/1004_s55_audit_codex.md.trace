train/docker/run.sh:2:# Run a command inside the training container on the A40s.
train/docker/run.sh:4:#   bash train/docker/run.sh                                   # GPU sanity check
train/docker/run.sh:5:#   bash train/docker/run.sh python -m train.stage1_ear --config train/config.yaml
train/docker/run.sh:8:# DATA is mounted READ-ONLY so training can never disturb data generation.
train/docker/run.sh:13:IMAGE=${IMAGE:-acot-uav-train:cu118}
train/docker/run.sh:19:if ! docker info 2>/dev/null | grep -qi "nvidia"; then
train/docker/run.sh:23:# Optional stable container name (NAME=acot-train-run) so long runs are monitorable
train/docker/run.sh:27:  docker rm -f "$NAME" >/dev/null 2>&1 || true
train/docker/run.sh:43:  "$IMAGE" "${@:-python -c 'import torch;print(\"torch\",torch.__version__,\"cuda_avail\",torch.cuda.is_available(),\"gpus\",torch.cuda.device_count())'}"
