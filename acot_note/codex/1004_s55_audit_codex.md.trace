   445	    def _dam4sam_select(self, cset, rgb, init_slot=None):
   446	        """EXTERNAL BASELINE: DAM4SAM (CVPR'25 SOTA distractor-aware SAM2 memory) as the WHICH module,
   447	        served over a socket bridge (separate torch2.1/SAM2 env). On the first target-visible frame,
   448	        init the tracker with the GT target box (same oracle-seed privilege as reid/assoc); each S2
   449	        tick, track → predicted target box → assign the candidate whose center is nearest (within a
   450	        gate) → pred_slot. Returns (N,) scores (higher=nearer the DAM4SAM box); -1e9 gate for far."""
   451	        from rollout.bridge import send_msg, recv_msg
   452	        cands = cset.cands
   453	        n = len(cands)
   454	        # init box: gallery_seed='gt' (oracle, legacy) = GT target box; 'committed' (DEPLOYABLE) = the language pick's box
   455	        ti = init_slot if self.gallery_seed == "committed" else cset.true_idx
   456	        bbox = None
   457	        if not self._dam4sam_inited:
   458	            if ti is not None and ti >= 0:                              # init from the chosen target box
   459	                c = cands[ti]
   460	                box = (c.u - c.w / 2.0, c.v - c.h / 2.0, c.w, c.h)
   461	                send_msg(self._dam4sam_sock, {"cmd": "init", "rgb": np.asarray(rgb, np.uint8), "box": box})
   462	                bbox = recv_msg(self._dam4sam_sock).get("bbox")
   463	                self._dam4sam_inited = True
   464	                self._dam4sam_iou = 0.5                                 # init frame: no predicted IoU yet
   465	            else:
   466	                self._dam_log(cset, "no_init", None, None)
   467	                return np.full(n, -1e9, np.float32)                     # target never seen yet → no pick
   468	        else:
   469	            send_msg(self._dam4sam_sock, {"cmd": "track", "rgb": np.asarray(rgb, np.uint8)})
   470	            resp = recv_msg(self._dam4sam_sock); bbox = resp.get("bbox")
   471	            iou = resp.get("iou")
   472	            self._dam4sam_iou = float(iou) if iou is not None and iou == iou else 0.0   # SAM2 predicted IoU = confidence
   473	        self._dam4sam_rgb = rgb                                         # for the PGIF reset hook (re-init on ŝ)
   474	        self._dam4sam_cool = max(0, getattr(self, "_dam4sam_cool", 0) - 1)
   475	        if bbox is None:
   476	            self._dam_log(cset, "empty", None, None)
   477	            return np.full(n, -1e9, np.float32)                         # lost (empty mask) → hold
   478	        bx, by, bw, bh = bbox
   479	        pc = np.array([bx + bw / 2.0, by + bh / 2.0])                   # DAM4SAM predicted center
   480	        uv = np.array([[c.u, c.v] for c in cands], np.float64)
   481	        dist = np.linalg.norm(uv - pc[None], axis=1)
   482	        gate = float(self.assoc_gate_px)
   483	        self._dam_log(cset, "pick" if float(dist.min()) < gate else "gate", dist, bbox)
   484	        return np.where(dist < gate, -dist / gate, -1e9).astype(np.float32)
