   244	            rec["cosA"] = [round(float(v), 4) for v in self._last[0]]
   245	            rec["zl"] = [round(float(v), 4) for v in self._last[1]]
   246	        with open(self.log_path, "a") as f:
   247	            f.write(json.dumps(rec) + "\n")

