     1	"""RolloutScorer — score a closed-loop episode from GT, per guide §6 / design §7.2.
     2	
     3	The controller never sees GT; the scorer does, every tick. Key rule (§3.4 族B, §7):
     4	closed-loop mis-follow is NOT per-frame argmax (that punishes single-frame flicker
     5	from flow-matching stochasticity). We maintain a COMMITTED target with K-frame
     6	hysteresis; a new candidate only takes over after winning K consecutive ticks.
     7	
     8	Reported:
     9	  mis_follow_inst      per-tick argmax≠target over target-present ticks (diagnostic, strict)
    10	  mis_follow_sustained committed≠target over target-present ticks (main; == MOT ID-switch)
    11	  id_switches          # times the committed target flips to a wrong car (held ≥K)
    12	  success              reached episode end with no committed-wrong run ≥ T_fail_s and
    13	                       never lost the target past truncation
    14	  track_frames         ticks the target stayed in frame
    15	  centering_rate       fraction of in-frame ticks with the target in the central region
    16	  reacquire_*          convergence time (delay OK) vs lock-wrong rate (hard failure, §7)
    17	  shortcut_*           "always nearest car" / "target dead-center" occupancy (捷径 checks, §7)
    18	
    19	The scorer maps the policy's predicted candidate SLOT → identity via the shuffled
    20	CandidateSet (cands[slot].is_target / .idx); it does not read any slot ordering
    21	into the control path.
    22	"""
    23	
    24	from __future__ import annotations
    25	
    26	import numpy as np
    27	
    28	
    29	def _identity_key(cand) -> str:
    30	    return "target" if cand.is_target else f"distractor_{cand.idx}"
    31	
    32	
    33	class RolloutScorer:
    34	    def __init__(self, fps: int = 10, commit_k: int = 5, t_fail_s: float = 2.0,
    35	                 max_lost_s: float = 5.0, central_frac: float = 0.3):
    36	        self.fps = fps
    37	        self.commit_k = commit_k
    38	        self.t_fail = int(t_fail_s * fps)
    39	        self.max_lost = int(max_lost_s * fps)
    40	        self.central_frac = central_frac
    41	
    42	    def reset(self, metadata: dict | None = None):
    43	        self.meta = metadata or {}
    44	        self.n = 0
    45	        # committed-target hysteresis
    46	        self._committed = None
    47	        self._challenger = None
    48	        self._chal_count = 0
    49	        self._id_switches = 0
    50	        self._wrong_run = 0          # consecutive committed-wrong ticks (target present)
    51	        self._max_wrong_run = 0
    52	        self._correct_run = 0           # committed==target consecutive in-frame ticks (symmetric to wrong run)
    53	        self._max_correct_run = 0
    54	        self._off_run = 0            # consecutive target-off-screen ticks
    55	        self._failed = False
    56	        # counters
    57	        self._present = 0            # target-present (in-frame) ticks
    58	        self._inst_wrong = 0
    59	        self._sustain_wrong = 0
    60	        self._central = 0
    61	        self._nearest_pred = 0       # ticks the pred == nearest candidate (shortcut)
    62	        self._nearest_denom = 0
    63	        self._central_target = 0     # ticks target is dead-center (shortcut)
    64	        self._dist_sum = 0.0
    65	        self._dist_n = 0
    66	        # per-frame grounding stratifiers (why is online mis_follow > offline?):
    67	        self._byN = {}          # N candidates -> [wrong, total]
    68	        self._byC = {"central": [0, 0], "off": [0, 0]}   # target central vs off-center
    69	        self._byD = {}          # target depth bucket -> [wrong, total]
    70	        # re-acquisition tracking: EVERY target-loss is one attempt, resolved on
    71	        # recovery (success) or left as timeout at episode end (no-WM baseline needs
    72	        # the failures, not just the successes).
    73	        self._was_lost = False
    74	        self._reacq_open = False
    75	        self._reacq_start = 0
    76	        self._reacq_wrong_counted = False
    77	        self._reacq_attempts = 0
    78	        self._reacq_success = 0      # re-locked the TRUE target
    79	        self._reacq_wrong = 0        # committed to a WRONG car during recovery (≥1 tick)
    80	        self._reacq_conv = []        # convergence frames, successful re-acquisitions only
    81	
    82	    # ------------------------------------------------------------------
    83	    def update(self, *, step: int, target_present: bool, target_central: bool,
    84	               in_loss_window: bool, info, uav_target_dist: float | None = None):
    85	        """info: policy.ActInfo (cand_set + pred_slot). target_present: target in-frame."""
    86	        self.n = step + 1
    87	        cset = getattr(info, "cand_set", None)
    88	        pred_slot = getattr(info, "pred_slot", -1)
    89	        pred_cand = cset.cands[pred_slot] if (cset is not None and 0 <= pred_slot < len(cset.cands)) else None
    90	        pred_key = _identity_key(pred_cand) if pred_cand is not None else None
    91	
    92	        # --- hysteresis commit ---
    93	        if pred_key is not None:
    94	            if self._committed is None:
    95	                self._committed = pred_key
    96	            elif pred_key == self._committed:
    97	                self._challenger, self._chal_count = None, 0
    98	            else:
    99	                if pred_key == self._challenger:
   100	                    self._chal_count += 1
   101	                else:
   102	                    self._challenger, self._chal_count = pred_key, 1
   103	                if self._chal_count >= self.commit_k:
   104	                    if self._committed == "target" and pred_key != "target":
   105	                        self._id_switches += 1
   106	                    self._committed = pred_key
   107	                    self._challenger, self._chal_count = None, 0
   108	
   109	        # --- off-screen / truncation bookkeeping ---
   110	        if target_present:
   111	            self._off_run = 0
   112	        else:
   113	            self._off_run += 1
   114	
   115	        # --- mis-follow accounting (only over target-present ticks) ---
   116	        if target_present:
   117	            self._present += 1
   118	            if target_central:
   119	                self._central += 1
   120	                self._central_target += 1
   121	            if pred_cand is not None and not pred_cand.is_target:
   122	                self._inst_wrong += 1
   123	            # per-frame stratified mis_follow (matches offline argmax≠target over target-present)
   124	            ti = getattr(cset, "true_idx", -1) if cset is not None else -1
   125	            if cset is not None and ti >= 0:
   126	                N = len(cset.cands)
   127	                wrong = int(pred_slot != ti)
   128	                nb = min(N, 6)
   129	                b = self._byN.setdefault(nb, [0, 0]); b[0] += wrong; b[1] += 1
   130	                ck = "central" if target_central else "off"
   131	                self._byC[ck][0] += wrong; self._byC[ck][1] += 1
   132	                td = float(cset.cands[ti].depth)
   133	                db = "d<30" if td < 30 else ("d30-60" if td < 60 else "d>=60")
   134	                bd = self._byD.setdefault(db, [0, 0]); bd[0] += wrong; bd[1] += 1
   135	            committed_wrong = self._committed is not None and self._committed != "target"
   136	            if committed_wrong:
   137	                self._sustain_wrong += 1
   138	                self._wrong_run += 1
   139	                self._max_wrong_run = max(self._max_wrong_run, self._wrong_run)
   140	                if self._wrong_run >= self.t_fail:
   141	                    self._failed = True
   142	            else:
   143	                self._wrong_run = 0
   144	            if self._committed == "target":
   145	                self._correct_run += 1
   146	                self._max_correct_run = max(self._max_correct_run, self._correct_run)
   147	            else:
   148	                self._correct_run = 0
   149	            # shortcut: does pred coincide with the nearest (smallest-depth) candidate?
   150	            if cset is not None and len(cset.cands) > 1 and pred_cand is not None:
   151	                nearest = min(range(len(cset.cands)), key=lambda i: cset.cands[i].depth)
   152	                self._nearest_pred += int(pred_slot == nearest)
   153	                self._nearest_denom += 1
   154	        else:
   155	            self._correct_run = 0           # target out of frame ends a correct-lock run (conservative)
   156	
   157	        if uav_target_dist is not None:
   158	            self._dist_sum += float(uav_target_dist); self._dist_n += 1
   159	
   160	        # --- re-acquisition: each target-loss is one attempt, resolved on recovery ---
   161	        lost_now = (not target_present) or in_loss_window
   162	        if lost_now and not self._was_lost:            # a loss STARTS → open a new attempt
   163	            self._reacq_open = True
   164	            self._reacq_start = step
   165	            self._reacq_wrong_counted = False
   166	            self._reacq_attempts += 1
   167	        if self._reacq_open:
   168	            if (not self._reacq_wrong_counted and target_present
   169	                    and self._committed is not None and self._committed != "target"):
   170	                self._reacq_wrong += 1                  # locked a wrong car while recovering (once/attempt)
   171	                self._reacq_wrong_counted = True
   172	            if (not lost_now) and target_present and self._committed == "target":
   173	                self._reacq_success += 1                # correctly re-acquired the TRUE target
   174	                self._reacq_conv.append(step - self._reacq_start)
   175	                self._reacq_open = False                # attempt resolved
   176	        self._was_lost = lost_now
   177	
   178	    def should_truncate(self) -> bool:
   179	        return self._off_run >= self.max_lost
   180	

