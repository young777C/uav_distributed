carla_uav_tracking/rollout/collect_tahdag.sh:20:  --policy-port 5555 --episodes "$EPISODES" --seed-base "$SEED_BASE" --steps "$STEPS" --town Town05 \
carla_uav_tracking/rollout/collect_tahdag.sh:21:  --out /workspace/rollout/eval_out/tahdag_collect.json || echo FAILED
