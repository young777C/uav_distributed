   486	    def _dam_log(self, cset, reason, dist, bbox):
   487	        """DAM4SAM abstention diagnosis record (offline scoring only: true_idx is NOT used by any decision)."""
   488	        if self._dam_diag is None:
   489	            return
   490	        ti = cset.true_idx if cset.true_idx is not None else -1
   491	        rec = {"ep": self._dam_ep, "k": self._dam_k, "reason": reason, "n": len(cset.cands), "true": int(ti),
   492	               "inited": bool(self._dam4sam_inited), "iou": round(float(self._dam4sam_iou), 4)}
   493	        if dist is not None:
   494	            j = int(dist.argmin())
   495	            rec.update(nearest=j, d_min=round(float(dist[j]), 1), nearest_is_true=bool(j == ti),
   496	                       d_true=round(float(dist[ti]), 1) if ti >= 0 else None,
   497	                       box_wh=[round(float(bbox[2]), 1), round(float(bbox[3]), 1)])
   498	        self._dam_diag.write(json.dumps(rec) + "\n"); self._dam_diag.flush()
   499	        self._dam_k += 1
