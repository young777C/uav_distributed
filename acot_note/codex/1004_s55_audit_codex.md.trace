     1	"""Audit (2026-10-02): how much of PGIF's gain relies on the simulator's PERSISTENT actor ids surviving occlusion?
     2	(1) Open-loop replay on observe logs (memory picks of TAHRelM w/o PGIF): PGIF-tempered fed the true persistent ids vs
     3	    ids that are re-issued whenever an actor RE-ENTERS the candidate set (= a realistic tracker without cross-occlusion
     4	    re-ID). Accuracy = output pick == true slot over target-present ticks; GT used only for scoring.
     5	(2) Closed-loop PGIF log: corrective fires (memory wrong → PGIF output right) split by whether the target re-entered
     6	    within the last R ticks.
     7	  python id_persistence_audit.py"""
     8	import collections
     9	import json
    10	import os
    11	
    12	import numpy as np
    13	
    14	from asd import ASD
    15	
    16	LG = os.path.join(os.path.dirname(__file__), "..", "..", "runs", "asd")
    17	
    18	
    19	def eps(path):
    20	    E = collections.defaultdict(list)
    21	    for line in open(path):
    22	        r = json.loads(line); E[r["ep"]].append(r)
    23	    return [sorted(v, key=lambda r: r["t"]) for v in E.values()]
    24	
    25	
    26	def reissue_on_reentry(seq, gap=6):
    27	    """ids re-issued when an actor was absent at the previous S2 tick (or the previous tick is > gap steps ago)."""
    28	    lab, nxt, prev_ids, prev_t, out = {}, 10_000, set(), None, []
    29	    for r in seq:
    30	        cont = prev_t is not None and r["t"] - prev_t <= gap
    31	        ids = []
    32	        for a in r["aidx"]:
    33	            if a not in lab or not (cont and a in prev_ids):
    34	                lab[a] = nxt; nxt += 1
    35	            ids.append(lab[a])
    36	        out.append(ids); prev_ids = set(r["aidx"]); prev_t = r["t"]
    37	    return out
    38	
    39	
    40	def replay(seq, ids_seq):
    41	    f = ASD(mode="filter", filter_kind="tempered", resid_decay=0.98)
    42	    f.reset(); hit = n = 0
    43	    for r, ids in zip(seq, ids_seq):
    44	        if r["mem"] is None or r["mem"] < 0:
    45	            continue
    46	        o = f.step(None, ids, r["mem"], mem_conf=r["conf"])
    47	        out = o["slot"]
    48	        if r["true"] is not None and r["true"] >= 0:
    49	            n += 1; hit += out == r["true"]
    50	    return hit, n
    51	
    52	
    53	def main():
    54	    print("## (1) open-loop replay: PGIF with persistent ids vs ids re-issued on re-entry")
    55	    for name in ("tah_observe_91000", "tah_observe_t10", "reid_observe_91000"):
    56	        p = os.path.join(LG, name + ".jsonl")
    57	        if not os.path.exists(p):
    58	            continue
    59	        E = eps(p); mem = [0, 0]; per = [0, 0]; reent = [0, 0]
    60	        for seq in E:
    61	            for r in seq:
    62	                if r["true"] is not None and r["true"] >= 0 and r["mem"] is not None:
    63	                    mem[0] += r["mem"] == r["true"]; mem[1] += 1
    64	            h, n = replay(seq, [r["aidx"] for r in seq]); per[0] += h; per[1] += n
    65	            h, n = replay(seq, reissue_on_reentry(seq)); reent[0] += h; reent[1] += n
    66	        a = lambda x: x[0] / max(x[1], 1)
    67	        print(f"{name:20s} eps={len(E):2d} ticks={mem[1]} | memory raw {a(mem):.3f} | PGIF persistent ids {a(per):.3f} "
    68	              f"(+{a(per)-a(mem):.3f}) | PGIF ids re-issued on re-entry {a(reent):.3f} (+{a(reent)-a(mem):.3f}) | "
    69	              f"share of gain kept {((a(reent)-a(mem))/(a(per)-a(mem)) if a(per)>a(mem) else float('nan')):.2f}")
    70	    print("\n## (2) closed-loop PGIF (deploy_all/tahrelm_pgif.jsonl): corrective vs harmful fires by target re-entry recency")
    71	    p = os.path.join(LG, "deploy_all", "tahrelm_pgif.jsonl")
    72	    cnt = collections.Counter()
    73	    for seq in eps(p):
    74	        last_seen_t, prev_t, absent_since = None, None, None
    75	        for r in seq:
    76	            tv = r["true"] is not None and r["true"] >= 0
    77	            gap_before = (prev_t is None) or (r["t"] - prev_t > 6)
    78	            if tv:
    79	                if last_seen_t is None or gap_before or r["t"] - last_seen_t > 6:
    80	                    reentry_t = r["t"]
    81	                    cur_reentry = reentry_t
    82	                last_seen_t = r["t"]
    83	            prev_t = r["t"]
    84	            if not tv or r.get("anc") is None:
    85	                continue
    86	            recent = (r["t"] - cur_reentry) <= 30          # within 5 S2 ticks (3 s) of the target (re)appearing
    87	            first = cur_reentry == seq[0]["t"]              # the episode's first appearance is not a re-entry
    88	            kind = "corrective" if (r["mem"] != r["true"] and r["anc"] == r["true"]) else \
    89	                   ("harmful" if (r["mem"] == r["true"] and r["anc"] != r["true"]) else None)
    90	            if kind:
    91	                cnt[(kind, "after_reentry≤3s" if (recent and not first) else "steady")] += 1
    92	    for k in ("corrective", "harmful"):
    93	        a, b = cnt[(k, "after_reentry≤3s")], cnt[(k, "steady")]
    94	        print(f"{k:10s} fires: {a+b:4d} | within 3 s after target re-entry {a:4d} ({a/max(a+b,1):.0%}) | steady tracking {b:4d}")
    95	
    96	
    97	if __name__ == "__main__":
    98	    main()

