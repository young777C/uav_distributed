   116	    ap.add_argument("--reid-bank", type=int, default=1, help="reid K-view gallery size (sweet spot ~2-3)")
   117	    ap.add_argument("--reid-topm", type=int, default=1, help="reid match = top-m mean cosine to gallery")
   118	    ap.add_argument("--warmup-oracle-s", type=float, default=0.0,
