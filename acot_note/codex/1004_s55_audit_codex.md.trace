/bin/sh -lc "python3 - <<'PY'
import json, glob, os, numpy as np
# Recompute deploy comparison excluding episodes with metadata error
arms=['xattn','l4','l5','borrow1','tahdag','tahrelm','ocsort','deepsort','dam4sam','tahrelm_pgif']
D={}
for s in arms:
    eps=json.load(open(f'carla_uav_tracking/rollout/eval_out/paper_dep_{s}.json'))['episodes']
    D[s]={e['episode_seed']:e for e in eps if e.get('mis_follow_inst') is not None and not e.get('error')}
P=D['tahrelm_pgif']
def vals(A,key):
    if key=='correct': return [1-e['mis_follow_sustained'] for e in A.values()]
    if key=='longC': return [e['max_correct_run_s'] for e in A.values()]
    if key=='longW': return [e['max_wrong_run_s'] for e in A.values()]
for s in arms:
    print(s,'n_noerr',len(D[s]),'seeds',sorted(D[s]))
    print(' mean correct/longC/longW', *(sum(vals(D[s],k))/len(D[s]) for k in ['correct','longC','longW']))
    if s"'!='"'tahrelm_pgif':
        S=sorted(set(D[s])&set(P))
        print(' paired_noerr n',len(S),'delta', *(np.mean([(1-P[x]['mis_follow_sustained'] if k=='correct' else P[x]['max_correct_run_s'] if k=='longC' else P[x]['max_wrong_run_s']) - (1-D[s][x]['mis_follow_sustained'] if k=='correct' else D[s][x]['max_correct_run_s'] if k=='longC' else D[s][x]['max_wrong_run_s']) for x in S]) for k in ['correct','longC','longW']))
