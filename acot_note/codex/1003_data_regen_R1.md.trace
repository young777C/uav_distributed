    70	# --------------------------- stage 2: train ---------------------------
    71	def supcon_loss(z, labels, tau):
    72	    import torch
    73	    sim = (z @ z.T) / tau
    74	    sim = sim - sim.max(dim=1, keepdim=True).values.detach()
    75	    self_mask = torch.eye(z.shape[0], device=z.device, dtype=torch.bool)

