    45	
    46	def _centering_target(tgt, cam, act, i, H, W, fov, a_scale, yaw_cap_deg, blend=1.0):
    47	    """(H, 5) centering action chunk: recorded dx,dy,dz + blended centering dyaw + recorded search.
    48	
    49	    blend=1.0 → full geometric centering yaw (aggressive; destabilized tracking in the 4-ep smoke:
    50	    track_s 33.8→2.2 — over-rotates on noisy CV z_ex). blend<1.0 → dyaw = b·center + (1-b)·recorded,
    51	    a GENTLER nudge toward center that preserves the expert's coordinated (yaw,translation) so it
    52	    doesn't swing the target out of frame.
    53	    """
    54	    out = np.zeros((H, 5), np.float32)
    55	    n = len(tgt)
    56	    for k in range(H):
    57	        j = min(i + k, n - 1)
    58	        cx, cy, cz, cp, cyaw = cam[j]
    59	        desired = math.degrees(math.atan2(tgt[j][1] - cy, tgt[j][0] - cx))
    60	        yaw_err = _norm180(desired - cyaw)
    61	        dyaw_c = float(np.clip(yaw_err, -yaw_cap_deg, yaw_cap_deg) / a_scale)
    62	        out[k, 0], out[k, 1], out[k, 2] = act[j, 0], act[j, 1], act[j, 2]   # recorded dx,dy,dz
    63	        out[k, 3] = blend * dyaw_c + (1.0 - blend) * float(act[j, 3])       # blended CENTERING dyaw
    64	        out[k, 4] = act[j, 4] if act.shape[1] > 4 else 0.0                   # recorded search
    65	    return out
