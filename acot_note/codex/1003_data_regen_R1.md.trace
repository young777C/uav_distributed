   662	    # ------------------------------------------------------------------
   663	    # Per-step API
   664	    # ------------------------------------------------------------------
   665	
   666	    def get_target_state(self) -> tuple[np.ndarray, np.ndarray, float, float]:
   667	        assert self._target is not None
   668	        return self._target.get_state()
   669	
   670	    def recycle_lost_lookalikes(self) -> None:
   671	        """Smooth off-screen recycle (spec §4d): keep >=2 SIMILAR look-alikes co-visible
   672	        with the target by teleporting one that has drifted FAR off-camera back into view
   673	        AHEAD of the target. Robustness guards (the two failure modes that disabled the old
   674	        version): only OFF-screen actors move (real-camera projection → no visible jump);
   675	        the destination slot is on a DRIVING lane and validated CLEAR of every nearby
   676	        vehicle (no collision). Only fires when <2 look-alikes are currently on-screen, so
   677	        it does no work (and no world query) while co-visibility is already fine. Keeping
   678	        the look-alikes near the target also keeps the framing centroid near the target →
   679	        the target stays in-frame (fixes the earlier off-screen instability)."""
   680	        cfg = self._config.get("scene", {}).get("covisibility", {})
   681	        if not cfg.get("enabled", True) or self._target is None or self.drone is None:
   682	            return
   683	        try:
   684	            cam_t = self.drone.get_camera_transform()
   685	            tloc = self._target.transform.location
   686	        except RuntimeError:
   687	            return
   688	        tgt_wp = self._map.get_waypoint(tloc)
   689	        if tgt_wp is None:
   690	            return
   691	        W, H = self._config.get("output", {}).get("rgb_resolution", [336, 336])
   692	        _fov = float(self._config.get("output", {}).get("fov", 90.0))   # §10: match sensor FOV
   693	        M = np.array(cam_t.get_inverse_matrix())
   694	        focal = W / (2.0 * np.tan(np.radians(_fov) / 2.0))
   695	
   696	        def _visible(p) -> bool:
   697	            q = M @ np.array([p[0], p[1], p[2], 1.0])
   698	            if q[0] <= 0.1:
   699	                return False
   700	            u = focal * (q[1] / q[0]) + W / 2.0
   701	            v = focal * (-q[2] / q[0]) + H / 2.0
   702	            return 0 <= u < W and 0 <= v < H
   703	
   704	        far = float(cfg.get("recycle_radius", 55.0))
   705	        clr = float(cfg.get("min_clearance", 6.0))
   706	        tpos = np.array([tloc.x, tloc.y, tloc.z])
   707	        # Cheap pass: how many similar are on-screen; which off-screen ones drifted far.
   708	        on_screen, needy = 0, []
   709	        for obj, meta in zip(self._distractors, self._distractor_meta):
   710	            if not meta.get("similar"):
   711	                continue
   712	            try:
   713	                p, _, _, _ = obj.get_state()
   714	            except RuntimeError:
   715	                continue
   716	            if _visible(p):
   717	                on_screen += 1
   718	            elif np.linalg.norm(np.asarray(p)[:2] - tpos[:2]) > far:
   719	                needy.append(obj)
   720	        if on_screen >= 2 or not needy:
   721	            return                               # co-visibility already fine → do nothing
   722	
   723	        # Candidate driving lanes = target lane + same-direction neighbours.
   724	        lanes = [tgt_wp]
   725	        for g in ("get_left_lane", "get_right_lane"):
   726	            try:
   727	                c = getattr(tgt_wp, g)()
   728	            except RuntimeError:
   729	                c = None
   730	            if (c is not None and c.lane_type == carla.LaneType.Driving
   731	                    and c.lane_id * tgt_wp.lane_id > 0):
   732	                lanes.append(c)
   733	        # Occupancy = every vehicle within 45 m of the target (collision check).
   734	        occupied = [tpos]
   735	        try:
   736	            for a in self._world.get_actors().filter("vehicle.*"):
   737	                loc = a.get_location()
   738	                if abs(loc.x - tloc.x) < 45 and abs(loc.y - tloc.y) < 45:
   739	                    occupied.append(np.array([loc.x, loc.y, loc.z]))
   740	        except RuntimeError:
   741	            pass
   742	
   743	        random.shuffle(needy)
   744	        for obj in needy[:max(0, 2 - on_screen)]:
   745	            actor = getattr(obj, "_vehicle", None)
   746	            if actor is None:
   747	                continue
   748	            for _try in range(8):                # find a clear on-road slot near the target, in view
