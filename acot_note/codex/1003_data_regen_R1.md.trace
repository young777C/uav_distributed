   507	    def _spawn_ambient_traffic(self, scene_cfg: dict) -> None:
   508	        """Populate background traffic CONCENTRATED NEAR THE TARGET the official way:
   509	        diverse vehicles (cars/bus/trucks/motos/bikes) via batch SpawnActor+SetAutopilot,
   510	        kept near the hero (target) by hybrid-physics + respawn_dormant_vehicles; plus
   511	        manually-controlled background pedestrians on the nearby navmesh."""
