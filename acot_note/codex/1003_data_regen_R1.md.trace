     1	"""Build a proper train/val/test split manifest (Phase A2).
     2	
     3	Fixes the naive "first-N episodes = val" slice, which put ALL of Town01 in val
     4	(town leakage + unrepresentative). Instead:
     5	
     6	  - TEST  = one whole HELD-OUT town  -> measures cross-town generalization (§7.2).
     7	  - VAL   = strategy-stratified sample of the remaining towns (deterministic).
     8	  - TRAIN = the rest.
     9	
    10	Episode-level (no frame leakage). Reads only attrs. Writes a JSON manifest that
    11	RealEARDataset consumes. Run after data generation is finished:
    12	
    13	    python -m train.make_split --config train/config.yaml
    14	"""
    15	
    16	from __future__ import annotations
    17	
    18	import argparse
    19	import glob
    20	import json
    21	import math
    22	from collections import Counter, defaultdict
    23	from pathlib import Path
    24	
    25	import h5py
    26	import numpy as np
    27	import yaml
    28	
    29	
    30	def _attrs(ep):
    31	    with h5py.File(ep, "r") as f:
    32	        a = f.attrs
    33	        def g(k):
    34	            v = a.get(k, "")
    35	            return v.decode() if isinstance(v, bytes) else str(v)
    36	        return {"town": g("town"), "strategy": g("strategy"), "cls": g("target_class")}
    37	
    38	
    39	def build(cfg):
    40	    eps = sorted(glob.glob(cfg["data"]["episodes_glob"]))
    41	    if not eps:
    42	        raise SystemExit(f"no episodes at {cfg['data']['episodes_glob']}")
    43	    meta = {ep: _attrs(ep) for ep in eps}
    44	    towns = Counter(m["town"] for m in meta.values())
    45	
    46	    # choose held-out test town: configured, else the smallest town (least train loss)
    47	    test_town = cfg["data"].get("test_town") or min(towns, key=lambda t: towns[t])
    48	    test = [ep for ep in eps if meta[ep]["town"] == test_town]
    49	    pool = [ep for ep in eps if meta[ep]["town"] != test_town]
    50	
    51	    # strategy-stratified val from the pool (deterministic per strategy group)
    52	    val_frac = cfg["data"].get("val_frac", 0.15)
    53	    rng = np.random.default_rng(cfg.get("seed", 0))
    54	    by_strat = defaultdict(list)
    55	    for ep in pool:
    56	        by_strat[meta[ep]["strategy"]].append(ep)
    57	    val, train = [], []
    58	    for _strat, group in sorted(by_strat.items()):
    59	        group = list(group)
    60	        order = rng.permutation(len(group))
    61	        n_val = max(1, math.floor(len(group) * val_frac))
    62	        vi = set(order[:n_val].tolist())
    63	        for i, ep in enumerate(group):
    64	            (val if i in vi else train).append(ep)
    65	
    66	    manifest = {
    67	        "test_town": test_town,
    68	        "train": sorted(Path(e).name for e in train),
    69	        "val": sorted(Path(e).name for e in val),
    70	        "test": sorted(Path(e).name for e in test),
    71	    }
    72	    out = Path(cfg["data"].get("split_manifest", "train/splits/mvp_split.json"))
    73	    out.parent.mkdir(parents=True, exist_ok=True)
    74	    out.write_text(json.dumps(manifest, indent=2))
    75	
    76	    def brk(names):
    77	        ms = [meta[e] for e in eps if Path(e).name in set(names)]
    78	        return dict(Counter(m["town"] for m in ms)), dict(Counter(m["strategy"] for m in ms))
    79	    print(f"[split] test_town={test_town}  ->  {out}")
    80	    for k in ["train", "val", "test"]:
    81	        tt, ss = brk(manifest[k])
    82	        print(f"  {k:5s} n={len(manifest[k]):3d}  towns={tt}")
    83	        print(f"        strat={ss}")
    84	    return manifest
    85	
    86	
    87	def main():
    88	    ap = argparse.ArgumentParser()
    89	    ap.add_argument("--config", required=True)
    90	    cfg = yaml.safe_load(Path(ap.parse_args().config).read_text())
    91	    build(cfg)
    92	
    93	
    94	if __name__ == "__main__":
    95	    main()

