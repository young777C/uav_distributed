    22	
    23	class ASD:
    24	    def __init__(self, mode: str = "rule", k_anchor: int = 3, beta_lang: float = 0.25, lang_ema: float = 0.7,
    25	                 tau: float = 0.1, kappa: float = 0.25, h: float = 2.0, refractory: int = 3,
    26	                 learned_ckpt: str | None = None, log_path: str | None = None, anchor_mode: str = "first",
    27	                 eps_switch: float = 0.01, q_lo: float = 0.2, q_hi: float = 0.7, conf_window: int = 30,
    28	                 gate_memory: bool = True, filter_kind: str = "bayes", resid_decay: float = 0.98,
    29	                 alpha: dict | None = None, naive: bool = False, gate_tah: bool = True, gate_dam: bool = True):
    30	        assert mode in ("observe", "rule", "learned", "filter"), mode
    31	        self.mode, self.k_anchor, self.beta, self.lema = mode, int(k_anchor), float(beta_lang), float(lang_ema)
    32	        self.tau, self.kappa, self.h, self.refractory = float(tau), float(kappa), float(h), int(refractory)
    33	        self.w = self.b = None
    34	        if mode == "learned":
    35	            assert learned_ckpt, "mode=learned needs learned_ckpt"
    36	            ck = json.load(open(learned_ckpt))
    37	            self.w, self.b = np.asarray(ck["w"], np.float64), float(ck["b"])
    38	            self.prior_logit = float(ck.get("prior_logit", 0.0))
    39	            self.h = float(ck.get("h", self.h))
    40	            self.mu, self.sd = np.asarray(ck["mu"]), np.asarray(ck["sd"])
    41	        self.log_path = log_path
    42	        # anchor_mode: 'first' = anchor = M's picks during the window (inherits cold-start errors) |
    43	        # 'spec' = sequential SPEC identification: integrate language evidence per actor over the window, anchor
    44	        # to the argmax actor's crops and correct M if it disagrees (also fixes wrong cold-start locks).
    45	        assert anchor_mode in ("first", "spec"), anchor_mode
    46	        self.anchor_mode = anchor_mode
    47	        # filter mode (ASD-IF): sticky Bayes filter over persistent tracklets; the memory's pick is a noisy
    48	        # observation whose error rate q is set by the rank of its confidence within a sliding window
    49	        # (scale-free → memory-agnostic, no per-memory calibration). Output = MAP tracklet (posterior gating).
    50	        self.eps_switch, self.q_lo, self.q_hi, self.conf_window = float(eps_switch), float(q_lo), float(q_hi), int(conf_window)
    51	        self.gate_memory = bool(gate_memory)          # ablation: False = override commitment only, memory still self-updates
    52	        assert filter_kind in ("bayes", "resid", "tempered"), filter_kind
    53	        self.filter_kind, self.resid_decay = filter_kind, float(resid_decay)   # 'resid' = longest-residence heuristic
    54	        # V3 fusion: per-source weights (default equal), naive = per-tick vote (no tempering, ensemble control)
    55	        self.alpha = dict(alpha or {}); self.naive = bool(naive)
    56	        self.gate_tah, self.gate_dam = bool(gate_tah), bool(gate_dam)
    57	        self.ep = -1
    58	        self.reset()
    59	
    60	    # ------------------------------------------------------------------ state
    61	    def reset(self):
    62	        self.anchor: list[np.ndarray] = []      # frozen early-track appearance bank (drift-immune reference)
    63	        self.win_feats: dict[int, list] = {}    # spec-anchor window: actor id -> crops seen
    64	        self.win_ticks = 0
    65	        self.belief: dict[int, float] = {}      # filter: posterior over tracklet ids
    66	        self.conf_hist: list[float] = []
    67	        self.src_hist: dict[str, list] = {}     # V3 fusion: per-source confidence windows
    68	        self.lang_score: dict[int, float] = {}  # per-actor EMA of z-scored language logit (spec integration)
    69	        self.S: dict[int, float] = {}           # multi-hypothesis CUSUM: per challenger identity (actor id)
    70	        self.cool = 0                           # refractory ticks after an alarm
    71	        self.tick = 0
    72	        self.fires = 0
