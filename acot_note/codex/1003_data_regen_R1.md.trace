   318	
   319	def collate_stage2(batch):
   320	    """Pad per-layer context tokens (M) and candidates (N) to batch max; build masks."""
   321	    L = len(batch[0]["vlm_ctx_layers"])
   322	    C = batch[0]["vlm_ctx"].shape[-1]
   323	    Ccand = batch[0]["cand_feats"].shape[-1]
   324	    Mmax = max(b["vlm_ctx"].shape[0] for b in batch)
   325	    Nmax = max(b["cand_feats"].shape[0] for b in batch)
   326	    B = len(batch)
   327	
   328	    ctx_layers = [torch.zeros(B, Mmax, C) for _ in range(L)]
   329	    ctx = torch.zeros(B, Mmax, C)
   330	    ctx_mask = torch.zeros(B, Mmax, dtype=torch.bool)
   331	    cand = torch.zeros(B, Nmax, Ccand)
   332	    cand_mask = torch.zeros(B, Nmax, dtype=torch.bool)
   333	    tgt = torch.zeros(B, dtype=torch.long)
   334	
   335	    for i, b in enumerate(batch):
   336	        m = b["vlm_ctx"].shape[0]
   337	        ctx[i, :m] = b["vlm_ctx"]; ctx_mask[i, :m] = True
   338	        for l in range(L):
   339	            ctx_layers[l][i, :m] = b["vlm_ctx_layers"][l]
   340	        nc = b["cand_feats"].shape[0]
   341	        cand[i, :nc] = b["cand_feats"]; cand_mask[i, :nc] = True
   342	        tgt[i] = b["target_idx"]
   343	
   344	    stack = lambda k: torch.stack([b[k] for b in batch])
   345	    return {
   346	        "vlm_ctx_layers": ctx_layers, "vlm_ctx": ctx, "ctx_mask": ctx_mask,
   347	        "proprio": stack("proprio"), "action": stack("action"),
   348	        "waypoint": stack("waypoint"), "occ_structural": stack("occ_structural"),
   349	        "maneuver": stack("maneuver"), "cand_feats": cand, "cand_mask": cand_mask,
   350	        "target_idx": tgt, "visible": stack("visible"), "act_supervise": stack("act_supervise"),
   351	        "tid_valid": stack("tid_valid"),
   352	        "tiers": [b["tier"] for b in batch],
   353	        **({"target_px": stack("target_px")} if "target_px" in batch[0] else {}),
   354	        **({"target_central": stack("target_central")} if "target_central" in batch[0] else {}),
   355	        **({"target_colors": [b["target_color"] for b in batch],
   356	            "target_makes": [b["target_make"] for b in batch]} if "target_color" in batch[0] else {}),
   357	    }

