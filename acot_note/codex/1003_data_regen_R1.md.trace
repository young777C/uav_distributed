    59	class StudentRolloutEnv:
    60	    """Run one closed-loop episode driven by an injected policy (.reset()/.act())."""
    61	
    62	    def __init__(self, scene: SceneManager, world, *, policy, scorer,
    63	                 fps: int = 10, resolution=(512, 512), central_frac: float = 0.3,
    64	                 fov_deg: float = 90.0, expert_control: bool = False,
    65	                 predict_road: bool = False, road_oracle: bool = False,
    66	                 waypoint_offsets_s=(1, 2, 4, 6)):
