    39	# --------------------------- stage 1: cache ---------------------------
    40	def cache_features(cfg, out_path, device, episodes, stride):
    41	    b = cfg["backbone"]; img = cfg["image"]
    42	    dino = _load_dino("vit_small_patch14_dinov2.lvd142m", device)
    43	    feats = []; gid = []; ep_a = []; fr_a = []; tgt_a = []; cen_a = []; spl_a = []
    44	    for split_id, split in enumerate(["train", "val"]):
    45	        eps = _select_episodes(cfg, split)[:episodes]
    46	        for ei, ep in enumerate(eps):
    47	            with h5py.File(ep, "r") as f:
    48	                n = f["rgb"].shape[0]
    49	                tgt = np.stack([f["target/tx"][:], f["target/ty"][:], f["target/tz"][:]], -1)
    50	                cam = np.stack([f[f"state/cam_{k}"][:] for k in ["x", "y", "z", "pitch", "yaw"]], -1)
    51	                distr = f["distractors/positions"][:] if "distractors/positions" in f else None
    52	                for i in range(0, n - 1, stride):
    53	                    cands = build_cands(tgt[i], distr[i] if distr is not None else None, cam[i], img)
    54	                    if not cands:
    55	                        continue
    56	                    ff = _dino_feats(dino, np.asarray(f["rgb"][i]), cands, img["width"], img["height"], 224, 1.3, device)
    57	                    for k, c in enumerate(cands):
    58	                        feats.append(ff[k].astype(np.float32))
    59	                        gid.append(split_id * 10_000_000 + ei * 100 + (c.idx + 1))   # unique per (split,ep,vehicle)
    60	                        ep_a.append(ei); fr_a.append(i); tgt_a.append(int(c.is_target))
    61	                        cen_a.append(int(_is_central(c, img))); spl_a.append(split_id)
    62	            print(f"[cache] {split} ep{ei} {Path(ep).name}: total crops={len(feats)}", flush=True)
    63	    np.savez_compressed(out_path, feats=np.stack(feats), gid=np.array(gid, np.int64),
    64	                        ep=np.array(ep_a, np.int32), frame=np.array(fr_a, np.int32),
    65	                        is_target=np.array(tgt_a, np.int8), central=np.array(cen_a, np.int8),
    66	                        split=np.array(spl_a, np.int8))
    67	    print(f"[cache] wrote {out_path}: {len(feats)} crops, dim={feats[0].shape[0]}", flush=True)
    68	
