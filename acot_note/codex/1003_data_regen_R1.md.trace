   281	        tgt = np.array([b[1] for b in self._dagger_buf], np.int64)
   282	        col = np.array([b[2] for b in self._dagger_buf])
   283	        mk = np.array([b[3] for b in self._dagger_buf])
   284	        n = np.array([f.shape[0] for f in feats], np.int64)
   285	        out = os.path.join(self._dagger_dir, f"dagger_ep{self._dagger_ep:04d}.npz")
   286	        np.savez_compressed(out, feats=np.concatenate(feats, 0).astype(np.float16),
   287	                            n=n, true_idx=tgt, color=col, make=mk)
   288	        print(f"[dagger] wrote {out}  ({len(feats)} frames)", flush=True)
   289	        self._dagger_ep += 1
