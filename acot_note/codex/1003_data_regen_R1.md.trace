    97	# ----------------------------------------------------------------------------------------------- model
    98	class Grounder(nn.Module):
    99	    def __init__(self, model_id, device, rank, lora_lo, alpha):
   100	        super().__init__()
   101	        from transformers import AutoModelForImageTextToText, AutoProcessor
   102	        self.proc = AutoProcessor.from_pretrained(model_id)
   103	        self.vlm = AutoModelForImageTextToText.from_pretrained(model_id, dtype=torch.bfloat16).to(device)
   104	        lm = self.vlm.model.language_model
   105	        lm.layers = lm.layers[:READ_LAYER]                         # truncate: only layers 0..23 are needed
   106	        for p in self.vlm.parameters():
   107	            p.requires_grad_(False)
   108	        self._cap = {}
   109	        lm.layers[READ_LAYER - 1].register_forward_hook(lambda m, i, o: self._cap.__setitem__("h", o[0] if isinstance(o, tuple) else o))
   110	        self.rank = rank
   111	        if rank > 0:
   112	            from peft import LoraConfig, inject_adapter_in_model
   113	            tm = [f"model.language_model.layers.{l}.self_attn.{p}" for l in range(lora_lo, READ_LAYER)
   114	                  for p in ("q_proj", "k_proj", "v_proj", "o_proj")]
   115	            self.vlm = inject_adapter_in_model(LoraConfig(r=rank, lora_alpha=alpha, lora_dropout=0.05,
   116	                                                          target_modules=tm), self.vlm)
   117	            for n, p in self.vlm.named_parameters():
   118	                p.requires_grad_("lora_" in n)
   119	            self.vlm.gradient_checkpointing_enable(gradient_checkpointing_kwargs={"use_reentrant": False})
   120	            self.vlm.enable_input_require_grads()
   121	        C = self.vlm.config.text_config.hidden_size
   122	        self.ln_c, self.ln_t = nn.LayerNorm(C), nn.LayerNorm(C)
   123	        self.mlp = nn.Sequential(nn.Linear(C, 256), nn.GELU(), nn.Linear(256, 1))
   124	        self.pc, self.pt = nn.Linear(C, 128, bias=False), nn.Linear(C, 128, bias=False)
   125	        self.img_tok = self.vlm.config.image_token_id
   126	        self.device = device
   127	
   128	    def head_params(self):
   129	        return [p for m in (self.ln_c, self.ln_t, self.mlp, self.pc, self.pt) for p in m.parameters()]
   130	
   131	    def lora_params(self):
   132	        return [p for n, p in self.vlm.named_parameters() if p.requires_grad]
   133	
   134	    def forward(self, rgb, instruction, boxes):
   135	        msgs = [{"role": "user", "content": [{"type": "text", "text": instruction}, {"type": "image"}]}]
   136	        prompt = self.proc.apply_chat_template(msgs, tokenize=False, add_generation_prompt=True)
   137	        inp = self.proc(text=[prompt], images=[Image.fromarray(rgb)], return_tensors="pt").to(self.device)
   138	        with torch.autocast("cuda", dtype=torch.bfloat16), torch.set_grad_enabled(self.rank > 0 and self.training):
   139	            self.vlm.model(**inp)                                  # base model only (no LM head); hook grabs layer 23
   140	        h = self._cap["h"][0].float()                              # (S, C)
   141	        ids = inp["input_ids"][0]
   142	        img = (ids == self.img_tok).nonzero(as_tuple=True)[0]
   143	        thw = inp["image_grid_thw"][0].tolist(); m = self.vlm.config.vision_config.spatial_merge_size
   144	        gh, gw = thw[1] // m, thw[2] // m
   145	        grid = h[img][: gh * gw].reshape(gh, gw, -1)
   146	        txt = h[(ids != self.img_tok)].mean(0)
   147	        feats = []
   148	        for fu0, fv0, fu1, fv1 in boxes:                           # differentiable pool_box
   149	            c0 = int(math.floor(fu0 * gw)); c1 = max(c0 + 1, int(math.ceil(fu1 * gw)))
   150	            r0 = int(math.floor(fv0 * gh)); r1 = max(r0 + 1, int(math.ceil(fv1 * gh)))
   151	            c0, c1 = min(max(c0, 0), gw - 1), min(max(c1, 1), gw); r0, r1 = min(max(r0, 0), gh - 1), min(max(r1, 1), gh)
   152	            feats.append(grid[r0:r1, c0:c1].reshape(-1, grid.shape[-1]).mean(0))
   153	        c = self.ln_c(torch.stack(feats)); t = self.ln_t(txt)
   154	        return self.mlp(c).squeeze(-1) + (self.pc(c) * self.pt(t)[None]).sum(-1) / math.sqrt(128)
   155	
   156	
   157	# ----------------------------------------------------------------------------------------------- loop
   158	def sample(p, i, rng, lang_override=None):
   159	    with h5py.File(p, "r") as fh:
   160	        rgb = np.asarray(fh["rgb"][i]); c = candidates(fh, i); lang = str(fh.attrs["language"])
   161	    order = rng.permutation(len(c)); c = [c[o] for o in order]
   162	    y = next(k for k, x in enumerate(c) if x[1])
   163	    instr = neutralize_language(lang_override or lang)
   164	    return rgb, instr, [x[0] for x in c], y
   165	
