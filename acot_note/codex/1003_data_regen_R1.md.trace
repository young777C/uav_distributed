   969	    def _target_tm(self):
   970	        veh = getattr(self._target, "_vehicle", None) if self._target_type == "vehicle" else None
   971	        tm = getattr(self._maneuver_injector, "_tm", None) if self._maneuver_injector else None
   972	        return veh, tm
   973	
   974	    def force_target_evade(self, elapsed: float, duration: float) -> None:
   975	        """§11: at loss-window onset, force the target to TURN at the upcoming junctions
   976	        (set_route) so it leaves the UAV's forward view. A pure forward sprint does NOT work
   977	        (target just gets far & small while staying in the forward frame, and the gap becomes
   978	        un-re-acquirable); a TURN makes the target go off-frame while staying CLOSE, so the
   979	        intercepting UAV must cut across and can re-acquire → genuine long loss + intercept."""
   980	        veh, tm = self._target_tm()
   981	        if veh is None or tm is None:
   982	            return
   983	        try:
   984	            tm.set_route(veh, [random.choice(["Left", "Right"]) for _ in range(4)])
   985	            tm.set_desired_speed(veh, 16.0)   # moderate → stays close (re-acquirable), not sprint-away
   986	        except (RuntimeError, AttributeError):
   987	            pass
   988	
   989	    def sustain_target_evade(self, elapsed: float) -> None:
   990	        """§11: keep the target moving at a moderate speed through its forced turns for the
   991	        whole window (TM can otherwise reset it at a light), so it stays off the forward view
   992	        while the expert flies to INTERCEPT the true target."""
   993	        veh, tm = self._target_tm()
   994	        if veh is None or tm is None:
   995	            return
   996	        try:
   997	            tm.set_desired_speed(veh, 16.0)
   998	        except (RuntimeError, AttributeError):
   999	            pass
  1000	
  1001	    def restore_target_speed(self) -> None:
  1002	        """§11: at loss-window end, drop the target back to normal traffic speed so the
  1003	        intercepting UAV catches up and re-acquires."""
  1004	        veh, tm = self._target_tm()
  1005	        if veh is None or tm is None:
  1006	            return
  1007	        try:
  1008	            tm.set_desired_speed(veh, 9.0)
  1009	        except (RuntimeError, AttributeError):
  1010	            pass
  1011	
  1012	    def loss_window_offset(self, elapsed: float) -> bool:
  1013	        """True once when a loss window just ended (target re-appearing)."""
  1014	        sched = getattr(self, "_loss_scheduler", None)
  1015	        return bool(sched and sched.offset(elapsed))
  1016	
  1017	    def force_covisible_lookalikes(self, min_n: int = 2) -> None:
  1018	        """§11: at target re-appearance, GUARANTEE >=min_n similar look-alikes co-visible near
  1019	        the target, so re-acquisition must use LANGUAGE (not 'whichever car just appeared').
  1020	        Teleports off-screen/far similars to clear, on-road, IN-FRAME slots beside the target."""
  1021	        if self._target is None or self.drone is None:
  1022	            return
  1023	        try:
  1024	            cam_t = self.drone.get_camera_transform()
  1025	            tloc = self._target.transform.location
  1026	        except (RuntimeError, AttributeError):
  1027	            return
  1028	        tgt_wp = self._map.get_waypoint(tloc)
  1029	        if tgt_wp is None:
  1030	            return
  1031	        W, H = self._config.get("output", {}).get("rgb_resolution", [336, 336])
  1032	        _fov = float(self._config.get("output", {}).get("fov", 90.0))
  1033	        M = np.array(cam_t.get_inverse_matrix())
  1034	        focal = W / (2.0 * np.tan(np.radians(_fov) / 2.0))
  1035	
  1036	        def _visible(p) -> bool:
  1037	            q = M @ np.array([p[0], p[1], p[2], 1.0])
  1038	            if q[0] <= 0.1:
  1039	                return False
  1040	            u = focal * (q[1] / q[0]) + W / 2.0
  1041	            v = focal * (-q[2] / q[0]) + H / 2.0
  1042	            return 0 <= u < W and 0 <= v < H
  1043	
  1044	        tpos = np.array([tloc.x, tloc.y, tloc.z])
  1045	        on_screen, movable = 0, []
  1046	        for obj, meta in zip(self._distractors, self._distractor_meta):
  1047	            if not meta.get("similar"):
  1048	                continue
  1049	            try:
  1050	                p, _, _, _ = obj.get_state()
  1051	            except RuntimeError:
  1052	                continue
  1053	            if _visible(p):
  1054	                on_screen += 1
  1055	            else:
  1056	                movable.append(obj)
  1057	        need = max(0, min_n - on_screen)
  1058	        if need <= 0 or not movable:
  1059	            return
  1060	        lanes = [tgt_wp]
  1061	        for g in ("get_left_lane", "get_right_lane"):
  1062	            try:
  1063	                c = getattr(tgt_wp, g)()
  1064	            except RuntimeError:
  1065	                c = None
  1066	            if c is not None and c.lane_type == carla.LaneType.Driving and c.lane_id * tgt_wp.lane_id > 0:
  1067	                lanes.append(c)
  1068	        occupied = [tpos]
  1069	        try:
  1070	            for a in self._world.get_actors().filter("vehicle.*"):
  1071	                loc = a.get_location()
  1072	                if abs(loc.x - tloc.x) < 45 and abs(loc.y - tloc.y) < 45:
  1073	                    occupied.append(np.array([loc.x, loc.y, loc.z]))
  1074	        except RuntimeError:
  1075	            pass
  1076	        random.shuffle(movable)
  1077	        for obj in movable[:need]:
  1078	            actor = getattr(obj, "_vehicle", None)
  1079	            if actor is None:
  1080	                continue
  1081	            for _try in range(10):
  1082	                wp = random.choice(lanes)
  1083	                off = random.uniform(-12.0, 12.0)
  1084	                for _ in range(int(abs(off) / 8)):
  1085	                    nxt = wp.next(8.0) if off > 0 else wp.previous(8.0)
  1086	                    if not nxt:
  1087	                        break
  1088	                    wp = nxt[0]
  1089	                loc = wp.transform.location
  1090	                slot = np.array([loc.x, loc.y, loc.z])
  1091	                if _visible(slot) and all(np.linalg.norm(slot[:2] - o[:2]) > 6.0 for o in occupied):
  1092	                    try:
  1093	                        actor.set_transform(carla.Transform(
  1094	                            carla.Location(loc.x, loc.y, loc.z + 0.3), wp.transform.rotation))
  1095	                        actor.set_target_velocity(carla.Vector3D(0, 0, 0))
  1096	                        occupied.append(slot)
  1097	                    except RuntimeError:
  1098	                        pass
  1099	                    break
  1100	
  1101	    def step_drone(self, action: tuple[float, float, float, float]) -> None:
  1102	        assert self.drone is not None
  1103	        self.drone.step(*action)
  1104	
  1105	    def cleanup(self) -> None:
  1106	        self.drone = None
  1107	        if self._target is not None:
  1108	            try:
  1109	                self._target.destroy()
  1110	            except RuntimeError:
  1111	                pass
  1112	            self._target = None
  1113	        for d in self._distractors:
  1114	            try:
  1115	                d.destroy()
  1116	            except RuntimeError:
  1117	                pass
  1118	        for pw in self._ambient_walkers:
  1119	            try:
  1120	                pw.destroy()

codex
还有一个微妙但重要的分布点：录制时专家在目标可见时跟“目标+相似车簇中心”，目标丢出画后才切回真目标恢复；闭环则由策略承诺的单车世界坐标驱动。这说明新离线数据如果只“复刻旧 v5”，对 TAHRelM 的 WHICH 缓存还不够，必须显式补部署分布或重新收 DAgger。
exec
/bin/sh -lc "nl -ba train/dataset.py | sed -n '1,260p'" in /nvidia/hque/code/cyhe/uav-acot-track
exec
/bin/sh -lc "nl -ba train/dataset_stage2.py | sed -n '1,360p'" in /nvidia/hque/code/cyhe/uav-acot-track
 succeeded in 5ms:
     1	"""Stage-2 datasets.
     2	
     3	RealStage2Dataset  — reads episodes + a MULTI-LAYER VLM context cache
     4	                     (backbone_kv --layers ...) + labels.py-derived targets.
     5	SyntheticStage2Dataset — dependency-free, learnable mappings so the full Stage-2
     6	                     loss/train loop can be smoke-tested with no VLM/CARLA/GPU.
     7	
     8	Sample dict contract (both datasets + collate_stage2):
     9	  vlm_ctx_layers : list[L] of (M, C)     # per-layer context, for IAR
    10	  vlm_ctx        : (M, C)                 # single layer for EAR/DiT cross-attn
    11	  proprio        : (8,)
    12	  action         : (H, 5)                # expert action chunk GT
    13	  waypoint       : (K, 3)                # EAR waypoint GT
    14	  occ_structural : ()                    # IAR occlusion-head target (L_visibility)
    15	  maneuver       : ()                    # IAR maneuver-head target (L_maneuver)
    16	  cand_feats     : (N, Ccand)            # candidate box features (target + distractors)
    17	  target_idx     : int                   # which candidate is the referred target
    18	  visible        : ()                    # 1 = target genuinely observable (mask L_action)
    19	  tier           : 'a' | 'b' | 'c'
    20	"""
    21	
    22	from __future__ import annotations
    23	
    24	from pathlib import Path
    25	
    26	import numpy as np
    27	import torch
    28	from torch.utils.data import Dataset
    29	
    30	from acot_probe.projection import inverse_pose_matrix
    31	
    32	
    33	def _unit(x):
    34	    return (x / (x.std() + 1e-6)).astype(np.float32)
    35	
    36	
    37	class SyntheticStage2Dataset(Dataset):
    38	    def __init__(self, n=1024, L=4, M=16, C=48, H=16, K=3, N=5,
    39	                 proprio=8, seed=0, map_seed=42):
    40	        rng = np.random.default_rng(seed)
    41	        mrng = np.random.default_rng(map_seed)          # SHARED mapping across train/val
    42	        self.L, self.H, self.K, self.N, self.C = L, H, K, N, C
    43	        Wa = mrng.normal(0, 1, (C + proprio, H * 5)).astype(np.float32) / np.sqrt(C + proprio)
    44	        Ww = mrng.normal(0, 1, (C, K * 3)).astype(np.float32) / np.sqrt(C)
    45	        Wt = mrng.normal(0, 1, (C, C)).astype(np.float32) / np.sqrt(C)
    46	        wocc = mrng.normal(0, 1, C).astype(np.float32)
    47	        wman = mrng.normal(0, 1, C).astype(np.float32)
    48	        tiers = np.array(list("abc"))
    49	
    50	        # pass 1: raw targets (linear maps of context/proprio)
    51	        raw = []
    52	        for _ in range(n):
    53	            ctx = rng.normal(0, 1, (L, M, C)).astype(np.float32)
    54	            pooled = ctx.mean((0, 1))                    # (C,)
    55	            prop = rng.normal(0, 1, proprio).astype(np.float32)
    56	            a_raw = (np.concatenate([pooled, prop]) @ Wa).astype(np.float32)   # (H*5,)
    57	            w_raw = (pooled @ Ww).astype(np.float32)                            # (K*3,)
    58	            cand = rng.normal(0, 1, (N, C)).astype(np.float32)
    59	            tgt = int(rng.integers(N))
    60	            cand[tgt] = (Wt @ pooled) + 0.3 * rng.normal(0, 1, C).astype(np.float32)
    61	            occ = float(1 / (1 + np.exp(-(pooled @ wocc) / np.sqrt(C))))
    62	            man = float((pooled @ wman) > 0)
    63	            raw.append((ctx, prop, a_raw, w_raw, cand, tgt, occ, man, str(rng.choice(tiers))))
    64	        # pass 2: GLOBAL normalization (keeps the map linear -> learnable, cf. Stage-1)
    65	        A_all = np.stack([r[2] for r in raw]); A_all = A_all / (A_all.std() + 1e-6)
    66	        W_all = np.stack([r[3] for r in raw]); W_all = W_all / (W_all.std() + 1e-6)
    67	        self.samples = []
    68	        for i, (ctx, prop, _, _, cand, tgt, occ, man, tier) in enumerate(raw):
    69	            self.samples.append({
    70	                "vlm_ctx_layers": [torch.from_numpy(ctx[l]) for l in range(L)],
    71	                "vlm_ctx": torch.from_numpy(ctx[-1]),
    72	                "proprio": torch.from_numpy(prop),
    73	                "action": torch.from_numpy(A_all[i].reshape(H, 5).astype(np.float32)),
    74	                "waypoint": torch.from_numpy(W_all[i].reshape(K, 3).astype(np.float32)),
    75	                "occ_structural": torch.tensor(occ, dtype=torch.float32),
    76	                "maneuver": torch.tensor(man, dtype=torch.float32),
    77	                "cand_feats": torch.from_numpy(cand),
    78	                "target_idx": tgt,
    79	                "visible": torch.tensor(1.0),
    80	                "act_supervise": torch.tensor(1.0),
    81	                "tid_valid": torch.tensor(1.0),
    82	                "tier": tier,
    83	            })
    84	
    85	    def __len__(self):
    86	        return len(self.samples)
    87	
    88	    def __getitem__(self, i):
    89	        return self.samples[i]
    90	
    91	
    92	class RealStage2Dataset(Dataset):
    93	    """Reads episodes + a MULTI-LAYER context cache (backbone_kv --layers ...) and
    94	    labels.py-derived targets. Candidate features are pooled from the cached grid at
    95	    each vehicle's projected box. Requires the Stage-2 context cache to exist."""
    96	
    97	    def __init__(self, cfg, split="train"):
    98	        from .dataset import _select_episodes
    99	        from . import curriculum
   100	        self.cfg = cfg
   101	        self.ctx_dir = Path(cfg["data"]["stage2_context_cache"])
   102	        # If the ctx cache was regenerated with more layers than a target ckpt used,
   103	        # this restricts IAR to the LAST layer (layer 24) so n_layers_in==1 — matches
   104	        # stage2_v5 (1-layer) for controlled ablations against a 5-layer cache.
   105	        self.last_layer_only = bool(cfg["data"].get("use_last_layer_only", False))
   106	        self.H = cfg["action"]["horizon"]
   107	        fps = cfg.get("fps", 10)
   108	        self.offsets = [int(o * fps) for o in cfg["waypoint"].get("offsets_s", [2, 4, 6])]
   109	        self.K = len(self.offsets)
   110	        self.wp_scale = cfg["waypoint"]["scale"]
   111	        self.a_scale = cfg["action"].get("scale", 5.0)
   112	        self.cam_frame = cfg["waypoint"].get("camera_frame", False)  # align with Stage-1 EAR
   113	        # §3.2 mask reversal: supervise action on temporary-loss frames where the target
   114	        # reappears within the EAR horizon (expert demonstrates intercept, not blind-follow).
   115	        self.supervise_intercept = bool(cfg["train"].get("supervise_intercept", False)) \
   116	            if "train" in cfg else False
   117	        self.intercept_hz = int(cfg["waypoint"].get("max_horizon_s", 6) * fps)
   118	        self.img = cfg["image"]
   119	        self._tier_of = curriculum.tier_of
   120	        self._zc = {}          # multi-layer ctx npz cache (path -> (frames, grid, ctx))
   121	        self._hc = {}          # h5 field cache (ep -> dict of arrays)
   122	        self.index = self._build_index(_select_episodes(cfg, split), cfg)
   123	        self.cond_dim = self._peek()
   124	
   125	    # h5 datasets _h5/_candidates read unconditionally; an episode missing any is
   126	    # skipped (some CARLA runs write partial episodes, e.g. mvp_full ep011 lacked
   127	    # annotation/*, mvp_full_v3 ep066 lacked search_mode+off_screen -> KeyError mid-train).
   128	    _REQUIRED_H5 = (
   129	        "target/tx", "target/ty", "target/tz",
   130	        "state/cam_x", "state/cam_y", "state/cam_z", "state/cam_pitch", "state/cam_yaw",
   131	        "state/uav_vx", "state/uav_vy", "state/uav_vz",
   132	        "action/dx", "action/dy", "action/dz", "action/dyaw",
   133	        "annotation/search_mode", "annotation/off_screen",
   134	    )
   135	
   136	    def _build_index(self, eps, cfg):
   137	        import h5py
   138	        stride = int(cfg["data"].get("frame_stride", 3))
   139	        cap = int(cfg["data"].get("max_frames_per_episode", 200))
   140	        horizon = int(cfg["waypoint"].get("max_horizon_s", 6) * cfg.get("fps", 10))
   141	        idx = []
   142	        for ep in eps:
   143	            ctx = self.ctx_dir / (Path(ep).stem + ".npz")
   144	            if not ctx.exists():
   145	                continue
   146	            with h5py.File(ep, "r") as f:
   147	                miss = [k for k in self._REQUIRED_H5 if k not in f]
   148	                if miss:
   149	                    print(f"[stage2] skip {Path(ep).name}: missing {miss}")
   150	                    continue
   151	                n = f["rgb"].shape[0]
   152	                a = f.attrs
   153	                tier = self._tier_of(str(a.get("strategy", "")), int(a.get("num_similar", 0)))
   154	            valid = n - horizon
   155	            for i in list(range(0, max(0, valid), stride))[:cap]:
   156	                idx.append((ep, str(ctx), i, tier))
   157	        return idx
   158	
   159	    def _peek(self):
   160	        if not self.index:
   161	            return self.cfg["model"].get("cond_dim", 2048)
   162	        return int(self._ctx(self.index[0][1])[2].shape[-1])   # works for mmap & fat-npz
   163	
   164	    def __len__(self):
   165	        return len(self.index)
   166	
   167	    def _ctx(self, path):                          # meta from npz; big ctx via mmap (shared)
   168	        z = self._zc.get(path)
   169	        if z is None:
   170	            d = np.load(path)
   171	            frames = np.asarray(d["frames"]); grid = tuple(int(x) for x in d["grid"])
   172	            ctx_npy = Path(path).with_name(Path(path).stem + ".ctx.npy")
   173	            if ctx_npy.exists():
   174	                ctx = np.load(ctx_npy, mmap_mode="r")      # memmap -> OS page cache, shared
   175	            else:
   176	                ctx = np.asarray(d["ctx"], dtype=np.float32)  # fallback: old fat-npz format
   177	            z = (frames, grid, ctx)
   178	            self._zc[path] = z
   179	        return z
   180	
   181	    def _h5(self, ep):                             # h5 field arrays, read ONCE
   182	        d = self._hc.get(ep)
   183	        if d is None:
   184	            import h5py
   185	            from . import labels
   186	            with h5py.File(ep, "r") as f:
   187	                g = lambda k: np.asarray(f[k][:], np.float32)
   188	                d = {
   189	                    "tgt": np.stack([g("target/tx"), g("target/ty"), g("target/tz")], -1),
   190	                    "cam": np.stack([g("state/cam_x"), g("state/cam_y"), g("state/cam_z"),
   191	                                     g("state/cam_pitch"), g("state/cam_yaw")], -1),
   192	                    "vel": np.stack([g("state/uav_vx"), g("state/uav_vy"), g("state/uav_vz")], -1),
   193	                    "act": np.stack([g("action/dx"), g("action/dy"), g("action/dz"), g("action/dyaw")], -1),
   194	                    "sm": g("annotation/search_mode"),
   195	                    "occ_s": g("annotation/occ_structural") if "annotation/occ_structural" in f else None,
   196	                    "man": g("state/maneuver") if "state/maneuver" in f else None,
   197	                    # target observable = low occlusion AND on-screen. off_screen must be
   198	                    # included: combined_occlusion only reaches ~0.5-0.7 during full out-of-frame
   199	                    # (misses it at the 0.8 thresh), so long out-of-frame losses were wrongly
   200	                    # marked visible -> skipped. Fixes long-loss frames reaching intercept training.
   201	                    "vis": ((labels.combined_occlusion(f) < 0.8) &
   202	                            (f["annotation/off_screen"][:] < 0.5
   203	                             if "annotation/off_screen" in f else True)).astype(np.float32),
   204	                    "distr": g("distractors/positions") if "distractors/positions" in f else None,
   205	                    # target language identity (color+make) — for the language-binding head
   206	                    "tcolor": str(f.attrs.get("target_color", "?")),
   207	                    "tmake": str(f.attrs.get("target_bp", "?")),
   208	                }
   209	            self._hc[ep] = d
   210	        return d
   211	
   212	    def _candidates(self, h, i):                   # target + in-frame distractor boxes (L_target_id)
   213	        import math
   214	        from acot_probe.projection import project_point, Candidate
   215	        img = self.img; W, H, fov = img["width"], img["height"], img["fov_deg"]
   216	        cam = tuple(h["cam"][i]); f = W / (2.0 * math.tan(math.radians(fov) / 2.0))
   217	        def mk(xyz, is_t, idx):
   218	            pr = project_point(xyz, cam, W, H, fov)
   219	            if pr is None:
   220	                return None
   221	            u, v, depth = pr
   222	            if not (0 <= u < W and 0 <= v < H):
   223	                return None
   224	            s = float(np.clip(f * img.get("vehicle_size_m", 4.0) / max(depth, 0.1),
   225	                              img.get("box_min_px", 10), img.get("box_max_px", 140)))
   226	            return Candidate(u, v, s, s, depth, is_t, idx)
   227	        t = mk(h["tgt"][i], True, -1)
   228	        out = [t] if t is not None else []          # target may be off-screen (absent)
   229	        if h["distr"] is not None:
   230	            for d in range(h["distr"].shape[1]):
   231	                c = mk(h["distr"][i, d, :3], False, d)
   232	                if c is not None:
   233	                    out.append(c)
   234	        return out                                   # may lack target (all is_target=False) or be empty
   235	
   236	    def __getitem__(self, j):
   237	        from acot_probe.backbones import pool_box
   238	        ep, ctx_path, i, tier = self.index[j]
   239	        frames, (gh, gw), ctx_all = self._ctx(ctx_path)
   240	        row = min(int(np.searchsorted(frames, i)), len(frames) - 1)
   241	        ctx = np.ascontiguousarray(ctx_all[row]).astype(np.float32)   # (L, gh*gw, C); fp16 cache -> fp32 for model
   242	        if self.last_layer_only:
   243	            ctx = ctx[-1:]                                            # keep only layer 24 (last) -> L=1
   244	        L, _, C = ctx.shape
   245	        layers = [torch.from_numpy(ctx[l]) for l in range(L)]
   246	        grid_last = ctx[-1].reshape(gh, gw, C)
   247	        h = self._h5(ep); n = len(h["tgt"])
   248	        W, H = self.img["width"], self.img["height"]
   249	        # action chunk: [dx,dy,dz,dyaw]/scale + search_mode
   250	        action = np.concatenate([h["act"][i:i + self.H], h["sm"][i:i + self.H][:, None]], -1).astype(np.float32)
