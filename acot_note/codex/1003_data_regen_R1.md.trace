     1	#!/bin/bash
     2	# Resilient batch runner: keeps a CARLA server alive AND resumes generate_batch
     3	# past any episode that crashes the client, until N episodes are attempted.
     4	#
     5	# Usage (inside the cyh-carla container):
     6	#   bash scripts/run_resilient.sh <config> <output_dir> <N> [seed] [max_gb] [port] [gpu]
     7	set -u
     8	CFG="$1"; OUT="$2"; N="$3"; SEED="${4:-42}"; MAXGB="${5:-60}"
     9	PORT="${6:-2000}"; GPU="${7:-0}"
    10	mkdir -p "$OUT"
    11	
    12	port_up() {
    13	    python -c "import socket,sys;s=socket.socket();s.settimeout(1);\
    14	sys.exit(0 if s.connect_ex(('127.0.0.1',$PORT))==0 else 1)" 2>/dev/null
    15	}
    16	
    17	ensure_server() {
    18	    if port_up; then return 0; fi
    19	    echo "  [server] port $PORT down — launching CARLA (gpu $GPU, Epic)..."
    20	    # -graphicsadapter selects the Vulkan render GPU. CARLA 0.9.15 renders via
    21	    # Vulkan, which IGNORES CUDA_VISIBLE_DEVICES — without -graphicsadapter it
    22	    # always renders on physical GPU0 (the training GPU). Pin it to $GPU.
    23	    (cd "${CARLA_ROOT:-/home/carla}" && CUDA_VISIBLE_DEVICES="$GPU" nohup \
    24	        ./CarlaUE4.sh -RenderOffScreen -carla-rpc-port="$PORT" -quality-level=Epic \
    25	        -nosound -graphicsadapter="$GPU" \
    26	        >/tmp/carla_server_${PORT}.log 2>&1 &)
    27	    for _ in $(seq 1 45); do
    28	        if port_up; then echo "  [server] up on $PORT"; sleep 2; return 0; fi
    29	        sleep 4
    30	    done
    31	    echo "  [server] FAILED to come up on $PORT"; return 1
    32	}
    33	
    34	for attempt in $(seq 1 200); do
    35	    start=0
    36	    if [ -f "$OUT/.attempted" ]; then start=$(( $(cat "$OUT/.attempted") + 1 )); fi
    37	    remaining=$(( N - start ))
    38	    if [ "$remaining" -le 0 ]; then
    39	        echo "=== all $N episodes attempted; done ==="
    40	        break
    41	    fi
    42	    ensure_server || { echo "cannot start server; aborting"; exit 1; }
    43	    echo "=== attempt $attempt: start-id=$start remaining=$remaining ==="
    44	    python scripts/generate_batch.py \
    45	        --num-episodes "$remaining" --start-id "$start" \
    46	        --config "$CFG" --output "$OUT" --seed "$SEED" --port "$PORT" --max-size-gb "$MAXGB"
    47	    code=$?
    48	    if [ "$code" = 0 ]; then
