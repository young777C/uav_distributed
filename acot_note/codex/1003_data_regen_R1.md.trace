     1	"""Occlusion detection via raycast from target to UAV."""
     2	
     3	from __future__ import annotations
     4	
     5	import math
     6	
     7	import carla
     8	import numpy as np
     9	
    10	
    11	class OcclusionDetector:
    12	    """Raycast-based occlusion detection between target and UAV.
    13	
    14	    Projects target bounding box corners as ray origins toward the UAV camera.
    15	    If ≥ threshold fraction of rays are blocked → target is occluded.
    16	
    17	    Usage:
    18	        detector = OcclusionDetector(world, num_rays=8, threshold=0.5)
    19	        is_occluded, level = detector.check(target_actor, uav_position)
    20	    """
    21	
    22	    def __init__(
    23	        self,
    24	        world: carla.World,
    25	        num_rays: int = 8,
    26	        hit_threshold: float = 0.5,
    27	    ):
    28	        self._world = world
    29	        self._num_rays = num_rays
    30	        self._hit_threshold = hit_threshold
    31	
    32	    def check(
    33	        self,
    34	        target_actor: carla.Actor,
    35	        uav_camera_position: np.ndarray,
    36	    ) -> tuple[bool, float]:
    37	        """Check if target is occluded from UAV camera.
    38	
    39	        Args:
    40	            target_actor: The CARLA vehicle/walker actor
    41	            uav_camera_position: [x, y, z] of UAV camera in world coords
    42	
    43	        Returns:
    44	            (is_occluded: bool, occlusion_level: float [0, 1])
    45	            occlusion_level = fraction of rays blocked
    46	        """
    47	        bbox = target_actor.bounding_box
    48	        target_transform = target_actor.get_transform()
    49	
    50	        # Get bbox corner positions in world coordinates
    51	        corners = self._get_bbox_corners(bbox, target_transform)
    52	
    53	        # Cast rays from corners toward UAV
    54	        uav_loc = carla.Location(
    55	            x=uav_camera_position[0],
    56	            y=uav_camera_position[1],
    57	            z=uav_camera_position[2],
    58	        )
    59	
    60	        blocked = 0
    61	        for corner in corners:
    62	            c = carla.Location(x=float(corner[0]), y=float(corner[1]), z=float(corner[2]))
    63	            d_cam = c.distance(uav_loc)
    64	            # cast_ray returns a LIST of labelled points where the ray crosses geometry;
    65	            # a corner is blocked if something lies strictly between it and the camera
    66	            # (2 m buffers skip the target's own body and the camera end).
    67	            for h in self._world.cast_ray(c, uav_loc):
    68	                if 2.0 < c.distance(h.location) < d_cam - 2.0:
    69	                    blocked += 1
    70	                    break
    71	
    72	        level = blocked / max(len(corners), 1)
    73	        return level >= self._hit_threshold, level
    74	
    75	    @staticmethod
    76	    def _get_bbox_corners(
    77	        bbox: carla.BoundingBox,
    78	        transform: carla.Transform,
    79	        num_samples: int = 8,
    80	    ) -> list[np.ndarray]:
    81	        """Sample points on the bounding box surface in world coordinates.
    82	
    83	        Uses 8 corners + edge midpoints for better coverage.
    84	        """
    85	        ext = bbox.extent
    86	        loc = transform.location
    87	        rot = transform.rotation
    88	
    89	        # Local-space corners
    90	        lx, ly, lz = ext.x, ext.y, ext.z
    91	        local_corners = [
    92	            np.array([+lx, +ly, +lz]),
    93	            np.array([+lx, +ly, -lz]),
    94	            np.array([+lx, -ly, +lz]),
    95	            np.array([+lx, -ly, -lz]),
    96	            np.array([-lx, +ly, +lz]),
    97	            np.array([-lx, +ly, -lz]),
    98	            np.array([-lx, -ly, +lz]),
    99	            np.array([-lx, -ly, -lz]),
   100	        ]
   101	
   102	        # Rotate to world frame
   103	        yaw_rad = math.radians(rot.yaw)
   104	        cos_y = math.cos(yaw_rad)
   105	        sin_y = math.sin(yaw_rad)
   106	        # Simplified 2D rotation (UAV scenario: pitch/roll ≈ 0)
   107	        world_corners = []
   108	        for lc in local_corners[:num_samples]:
   109	            wx = loc.x + lc[0] * cos_y - lc[1] * sin_y
   110	            wy = loc.y + lc[0] * sin_y + lc[1] * cos_y
   111	            wz = loc.z + lc[2]
   112	            world_corners.append(np.array([wx, wy, wz]))
   113	
   114	        return world_corners

