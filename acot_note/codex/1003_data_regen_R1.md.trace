   571	                self._ambient_walkers.append(PedestrianTarget(
   572	                    self._world, random.choice(wbps), carla.Transform(loc),
   573	                    walk_speed=random.uniform(1.2, 2.2), snap_to_road=False,
   574	                    role_name="ambient_walker"))
   575	            except RuntimeError:
