 succeeded in 0ms:
     1	"""Scenario-conditioned advantage — ZERO new rollouts, reuses per-episode conditional buckets in eval_out.
     2	
     3	Each episode logs mis_follow conditioned on scene buckets:
     4	  mis_by_N       (× n_dist)    — # of in-frame distractors (2 / 3 / 5): look-alike DENSITY
     5	  mis_by_central (× c_dist)    — target central vs OFF-center: OFF is the deployment-hard regime
     6	  mis_by_depth   (× d_dist)    — target range bucket
     7	Plus per-episode reacquire_* (loss→re-acq events) → split episodes by re-acquisition LOAD.
     8	
     9	We frame-weight-aggregate track_correct (=1−mis) per bucket per arm on the common paired seeds, to find the
    10	scenario where the learned module (TAH+DAgger) wins on MULTIPLE metrics — honestly, not by cherry-pick:
    11	we report ALL buckets, and read where each method leads.
    12	
    13	Usage: scenario_split.py  (arms hard-wired to the paper lineup)
    14	"""
    15	import json
    16	import os
    17	import numpy as np
    18	
    19	ROOT = os.path.join(os.path.dirname(__file__), "eval_out")
    20	ARMS = [
    21	    ("l5",        "paper_l5_dino_conf_tavg"),
    22	    ("borrow#1",  "paper_ext_reidmotion03"),
    23	    ("DeepSORT",  "paper_ext_assoc_deepsort"),
    24	    ("DAM4SAM",   "paper_ext_dam4sam"),
    25	    ("TAH+DAgger", "paper_ext_tahdag_gt"),
    26	    ("TAHRelM+DAg", "paper_ext_tahrelm_gt"),
    27	]
    28	
    29	
    30	def load(stem):
    31	    p = os.path.join(ROOT, stem + ".json")
    32	    if not os.path.exists(p):
    33	        return None                                    # arm not yet run (e.g. A1 pending) → skipped
    34	    d = json.load(open(p))
    35	    return {int(e["episode_seed"]): e for e in d["episodes"] if "mis_by_N" in e}
    36	
    37	
    38	def wmean_bucket(eps, seeds, mis_key, cnt_key, bucket):
    39	    """frame-weighted track_correct (=1-mis) in `bucket` across seeds."""
    40	    num = den = 0.0
    41	    for s in seeds:
    42	        e = eps[s]
    43	        c = e[cnt_key].get(bucket, 0)
    44	        if c and bucket in e[mis_key]:
    45	            num += (1.0 - e[mis_key][bucket]) * c
    46	            den += c
    47	    return (num / den) if den else float("nan"), den
    48	
    49	
    50	def main():
    51	    loaded = [(lab, load(stem)) for lab, stem in ARMS]
    52	    loaded = [(lab, e) for lab, e in loaded if e]      # drop arms whose json isn't present yet
    53	    common = sorted(set.intersection(*[set(e) for _, e in loaded]))
    54	    print(f"paired seeds n={len(common)}  arms={[l for l,_ in loaded]}\n")
    55	
    56	    # ---- 1) look-alike density (mis_by_N) ----
    57	    print("== track_correct by distractor density (frames) ==")
    58	    Ns = ["2", "3", "5"]
    59	    hdr = f"{'arm':<12}" + "".join(f"{'N='+n:>10}" for n in Ns)
    60	    print(hdr); print("-"*len(hdr))
    61	    for lab, eps in loaded:
    62	        row = f"{lab:<12}"
    63	        for n in Ns:
    64	            v, _ = wmean_bucket(eps, common, "mis_by_N", "n_dist", n)
    65	            row += f"{v:>10.3f}" if not np.isnan(v) else f"{'-':>10}"
    66	        print(row)
    67	    # frame counts (context)
    68	    ctx = {n: int(sum(loaded[0][1][s]["n_dist"].get(n, 0) for s in common)) for n in Ns}
    69	    print(f"  [frames: N=2:{ctx['2']}  N=3:{ctx['3']}  N=5:{ctx['5']}]")
    70	
    71	    # ---- 2) central vs OFF-center (deployment-hard) ----
    72	    print("\n== track_correct by target framing (central vs OFF-center = deployment-hard) ==")
    73	    hdr = f"{'arm':<12}{'central':>12}{'OFF-center':>12}"
    74	    print(hdr); print("-"*len(hdr))
    75	    for lab, eps in loaded:
    76	        vc, _ = wmean_bucket(eps, common, "mis_by_central", "c_dist", "central")
    77	        vo, _ = wmean_bucket(eps, common, "mis_by_central", "c_dist", "off")
    78	        print(f"{lab:<12}{vc:>12.3f}{vo:>12.3f}")
    79	
    80	    # ---- 3) episodes split by re-acquisition LOAD (loss→reacq events) ----
    81	    print("\n== re-acquisition scenario (episodes with reacquire_attempts >= 3) ==")
    82	    base = loaded[0][1]
    83	    hi = [s for s in common if base[s].get("reacquire_attempts", 0) >= 3]
    84	    lo = [s for s in common if base[s].get("reacquire_attempts", 0) < 3]
    85	    print(f"  hi-reacq seeds (n={len(hi)}): {hi}")
    86	    print(f"  lo-reacq seeds (n={len(lo)}): {lo}")
    87	    for tag, sub in [("HI-reacq", hi), ("LO-reacq", lo)]:
    88	        if not sub:
    89	            continue
    90	        print(f"\n  [{tag}] arm: track_correct / max_wrong_mean_s / latch@4s / q_reacq")
    91	        for lab, eps in loaded:
    92	            tc = np.mean([1 - eps[s]["mis_follow_inst"] for s in sub])
    93	            mw = np.mean([eps[s]["max_wrong_run_s"] for s in sub])
    94	            l4 = np.mean([1.0 if eps[s]["max_wrong_run_s"] < 4 else 0.0 for s in sub])
    95	            att = np.array([eps[s]["reacquire_attempts"] for s in sub], float)
    96	            qs = np.array([eps[s]["reacquire_success_rate"] for s in sub])
    97	            q = float((qs*att).sum()/att.sum()) if att.sum() > 0 else float("nan")
    98	            print(f"    {lab:<12} {tc:>6.3f}  {mw:>6.2f}  {l4:>6.3f}  {q:>6.3f}")
    99	
   100	
   101	if __name__ == "__main__":
   102	    main()

