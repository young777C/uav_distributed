     1	"""Datasets for Stage-1 EAR warmup.
     2	
     3	RealEARDataset  — reads episode H5 (waypoint GT + UAV pose) + a precomputed VLM
     4	                  context cache (per-episode .npz from backbone_kv.precompute).
     5	SyntheticEARDataset — dependency-free; a LEARNABLE cond->waypoint mapping so the
     6	                  Stage-1 loop can be smoke-tested with no VLM / no CARLA data.
     7	
     8	Waypoint GT (`annotation/waypoints`, shape (T,9) -> (T,3,3) = [+2s,+4s,+6s]×xyz) is
     9	world-frame; we predict it RELATIVE to the current UAV position and /scale so the
    10	target is translation-invariant and O(1).
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import glob
    16	from pathlib import Path
    17	
    18	import numpy as np
    19	import torch
    20	from torch.utils.data import Dataset
    21	
    22	from acot_probe.projection import inverse_pose_matrix
    23	
    24	
    25	def _select_episodes(cfg, split):
    26	    """Episodes for a split. Prefer the A2 manifest; else fall back to a naive slice."""
    27	    import json
    28	    all_eps = sorted(glob.glob(cfg["data"]["episodes_glob"]))
    29	    manifest_path = cfg["data"].get("split_manifest")
    30	    if manifest_path and Path(manifest_path).exists():
    31	        man = json.loads(Path(manifest_path).read_text())
    32	        names = set(man.get(split, []))
    33	        return [e for e in all_eps if Path(e).name in names]
    34	    # fallback (no manifest): naive episode slice, train/val only
    35	    vf = cfg["data"].get("val_frac", 0.15)
    36	    n_val = max(1, int(len(all_eps) * vf))
    37	    if split == "test":
    38	        return []
    39	    return all_eps[n_val:] if split == "train" else all_eps[:n_val]
    40	
    41	
    42	class RealEARDataset(Dataset):
    43	    def __init__(self, cfg, split="train"):
    44	        self.cfg = cfg
    45	        self.scale = cfg["waypoint"].get("scale", 50.0)
    46	        fps = cfg.get("fps", 10)
    47	        self.offsets = [int(o * fps) for o in cfg["waypoint"].get("offsets_s", [2, 4, 6])]
    48	        self.k = len(self.offsets)
    49	        self.rel = cfg["waypoint"].get("relative_to_uav", True)
    50	        self.cam_frame = cfg["waypoint"].get("camera_frame", False)  # predict in camera frame
    51	        self.ctx_dir = Path(cfg["data"]["context_cache"])
    52	        self._zc = {}          # ctx npz cache (path -> (frames, ctx)); load each file ONCE
    53	        self._hc = {}          # h5 field cache (ep -> (waypoints, uav_xyz, occ)); read ONCE
    54	        eps = _select_episodes(cfg, split)
    55	        self.index = self._build_index(eps, cfg)
    56	        self.cond_dim = self._peek_cond_dim()
    57	
    58	    def _build_index(self, eps, cfg):
    59	        import h5py
    60	        stride = int(cfg["data"].get("frame_stride", 3))
    61	        cap = int(cfg["data"].get("max_frames_per_episode", 200))
    62	        # Drop each episode's last `horizon` frames: their +6s waypoint GT is clamped
    63	        # to the final frame (degenerate) — see postprocess._compute_waypoints. Also
    64	        # drops episodes too short to yield any valid-horizon frame.
    65	        horizon = int(cfg["waypoint"].get("max_horizon_s", 6) * cfg.get("fps", 10))
    66	        idx = []
    67	        for ep in eps:
    68	            ctx = self.ctx_dir / (Path(ep).stem + ".npz")
    69	            if not ctx.exists():
    70	                continue
    71	            with h5py.File(ep, "r") as f:
    72	                n = f["rgb"].shape[0]
    73	            valid_n = n - horizon
    74	            if valid_n <= 0:
    75	                continue
    76	            for i in list(range(0, valid_n, stride))[:cap]:
    77	                idx.append((ep, str(ctx), i))
    78	        return idx
    79	
    80	    def _peek_cond_dim(self):
    81	        if not self.index:
    82	            return self.cfg["ear"].get("cond_dim", 2048)
    83	        z = np.load(self.index[0][1])
    84	        return int(z["ctx"].shape[-1])
    85	
    86	    def __len__(self):
    87	        return len(self.index)
    88	
    89	    def _ctx(self, path):
    90	        z = self._zc.get(path)
    91	        if z is None:
    92	            d = np.load(path)
    93	            z = (np.asarray(d["frames"]), np.asarray(d["ctx"], dtype=np.float32))
    94	            self._zc[path] = z
    95	        return z
    96	
    97	    def _h5(self, ep):
    98	        h = self._hc.get(ep)
    99	        if h is None:
   100	            import h5py
   101	            with h5py.File(ep, "r") as f:
   102	                occ = np.asarray(f["annotation/occlusion"][:], np.float32) \
   103	                    if "annotation/occlusion" in f else None
   104	                tgt = np.stack([f["target/tx"][:], f["target/ty"][:],
   105	                                f["target/tz"][:]], -1).astype(np.float32)
   106	                uav = np.stack([f["state/uav_x"][:], f["state/uav_y"][:],
   107	                                f["state/uav_z"][:]], -1).astype(np.float32)
   108	                cam = np.stack([f["state/cam_x"][:], f["state/cam_y"][:], f["state/cam_z"][:],
   109	                                f["state/cam_pitch"][:], f["state/cam_yaw"][:]], -1).astype(np.float32)
   110	                vel = np.stack([f["state/uav_vx"][:], f["state/uav_vy"][:],
   111	                                f["state/uav_vz"][:]], -1).astype(np.float32)
   112	                h = (tgt, uav, cam, vel, occ)   # waypoints computed on-the-fly at self.offsets
   113	            self._hc[ep] = h
   114	        return h
   115	
   116	    def __getitem__(self, j):
   117	        # in-memory caches: each ctx npz / h5 file is read ONCE, then indexed (was
   118	        # reloading the whole npz + reopening h5 per sample -> GPU-starved training).
   119	        ep, ctx_path, i = self.index[j]
   120	        frames, ctx = self._ctx(ctx_path)
   121	        row = min(int(np.searchsorted(frames, i)), len(frames) - 1)
   122	        cond = torch.from_numpy(ctx[row])                       # (M, C)
   123	        tgt, uav_all, cam, vel, occ = self._h5(ep)
   124	        n = len(tgt)
   125	        fut = np.stack([tgt[min(i + off, n - 1)] for off in self.offsets])  # (K,3) future target world
   126	        if self.cam_frame:
   127	            # transform future target into the CURRENT camera frame (fwd, right, up) ->
   128	            # removes UAV-yaw ambiguity of a world-frame target (root cause #1)
   129	            M = inverse_pose_matrix(*cam[i])                    # world -> camera-local (4x4)
   130	            homog = np.concatenate([fut, np.ones((self.k, 1), np.float32)], -1)
   131	            wp = (homog @ M.T)[:, :3].astype(np.float32)
   132	        else:
   133	            wp = fut - uav_all[i][None, :]
   134	        wp = (wp / self.scale).astype(np.float32)
   135	        # proprio: altitude + camera pitch (depth via ground plane) + velocity (motion)
   136	        proprio = np.array([cam[i][2] / 30.0, cam[i][3] / 90.0,
   137	                            vel[i][0] / 15.0, vel[i][1] / 15.0, vel[i][2] / 15.0], np.float32)
   138	        vis = float(occ[i] < 0.8) if occ is not None else 1.0
   139	        mask = torch.ones(cond.shape[0], dtype=torch.bool)
   140	        return {"cond": cond, "cond_mask": mask, "wp": torch.from_numpy(wp),
   141	                "proprio": torch.from_numpy(proprio), "vis": torch.tensor(vis)}
   142	
   143	
   144	class SyntheticEARDataset(Dataset):
   145	    """cond ~ N(0,1) (M,C); wp = pooled(cond) @ W + b + noise -> learnable by EAR."""
   146	
   147	    def __init__(self, n=512, m=16, c=64, k=3, seed=0, map_seed=42):
   148	        rng = np.random.default_rng(seed)
   149	        self.k = k
   150	        self.cond_dim = c
   151	        self._cond = rng.normal(0, 1, (n, m, c)).astype(np.float32)
   152	        # SHARED mapping across train/val (fixed map_seed) — like the real physics;
   153	        # train/val differ only in sampled cond, not in the cond->waypoint function.
   154	        W = np.random.default_rng(map_seed).normal(0, 1, (c, k * 3)).astype(np.float32) / np.sqrt(c)
   155	        pooled = self._cond.mean(1)                              # (n, c)
   156	        wp = pooled @ W
   157	        wp = wp / (wp.std() + 1e-6)                              # unit-scale (like real /scale)
   158	        wp = wp + 0.03 * rng.normal(0, 1, (n, k * 3)).astype(np.float32)
   159	        self._wp = wp.reshape(n, k, 3).astype(np.float32)
   160	
   161	    def __len__(self):
   162	        return len(self._cond)
   163	
   164	    def __getitem__(self, j):
   165	        cond = torch.from_numpy(self._cond[j])
   166	        return {"cond": cond, "cond_mask": torch.ones(cond.shape[0], dtype=torch.bool),
   167	                "wp": torch.from_numpy(self._wp[j]), "proprio": torch.zeros(5),
   168	                "vis": torch.tensor(1.0)}
   169	
   170	
   171	def collate(batch):
   172	    """Pad variable-length cond token sets to the batch max M."""
   173	    M = max(b["cond"].shape[0] for b in batch)
   174	    C = batch[0]["cond"].shape[1]
   175	    cond = torch.zeros(len(batch), M, C)
   176	    mask = torch.zeros(len(batch), M, dtype=torch.bool)
   177	    for i, b in enumerate(batch):
   178	        m = b["cond"].shape[0]
   179	        cond[i, :m] = b["cond"]
   180	        mask[i, :m] = b["cond_mask"]
   181	    wp = torch.stack([b["wp"] for b in batch])
   182	    vis = torch.stack([b["vis"] for b in batch])
   183	    proprio = torch.stack([b["proprio"] for b in batch])
   184	    return {"cond": cond, "cond_mask": mask, "wp": wp, "proprio": proprio, "vis": vis}

