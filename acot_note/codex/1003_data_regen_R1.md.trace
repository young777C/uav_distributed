    74	
    75	    # ------------------------------------------------------------------ stats
    76	    def _lang_z(self, aidx, lang):
    77	        if lang is None or len(lang) == 0:
    78	            return np.zeros(len(aidx))
    79	        l = np.asarray(lang, np.float64)
    80	        z = (l - l.mean()) / (l.std() + 1e-6) if len(l) > 1 else np.zeros_like(l)
    81	        for a, v in zip(aidx, z):
    82	            p = self.lang_score.get(int(a), float(v))
    83	            self.lang_score[int(a)] = self.lema * p + (1 - self.lema) * float(v)
    84	        return np.array([self.lang_score[int(a)] for a in aidx])
    85	
    86	    def stats(self, feats, aidx, mem_slot, lang):
    87	        zl = self._lang_z(aidx, lang)
