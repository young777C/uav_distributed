   167	@torch.no_grad()
   168	def evaluate(model, idx, seen_desc, swap_pool=None, max_n=None, seed=0):
   169	    model.eval(); rng = np.random.default_rng(seed); res = {"all": [], "lookalike": [], "unseen": [], "chance": []}
   170	    sel = idx if max_n is None else [idx[j] for j in np.random.default_rng(1).choice(len(idx), min(max_n, len(idx)), replace=False)]
   171	    for p, i, look in sel:
   172	        override = None
   173	        if swap_pool is not None:                                  # language-swap control
   174	            d0 = desc(p)[0]; cand = [l for d, l in swap_pool if d != d0]; override = cand[rng.integers(len(cand))]
   175	        rgb, instr, boxes, y = sample(p, i, rng, override)
   176	        ok = int(model(rgb, instr, boxes).argmax().item() == y)
   177	        res["all"].append(ok); res["chance"].append(1.0 / len(boxes))
   178	        if look:
   179	            res["lookalike"].append(ok)
   180	        if desc(p)[0] not in seen_desc:
   181	            res["unseen"].append(ok)
   182	    model.train()
   183	    return {k: (float(np.mean(v)) if v else None, len(v)) for k, v in res.items()}
   184	
   185	
   186	def main():
   187	    ap = argparse.ArgumentParser()
   188	    ap.add_argument("--rank", type=int, default=16)
   189	    ap.add_argument("--lora-lo", type=int, default=16, help="first (0-based) layer with LoRA; through layer 23")
   190	    ap.add_argument("--alpha", type=int, default=32)
   191	    ap.add_argument("--stride", type=int, default=6)
   192	    ap.add_argument("--eval-stride", type=int, default=9)
   193	    ap.add_argument("--epochs", type=int, default=3)
   194	    ap.add_argument("--accum", type=int, default=8)
   195	    ap.add_argument("--lr-lora", type=float, default=1e-4)
   196	    ap.add_argument("--lr-head", type=float, default=1e-3)
   197	    ap.add_argument("--eval-max", type=int, default=1500)
   198	    ap.add_argument("--max-train", type=int, default=0, help="subsample train frames (smoke test)")
   199	    ap.add_argument("--out", required=True)
   200	    ap.add_argument("--device", default="cuda:0")
   201	    a = ap.parse_args()
   202	    os.makedirs(a.out, exist_ok=True)
   203	    log = open(os.path.join(a.out, "log.txt"), "a")
   204	
   205	    def say(*s):
   206	        msg = f"[{time.strftime('%H:%M:%S')}] " + " ".join(str(x) for x in s)
   207	        print(msg, flush=True); log.write(msg + "\n"); log.flush()
   208	
   209	    torch.manual_seed(0); random.seed(0)
   210	    S = split_eps()
   211	    seen = set(desc(p)[0] for p in S["train"])
   212	    swap_pool = [desc(p) for p in S["val"] + S["test"]]
   213	    tr, va, te = build_index(S["train"], a.stride), build_index(S["val"], a.eval_stride), build_index(S["test"], a.eval_stride)
   214	    if a.max_train:
   215	        tr = [tr[j] for j in np.random.default_rng(0).choice(len(tr), min(a.max_train, len(tr)), replace=False)]
   216	    say(f"rank={a.rank} lora_layers={a.lora_lo}-23 | train frames {len(tr)} ({len(S['train'])} eps) | val {len(va)} | test {len(te)}")
   217	    model = Grounder("Qwen/Qwen3-VL-4B-Instruct", a.device, a.rank, a.lora_lo, a.alpha)
   218	    model.ln_c.to(a.device); [m.to(a.device) for m in (model.ln_t, model.mlp, model.pc, model.pt)]
   219	    groups = [{"params": model.head_params(), "lr": a.lr_head}]
   220	    if a.rank > 0:
   221	        groups.append({"params": model.lora_params(), "lr": a.lr_lora})
   222	    say("trainable params: head", sum(p.numel() for p in model.head_params()),
   223	        "lora", sum(p.numel() for p in model.lora_params()) if a.rank > 0 else 0)
   224	    opt = torch.optim.AdamW(groups, weight_decay=1e-2)
   225	    total = a.epochs * len(tr) // a.accum; step = 0
   226	    sched = torch.optim.lr_scheduler.LambdaLR(opt, lambda s: min(1.0, (s + 1) / 50) * 0.5 * (1 + math.cos(math.pi * min(s, total) / total)))
   227	    rng = np.random.default_rng(0); best = -1
   228	    for ep in range(a.epochs):
   229	        order = rng.permutation(len(tr)); run_loss = run_acc = 0.0; n = 0; t0 = time.time()
   230	        for k, j in enumerate(order):
   231	            p, i, _ = tr[j]
   232	            rgb, instr, boxes, y = sample(p, i, rng)
   233	            logit = model(rgb, instr, boxes)
   234	            loss = F.cross_entropy(logit[None], torch.tensor([y], device=a.device)) / a.accum
   235	            loss.backward(); run_loss += loss.item() * a.accum; run_acc += float(logit.argmax().item() == y); n += 1
   236	            if (k + 1) % a.accum == 0:
