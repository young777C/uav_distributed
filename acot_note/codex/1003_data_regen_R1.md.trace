    22	class TestHDF5Format:
    23	    """Verify HDF5 output format matches training pipeline expectations."""
    24	
    25	    def test_minimal_format(self):
    26	        """Create a minimal valid HDF5 file and verify structure."""
    27	        with tempfile.TemporaryDirectory() as tmpdir:
    28	            path = Path(tmpdir) / "test_episode.h5"
    29	
    30	            n_steps = 100
    31	            H, W = 224, 224
    32	
    33	            with h5py.File(path, "w") as f:
    34	                # RGB frames
    35	                f.create_dataset("rgb", data=np.random.randint(0, 255, (n_steps, H, W, 3),
    36	                                                               dtype=np.uint8))
    37	
    38	                # State
    39	                sg = f.create_group("state")
    40	                for key in ["t", "uav_x", "uav_y", "uav_z", "uav_vx", "uav_vy",
    41	                             "uav_vz", "uav_yaw", "uav_energy"]:
    42	                    sg.create_dataset(key, data=np.random.randn(n_steps).astype(np.float32))
    43	
    44	                # Actions
    45	                ag = f.create_group("action")
    46	                for key in ["dx", "dy", "dz", "dyaw"]:
    47	                    ag.create_dataset(key, data=np.random.randn(n_steps).astype(np.float32))
    48	
    49	                # Target
    50	                tg = f.create_group("target")
    51	                for key in ["tx", "ty", "tz", "tvx", "tvy", "tvz", "tspeed", "tyaw"]:
    52	                    tg.create_dataset(key, data=np.random.randn(n_steps).astype(np.float32))
    53	
    54	                # Annotations
    55	                ann = f.create_group("annotation")
    56	                for key in ["bbox_u", "bbox_v", "bbox_w", "bbox_h",
    57	                             "occlusion", "search_mode"]:
    58	                    ann.create_dataset(key, data=np.random.randn(n_steps).astype(np.float32))
    59	                ann.create_dataset("waypoints", data=np.random.randn(n_steps, 9).astype(np.float32))
    60	                ann.create_dataset("waypoint_sigma", data=np.random.randn(n_steps, 3).astype(np.float32))
    61	
    62	            # Re-read and validate
