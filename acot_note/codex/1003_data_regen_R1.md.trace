   166	            self._reacq_attempts += 1
   167	        if self._reacq_open:
   168	            if (not self._reacq_wrong_counted and target_present
   169	                    and self._committed is not None and self._committed != "target"):
   170	                self._reacq_wrong += 1                  # locked a wrong car while recovering (once/attempt)
   171	                self._reacq_wrong_counted = True
   172	            if (not lost_now) and target_present and self._committed == "target":
   173	                self._reacq_success += 1                # correctly re-acquired the TRUE target
   174	                self._reacq_conv.append(step - self._reacq_start)
   175	                self._reacq_open = False                # attempt resolved
   176	        self._was_lost = lost_now
   177	
   178	    def should_truncate(self) -> bool:
   179	        return self._off_run >= self.max_lost
   180	
   181	    # ------------------------------------------------------------------
   182	    def finalize(self) -> dict:
   183	        present = max(self._present, 1)
   184	        att = self._reacq_attempts
   185	        conv = self._reacq_conv
   186	        success = (not self._failed) and (self._off_run < self.max_lost)
   187	        return {
   188	            "success": bool(success),
   189	            "mis_follow_inst": self._inst_wrong / present,
   190	            "mis_follow_sustained": self._sustain_wrong / present,
   191	            "id_switches": self._id_switches,
   192	            "track_frames": self._present,
   193	            "track_seconds": self._present / self.fps,
   194	            "centering_rate": self._central / present,
   195	            "max_wrong_run_s": self._max_wrong_run / self.fps,
   196	            "max_correct_run_s": self._max_correct_run / self.fps,   # longest continuous correct lock (committed)
   197	            "mean_uav_target_dist": (self._dist_sum / self._dist_n) if self._dist_n else None,
   198	            # re-acquisition (guide §7): each target-loss = one attempt (deliberate loss
   199	            # window OR model-caused loss). success = re-locked TRUE target; the no-WM
   200	            # baseline's failure modes are timeout (never re-acquired) + lock-wrong.
   201	            "reacquire_attempts": att,
   202	            "reacquire_success_rate": (self._reacq_success / att) if att else None,
   203	            "reacquire_timeout_rate": ((att - self._reacq_success) / att) if att else None,
   204	            "reacquire_lock_wrong_rate": (self._reacq_wrong / att) if att else None,
   205	            "reacquire_convergence_s_mean": (float(np.mean(conv)) / self.fps) if conv else None,
   206	            # shortcut checks (§7): high ⇒ a shortcut survived, re-harden data (§2.3)
   207	            "shortcut_nearest_rate": (self._nearest_pred / self._nearest_denom) if self._nearest_denom else None,
   208	            "shortcut_target_central_rate": self._central_target / present,
   209	            # per-frame grounding stratifiers (online-vs-offline diagnosis)
   210	            "mis_by_N": {k: v[0] / v[1] for k, v in self._byN.items() if v[1]},
   211	            "n_dist": {k: v[1] for k, v in self._byN.items()},
   212	            "mis_by_central": {k: (v[0] / v[1] if v[1] else None) for k, v in self._byC.items()},
   213	            "c_dist": {k: v[1] for k, v in self._byC.items()},
   214	            "mis_by_depth": {k: v[0] / v[1] for k, v in self._byD.items() if v[1]},
   215	            "d_dist": {k: v[1] for k, v in self._byD.items()},
   216	            "steps": self.n,
   217	        }

