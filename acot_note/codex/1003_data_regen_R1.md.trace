     1	"""Post-processing: compute occlusion levels, 2D bboxes, EAR waypoint GT, and search_mode labels.
     2	
     3	Run after raw data collection to add training annotations.
     4	"""
     5	
     6	from __future__ import annotations
     7	
     8	import json
     9	import math
    10	from pathlib import Path
    11	from typing import Any
    12	
    13	import h5py
    14	import numpy as np
    15	from scipy.ndimage import uniform_filter1d
    16	
    17	# ---------------------------------------------------------------------------
    18	# Correct offline projection (ported verbatim from acot_probe/projection.py so the
    19	# training labels match the layer-16 grounding probe). Uses the per-frame camera
    20	# pose stored by the recorder (state/cam_*) incl. pitch & yaw, and the real image
    21	# size — replaces the old buggy 224-hardcoded / yaw-only projection.
    22	# ---------------------------------------------------------------------------
    23	_FOV_DEG = 90.0
    24	_VEHICLE_SIZE_M = 4.0        # pseudo-box scale (data stores 3D centres only)
    25	_BOX_MIN_PX = 8.0
    26	_BOX_MAX_PX = 140.0
    27	
    28	
    29	def _carla_matrix(x, y, z, pitch, yaw, roll=0.0) -> np.ndarray:
    30	    """CARLA Transform.get_matrix() (local->world), angles in DEGREES."""
    31	    p, yw, r = math.radians(pitch), math.radians(yaw), math.radians(roll)
    32	    cp, sp = math.cos(p), math.sin(p)
    33	    cy, sy = math.cos(yw), math.sin(yw)
    34	    cr, sr = math.cos(r), math.sin(r)
    35	    m = np.eye(4, dtype=np.float64)
    36	    m[0, 0] = cp * cy; m[0, 1] = cy * sp * sr - sy * cr; m[0, 2] = -cy * sp * cr - sy * sr; m[0, 3] = x
    37	    m[1, 0] = cp * sy; m[1, 1] = sy * sp * sr + cy * cr; m[1, 2] = -sy * sp * cr + cy * sr; m[1, 3] = y
    38	    m[2, 0] = sp;      m[2, 1] = -cp * sr;               m[2, 2] = cp * cr;                 m[2, 3] = z
    39	    return m
    40	
    41	
    42	def _project(world_xyz, campose, W, H, fov=_FOV_DEG):
    43	    """Project a world point with campose=(x,y,z,pitch,yaw). Returns (u,v,depth) in
    44	    pixels, or None if behind the camera."""
    45	    M = np.linalg.inv(_carla_matrix(*campose))
    46	    q = M @ np.array([world_xyz[0], world_xyz[1], world_xyz[2], 1.0])
    47	    depth = q[0]
    48	    if depth <= 0.1:
    49	        return None
    50	    f = W / (2.0 * math.tan(math.radians(fov) / 2.0))
    51	    return f * (q[1] / depth) + W / 2.0, f * (-q[2] / depth) + H / 2.0, depth
    52	
    53	
    54	def _pseudo_box(depth, W, fov=_FOV_DEG) -> float:
    55	    f = W / (2.0 * math.tan(math.radians(fov) / 2.0))
    56	    return float(np.clip(f * _VEHICLE_SIZE_M / max(depth, 0.1), _BOX_MIN_PX, _BOX_MAX_PX))
    57	
    58	
    59	# Threshold on structural occlusion above which the target counts as "not usefully
    60	# visible" (majority of target→camera rays blocked) → mask the ACTION imitation loss.
    61	_OCCLUDED_THRESH = 0.5
    62	
    63	
    64	def compute_occlusion_labels(bbox_u, bbox_v, bbox_w, occ_raycast, W, H,
    65	                             occluded_thresh: float = _OCCLUDED_THRESH):
    66	    """Split occlusion into THREE non-overlapping signals (A1c ②), so the IAR
    67	    occlusion head learns structural occlusion and NOT "out of frame":
    68	
    69	      occ_structural [0,1] : target IS in frame but hidden by geometry
    70	                             (occ_raycast gated to in-frame). 0 when off-screen.
    71	      off_screen     {0,1} : target is behind the camera OR projected outside the
    72	                             image — a DISTINCT signal (drives search/re-acquisition).
    73	      occluded       {0,1} : "target not usefully visible" mask =
    74	                             (occ_structural >= thresh) OR off_screen. Use it to MASK
    75	                             the action imitation loss (expert used privileged GT the
    76	                             policy can't see); the EAR waypoint loss stays UNmasked so
    77	                             the model still learns to predict the re-emergence point.
    78	
    79	    All inputs/outputs are 1-D arrays of length n; outputs are float32 (0/1 or [0,1]).
    80	    """
    81	    bbox_u = np.asarray(bbox_u, dtype=np.float32)
    82	    bbox_v = np.asarray(bbox_v, dtype=np.float32)
    83	    bbox_w = np.asarray(bbox_w, dtype=np.float32)
    84	    behind = bbox_w == 0.0                                   # (-1,-1,0,0) sentinel
    85	    in_frame = (bbox_u >= 0) & (bbox_u < W) & (bbox_v >= 0) & (bbox_v < H) & ~behind
    86	    off_screen = (~in_frame).astype(np.float32)              # behind OR outside frame
    87	    ray = (np.asarray(occ_raycast, dtype=np.float32)
    88	           if occ_raycast is not None else np.zeros_like(bbox_u))
    89	    occ_structural = np.where(in_frame, ray, 0.0).astype(np.float32)
    90	    occluded = ((occ_structural >= occluded_thresh) | (off_screen > 0)).astype(np.float32)
    91	    return occ_structural, off_screen, occluded
    92	
    93	
    94	class PostProcessor:
    95	    """Add training annotations to raw recording data."""
    96	
    97	    def __init__(self, output_dir: Path, fov: float = _FOV_DEG):
    98	        self._output_dir = Path(output_dir)
    99	        # §10: the sensor FOV was narrowed 90→70; bbox/off_screen projection MUST use the
   100	        # SAME fov as the camera (else off_screen under-reports — the target leaves the real
   101	        # 70° frame but a 90° projection still counts it in-frame). Caller passes output.fov.
   102	        self._fov = float(fov)
   103	
   104	    def process_episode(self, episode_path: Path) -> None:
   105	        """Add annotations to one episode HDF5 file."""
   106	        with h5py.File(episode_path, "r+") as f:
   107	            n_steps = f["rgb"].shape[0]
   108	
   109	            # 1. Correct-projection 2D bboxes: TARGET + ALL DISTRACTORS
   110	            bboxes = self._compute_bboxes(f, n_steps, self._fov)               # (n, 4)
   111	            dbboxes = self._compute_distractor_bboxes(f, n_steps, self._fov)   # (n, D, 4)
   112	
   113	            # 2. Occlusion (from the correct target bbox)
   114	            occlusions = self._compute_occlusions(f, n_steps, bboxes)
   115	
   116	            # 2b. Separated occlusion labels (A1c ②): structural (in-frame, hidden by
   117	            #     geometry) vs off-screen vs the "occluded" action-loss mask.
   118	            H, W = int(f["rgb"].shape[1]), int(f["rgb"].shape[2])
   119	            ray = (f["state/occ_raycast"][:n_steps].astype(np.float32)
   120	                   if "state/occ_raycast" in f else None)
   121	            occ_struct, off_screen, occluded = compute_occlusion_labels(
   122	                bboxes[:, 0], bboxes[:, 1], bboxes[:, 2], ray, W, H)
   123	
   124	            # 3. Compute EAR waypoint ground truth (unchanged — no recompute needed)
   125	            waypoints, wp_sigmas = self._compute_waypoints(f, n_steps)
   126	
   127	            # 4. Compute search_mode ground truth (from corrected occlusion)
   128	            search_modes = self._compute_search_modes(occlusions, n_steps)
   129	
   130	            # Write annotations
   131	            self._write_dataset(f, "annotation/bbox_u", bboxes[:, 0])
   132	            self._write_dataset(f, "annotation/bbox_v", bboxes[:, 1])
   133	            self._write_dataset(f, "annotation/bbox_w", bboxes[:, 2])
   134	            self._write_dataset(f, "annotation/bbox_h", bboxes[:, 3])
   135	            self._write_dataset(f, "annotation/occlusion", occlusions)
   136	            # A1c ② — separated, non-overlapping occlusion signals.
   137	            self._write_dataset(f, "annotation/occ_structural", occ_struct)
   138	            self._write_dataset(f, "annotation/off_screen", off_screen)
   139	            self._write_dataset(f, "annotation/occluded", occluded)
   140	            self._write_dataset(f, "annotation/search_mode", search_modes)
   141	            # Distractor 2D bboxes (n, D, 4) [u,v,w,h] for Stage-2 target-ID loss.
   142	            self._write_dataset(f, "distractors/bbox", dbboxes)
   143	
   144	            # Waypoints: shape (n_steps, 3, 3) → (n_steps, 9)
   145	            wp_flat = waypoints.reshape(n_steps, -1)
   146	            self._write_dataset(f, "annotation/waypoints", wp_flat)
   147	            self._write_dataset(f, "annotation/waypoint_sigma", wp_sigmas)
   148	
   149	            # Finalize the language with the target's ACTUAL early motion (accurate
   150	            # "about to turn left / stop / accelerate"), derived from the trajectory.
   151	            self._finalize_language(f, n_steps)
   152	
   153	    # ------------------------------------------------------------------
   154	    # Annotation computation
   155	    # ------------------------------------------------------------------
   156	
   157	    @staticmethod
   158	    def _campose(f, i):
   159	        return (float(f["state/cam_x"][i]), float(f["state/cam_y"][i]),
   160	                float(f["state/cam_z"][i]), float(f["state/cam_pitch"][i]),
   161	                float(f["state/cam_yaw"][i]))
   162	
   163	    @staticmethod
   164	    def _compute_bboxes(f: h5py.File, n: int, fov: float = _FOV_DEG) -> np.ndarray:
   165	        """TARGET 2D pseudo-bbox [u, v, w, h] (px) via the CORRECT projection (real
   166	        camera pose incl. pitch/yaw + actual W,H + sensor fov). [-1,-1,0,0] if behind."""
   167	        H, W = int(f["rgb"].shape[1]), int(f["rgb"].shape[2])
   168	        tx, ty, tz = f["target/tx"][:], f["target/ty"][:], f["target/tz"][:]
   169	        out = np.zeros((n, 4), dtype=np.float32)
   170	        for i in range(n):
   171	            pr = _project((tx[i], ty[i], tz[i]), PostProcessor._campose(f, i), W, H, fov)
   172	            if pr is None:
   173	                out[i] = (-1, -1, 0, 0)
   174	                continue
   175	            u, v, depth = pr
   176	            s = _pseudo_box(depth, W, fov)
   177	            out[i] = (u, v, s, s)
   178	        return out
   179	
   180	    @staticmethod
   181	    def _compute_distractor_bboxes(f: h5py.File, n: int, fov: float = _FOV_DEG) -> np.ndarray:
   182	        """ALL distractors' 2D pseudo-bbox → (n, D, 4) [u,v,w,h] (px) for Stage-2
   183	        L_target_id. [-1,-1,0,0] where a distractor is behind the camera."""
   184	        if "distractors/positions" not in f:
   185	            return np.zeros((n, 0, 4), dtype=np.float32)
   186	        H, W = int(f["rgb"].shape[1]), int(f["rgb"].shape[2])
   187	        dpos = f["distractors/positions"][:, :, :3]      # (n, D, 3)
   188	        D = dpos.shape[1]
   189	        out = np.zeros((n, D, 4), dtype=np.float32)
   190	        out[..., 0:2] = -1.0
   191	        for i in range(n):
   192	            cp = PostProcessor._campose(f, i)
   193	            for d in range(D):
   194	                pr = _project((dpos[i, d, 0], dpos[i, d, 1], dpos[i, d, 2]), cp, W, H, fov)
   195	                if pr is None:
   196	                    continue
   197	                u, v, depth = pr
   198	                s = _pseudo_box(depth, W, fov)
   199	                out[i, d] = (u, v, s, s)
   200	        return out
   201	
   202	    @staticmethod
   203	    def _compute_occlusions(f: h5py.File, n: int, bboxes: np.ndarray) -> np.ndarray:
   204	        """Occlusion in [0,1], combining:
   205	          - view geometry from the correct bbox: 1.0 behind camera (w==0), 0.5 in-front
   206	            but out-of-frame, 0.0 in-frame; and
   207	          - STRUCTURAL occlusion (state/occ_raycast): graded fraction of target→camera
   208	            rays blocked by buildings/tunnel roof while the target is still in frame
   209	            (A1b — the label §6.2/§6.4/H2 need). Absent on pre-A1b data → geometry only.
   210	        """
   211	        H, W = int(f["rgb"].shape[1]), int(f["rgb"].shape[2])
   212	        u, v, w = bboxes[:, 0], bboxes[:, 1], bboxes[:, 2]
   213	        behind = w == 0.0                       # (-1,-1,0,0) sentinel
   214	        in_frame = (u >= 0) & (u < W) & (v >= 0) & (v < H) & ~behind
   215	        occ = np.zeros(n, dtype=np.float32)
   216	        occ[behind] = 1.0
   217	        occ[~in_frame & ~behind] = 0.5
   218	        if "state/occ_raycast" in f:
   219	            occ = np.maximum(occ, f["state/occ_raycast"][:n].astype(np.float32))
   220	        return occ
   221	
   222	    @staticmethod
   223	    def _compute_waypoints(f: h5py.File, n: int) -> tuple[np.ndarray, np.ndarray]:
   224	        """Compute EAR waypoint ground truth: future target positions at +2s, +4s, +6s.
   225	
   226	        Returns:
   227	            waypoints: (n, 3, 3) → [t+2s, t+4s, t+6s] × [x, y, z]
   228	            sigmas: (n, 3) → uncertainty per waypoint
   229	        """
   230	        fps = 10
   231	        offsets = [2 * fps, 4 * fps, 6 * fps]  # 20, 40, 60 steps
   232	
   233	        waypoints = np.zeros((n, 3, 3), dtype=np.float32)
   234	        sigmas = np.zeros((n, 3), dtype=np.float32)
   235	
   236	        for i in range(n):
   237	            for j, offset in enumerate(offsets):
   238	                future_idx = min(i + offset, n - 1)
   239	                tx = f["target/tx"][future_idx]
   240	                ty = f["target/ty"][future_idx]
   241	                tz = f["target/tz"][future_idx]
   242	
   243	                # Add Kalman-style smoothing
   244	                if i > 0 and future_idx < n - 1:
   245	                    window = f["target/tx"][i:future_idx+1]
   246	                    tx = float(np.mean(window))
   247	                    window = f["target/ty"][i:future_idx+1]
   248	                    ty = float(np.mean(window))
   249	                    window = f["target/tz"][i:future_idx+1]
   250	                    tz = float(np.mean(window))
   251	
   252	                waypoints[i, j] = [tx, ty, tz]
   253	                # Uncertainty grows with prediction horizon
   254	                sigmas[i, j] = 1.0 + 2.0 * (j + 1)
   255	
   256	        return waypoints, sigmas
   257	
   258	    @staticmethod
   259	    def _compute_search_modes(occlusions: np.ndarray, n: int) -> np.ndarray:
   260	        """Compute search_mode ground truth from occlusion level + time-since-lost.
   261	
   262	        search_mode ∈ [0, 1]:
   263	          0 = precise tracking (target fully visible)
   264	          1 = wide-area search (target lost for long duration)
   265	        """
   266	        search_modes = np.zeros(n, dtype=np.float32)
   267	        time_since_lost = 0.0
   268	
   269	        for i in range(n):
   270	            if occlusions[i] > 0.8:
   271	                time_since_lost += 0.1  # dt = 0.1s
   272	            else:
   273	                time_since_lost = max(0.0, time_since_lost - 0.2)  # decay
   274	
   275	            search_modes[i] = float(np.clip(
   276	                occlusions[i] * (1.0 + time_since_lost / 5.0), 0.0, 1.0
   277	            ))
   278	
   279	        return search_modes
   280	
   281	    @staticmethod
   282	    def _detect_maneuvers(f: h5py.File, n: int) -> list[dict]:
   283	        """Detect maneuver events from target velocity/acceleration changes."""
   284	        events = []
   285	        tspeed = f["target/tspeed"][:]
   286	        tyaw = f["target/tyaw"][:]
   287	
   288	        for i in range(1, n - 1):
   289	            accel = tspeed[i] - tspeed[i - 1]
   290	            yaw_change = abs(tyaw[i] - tyaw[i - 1])
   291	
   292	            if accel > 3.0:
   293	                events.append({"t": i * 0.1, "type": "ACCELERATION", "mag": float(accel)})
   294	            elif accel < -5.0:  # stronger threshold for braking
   295	                events.append({"t": i * 0.1, "type": "SUDDEN_STOP", "mag": float(accel)})
   296	            elif yaw_change > 15.0:  # deg/s
   297	                events.append({"t": i * 0.1, "type": "SHARP_TURN", "mag": float(yaw_change)})
   298	
   299	        return events
   300	
   301	    # ------------------------------------------------------------------
   302	    # Helpers
   303	    # ------------------------------------------------------------------
   304	
   305	    @staticmethod
   306	    def _finalize_language(f, n: int) -> None:
   307	        """Rewrite attrs['language'] using the target's actual early trajectory so the
   308	        motion clause ('about to turn left', 'about to stop', ...) is accurate."""
   309	        import random as _r
   310	        from scene.language_generator import (
   311	            LanguageGenerator, spatial_and_distance, motion_phrase)
   312	        a = f.attrs
   313	        desc = a.get("target_desc", "")
   314	        if not desc:
   315	            return
   316	        num_similar = int(a.get("num_similar", 0))
   317	        w = min(50, n - 1)                          # ~5s @ 10Hz
   318	        start = 10 if w > 15 else 0                 # skip spawn-alignment jitter
   319	        try:
   320	            motion = motion_phrase(f["target/tyaw"][start:w + 1],
   321	                                   f["target/tspeed"][start:w + 1])
   322	        except Exception:
   323	            motion = ""
   324	        try:
   325	            spatial, dist_m = spatial_and_distance(
   326	                float(f["state/uav_x"][0]), float(f["state/uav_y"][0]),
   327	                float(f["state/uav_yaw"][0]),
   328	                float(f["target/tx"][0]), float(f["target/ty"][0]),
   329	                uz=float(f["state/uav_z"][0]), tz=float(f["target/tz"][0]))
   330	        except Exception:
   331	            spatial, dist_m = "", None
   332	        seed_str = str(a.get("seed", "0"))
   333	        seed = int(seed_str) if seed_str.lstrip("-").isdigit() else 0
   334	        a["language"] = LanguageGenerator().build_instruction(
   335	            desc, num_similar, spatial=spatial, motion=motion,
   336	            distance_m=dist_m, rng=_r.Random(seed))
   337	
   338	    @staticmethod
   339	    def _write_dataset(f: h5py.File, name: str, data: np.ndarray) -> None:
   340	        if name in f:
   341	            del f[name]
   342	        f.create_dataset(name, data=data.astype(np.float32), compression="gzip",
   343	                         compression_opts=4)

