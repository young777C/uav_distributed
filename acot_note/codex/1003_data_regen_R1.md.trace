   275	    def _dagger_flush(self):
   276	        """Write the finished episode's collected frames to DAGGER_DIR (one .npz/episode)."""
   277	        if not self._dagger_dir or not getattr(self, "_dagger_buf", None):
   278	            return
   279	        os.makedirs(self._dagger_dir, exist_ok=True)
