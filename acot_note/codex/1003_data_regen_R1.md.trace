   618	    def _spawn_uav(self, uav_cfg: dict) -> None:
   619	        start = uav_cfg.get("start", {})
   620	        t = self._target.transform
   621	        target_loc = t.location
   622	        target_yaw_rad = np.radians(t.rotation.yaw)
   623	
   624	        # Oblique episodes need more standoff so the camera's shallower depression aims
   625	        # at the target (depression = atan(alt/behind) ≈ |pitch|); else it drops off-screen.
   626	        if getattr(self, "_camera_oblique", False):
   627	            ob = self._config.get("camera", {}).get("oblique", {})
   628	            behind_dist = random.uniform(*ob.get("behind_range", [22, 30]))
   629	        else:
   630	            behind_dist = random.uniform(*start.get("distance_range", [12, 22]))
   631	        lateral_offset = random.uniform(*start.get("lateral_offset_range", [6, 14]))
   632	        lateral_side = random.choice([-1, 1])
   633	        alt = random.uniform(*self._tier_alt)   # tier-controlled tracking altitude
   634	
   635	        fwd_x, fwd_y = np.cos(target_yaw_rad), np.sin(target_yaw_rad)
   636	        right_x, right_y = -fwd_y, fwd_x
   637	        uav_loc = carla.Location(
   638	            x=target_loc.x - fwd_x * behind_dist + right_x * lateral_offset * lateral_side,
   639	            y=target_loc.y - fwd_y * behind_dist + right_y * lateral_offset * lateral_side,
   640	            z=target_loc.z + alt,
   641	        )
   642	        look_yaw = np.degrees(np.arctan2(target_loc.y - uav_loc.y, target_loc.x - uav_loc.x))
   643	        uav_transform = carla.Transform(uav_loc, carla.Rotation(pitch=-10, yaw=look_yaw, roll=0))
   644	        self.drone = KinematicDrone(self._world, uav_transform,
   645	                                    camera_pitch=getattr(self, "_camera_pitch", -50.0))
   646	
   647	    def _distance_category(self) -> str:
   648	        """Map the UAV↔target horizontal standoff to close / suitable / long, so the
   649	        language distance constraint matches the actual tracking distance."""
   650	        try:
   651	            u = self.drone.transform.location
   652	            t = self._target.transform.location
   653	            d = ((u.x - t.x) ** 2 + (u.y - t.y) ** 2) ** 0.5
   654	        except (RuntimeError, AttributeError):
   655	            return "suitable"
   656	        if d <= 16.0:
   657	            return "close"
   658	        if d <= 26.0:
   659	            return "suitable"
   660	        return "long"
