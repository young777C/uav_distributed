   127	    # Save batch summary
   128	    summary_path = output_dir / "batch_summary.json"
   129	    with open(summary_path, "w") as f:
   130	        json.dump(summaries, f, indent=2)
   131	
   132	    total_steps = sum(s["steps"] for s in summaries)
   133	    total_dur = sum(s["duration_seconds"] for s in summaries)
   134	    print(f"\nBatch complete. {len(summaries)} episodes, {total_steps} steps, "
   135	          f"{total_dur/60:.1f} min")
   136	    print(f"Summary: {summary_path}")
   137	
   138	
   139	def _load_config(config_path: str | None) -> dict:
   140	    base_path = Path(__file__).resolve().parent.parent / "config" / "default.yaml"
   141	    with open(base_path) as f:
   142	        cfg = yaml.safe_load(f)
   143	    if config_path:
   144	        with open(config_path) as f:
   145	            override = yaml.safe_load(f)
   146	        _deep_merge(cfg, override)
   147	    return cfg
   148	
   149	
   150	def _deep_merge(base: dict, override: dict) -> None:
   151	    for key, value in override.items():
   152	        if key in base and isinstance(base[key], dict) and isinstance(value, dict):
   153	            _deep_merge(base[key], value)
   154	        else:
   155	            base[key] = value
   156	
   157	
   158	if __name__ == "__main__":
   159	    main()

