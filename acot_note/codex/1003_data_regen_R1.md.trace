   304	        return {
   305	            "vlm_ctx_layers": layers, "vlm_ctx": layers[-1],
   306	            "proprio": torch.from_numpy(proprio), "action": torch.from_numpy(action),
   307	            "waypoint": torch.from_numpy(wp),
   308	            "occ_structural": torch.tensor(occ_s, dtype=torch.float32),
   309	            "maneuver": torch.tensor(man, dtype=torch.float32),
   310	            "cand_feats": torch.from_numpy(cand_feats), "target_idx": tgt_idx,
   311	            "visible": torch.tensor(vis), "act_supervise": torch.tensor(act_sup),
   312	            "tid_valid": torch.tensor(tid_valid), "tier": tier,
   313	            "target_px": torch.tensor(target_px, dtype=torch.float32),
   314	            "target_central": torch.tensor(target_central, dtype=torch.float32),
   315	            "target_color": h["tcolor"], "target_make": h["tmake"],
   316	        }
