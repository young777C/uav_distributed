   112	        # Check size limit
   113	        total_size = sum(
   114	            f.stat().st_size for f in output_dir.glob("episode_*.h5")
   115	        )
   116	        print(f"  Total data: {total_size/1024**3:.2f} GB / {args.max_size_gb:.1f} GB")
   117	        if total_size >= max_bytes:
