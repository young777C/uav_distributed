   104	                    # z_ex = CV of the TRUE target (world → cam frame) — teaches "center what z_ex points at"
   105	                    hor = offs_s
   106	                    pw = tgt[i][None] + tv[i][None] * hor[:, None]              # (K,3)
   107	                    M = inverse_pose_matrix(*tuple(cam[i]))
   108	                    z_ex = ((np.concatenate([pw, np.ones((K, 1))], -1) @ M.T)[:, :3] / wp["scale"]).astype(np.float32)
   109	                    prop = np.array([cam[i][2] / 30.0, cam[i][3] / 90.0,
   110	                                     uavv[i][0] / 15.0, uavv[i][1] / 15.0, uavv[i][2] / 15.0], np.float32)
   111	                    a1 = _centering_target(tgt, cam, act, i, H, W, fov, a_scale, yaw_cap, blend=1.0)
   112	                    rec_dyaw = np.array([act[min(i + k, n - 1), 3] for k in range(H)], np.float32)  # for train-time blend
   113	                    pr = project_point(tuple(float(x) for x in tgt[i]), tuple(cam[i]), W, Himg, fov)
   114	                    visible = pr is not None and 0 <= pr[0] < W
   115	                    recs.append({"vlm_ctx": vlm_ctx.half().cpu().numpy(),
   116	                                 "z_im": z_im[0].half().cpu().numpy(), "z_ex": z_ex,
   117	                                 "proprio": prop, "a1": a1, "rec_dyaw": rec_dyaw, "visible": visible})
   118	            print(f"[cache] {split} ep{ei} {Path(ep).name}: n={len(recs)}", flush=True)
   119	    import torch
   120	    torch.save({"recs": recs, "dims": {"K": K, "H": H, "A": A}}, out_path)
   121	    print(f"[cache] wrote {out_path}: {len(recs)} frames", flush=True)
   122	
   123	
   124	def train_stage(cfg, cache, device, epochs, lr, last_layers, save_ckpt, blend=1.0):
   125	    import torch
   126	    from rollout.policy import load_policy_modules
   127	    from train.stage2 import action_flow_loss
   128	    ear, iar, dit, tid, d, meta = load_policy_modules(cfg["_ckpt"], cfg, device)
   129	    data = torch.load(cache, weights_only=False)["recs"]
   130	    if blend < 1.0:   # train-time gentler blend: dyaw = b·center + (1-b)·recorded (no re-cache)
   131	        for b in data:
   132	            b["a1"] = b["a1"].copy()
   133	            b["a1"][:, 3] = blend * b["a1"][:, 3] + (1.0 - blend) * b["rec_dyaw"]
   134	        print(f"[train] applied center-blend={blend} (dyaw = {blend}·center + {1-blend:.2f}·recorded)", flush=True)
   135	    # freeze all but the last `last_layers` DiT blocks + the output head (VLM/EAR/IAR already frozen)
   136	    import re
   137	    for p in dit.parameters():
   138	        p.requires_grad_(False)
   139	    names = [n for n, _ in dit.named_parameters()]
   140	    idxs = sorted(set(int(m.group(1)) for n in names for m in [re.search(r'blocks\.(\d+)\.', n)] if m))
   141	    keep = set(idxs[-last_layers:]) if idxs else set()
   142	    trainable = []
   143	    for n, p in dit.named_parameters():
   144	        m = re.search(r'blocks\.(\d+)\.', n)
   145	        unfreeze = (m and int(m.group(1)) in keep) or n.startswith("out.")
   146	        if not idxs:               # fallback: no block naming → DiT-only full fine-tune (still freezes VLM/EAR/IAR)
   147	            unfreeze = True
   148	        if unfreeze:
   149	            p.requires_grad_(True); trainable.append(p)
   150	    print(f"[train] DiT blocks={idxs}, unfreezing last {last_layers} + head → {sum(p.numel() for p in trainable)} params", flush=True)
   151	    opt = torch.optim.AdamW(trainable, lr=lr, weight_decay=1e-4)
   152	    B = 32
   153	    for ep in range(epochs):
   154	        tot = 0.0; nb = 0
   155	        order = np.random.permutation(len(data))
   156	        for s0 in range(0, len(data), B):
   157	            bat = [data[o] for o in order[s0:s0 + B]]
   158	            vc = torch.tensor(np.stack([b["vlm_ctx"] for b in bat]), dtype=torch.float32, device=device)
   159	            zim = torch.tensor(np.stack([b["z_im"] for b in bat]), dtype=torch.float32, device=device)
   160	            zex = torch.tensor(np.stack([b["z_ex"] for b in bat]), dtype=torch.float32, device=device)
   161	            prop = torch.tensor(np.stack([b["proprio"] for b in bat]), dtype=torch.float32, device=device)
   162	            a1 = torch.tensor(np.stack([b["a1"] for b in bat]), dtype=torch.float32, device=device)
   163	            vis = torch.tensor(np.array([b["visible"] for b in bat]), dtype=torch.float32, device=device)
   164	            mask = torch.ones(vc.shape[:2], dtype=torch.bool, device=device)
   165	            loss = action_flow_loss(dit, a1, zex, zim, vc, prop, mask, vis)
   166	            opt.zero_grad(); loss.backward(); opt.step()
   167	            tot += float(loss); nb += 1
   168	        print(f"[train] epoch {ep+1}/{epochs}  action_flow={tot/max(nb,1):.4f}", flush=True)
   169	    # save a stage2-format ckpt (only DiT changed)
   170	    ck = torch.load(cfg["_ckpt"], map_location="cpu", weights_only=False)
   171	    ck["dit"] = {k: v.cpu() for k, v in dit.state_dict().items()}
   172	    torch.save(ck, save_ckpt)
   173	    print(f"[train] saved fine-tuned ckpt → {save_ckpt} (eval closed-loop with --ckpt {save_ckpt})", flush=True)
   174	
   175	
   176	def main():
   177	    ap = argparse.ArgumentParser()
   178	    ap.add_argument("--config", default="train/config_v5.yaml")
   179	    ap.add_argument("--ckpt", default="runs/stage2_v5/stage2_best.pt")
   180	    ap.add_argument("--stage", default="all", choices=["cache", "train", "all"])
   181	    ap.add_argument("--cache", default="runs/bc_center_cache.pt")
   182	    ap.add_argument("--save-ckpt", default="runs/stage2_bc_center.pt")
   183	    ap.add_argument("--episodes", type=int, default=999)
   184	    ap.add_argument("--stride", type=int, default=3)
   185	    ap.add_argument("--cap", type=int, default=150)
   186	    ap.add_argument("--epochs", type=int, default=15)
   187	    ap.add_argument("--lr", type=float, default=1e-4)
   188	    ap.add_argument("--last-layers", type=int, default=4)
   189	    ap.add_argument("--yaw-cap-deg", type=float, default=20.0)
   190	    ap.add_argument("--center-blend", type=float, default=1.0,
   191	                    help="dyaw target = b·centering + (1-b)·recorded; <1 = gentler (full 1.0 destabilized track)")
   192	    ap.add_argument("--device", default="cuda:0")
   193	    a = ap.parse_args()
   194	    cfg = yaml.safe_load(open(a.config)); cfg["_ckpt"] = a.ckpt; cfg["_yaw_cap_deg"] = a.yaw_cap_deg
   195	    cfg["_center_blend"] = a.center_blend
   196	    if a.stage in ("cache", "all"):
   197	        if not _select_episodes(cfg, "train"):
   198	            print("[cache] NO DATA — regenerate mvp per acot_note/mvp-regen-spec.md"); return
   199	        cache_stage(cfg, a.cache, a.device, a.episodes, a.stride, a.cap)
   200	    if a.stage in ("train", "all"):
   201	        train_stage(cfg, a.cache, a.device, a.epochs, a.lr, a.last_layers, a.save_ckpt, blend=a.center_blend)
   202	
   203	
   204	if __name__ == "__main__":
   205	    main()

