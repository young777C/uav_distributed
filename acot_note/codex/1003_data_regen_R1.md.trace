    37	REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    38	for _p in (REPO, os.path.join(REPO, "carla_uav_tracking")):
    39	    if _p not in sys.path:
    40	        sys.path.insert(0, _p)
    41	from acot_probe.projection import project_point  # noqa: E402
    42	from train.backbone_kv import neutralize_language  # noqa: E402
    43	
    44	DATA = "/nvidia/hque/data/carla_data/mvp_full_v5"
    45	W = H = 512; FOV = 90.0; VSZ = 4.0; BMIN, BMAX = 10.0, 140.0
    46	READ_LAYER = 24                       # hidden_states index used by the deployed policy (config_v5 backbone.layer)
    47	
    48	
    49	# ----------------------------------------------------------------------------------------------- data
    50	def candidates(fh, i):
    51	    """GT-projected candidate boxes for frame i → list of (fu0,fv0,fu1,fv1), label index or -1, similar flags."""
    52	    cam = tuple(float(fh[f"state/cam_{k}"][i]) for k in ("x", "y", "z", "pitch", "yaw"))
    53	    tgt = (float(fh["target/tx"][i]), float(fh["target/ty"][i]), float(fh["target/tz"][i]))
    54	    dpos = fh["distractors/positions"][i]; sim = fh["distractors/similar"][:]
    55	    out = []
    56	
    57	    def mk(world, is_t, simf):
    58	        pr = project_point(world, cam, W, H, FOV)
    59	        if pr is None:
    60	            return
    61	        u, v, d = pr
    62	        if not (0 <= u < W and 0 <= v < H):
    63	            return
    64	        f = W / (2 * math.tan(math.radians(FOV) / 2)); s = float(np.clip(f * VSZ / max(d, 0.1), BMIN, BMAX))
    65	        out.append(((max(0, u - s / 2) / W, max(0, v - s / 2) / H, min(W, u + s / 2) / W, min(H, v + s / 2) / H), is_t, simf))
    66	
    67	    mk(tgt, True, False)
    68	    for d in range(dpos.shape[0]):
    69	        if np.any(dpos[d, :3] != 0):
    70	            mk(tuple(float(x) for x in dpos[d, :3]), False, bool(sim[d]))
    71	    return out
    72	
    73	
    74	def build_index(eps, stride):
    75	    idx = []
    76	    for p in eps:
    77	        with h5py.File(p, "r") as fh:
    78	            for i in range(0, fh["rgb"].shape[0], stride):
    79	                c = candidates(fh, i)
    80	                if len(c) >= 2 and any(x[1] for x in c):
    81	                    idx.append((p, i, any(x[2] for x in c)))
    82	    return idx
    83	
    84	
    85	def split_eps():
    86	    man = json.load(open(os.path.join(REPO, "train/splits/mvp_full_split.json")))
    87	    on = {os.path.basename(p): p for p in glob.glob(f"{DATA}/episode_*.h5")}
    88	    S = {k: [on[n] for n in man[k] if n in on] for k in ("train", "val", "test")}
    89	    return S
    90	
    91	
    92	def desc(p):
    93	    with h5py.File(p, "r") as fh:
    94	        return str(fh.attrs["target_desc"]), str(fh.attrs["language"])
