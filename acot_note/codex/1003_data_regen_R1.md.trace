    25	def main():
    26	    parser = argparse.ArgumentParser(description="Batch generate tracking episodes")
    27	    parser.add_argument("--num-episodes", type=int, default=100)
    28	    parser.add_argument("--config", type=str, default=None)
    29	    parser.add_argument("--host", type=str, default="127.0.0.1")
