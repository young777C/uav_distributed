    35	                        help="Base seed; per-episode seed = seed + episode_id")
    36	    parser.add_argument("--max-size-gb", type=float, default=45.0,
    37	                        help="Stop when total data exceeds this")
    38	    parser.add_argument("--postprocess", action="store_true", default=True)
    39	    args = parser.parse_args()
    40	
    41	    # Load config
    42	    cfg = _load_config(args.config)
    43	    output_dir = Path(args.output)
    44	    output_dir.mkdir(parents=True, exist_ok=True)
    45	    max_bytes = int(args.max_size_gb * 1024**3)
    46	    town_list = cfg.get("environment", {}).get("towns", ["Town01"])
    47	
    48	    # Connect (generous timeout: first map load compiles shaders)
    49	    client = carla.Client(args.host, args.port)
    50	    client.set_timeout(60.0)
    51	
    52	    summaries = []
    53	    postproc = PostProcessor(output_dir, fov=float(cfg.get("output", {}).get("fov", 90.0)))
    54	
    55	    # Load the scenario's first town up front (skip if the server is already on
    56	    # it — important for crash-resume so we don't reload every restart).
    57	    first_town = town_list[0] if town_list else "Town10HD"
    58	    cur_map = client.get_world().get_map().name.split("/")[-1]
    59	    if cur_map != first_town:
    60	        try:
    61	            print(f"Loading initial map: {first_town}")
    62	            client.load_world(first_town)
    63	            time.sleep(3.0)
    64	        except RuntimeError:
    65	            print("  Initial map load failed; using current map")
    66	
    67	    progress_file = output_dir / ".attempted"
    68	    for ep_id in range(args.start_id, args.start_id + args.num_episodes):
    69	        # Record attempt so a supervisor can resume past a crashing episode.
    70	        progress_file.write_text(str(ep_id))
    71	        # Map switch every 10 episodes (with crash guard)
    72	        if ep_id % 10 == 0 and len(town_list) > 1:
    73	            town = town_list[(ep_id // 10) % len(town_list)]
    74	            print(f"[{ep_id}] Loading map: {town}")
    75	            try:
    76	                client.load_world(town)
    77	                time.sleep(3.0)
    78	            except RuntimeError:
    79	                print(f"  Map load failed, continuing with current map")
    80	
    81	        world = client.get_world()
    82	
    83	        # Update scenario-specific town override
    84	        if "towns" not in cfg.get("environment", {}):
    85	            cfg["environment"]["towns"] = town_list
    86	
    87	        # Per-episode seed for reproducibility (P1-b)
    88	        cfg.setdefault("environment", {})["seed"] = args.seed + ep_id
    89	
    90	        scene = SceneManager(world, cfg, client)
    91	        recorder = EpisodeRecorder(
    92	            scene=scene, world=world, output_dir=output_dir,
    93	            episode_id=ep_id, fps=cfg.get("environment", {}).get("fps", 10),
    94	            resolution=tuple(cfg.get("output", {}).get("rgb_resolution", [336, 336])),
    95	        )
    96	
    97	        print(f"[{ep_id}] Starting...", end=" ", flush=True)
    98	        summary = recorder.run()
    99	        summaries.append(summary)
   100	
   101	        n_steps = summary["steps"]
   102	        dur = summary["duration_seconds"]
   103	        if summary.get("skipped"):
   104	            print(f"SKIPPED — {summary.get('reason', 'unknown')}")
   105	            # Remove the empty H5 file
   106	            ep_file = output_dir / f"episode_{ep_id:06d}.h5"
   107	            if ep_file.exists():
   108	                ep_file.unlink()
   109	            continue
   110	        print(f"{n_steps} steps in {dur:.1f}s ({n_steps/max(dur,0.001):.1f} fps)")
