    32	def build_cands(tgt_xyz, distr_i, cam, img):
    33	    W, H, fov = img["width"], img["height"], img["fov_deg"]
    34	    f = W / (2.0 * math.tan(math.radians(fov) / 2.0))
    35	
    36	    def mk(xyz, is_t, idx):
    37	        pr = project_point(tuple(float(x) for x in xyz), tuple(float(x) for x in cam), W, H, fov)
    38	        if pr is None:
    39	            return None
    40	        u, v, depth = pr
    41	        if not (0 <= u < W and 0 <= v < H):
    42	            return None
    43	        s = float(np.clip(f * img.get("vehicle_size_m", 4.0) / max(depth, 0.1),
    44	                          img.get("box_min_px", 10), img.get("box_max_px", 140)))
    45	        return Candidate(u, v, s, s, depth, is_t, idx)
    46	
    47	    t = mk(tgt_xyz, True, -1)
    48	    out = [t] if t is not None else []
    49	    if distr_i is not None:
    50	        for d in range(distr_i.shape[0]):
    51	            c = mk(distr_i[d, :3], False, d)
    52	            if c is not None:
    53	                out.append(c)
    54	    return out
    55	
    56	
    57	_IMAGENET_MEAN = np.array([0.485, 0.456, 0.406], np.float32)
    58	_IMAGENET_STD = np.array([0.229, 0.224, 0.225], np.float32)
    59	
    60	
    61	def _load_dino(model_name, device):
    62	    import timm
    63	    m = timm.create_model(model_name, pretrained=True, num_classes=0,
    64	                          dynamic_img_size=True).eval().to(device)   # allow 224 input (default 518)
    65	    return m
    66	
    67	
    68	def _dino_feats(dino, rgb, cands, W, H, size, pad, device):
    69	    """Crop each candidate's PIXEL box from the raw RGB → resize → DINOv2 → (N, D) instance feats.
    70	    Uses the SAME pixels as vlmpool but gives the car ~ (size/14)^2 tokens instead of ~1 grid cell."""
    71	    import torch
    72	    crops = []
    73	    for c in cands:
    74	        w, h = c.w * pad, c.h * pad
    75	        x0 = int(max(0, c.u - w / 2)); y0 = int(max(0, c.v - h / 2))
    76	        x1 = int(min(W, c.u + w / 2)); y1 = int(min(H, c.v + h / 2))
    77	        crop = rgb[y0:y1, x0:x1]
    78	        if crop.size == 0:
    79	            crop = rgb
    80	        img = np.asarray(Image.fromarray(crop).resize((size, size), Image.BILINEAR), np.float32) / 255.0
    81	        crops.append(((img - _IMAGENET_MEAN) / _IMAGENET_STD).transpose(2, 0, 1))   # (3,H,W)
    82	    x = torch.from_numpy(np.stack(crops)).to(device)
    83	    with torch.no_grad():
    84	        return dino(x).float().cpu().numpy()                                        # (N, D)
    85	
