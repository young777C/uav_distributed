   513	        n_veh = int(amb.get("vehicles", 0))
   514	        n_walk = int(amb.get("walkers", 0))
   515	        radius = float(amb.get("radius", 90.0))
   516	        if self._target is None:
   517	            return
   518	        try:
   519	            tloc = self._target.transform.location
   520	        except RuntimeError:
   521	            return
   522	        tm = self._client.get_trafficmanager(_tm_port())
   523	
   524	        # Official mechanism: hybrid physics around the hero (target) + respawn dormant
   525	        # vehicles → ambient traffic auto-concentrates near the moving target.
   526	        if self._target_class in VEHICLE_CLASSES:
   527	            try:
   528	                tm.set_hybrid_physics_mode(True)
   529	                tm.set_hybrid_physics_radius(radius)
   530	                tm.set_respawn_dormant_vehicles(True)
   531	            except (RuntimeError, AttributeError):
   532	                pass
   533	
   534	        # --- vehicles: batch spawn at the spawn points NEAREST the target ---
   535	        if n_veh > 0:
   536	            SpawnActor = carla.command.SpawnActor
   537	            SetAutopilot = carla.command.SetAutopilot
   538	            FutureActor = carla.command.FutureActor
   539	            vbps = list(self._world.get_blueprint_library().filter("vehicle.*"))
   540	            if amb.get("cars_only", False):        # 4-wheel cars only (no bikes/motos) — spec §4d
   541	                cars = [b for b in vbps if b.has_attribute("number_of_wheels")
   542	                        and int(b.get_attribute("number_of_wheels")) == 4]
   543	                if cars:
   544	                    vbps = cars
   545	            sps = sorted(self._world.get_map().get_spawn_points(),
   546	                         key=lambda sp: sp.location.distance(tloc))
   547	            batch = []
   548	            for sp in sps[1:n_veh + 1]:    # nearest points (skip target's own)
   549	                bp = random.choice(vbps)
   550	                if bp.has_attribute("color"):
   551	                    try:
   552	                        bp.set_attribute("color", random.choice(
   553	                            bp.get_attribute("color").recommended_values))
   554	                    except (RuntimeError, ValueError, IndexError):
   555	                        pass
   556	                bp.set_attribute("role_name", "ambient")
   557	                batch.append(SpawnActor(bp, sp)
   558	                             .then(SetAutopilot(FutureActor, True, tm.get_port())))
   559	            try:
