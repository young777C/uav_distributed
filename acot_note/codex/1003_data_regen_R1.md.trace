   303	    def _reid_select(self, cset, rgb, store_slot=None):
   304	        """Temporal appearance-memory re-ID (reframe → offline milestone: crop-DINOv2 feature +
   305	        K-view gallery breaks the 0.5 wall without resolution). Returns (N,) match scores to the
   306	        stored target gallery, or None if empty.
   307	
   308	        Fair-by-construction (no GT leak): SELECT with the PAST gallery, THEN store this view from
   309	        the GT-identified target (future only). Feature = crop-DINOv2 (instance-discriminative,
   310	        `reid_feature=dinov2`) or the coarse VLM pool (`vlmpool`). Matching = top-m mean over a
   311	        K-view diversity gallery (viewpoint-robust). Ported from train.reid_resolution_probe."""
   312	        from train.reid_resolution_probe import _dino_feats, bank_update, bank_score
   313	        if self.reid_feature == "dinov2":
   314	            W, H = self.image_cfg["width"], self.image_cfg["height"]
   315	            feats = _dino_feats(self._dino, rgb, cset.cands, W, H, 224, 1.3, self.device).astype(np.float64)
   316	        else:
   317	            feats = cset.feats.astype(np.float64)
   318	        fn = feats / (np.linalg.norm(feats, axis=1, keepdims=True) + 1e-8)
   319	        logits = bank_score(self._reid_bank, fn, self.reid_topm) if self._reid_bank else None
   320	        self._reid_fn = fn                                                    # stash for deployable re-anchor re-seed
   321	        # gallery update source: 'committed'=deployable (store the believed-target crop passed as store_slot;
   322	        # GT never touches the template) | 'gt'=legacy oracle-seeded (store the GT target view, future only).
   323	        ss = store_slot if self.gallery_seed == "committed" else \
   324	             (cset.true_idx if (cset.true_idx is not None and cset.true_idx >= 0) else None)
   325	        if ss is not None and 0 <= ss < len(fn):
   326	            bank_update(self._reid_bank, fn[ss], self.reid_bank, 0.9)
   327	        return logits
   328	
   329	    def _asd_feats(self, cset, rgb):
   330	        """ASD appearance view of the candidates: reuse the active memory's frozen crop-DINOv2 feats when it
   331	        computed them this tick (tah / reid-dinov2), else compute them (memory-agnostic)."""
   332	        if self.tid_head == "tah" and self._asd_fe is not None:
   333	            return self._asd_fe
   334	        if self.tid_head == "reid" and self.reid_feature == "dinov2" and self._reid_fn is not None \
   335	           and len(self._reid_fn) == len(cset.cands):
   336	            return self._reid_fn
   337	        from train.reid_resolution_probe import _dino_feats
   338	        W, H = self.image_cfg["width"], self.image_cfg["height"]
   339	        fe = _dino_feats(self._dino, rgb, cset.cands, W, H, 224, 1.3, self.device).astype(np.float64)
   340	        return fe / (np.linalg.norm(fe, axis=1, keepdims=True) + 1e-8)
   341	
   342	    def _asd_gate_memory(self, slot, which=None):
   343	        """Posterior-gated memory update: redo this tick's update with the filter's MAP crop (tah); reid's gallery
   344	        already stores the COMMITTED identity, which is overridden by the caller; dam4sam (V1): re-init SAM2 on the
   345	        filter's MAP candidate box (drops its RAM/DRM), with a pre-registered 3-tick cooldown."""
   346	        which = which or self.tid_head
   347	        if which == "dam4sam" and self._dam4sam_rgb is not None and self._cand_set_cur is not None \
   348	           and self._dam4sam_cool == 0:
   349	            from rollout.bridge import send_msg, recv_msg
   350	            c = self._cand_set_cur.cands[slot]
   351	            send_msg(self._dam4sam_sock, {"cmd": "init", "rgb": np.asarray(self._dam4sam_rgb, np.uint8),
   352	                                          "box": (c.u - c.w / 2.0, c.v - c.h / 2.0, c.w, c.h)})
   353	            recv_msg(self._dam4sam_sock)
   354	            self._dam4sam_cool = 3
   355	            return
   356	        if which in ("tah", "fusion") and self._tah_last is not None:
   357	            feat, pos = self._tah_last
   358	            prev = getattr(self, "_tah_mem_prev", None)
   359	            prev = prev if prev is not None else self._tah.reset(self.device)
   360	            self._tah_mem = self._tah.update(prev, feat[slot], pos[slot])
   361	
   362	    def _cold_vote(self, aidx, lang_logits, lang_slot):
   363	        """V2: one tempered, rank-weighted language vote per tick; returns the slot of argmax_k G_k (visible)."""
   364	        l = np.asarray(lang_logits, np.float64); srt = np.sort(l)
   365	        m = float(srt[-1] - srt[-2]) if l.size >= 2 else 0.0
   366	        h = self._cold_hist; rho = float(np.searchsorted(np.sort(h), m)) / len(h) if len(h) >= 2 else 0.5
   367	        self._cold_hist = h + [m]
   368	        for k in self._cold_G:
   369	            self._cold_G[k] *= self.cold_lambda
   370	        a = int(aidx[lang_slot]); self._cold_G[a] = self._cold_G.get(a, 0.0) + 0.5 + rho
   371	        return max(range(len(aidx)), key=lambda s_: self._cold_G.get(int(aidx[s_]), 0.0))
   372	
   373	    def _asd_reset_memory(self, slot):
   374	        """The ONE hook ASD needs from a memory: reset it to the anchor's pick (drop the drifted state)."""
   375	        if self.tid_head == "tah" and self._tah_last is not None:
   376	            feat, pos = self._tah_last
   377	            self._tah_mem = self._tah.update(self._tah.reset(self.device), feat[slot], pos[slot])
   378	        elif self.tid_head == "reid" and self._reid_fn is not None:
   379	            from train.reid_resolution_probe import bank_update
   380	            self._reid_bank = []

