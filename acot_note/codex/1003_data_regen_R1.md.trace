     1	"""Main recording loop — drives the synchronous CARLA mode for one episode."""
     2	
     3	from __future__ import annotations
     4	
     5	import json
     6	import time
     7	from pathlib import Path
     8	from typing import Any
     9	
    10	import carla
    11	import h5py
    12	import numpy as np
    13	from PIL import Image
    14	
    15	from scene.scene_manager import SceneManager
    16	from recording.sensors import RGBSensor
    17	
    18	
    19	class EpisodeRecorder:
    20	    """Records one tracking episode in CARLA synchronous mode.
    21	
    22	    Output: an HDF5 file with all frames + a metadata JSON sidecar.
    23	    """
    24	
    25	    def __init__(
    26	        self,
    27	        scene: SceneManager,
    28	        world: carla.World,
    29	        output_dir: Path,
    30	        episode_id: int,
    31	        fps: int = 10,
    32	        resolution: tuple[int, int] = (336, 336),
    33	    ):
    34	        self._scene = scene
    35	        self._world = world
    36	        self._output_dir = output_dir
    37	        self._episode_id = episode_id
    38	        self._fps = fps
    39	        self._resolution = resolution
    40	        # §10: horizontal FOV (deg) — narrowed 90→70 so small aerial targets project to
    41	        # more pixels (make/body readable). Drives the sensor AND the projection maths below.
    42	        self._fov = float(scene._config.get("output", {}).get("fov", 90.0))
    43	        self._dt = 1.0 / fps
    44	
    45	        # Buffers (flushed every N frames)
    46	        self._buffer_size = 100
    47	        self._frames: list[np.ndarray] = []
    48	        self._actions: list[list[float]] = []
    49	        self._states: list[dict] = []
    50	        self._bboxes: list[dict] = []
    51	        self._occlusions: list[float] = []
    52	        self._maneuvers: list[dict] = []
    53	        self._target_positions: list[list[float]] = []  # for waypoint GT
    54	        self._distractor_positions: list[np.ndarray] = []  # each (D, 6): xyz + vxyz
    55	        self._episode_attrs: dict = {}                     # written once on file create
    56	
    57	    # ------------------------------------------------------------------
    58	    # Public API
    59	    # ------------------------------------------------------------------
    60	
    61	    def run(self, max_steps: int | None = None) -> dict[str, Any]:
    62	        """Run one episode. Returns summary dict."""
    63	        # Setup scene first
    64	        metadata = self._scene.setup_episode()
    65	        assert self._scene.drone is not None
    66	
    67	        # Episode-level attributes written into the HDF5 file (design §5.2 attrs).
    68	        self._episode_attrs = {
    69	            "language": metadata.get("language", ""),
    70	            "target_bp": metadata.get("target_blueprint", ""),
    71	            "target_desc": metadata.get("target_desc", ""),
    72	            "target_class": metadata.get("target_class", ""),
    73	            "target_color": str(metadata.get("target_color")),
    74	            "strategy": metadata.get("strategy", ""),
    75	            "num_similar": int(metadata.get("num_similar", 0)),
    76	            "town": self._world.get_map().name.split("/")[-1],
    77	            "seed": str(metadata.get("seed")),
    78	            "weather": json.dumps(metadata.get("weather", {})),
    79	            "distractors": json.dumps(metadata.get("distractors", [])),
    80	            "occlusion_biased": bool(metadata.get("occlusion_biased", False)),
    81	            "camera_pitch": float(metadata.get("camera_pitch", -50.0)),
    82	        }
    83	
    84	        # Scenarios set this under `environment:` (like the other env keys); fall back to
    85	        # a top-level value, then the default. (Was read only at top level → scenario
    86	        # `environment.max_duration_seconds` was silently ignored, e.g. mvp's 150 ran 180.)
    87	        cfg = self._scene._config
    88	        max_duration = cfg.get("environment", {}).get(
    89	            "max_duration_seconds", cfg.get("max_duration_seconds", 180))
    90	        max_steps = max_steps or int(max_duration * self._fps)
    91	
    92	        # Setup synchronous mode
    93	        settings = self._world.get_settings()
    94	        original_settings = settings
    95	        settings.synchronous_mode = True
    96	        settings.fixed_delta_seconds = self._dt
    97	        self._world.apply_settings(settings)
    98	
    99	        # Validate target is moving AND let traffic disperse (tick 90x = 9 seconds)
   100	        max_speed = 0.0
   101	        for _ in range(90):
   102	            self._scene.step_target(0.1)
   103	            # Also move UAV toward target during warmup
   104	            tpos, _, _, _ = self._scene.get_target_state()
   105	            drone_state = self._scene.drone.get_state()
   106	            action, _ = self._scene.expert_action(
   107	                tpos, drone_state.position, drone_state.yaw, True, 0.0,
   108	            )
   109	            self._scene.step_drone(action)
   110	            self._world.tick()
   111	            _, _, _, ts = self._scene.get_target_state()
   112	            max_speed = max(max_speed, ts)
   113	        if max_speed < 1.2:
   114	            self._scene.cleanup()
   115	            try:
   116	                self._world.tick()
   117	            except RuntimeError:
   118	                pass
   119	            self._world.apply_settings(original_settings)
   120	            return {"episode_id": self._episode_id, "steps": 0,
   121	                    "duration_seconds": 0, "fps_actual": 0,
   122	                    "metadata": metadata, "skipped": True,
   123	                    "reason": f"target stationary (max_speed={max_speed:.1f}m/s)"}
   124	
   125	        # Create RGB sensor (manually positioned each tick)
   126	        rgb_sensor = self._create_attached_sensor()
   127	
   128	        # Structural-occlusion detector: rays from target bbox corners → camera. Gives
   129	        # a graded occlusion level (target hidden by building/tunnel while still in
   130	        # frame) — the label §6.2/§6.4/H2 need. Computed live, stored per frame.
   131	        from scene.occlusion import OcclusionDetector
   132	        occ_detector = OcclusionDetector(self._world, num_rays=8, hit_threshold=0.5)
   133	        target_actor = (getattr(self._scene._target, "_vehicle", None)
   134	                        or getattr(self._scene._target, "_walker", None))
   135	
   136	        start_time = time.time()
   137	        off_lost = 0     # consecutive frames the target is OFF-screen (truly lost)
   138	        occ_lost = 0     # consecutive frames the target is in-frame but occluded
   139	        env_cfg = self._scene._config.get("environment", {})
   140	        max_lost = int(env_cfg.get("max_lost_seconds", 5.0) / self._dt)
   141	        max_occluded = int(env_cfg.get("max_occluded_seconds", 10.0) / self._dt)
   142	
   143	        try:
   144	            for step in range(max_steps):
   145	                elapsed = step * self._dt
   146	
   147	                # Step target vehicle (route following)
   148	                self._scene.step_target(self._dt)
   149	
   150	                # Possibly inject a target maneuver (sudden stop / sharp turn / ...)
   151	                man_event = self._scene.check_maneuver(elapsed)
   152	
   153	                # Recycle off-screen look-alikes back near the target (co-visibility).
   154	                drone_state = self._scene.drone.get_state()
   155	                self._scene.recycle_lost_lookalikes()
   156	
   157	                # Get current states (reflect any recycling)
   158	                tpos, tvel, tyaw, tspeed = self._scene.get_target_state()
   159	                dstates = self._scene.get_distractor_states()  # (D, 6)
   160	
   161	                # §11 deliberate loss event: at onset kick a strong evade; DURING the window
   162	                # keep the target sprinting/swerving so it stays off-frame while the expert
   163	                # flies to INTERCEPT the true (privileged) target (recovery mode) — a genuine
   164	                # fly-to-intercept demonstration, NOT hover. At window end, force >=2 look-alikes
   165	                # co-visible so the re-acquisition must use language.
   166	                win_dur = self._scene.loss_window_onset(elapsed)
   167	                if win_dur is not None:
   168	                    self._scene.force_target_evade(elapsed, win_dur)
   169	                if self._scene.in_loss_window(elapsed):
   170	                    self._scene.sustain_target_evade(elapsed)
   171	                elif self._scene.loss_window_offset(elapsed):
   172	                    self._scene.restore_target_speed()
   173	                    self._scene.force_covisible_lookalikes(min_n=2)
   174	                target_visible = True   # §11: expert always servos the true target → intercepts when lost
   175	
   176	                # Expert action with perturbation injection
   177	                action, pert_event = self._scene.expert_action(
   178	                    tpos, drone_state.position, drone_state.yaw,
   179	                    target_visible, elapsed,
   180	                )
   181	
   182	                # Obstacle avoidance override
   183	                action, obs_event = self._scene.check_obstacles(
   184	                    action, drone_state.position, drone_state.yaw, elapsed,
   185	                )
   186	
   187	                # §11: NO hover override — during a loss window the expert flies to intercept
   188	                # the true target (above, via recovery mode). The target's sustained sprint/
   189	                # swerve keeps it off-frame; the recorded (off-screen, fly-toward-target) pairs
   190	                # are the intercept demonstration BC needs (supervise_intercept, spec §3.2/§11).
   191	
   192	                # Apply action and move camera BEFORE the tick
   193	                self._scene.step_drone(action)
   194	                cam_t = self._scene.drone.get_camera_transform()
   195	                rgb_sensor._sensor.set_transform(cam_t)
   196	                cam_pose = [
   197	                    cam_t.location.x, cam_t.location.y, cam_t.location.z,
   198	                    cam_t.rotation.pitch, cam_t.rotation.yaw,
   199	                ]
   200	
   201	                # Single tick — advances simulation AND captures sensor frame
   202	                self._world.tick()
   203	                rgb_frame = rgb_sensor.get_frame(timeout=0.5)
   204	
   205	                # Graded structural occlusion [0,1] (fraction of target→camera rays
   206	                # blocked by geometry — building / tunnel roof).
   207	                occ_raycast = 0.0
   208	                if target_actor is not None:
   209	                    try:
   210	                        occ_raycast = float(occ_detector.check(
   211	                            target_actor,
   212	                            np.array([cam_t.location.x, cam_t.location.y,
   213	                                      cam_t.location.z]))[1])
   214	                    except RuntimeError:
   215	                        occ_raycast = 0.0
   216	
   217	                # Record
   218	                self._record_frame(
   219	                    rgb_frame, action, drone_state, tpos, tvel, tspeed, tyaw,
   220	                    target_visible, elapsed,
   221	                    is_turning=self._scene.is_target_turning(),
   222	                    pert_event=pert_event,
   223	                    obs_event=obs_event,
   224	                    distractor_states=dstates,
   225	                    cam_pose=cam_pose,
   226	                    man_event=man_event,
   227	                    occ_raycast=occ_raycast,
   228	                )
   229	
   230	                # A1c③ — separate truncation. A target driven OFF-screen (truly lost,
   231	                # e.g. off-map / expert can't follow) truncates fast (max_lost). A target
   232	                # IN frame but structurally occluded (bridge/overpass/tunnel) is tolerated
   233	                # much longer (max_occluded) so the occlusion event SURVIVES as recoverable
   234	                # data — that is exactly the signal §6.2/§6.4/H2 need. Both counters reset
   235	                # on a clean re-acquire.
   236	                in_frame = self._point_in_frame(cam_t, tpos)
   237	                # Expose visibility so the expert can switch to target-recovery framing
   238	                # (fly toward the true target to re-acquire) once it drifts off-screen,
   239	                # instead of staying with the group centroid and losing it.
   240	                self._scene._target_in_frame = bool(in_frame)
   241	                if not in_frame:
   242	                    off_lost += 1
   243	                    occ_lost = 0
   244	                elif occ_raycast >= 0.6:
   245	                    occ_lost += 1
   246	                    off_lost = 0
   247	                else:
   248	                    off_lost = 0
   249	                    occ_lost = 0
   250	                if off_lost >= max_lost or occ_lost >= max_occluded:
   251	                    why = "off-screen" if off_lost >= max_lost else "structural occlusion"
   252	                    print(f"[Episode {self._episode_id}] target {why} too long "
   253	                          f"(off={off_lost}/{max_lost} occ={occ_lost}/{max_occluded}) "
   254	                          f"— truncating at step {step}")
   255	                    break
   256	
   257	                # Flush buffer periodically
   258	                if len(self._frames) >= self._buffer_size:
   259	                    self._flush_buffer()
   260	
   261	        except Exception as e:
   262	            print(f"[Episode {self._episode_id}] Error at step {step}: {e}")
   263	            metadata["error"] = str(e)
   264	        finally:
   265	            # Destroy actors while STILL in synchronous mode, then tick once so the
   266	            # server finalizes destruction before we switch back / start the next
   267	            # episode (prevents 'operate on a destroyed actor' aborts from the TM).
   268	            try:
   269	                rgb_sensor.destroy()
   270	            except RuntimeError:
   271	                pass
   272	            self._scene.cleanup()
   273	            try:
   274	                self._world.tick()
   275	            except RuntimeError:
   276	                pass
   277	            self._world.apply_settings(original_settings)
   278	
   279	            # Final flush
   280	            if self._frames:
   281	                self._flush_buffer()
   282	
   283	        duration = time.time() - start_time
   284	        return {
   285	            "episode_id": self._episode_id,
   286	            "steps": step,
   287	            "duration_seconds": duration,
   288	            "fps_actual": step / max(duration, 0.001),
   289	            "metadata": metadata,
   290	            "output_file": str(self._output_dir / f"episode_{self._episode_id:06d}.h5"),
   291	        }
