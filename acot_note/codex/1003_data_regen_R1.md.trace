   263	                            h["vel"][i][0] / 15.0, h["vel"][i][1] / 15.0, h["vel"][i][2] / 15.0], np.float32)
   264	        occ_s = float(h["occ_s"][i]) if h["occ_s"] is not None else 0.0
   265	        man = float(h["man"][i]) if h["man"] is not None else 0.0
   266	        vis = float(h["vis"][i])
   267	        # §3.2 mask reversal: on temporary-loss frames (target occluded now but
   268	        # reappears within the EAR horizon) supervise the intercept action instead of
   269	        # masking it. act_supervise == visible when the flag is off (current behavior).
   270	        act_sup = vis; intercept = False
   271	        if self.supervise_intercept and vis < 0.5:
   272	            fut_vis = h["vis"][i:i + self.intercept_hz]
   273	            if fut_vis.size and float(fut_vis.max()) >= 0.5:  # temporary loss -> intercept-eligible
   274	                act_sup = 1.0; intercept = True
   275	        cands = self._candidates(h, i)
   276	        has_target = any(c.is_target for c in cands)
   277	        target_px = next((float(c.w) for c in cands if c.is_target), 0.0)  # target box size (grounding probe)
   278	        # target_central: same central-30%-box convention as the closed-loop scorer (metrics.py),
   279	        # to directly compare offline vs closed-loop off-center grounding (extreme-OOD check).
   280	        _tc = next((c for c in cands if c.is_target), None); _m = 0.3
   281	        _W, _H = self.img["width"], self.img["height"]
   282	        target_central = float(_tc is not None and
   283	                               (0.5 - _m / 2) * _W <= _tc.u <= (0.5 + _m / 2) * _W and
   284	                               (0.5 - _m / 2) * _H <= _tc.v <= (0.5 + _m / 2) * _H)
   285	        # Skip target-absent frames UNLESS intercept-eligible: keep them so the intercept
   286	        # action (fly toward EAR-predicted position) is supervised during a temporary loss;
   287	        # target_id loss is masked on such frames via tid_valid (no target candidate to pick).
   288	        if not cands or (not has_target and not intercept):
   289	            return self.__getitem__((j + 1) % len(self.index))
   290	        cand_feats = np.stack([pool_box(grid_last, c.frac_box(W, H)) for c in cands]).astype(np.float32)
   291	        tgt_idx = next((k for k, c in enumerate(cands) if c.is_target), 0)   # 0 placeholder if absent
   292	        tid_valid = 1.0 if has_target else 0.0
   293	        # Shuffle candidate order so the target is NOT always index 0. `_candidates`
   294	        # prepends the target, so target_idx was 100% idx0. mis_follow's argmax breaks
   295	        # ties toward the lowest index -> a non-discriminative head whose scores collapse
   296	        # to near-ties gets argmax==0==target => fake-low error (v2-nolang read 0% this
   297	        # way). The tid head is permutation-equivariant, so this leaves the training loss
   298	        # and gradients unchanged and ONLY makes the mis_follow metric honest. Seed by j
   299	        # for reproducible per-sample order.
   300	        if cand_feats.shape[0] > 1:
   301	            perm = np.random.default_rng(j).permutation(cand_feats.shape[0])
   302	            cand_feats = cand_feats[perm]
