 succeeded in 18ms:
     1	"""Non-destructive label adapters — fix data-check P2/P3 at the label layer.
     2	
     3	The raw HDF5 already contains everything needed; rather than rewriting 60 large
     4	files, we derive the corrected/enriched labels on the fly from raw fields:
     5	
     6	  P3  candidate boxes (target + distractors) for L_target_id
     7	      <- distractors/positions + target/* + state/cam_*  (via acot_probe.projection)
     8	
     9	  P2  occlusion supervision that USES the rich raycast signal
    10	      - `combined_occlusion` = max(out-of-frame projection occ, structural occ_raycast)
    11	      - `search_mode_target` recomputed from combined occlusion (was projection-only)
    12	      - `iar_occlusion_target` = state/occ_raycast (structural, for IAR's occ head)
    13	
    14	Used by the Stage-2 dataloader. (P1 waypoint-tail degeneracy is already handled in
    15	dataset._build_index; P4 occlusion sparsity is a data-coverage caveat, not code.)
    16	"""
    17	
    18	from __future__ import annotations
    19	
    20	import numpy as np
    21	
    22	from acot_probe.projection import extract_candidates
    23	
    24	# Matches the recorder (336×336, 90° FOV). Vehicle pseudo-box size in meters.
    25	IMAGE_DEFAULT = {
    26	    "width": 336, "height": 336, "fov_deg": 90.0,
    27	    "vehicle_size_m": 4.0, "box_min_px": 10, "box_max_px": 140,
    28	}
    29	
    30	
    31	# --- P3: candidate boxes for L_target_id -----------------------------------
    32	def candidate_boxes(ep, i, image=None):
    33	    """Target + in-frame distractor boxes for frame i. Returns list[Candidate];
    34	    the target has is_target=True. Empty if the target is off-screen that frame."""
    35	    return extract_candidates(ep, i, {"image": image or IMAGE_DEFAULT})
    36	
    37	
    38	# --- P2: occlusion / visibility supervision using the raycast signal --------
    39	def out_of_frame_occ(ep) -> np.ndarray:
    40	    return np.asarray(ep["annotation/occlusion"][:], np.float32)
    41	
    42	
    43	def structural_occ(ep) -> np.ndarray:
    44	    """state/occ_raycast (in-frame-but-blocked). Zeros if the field is absent."""
    45	    if "state/occ_raycast" in ep:
    46	        return np.asarray(ep["state/occ_raycast"][:], np.float32)
    47	    n = ep["rgb"].shape[0]
    48	    return np.zeros(n, np.float32)
    49	
    50	
    51	def combined_occlusion(ep) -> np.ndarray:
    52	    """Fixes P2: fold structural raycast occlusion into the visibility signal."""
    53	    return np.maximum(out_of_frame_occ(ep), structural_occ(ep))
    54	
    55	
    56	def search_mode_target(ep, dt: float = 0.1) -> np.ndarray:
    57	    """Recompute search_mode from COMBINED occlusion (design §5.3 formula), so the
    58	    drone also widens search when the target is hidden behind a building/tunnel."""
    59	    occ = combined_occlusion(ep)
    60	    sm = np.zeros_like(occ)
    61	    time_lost = 0.0
    62	    for i, o in enumerate(occ):
    63	        time_lost = time_lost + dt if o > 0.8 else max(0.0, time_lost - 2 * dt)
    64	        sm[i] = float(np.clip(o * (1.0 + time_lost / 5.0), 0.0, 1.0))
    65	    return sm
    66	
    67	
    68	def iar_occlusion_target(ep) -> np.ndarray:
    69	    """Structural occlusion target for IAR's "about-to-be-occluded" head (§6.2 #1)."""
    70	    return structural_occ(ep)
    71	
    72	
    73	def visible_mask(ep, thresh: float = 0.8) -> np.ndarray:
    74	    """Per-frame 'target genuinely observable' flag (combined occ below thresh).
    75	    Stage-2 masks L_action/L_ear on ¬visible frames (avoid supervising blind follow)."""
    76	    return (combined_occlusion(ep) < thresh).astype(np.float32)

