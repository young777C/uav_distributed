     1	"""QC report for generated tracking episodes.
     2	
     3	Verifies the properties the training data must have (design §5.1/§6.3/§7.4):
     4	  - target stays in the camera frame,
     5	  - >=2 *similar* distractors are actually co-visible with the target,
     6	  - distractor tracks + episode attrs (language, seed, ...) are recorded,
     7	  - no corrupt/black frames or NaNs.
     8	
     9	Uses the recorded per-frame camera pose (state/cam_*) + CARLA's own transform math
    10	to project world points into the image, so co-visibility is measured, not assumed.
    11	
    12	Usage (inside the cyh-carla container):
    13	    python scripts/qc_report.py --data /data/carla_data/pilot [--previews]
    14	"""
    15	
    16	from __future__ import annotations
    17	
    18	import argparse
    19	import glob
    20	import json
    21	import os
    22	
    23	import carla  # only used for its transform/inverse-matrix math
    24	import h5py
    25	import numpy as np
    26	
    27	
    28	def project(cam_pose, world_pt, w, h, fov=90.0):
    29	    """Project a world point into image (u, v); return None if behind camera."""
    30	    T = carla.Transform(
    31	        carla.Location(float(cam_pose[0]), float(cam_pose[1]), float(cam_pose[2])),
    32	        carla.Rotation(pitch=float(cam_pose[3]), yaw=float(cam_pose[4]), roll=0.0),
    33	    )
    34	    M = np.array(T.get_inverse_matrix())
    35	    p = M @ np.array([world_pt[0], world_pt[1], world_pt[2], 1.0])
    36	    x_c, y_c, z_c = p[0], p[1], p[2]        # CARLA cam frame: x fwd, y right, z up
    37	    if x_c <= 0.1:
    38	        return None
    39	    f = w / (2.0 * np.tan(np.radians(fov) / 2.0))
    40	    u = f * (y_c / x_c) + w / 2.0
    41	    v = f * (-z_c / x_c) + h / 2.0
    42	    return u, v
    43	
    44	
    45	def in_frame(uv, w, h):
    46	    return uv is not None and 0 <= uv[0] < w and 0 <= uv[1] < h
    47	
    48	
    49	def qc_episode(path, previews_dir=None):
    50	    with h5py.File(path, "r") as f:
    51	        n, H, W = f["rgb"].shape[:3]
    52	        attrs = {k: f.attrs[k] for k in f.attrs}
    53	        distractors_meta = json.loads(attrs.get("distractors", "[]"))
    54	        similar_idx = [i for i, d in enumerate(distractors_meta) if d.get("similar")]
    55	
    56	        cam = np.stack([f["state/cam_x"][:], f["state/cam_y"][:], f["state/cam_z"][:],
    57	                        f["state/cam_pitch"][:], f["state/cam_yaw"][:]], axis=1)
    58	        tgt = np.stack([f["target/tx"][:], f["target/ty"][:], f["target/tz"][:]], axis=1)
    59	        dpos = f["distractors/positions"][:, :, :3] if "distractors/positions" in f else \
    60	            np.zeros((n, 0, 3))
    61	
    62	        tgt_in = 0
    63	        dist_in_counts, sim_in_counts = [], []
    64	        for i in range(n):
    65	            if in_frame(project(cam[i], tgt[i], W, H), W, H):
    66	                tgt_in += 1
    67	            din = sum(in_frame(project(cam[i], dpos[i, j], W, H), W, H)
    68	                      for j in range(dpos.shape[1]))
    69	            sin = sum(in_frame(project(cam[i], dpos[i, j], W, H), W, H)
    70	                      for j in similar_idx)
    71	            dist_in_counts.append(din)
    72	            sim_in_counts.append(sin)
    73	
    74	        # frame health
    75	        sample = f["rgb"][:: max(1, n // 20)]
    76	        black = float(np.mean(sample.reshape(sample.shape[0], -1).mean(1) < 5))
    77	        nan_action = bool(np.isnan(f["action/dx"][:]).any())
    78	
    79	        res = {
    80	            "file": os.path.basename(path), "n": int(n), "res": f"{W}x{H}",
    81	            "class": attrs.get("target_class"), "strategy": attrs.get("strategy"),
    82	            "num_distractors": len(distractors_meta), "num_similar_meta": len(similar_idx),
    83	            "target_in_frame_rate": tgt_in / max(n, 1),
    84	            "mean_distractors_in_frame": float(np.mean(dist_in_counts)) if n else 0,
    85	            "mean_similar_in_frame": float(np.mean(sim_in_counts)) if n else 0,
    86	            "frames_with_2plus_similar": float(np.mean(np.array(sim_in_counts) >= 2)) if n else 0,
    87	            "black_frame_rate": black, "nan_in_action": nan_action,
    88	            "language": attrs.get("language", "")[:90],
    89	        }
    90	
    91	        if previews_dir is not None:
    92	            _save_preview(f, path, cam, tgt, dpos, similar_idx, W, H, previews_dir)
    93	    return res
    94	
    95	
    96	def _save_preview(f, path, cam, tgt, dpos, similar_idx, W, H, out_dir):
    97	    import cv2
    98	    os.makedirs(out_dir, exist_ok=True)
    99	    n = f["rgb"].shape[0]
   100	    idxs = np.linspace(0, n - 1, min(9, n)).astype(int)
   101	    tiles = []
   102	    for i in idxs:
   103	        img = f["rgb"][i][:, :, ::-1].copy()  # RGB->BGR for cv2
   104	        uv = project(cam[i], tgt[i], W, H)
   105	        if in_frame(uv, W, H):
   106	            cv2.circle(img, (int(uv[0]), int(uv[1])), 8, (0, 255, 0), 2)
   107	        for j in range(dpos.shape[1]):
   108	            uv = project(cam[i], dpos[i, j], W, H)
   109	            if in_frame(uv, W, H):
   110	                col = (0, 255, 255) if j in similar_idx else (0, 0, 255)
   111	                cv2.circle(img, (int(uv[0]), int(uv[1])), 5, col, 2)
   112	        tiles.append(img)
   113	    rows = [np.hstack(tiles[k:k + 3]) for k in range(0, len(tiles) - len(tiles) % 3, 3)]
   114	    if rows:
   115	        grid = np.vstack(rows)
   116	        cv2.imwrite(os.path.join(out_dir, os.path.basename(path).replace(".h5", ".png")), grid)
   117	
   118	
   119	def main():
   120	    ap = argparse.ArgumentParser()
   121	    ap.add_argument("--data", required=True)
   122	    ap.add_argument("--previews", action="store_true")
   123	    args = ap.parse_args()
   124	
   125	    files = sorted(glob.glob(os.path.join(args.data, "*.h5")))
   126	    if not files:
   127	        print(f"No episodes in {args.data}")
   128	        return
   129	    prev = os.path.join(args.data, "qc_previews") if args.previews else None
   130	    rows = [qc_episode(p, prev) for p in files]
   131	
   132	    print(f"\n=== QC: {len(rows)} episodes in {args.data} ===")
   133	    for r in rows:
   134	        print(f"\n{r['file']}  [{r['class']}/{r['strategy']}]  n={r['n']} {r['res']}")
   135	        print(f"  target_in_frame       : {r['target_in_frame_rate']:.2%}")
   136	        print(f"  distractors (meta/sim): {r['num_distractors']}/{r['num_similar_meta']}")
   137	        print(f"  mean distractors in-frame: {r['mean_distractors_in_frame']:.2f}"
   138	              f"  (similar: {r['mean_similar_in_frame']:.2f})")
   139	        print(f"  frames w/ >=2 similar visible: {r['frames_with_2plus_similar']:.2%}")
   140	        print(f"  black_frames={r['black_frame_rate']:.2%}  nan_action={r['nan_in_action']}")
   141	        print(f"  lang: {r['language']}")
   142	
   143	    agg = lambda k: float(np.mean([r[k] for r in rows]))
   144	    print("\n=== AGGREGATE ===")
   145	    print(f"  target_in_frame_rate         : {agg('target_in_frame_rate'):.2%}")
   146	    print(f"  mean_similar_in_frame        : {agg('mean_similar_in_frame'):.2f}")
   147	    print(f"  frames_with_2plus_similar    : {agg('frames_with_2plus_similar'):.2%}")
   148	    print(f"  black_frame_rate             : {agg('black_frame_rate'):.2%}")
   149	    if prev:
   150	        print(f"  previews written to {prev}")
   151	
   152	
   153	if __name__ == "__main__":
   154	    main()

