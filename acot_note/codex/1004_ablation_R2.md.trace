     1	"""Simulated power for paired arm comparisons under the BIMODAL episode outcome observed in CARLA closed loop
     2	(1004_ablation_design.md §3.5). Per seed: opening correct ~ Bernoulli(p); open-right → hold (U[0.9,1]) w.p. h else
     3	drift (U[0,0.6]); open-wrong → recover (U[0.3,0.9]) w.p. r else stay (U[0,0.1]). Full: h=0.95, r=0.05; the ablated arm
     4	lowers h so that the total mean difference is Δ. Natural opening: each arm flips the reference opening independently
     5	w.p. `flip`. Hold events of the two arms are independent within a seed (conservative). Test: paired, two-sided,
     6	normal approximation at α (0.0125 = strictest Holm step for 4 comparisons).
     7	  python power_sim.py"""
     8	import numpy as np
     9	
    10	RNG = np.random.default_rng(0)
    11	Z = {0.05: 1.96, 0.025: 2.24, 0.0125: 2.50}
    12	
    13	
    14	def arm(open_ok, h, r):
    15	    n = len(open_ok); u = RNG.random(n)
    16	    hold, drift = RNG.uniform(0.9, 1.0, n), RNG.uniform(0.0, 0.6, n)
    17	    rec, stay = RNG.uniform(0.3, 0.9, n), RNG.uniform(0.0, 0.1, n)
    18	    return np.where(open_ok, np.where(u < h, hold, drift), np.where(u < r, rec, stay))
    19	
    20	
    21	def power(n, dtot, natural, alpha, p=0.55, h_full=0.95, r=0.05, flip=0.10, sims=4000):
    22	    mean_right = lambda h: h * 0.95 + (1 - h) * 0.3
    23	    h_abl = (mean_right(h_full) - dtot / p - 0.3) / 0.65
    24	    hits = 0
    25	    for _ in range(sims):
    26	        o = RNG.random(n) < p
    27	        o_f = o ^ (RNG.random(n) < flip) if natural else o
    28	        o_a = o ^ (RNG.random(n) < flip) if natural else o
    29	        d = arm(o_f, h_full, r) - arm(o_a, h_abl, r)
    30	        hits += d.mean() - Z[alpha] * d.std(ddof=1) / np.sqrt(n) > 0
    31	    return hits / sims
    32	
    33	
    34	if __name__ == "__main__":
    35	    print("n   Δ     setting   α=0.05  α=0.025  α=0.0125")
    36	    for n in (40, 60, 80):
    37	        for dt in (0.10, 0.15, 0.20):
    38	            for nat in (False, True):
    39	                print(f"{n:3d} {dt:.2f}  {'natural' if nat else 'shared '}   "
    40	                      + "  ".join(f"{power(n, dt, nat, a):.2f}" for a in (0.05, 0.025, 0.0125)))

