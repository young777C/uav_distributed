    88	class TAHRelM(nn.Module):
    89	    """TAHRel + LEARNED motion-consensus (path-A upgrade, distills borrow#1). TAHRel already had a raw
    90	    relative-displacement feature but (a) fed the MLP only unbounded relp_x/relp_y — not a well-scaled
    91	    distance/gated consensus — and (b) used a noisy single-step velocity. This adds the two things
    92	    borrow#1's hand-tuned motion gate supplies, but LEARNED: an explicit gate-normalized soft motion
    93	    score msoft = exp(−‖relp‖/gate) (bounded 0–1, learned radius) + the raw distance ‖relp‖, and an EMA
    94	    velocity (learned decay) robust across losses. Targets the ONE metric TAHRel loses (q_reacq / re-
    95	    acquisition), where DeepSORT & borrow#1 win via an explicit motion prior. 7 vehicle-invariant
    96	    features; ~4.7K params (still cannot overfit). Same step/update signature → train & deploy unchanged."""
    97	    def __init__(self, d_feat=384):
    98	        super().__init__()
    99	        self.gate = nn.Parameter(torch.tensor(-1.0))          # appearance-memory EMA gate (sigmoid)
   100	        self.vbeta = nn.Parameter(torch.tensor(0.0))          # EMA velocity decay (sigmoid)
   101	        self.mgate = nn.Parameter(torch.tensor(-2.3))         # soft motion-gate radius (softplus, img-frac)
   102	        self.mlp = nn.Sequential(nn.Linear(7, 64), nn.GELU(), nn.Linear(64, 64), nn.GELU(), nn.Linear(64, 1))
   103	
   104	    def reset(self, device):
   105	        return {"app": None, "pos": None, "vel": None}
   106	
   107	    def step(self, feat, pos, mem):
   108	        """feat:(n,384) L2-normed; pos:(n,3)=[u/W,v/H,depth]; mem dict. Returns logits:(n,), conf, None."""
   109	        n = feat.shape[0]; dev = feat.device
   110	        if mem["app"] is None:                                # cold start: no target memory yet
   111	            cos = torch.zeros(n, device=dev); relp = torch.zeros(n, 2, device=dev)
   112	            rank = torch.zeros(n, device=dev); dmot = torch.zeros(n, device=dev); msoft = torch.zeros(n, device=dev)
   113	        else:
   114	            cos = feat @ mem["app"]                           # relative appearance (vehicle-agnostic cosine)
   115	            pred = mem["pos"] + (mem["vel"] if mem["vel"] is not None else torch.zeros(2, device=dev))
   116	            relp = pos[:, :2] - pred[None]                    # relative motion (candidate vs CV-predicted target)
   117	            rank = torch.softmax(cos * 5.0, dim=0)            # relative-to-neighbors (star-topology, GNN-style)
   118	            dmot = relp.norm(dim=-1)                          # distance from CV prediction
   119	            gate = F.softplus(self.mgate) + 1e-3
   120	            msoft = torch.exp(-dmot / gate)                   # borrow#1-style bounded soft motion consensus (learned radius)
   121	        x = torch.stack([cos, relp[:, 0], relp[:, 1], pos[:, 2], rank, dmot, msoft], dim=-1)  # (n,7) all invariant
   122	        logits = self.mlp(x).squeeze(-1)
   123	        srt = torch.sort(logits, descending=True).values
   124	        conf = torch.sigmoid(srt[0] - srt[1]) if n >= 2 else torch.tensor(1.0, device=dev)
   125	        return logits, conf, None
   126	
   127	    def update(self, mem, target_feat, target_pos):
   128	        g = torch.sigmoid(self.gate); m = dict(mem)
   129	        if m["app"] is None:
   130	            m["app"] = target_feat.clone()
   131	        else:
   132	            a = (1 - g) * m["app"] + g * target_feat
   133	            m["app"] = a / (a.norm() + 1e-8)
   134	        npos = target_pos[:2]
   135	        step_v = (npos - m["pos"]) if m["pos"] is not None else torch.zeros(2, device=target_feat.device)
   136	        if m["vel"] is None:
   137	            m["vel"] = step_v
   138	        else:
   139	            b = torch.sigmoid(self.vbeta)
   140	            m["vel"] = (1 - b) * m["vel"] + b * step_v        # EMA velocity — robust across losses
   141	        m["pos"] = npos
   142	        return m
     1	"""Train the Temporal Association Head (TAH, path-B). Supervised association over episode sequences:
     2	roll the recurrent memory over frames, predict the target candidate (CE vs GT tidx), teacher-force the
     3	memory update from the GT target embedding. Off-screen frames (tidx=-1) hold memory + skip loss.
     4	Reports val target-accuracy + mis_follow (1-acc) to compare vs the heuristic stack."""
     5	from __future__ import annotations
     6	import argparse, os, sys
     7	import numpy as np
     8	
     9	_REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    10	if _REPO not in sys.path: sys.path.insert(0, _REPO)
    11	
    12	
    13	def run_epoch(model, episodes, opt, device, train=True, rel=False, fnoise=0.0, pjit=0.0, perm=False):
    14	    import torch
    15	    model.train(train)
    16	    tot_loss = n_loss = correct = total = 0
    17	    order = np.random.permutation(len(episodes)) if train else range(len(episodes))
    18	    for ei in order:
    19	        frames = episodes[ei]
    20	        m = model.reset(device)
    21	        losses = []
    22	        for fr in frames:
    23	            feat = torch.tensor(np.asarray(fr["feat"], np.float32), device=device)
    24	            pos = torch.tensor(fr["pos"], device=device)
    25	            tidx = int(fr["tidx"])
    26	            if train:                                               # Tier-2 augmentation (train only)
    27	                if fnoise > 0:
    28	                    feat = feat + fnoise * torch.randn_like(feat); feat = feat / (feat.norm(dim=-1, keepdim=True) + 1e-8)
    29	                if pjit > 0:
    30	                    pos = pos.clone(); pos[:, :2] = pos[:, :2] + pjit * torch.randn_like(pos[:, :2])
    31	                if perm and feat.shape[0] > 1:                      # candidate-order permutation invariance
    32	                    p = torch.randperm(feat.shape[0], device=device)
    33	                    feat, pos = feat[p], pos[p]
    34	                    if tidx >= 0: tidx = int((p == tidx).nonzero()[0])
    35	            logits, conf, e = model.step(feat, pos, m)
    36	            if tidx >= 0:
    37	                losses.append(torch.nn.functional.cross_entropy(logits.unsqueeze(0),
    38	                              torch.tensor([tidx], device=device)))
    39	                pred = int(logits.argmax()); correct += (pred == tidx); total += 1
    40	                if rel:
    41	                    m = model.update(m, feat[tidx], pos[tidx])                   # TAHRel: DINOv2 feat + pos
    42	                else:
    43	                    m = model.update(m, e[tidx].detach() if not train else e[tidx])
    44	            # tidx<0 (target off-screen): hold memory, no loss
    45	        if losses:
    46	            loss = torch.stack(losses).mean()
    47	            if train:
    48	                opt.zero_grad(); loss.backward()
    49	                torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0); opt.step()
    50	            tot_loss += float(loss); n_loss += 1
    51	    return tot_loss / max(n_loss, 1), correct / max(total, 1)
    52	
    53	
    54	def main():
    55	    ap = argparse.ArgumentParser()
    56	    ap.add_argument("--cache", default="runs/tah_cache.pt")
    57	    ap.add_argument("--out", default="runs/tah.pt")
    58	    ap.add_argument("--epochs", type=int, default=40)
    59	    ap.add_argument("--lr", type=float, default=3e-4)
    60	    ap.add_argument("--val-frac", type=float, default=0.15)
    61	    ap.add_argument("--rel", action="store_true", help="Tier-1: use TAHRel (relative/vehicle-invariant features)")
    62	    ap.add_argument("--motion", action="store_true", help="path-A: use TAHRelM (TAHRel + learned motion-consensus + EMA vel)")
    63	    ap.add_argument("--aug", action="store_true", help="Tier-2: candidate-permutation + feature-noise + pos-jitter")
    64	    ap.add_argument("--fnoise", type=float, default=0.05)
    65	    ap.add_argument("--pjit", type=float, default=0.02)
    66	    ap.add_argument("--wd", type=float, default=1e-4)
    67	    ap.add_argument("--device", default="cuda:0")
    68	    a = ap.parse_args()
    69	    import torch
    70	    from train.tah import TAH, TAHRel, TAHRelM
    71	    data = torch.load(a.cache, weights_only=False)
    72	    eps = data["episodes"]
    73	    nval = max(1, int(len(eps) * a.val_frac))
    74	    val, tr = eps[:nval], eps[nval:]
    75	    arch = "relm" if a.motion else ("rel" if a.rel else "abs")
    76	    print(f"[tah] {len(tr)} train / {len(val)} val episodes; d_feat={data['d_feat']}; "
    77	          f"arch={arch} aug={a.aug} (fnoise={a.fnoise} pjit={a.pjit})", flush=True)
    78	    rel = a.rel or a.motion   # both TAHRel/TAHRelM use the relative update path in run_epoch
    79	    a.rel = rel
    80	    model = (TAHRelM(d_feat=data["d_feat"]) if a.motion else
    81	             TAHRel(d_feat=data["d_feat"]) if a.rel else TAH(d_feat=data["d_feat"])).to(a.device)
    82	    print(f"[tah] params: {sum(p.numel() for p in model.parameters())}", flush=True)
    83	    opt = torch.optim.AdamW(model.parameters(), lr=a.lr, weight_decay=a.wd)
    84	    fn, pj, pm = (a.fnoise, a.pjit, True) if a.aug else (0.0, 0.0, False)
    85	    best = 0.0
    86	    for ep in range(a.epochs):
    87	        tl, ta = run_epoch(model, tr, opt, a.device, train=True, rel=a.rel, fnoise=fn, pjit=pj, perm=pm)
    88	        with torch.no_grad():
    89	            vl, va = run_epoch(model, val, opt, a.device, train=False, rel=a.rel)
    90	        if va > best:
    91	            best = va; torch.save({"model": model.state_dict(), "d_feat": data["d_feat"], "arch": arch}, a.out)
    92	        print(f"[tah] ep{ep+1}/{a.epochs} train_loss={tl:.3f} train_acc={ta:.3f} | "
    93	              f"val_acc={va:.3f} (mis={1-va:.3f}) best={best:.3f}", flush=True)
    94	    print(f"[tah] done. best val_acc={best:.3f} (mis_follow={1-best:.3f}) → {a.out}", flush=True)
    95	    print(f"[tah] compare vs heuristic stack: l5 offline mis ~0.26 (1-0.738); reid-dino gallery.", flush=True)
    96	
    97	
    98	if __name__ == "__main__":
    99	    main()

