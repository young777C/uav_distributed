   146	        self._scorer.reset(metadata)
   147	        if self._predict_road:                         # P2a-1: env-side road-graph predictor
   148	            from rollout.road_predictor import RoadPredictor
   149	            self._road = RoadPredictor(self._world.get_map(), self._road_offsets_s, self._fps)
   150	            self._road.reset()
   151	
   152	        start = time.time()

