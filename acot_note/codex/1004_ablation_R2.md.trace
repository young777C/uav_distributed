   190	    def _filter_step(self, aidx, mem_slot, mem_conf, true_slot, t):
   191	        ids = [int(a) for a in aidx]; act = ids[mem_slot]; b = self.belief
   192	        if self.filter_kind in ("resid", "tempered"):
   193	            # TEMPERED evidence accumulator (PGIF main): L_k <- lam*L_k + w_t*1[k = memory pick]. Self-update makes
   194	            # the memory's errors autocorrelated, so per-tick evidence must be tempered (lam ~ 1 - 1/tau_corr)
   195	            # instead of multiplied as if independent (the untempered 'bayes' ablation flips in 1-2 ticks).
   196	            # w_t = 0.5 + rank(conf) (scale-free) for 'tempered'; w_t = 1 for the 'resid' ablation.
   197	            c = 0.0 if mem_conf is None else float(mem_conf); h = self.conf_hist
   198	            pct = float(np.searchsorted(np.sort(h), c)) / len(h) if len(h) >= 5 else 0.5
   199	            self.conf_hist = (h + [c])[-self.conf_window:]
   200	            w = 1.0 if self.filter_kind == "resid" else 0.5 + pct
   201	            for k in b:
   202	                b[k] *= self.resid_decay
   203	            b[act] = b.get(act, 0.0) + w
   204	            map_slot = max(range(len(ids)), key=lambda s_: b.get(ids[s_], 0.0))
   205	            fire = map_slot != mem_slot
   206	            self.fires += int(fire); self.tick += 1
   207	            self._log(t, aidx, mem_slot, mem_conf, true_slot, None, map_slot, fire)
   208	            return {"fire": fire, "slot": map_slot, "kind": "gate", "gate_memory": self.gate_memory}
   209	        for a in ids:                                            # new tracklets enter with a tiny prior
   210	            b.setdefault(a, 1e-3 if b else 1.0)
   211	        tot = sum(b.values()); m = len(b)
   212	        for k in b:                                              # sticky identity transition
   213	            b[k] = (1 - self.eps_switch) * b[k] / tot + self.eps_switch / m
   214	        c = 0.0 if mem_conf is None else float(mem_conf)
   215	        h = self.conf_hist
   216	        pct = float(np.searchsorted(np.sort(h), c)) / len(h) if len(h) >= 5 else 0.5
   217	        self.conf_hist = (h + [c])[-self.conf_window:]
   218	        q = self.q_hi - (self.q_hi - self.q_lo) * pct           # confident pick → lower error rate
   219	        nv = len(ids)
   220	        for k in b:
   221	            b[k] *= (1 - q) if k == act else q / max(nv - 1, 1)
   222	        tot = sum(b.values())

