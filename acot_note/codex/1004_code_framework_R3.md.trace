   170	def lit(node):
   171	    if node is None:
   172	        return "REQUIRED"
   173	    try:
   174	        return repr(ast.literal_eval(node))
   175	    except Exception:
   176	        return ast.unparse(node) if hasattr(ast, "unparse") else "<expr>"
   177	
   178	
   179	def classify(name, cat="runtime"):
   180	    if name in TEST:
   181	        return "test"
   182	    if name in INFRA or (name.startswith("--") and INFRA_FLAG.match(name)):
   183	        return "infra"
   184	    if cat in ("test", "other-owner", "analysis"):
   185	        return cat
   186	    if name in INJECTED:
   187	        return "injected"
   188	    if name in COLLECT:
   189	        return "collection"
   190	    if name in DIAG:
   191	        return "diagnostic"
   192	    if name in DIAG_VALUE:
   193	        return DIAG_VALUE[name]
   194	    if cat in ("offline", "datagen"):
   195	        return "artefact" if (name.startswith("--") and ARTEFACT_FLAG.match(name)) else cat
   196	    if name == "--out":
   197	        return "artefact"
   198	    return "scientific"
