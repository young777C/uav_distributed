   246	def env_rows(pyfiles):
   247	    rows, dyn = {}, []
   248	    rd = re.compile(r"""os\.(?:environ\.get|getenv)\(\s*['"](\w+)['"]\s*(?:,\s*([^)]*))?\)|os\.environ\[\s*['"](\w+)['"]\s*\](?!\s*=[^=])""")
   249	    wr = re.compile(r"""os\.environ\[\s*['"](\w+)['"]\s*\]\s*=[^=]|os\.environ\.setdefault\(\s*['"](\w+)['"]""")
   250	    dw = re.compile(r"""os\.environ\[\s*([A-Za-z_]\w*)\s*\]\s*=[^=]""")
   251	    for f in pyfiles:
   252	        cat = category(f)
   253	        for i, line in enumerate(open(os.path.join(ROOT, f), errors="ignore"), 1):
   254	            for m in rd.finditer(line):
   255	                var = m.group(1) or m.group(3)
