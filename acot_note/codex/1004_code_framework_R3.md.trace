   229	def signature_rows():
   230	    rows = []
   231	    for f, cname, meth, src in SIGNATURES:
   232	        for n in ast.walk(ast.parse(open(os.path.join(ROOT, f)).read())):
   233	            if isinstance(n, ast.ClassDef) and n.name == cname:
   234	                for m in n.body:
   235	                    if isinstance(m, ast.FunctionDef) and m.name == meth:
   236	                        pos = m.args.args[1:]
   237	                        pdef = [None] * (len(pos) - len(m.args.defaults)) + list(m.args.defaults)
   238	                        for a, d in list(zip(pos, pdef)) + list(zip(m.args.kwonlyargs, m.args.kw_defaults)):
   239	                            rows.append((f"{f}:{m.lineno}", src, a.arg, lit(d), classify(a.arg)))
   240	    for i, line in enumerate(open(os.path.join(ROOT, f"{R}/policy.py")), 1):
   241	        for k, d in re.findall(r'ocfg\.pop\("(\w+)",\s*([^)]+)\)', line):
   242	            rows.append((f"{R}/policy.py:{i}", "OPENING_CFG (popped by Policy)", k, d.strip(), "scientific"))
   243	    return rows
   244	
