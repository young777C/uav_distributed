     1	#!/usr/bin/env bash
     2	# Watchdog launcher: like launch.sh, but if no new episode finishes for STALL_MIN minutes (FIRST_MIN for the first
     3	# one, incl. server start-up), kill the arm, restart its CARLA server and RESUME from the next unfinished seed.
     4	# Parts are saved separately (paper_it_<name>_p<k>.json[.partial], <name>_p<k>.jsonl) and merged into paper_it_<name>.json.
     5	#   usage: launch_wd.sh <name> <carla_port> <gpu> <tm_port> <town> <head_args> [asd_cfg]
     6	# env: SEED_BASE (91000) EPISODES (20) STALL_MIN (12) FIRST_MIN (20) + COLD_*/V1_SELFRESET passthrough
     7	cd /nvidia/hque/code/cyhe/uav-acot-track; R=carla_uav_tracking/rollout; L=runs/asd/iter; EO=$R/eval_out
     8	NAME=$1; CP=$2; GPU=$3; TM=$4; TOWN=$5; HEAD=$6; CFG=${7:-}
     9	B=${SEED_BASE:-91000}; N=${EPISODES:-20}; STALL=$(( ${STALL_MIN:-12} * 60 )); FIRST=$(( ${FIRST_MIN:-20} * 60 ))
    10	declare -A ADAPTER=([2000]=0 [2010]=2 [2020]=3 [2040]=5 [2030]=4 [2050]=6 [2060]=7 [2070]=0 [2080]=3 [2090]=5 [2230]=0 [2250]=3)
    11	restart_carla() {
    12	  docker exec cyh-carla pkill -9 -f "carla-rpc-port=$CP( |$)" ; sleep 5
    13	  docker exec -d cyh-carla bash -c "/home/carla/CarlaUE4.sh -RenderOffScreen -graphicsadapter=${ADAPTER[$CP]} -carla-rpc-port=$CP -nosound -fps=20 > /tmp/carla_$CP.log 2>&1"
    14	  for i in $(seq 1 60); do
    15	    docker exec cyh-carla python -c "import socket;s=socket.socket();s.settimeout(2);s.connect(('127.0.0.1',$CP))" 2>/dev/null && break; sleep 10
    16	  done; sleep 20
    17	  docker exec cyh-carla python -c "import carla;c=carla.Client('127.0.0.1',$CP);c.set_timeout(180);c.load_world('$TOWN')" \
    18	    && echo "[$(date +%H:%M)] CARLA $CP restarted, $TOWN preloaded" >> $L/progress.log
    19	}
    20	count_done() { python3 - "$1" <<'EOF'
    21	import json, os, sys
    22	p = sys.argv[1]
    23	for f in (p, p + ".partial"):
    24	    if os.path.exists(f):
    25	        print(len(json.load(open(f))["episodes"])); break
    26	else:
    27	    print(0)
    28	EOF
    29	}
    30	echo "[$(date +%H:%M)] start $NAME ($TOWN) [watchdog]" >> $L/progress.log
    31	done_eps=0; part=${START_PART:-1}; parts=""; P0=$part   # START_PART: resume after a host reboot without overwriting earlier parts
    32	while [ $done_eps -lt $N ]; do
    33	  out=paper_it_${NAME}_p$part; log=$L/${NAME}_p$part.log; parts="$parts $EO/$out.json"
    34	  TOWN=$TOWN TM_PORT=$((TM + 10 * (part - 1))) ASD_CFG=$CFG SRV=it-$NAME CARLA_PORT=$CP GPU=$GPU OUT_NAME=$out \
    35	    SEED_BASE=$((B + done_eps)) EPISODES=$((N - done_eps)) ASD_LOG=$PWD/$L/${NAME}_p$part.jsonl HEAD_ARGS="$HEAD" \
    36	    setsid bash $R/eval_asd.sh > $log 2>&1 < /dev/null &
    37	  EV=$!; last=$(date +%s); seen=0; limit=$FIRST; hung=0
    38	  while kill -0 $EV 2>/dev/null; do
    39	    sleep 30; c=$(grep -cE 'ep[0-9]+ seed' $log)
    40	    if [ "$c" -gt "$seen" ]; then seen=$c; last=$(date +%s); limit=$STALL; fi
    41	    if [ $(( $(date +%s) - last )) -gt $limit ]; then hung=1; break; fi
    42	  done
    43	  if [ $hung = 1 ]; then
    44	    echo "[$(date +%H:%M)] HANG $NAME part$part after $seen eps on CARLA $CP → restart + resume" >> $L/progress.log
    45	    pkill -TERM -s $(ps -o sid= -p $EV | tr -d ' ') 2>/dev/null; kill $EV 2>/dev/null
    46	    docker exec cyh-carla pkill -f "policy-host it-$NAME " ; docker rm -f it-$NAME >/dev/null 2>&1
    47	    restart_carla
    48	  fi
    49	  wait $EV 2>/dev/null
    50	  k=$(count_done $EO/$out.json); done_eps=$((done_eps + k)); part=$((part + 1))
    51	  if [ $hung = 0 ] && [ "$k" = 0 ] && [ $done_eps -lt $N ]; then
    52	    # client died without finishing an episode (e.g. simulator time-out after a mid-tick client death leaves the
    53	    # sync-mode server wedged) → restart the server before the next part instead of reconnecting to a dead one
    54	    echo "[$(date +%H:%M)] FAILED-0ep $NAME part$((part - 1)) on CARLA $CP → restart CARLA + resume" >> $L/progress.log
    55	    docker exec cyh-carla pkill -f "policy-host it-$NAME " ; docker rm -f it-$NAME >/dev/null 2>&1
    56	    restart_carla
    57	  fi
    58	  [ $part -gt $((P0 + 5)) ] && { echo "[$(date +%H:%M)] GIVE UP $NAME after 5 restarts" >> $L/progress.log; break; }
    59	done
    60	python3 - $EO/paper_it_$NAME.json $parts <<'EOF'
    61	import glob, json, os, re, sys
    62	out = sys.argv[1]; eps = []
    63	# merge EVERY part of this arm (incl. parts written by an earlier invocation before a resume), ordered by part number
    64	parts = sorted({re.sub(r"\.partial$", "", p) for p in glob.glob(out[:-5] + "_p[0-9]*.json*")},
    65	               key=lambda p: int(re.search(r"_p(\d+)\.json$", p).group(1)))
    66	for p in parts:
    67	    for f in (p, p + ".partial"):
    68	        if os.path.exists(f):
    69	            eps += json.load(open(f))["episodes"]; break
    70	json.dump({"episodes": eps, "merged_from": parts}, open(out, "w"), indent=2, default=str)
    71	print(f"merged {len(eps)} episodes -> {out}")
    72	EOF
    73	echo "[$(date +%H:%M)] done  $NAME :: $done_eps eps this run (from part $P0), $(cat $L/${NAME}_p*.log | grep -c SKIP) skip total, parts=$((part - 1))" >> $L/progress.log
     1	#!/usr/bin/env bash
     2	# ASD (Anchored Sequential Drift-correction) PoC closed-loop eval — parametric, parallel-safe.
     3	# Each run = its own policy-server container (SRV) + its own CARLA server (CARLA_PORT) → many arms in parallel.
     4	#   SRV=asd-a0 CARLA_PORT=2000 GPU=1 OUT_NAME=paper_asd_x HEAD_ARGS="--tid-head tah ..." bash eval_asd.sh
     5	set -uo pipefail
     6	REPO=/nvidia/hque/code/cyhe/uav-acot-track; DATA=/nvidia/hque/data/carla_data
     7	HF=${HF_CACHE:-$HOME/.cache/huggingface}; NET=cyh-carla-net; CONFIG=train/config_v5.yaml
     8	EPISODES=${EPISODES:-20}; SEED_BASE=${SEED_BASE:-91000}; STEPS=${STEPS:-900}
     9	TOWN=${TOWN:-Town05}; S2=${S2_PERIOD:-6}; GPU=${GPU:-1}; SRV=${SRV:-asd-srv}; CARLA_PORT=${CARLA_PORT:-2000}
    10	OUT_NAME=${OUT_NAME:?}; HEAD_ARGS=${HEAD_ARGS:?}; ASD_LOG=${ASD_LOG:-}
    11	OUT=/workspace/rollout/eval_out/${OUT_NAME}.json
    12	docker rm -f $SRV >/dev/null 2>&1 || true
    13	docker run -d --gpus device=$GPU --network "$NET" --name $SRV --shm-size=16g \
    14	  -e NVIDIA_DRIVER_CAPABILITIES=compute,utility -e ASD_LOG="$ASD_LOG" -e ASD_CFG="${ASD_CFG:-}" -e COLD_WINDOW="${COLD_WINDOW:-0}" -e COLD_LAMBDA="${COLD_LAMBDA:-0.9}" -e COLD_SINGLE="${COLD_SINGLE:-0}" -e V1_SELFRESET="${V1_SELFRESET:-0}" -e DAM4SAM_DIAG="${DAM4SAM_DIAG:-0}" -e DAM4SAM_EVERY_FRAME="${DAM4SAM_EVERY_FRAME:-0}" -e TRK_CFG="${TRK_CFG:-}" -e OPENING_DUMP="${OPENING_DUMP:-}" -e OPENING="${OPENING:-head}" -e OPENING_CFG="${OPENING_CFG:-}" -e ORACLE_ABSENT="${ORACLE_ABSENT:-0}" -e TAH_DAGGER_DIR="${TAH_DAGGER_DIR:-}" -e OMP_NUM_THREADS=${NTHR:-6} -e MKL_NUM_THREADS=${NTHR:-6} \
    15	  -v "$REPO":"$REPO" -v "$DATA":"$DATA":ro -v "$HF":/root/.cache/huggingface -w "$REPO" \
    16	  acot-uav-train:cu118 bash -c "pip install -q timm==1.0.29 2>/dev/null; \
    17	    python carla_uav_tracking/rollout/policy_server.py --config '$CONFIG' \
    18	    --ckpt runs/stage2_v5/stage2_best.pt --language-mode neutral --s2-period '$S2' \
    19	    --ex-source track $HEAD_ARGS --port 5555" >/dev/null
    20	for _ in $(seq 1 150); do
    21	  docker logs $SRV 2>&1 | grep -q "listening" && break
    22	  docker ps --format '{{.Names}}' | grep -q "^$SRV\$" || { echo "server died:"; docker logs $SRV|tail -25; exit 1; }
    23	  sleep 3
    24	done
    25	echo "=== [$OUT_NAME] $EPISODES ep seed=$SEED_BASE town=$TOWN carla=$CARLA_PORT gpu=$GPU :: $HEAD_ARGS ==="
    26	docker exec -e DUMP_LABELS="${DUMP_LABELS:-}" -e CARLA_PORT=$CARLA_PORT -e CARLA_TM_PORT=${TM_PORT:-$((CARLA_PORT+6000))} cyh-carla python /workspace/rollout/run_rollout.py --policy-host $SRV \
    27	  --policy-port 5555 --episodes "$EPISODES" --seed-base "$SEED_BASE" --steps "$STEPS" --town "$TOWN" --out "$OUT" ${VIS_RAYCAST:+--vis-raycast} ${HIRES:+--hires $HIRES} || echo FAILED
    28	docker logs $SRV 2>&1 | grep -E "\[asd\]|\[reanchor\]|Traceback|Error" | tail -40
    29	docker rm -f $SRV >/dev/null 2>&1 || true
    30	echo "=== DONE $OUT_NAME ==="
     1	#!/usr/bin/env bash
     2	# Closed-loop OPENING validation (1004 opening fix): short episodes (STEPS=19 → S2 ticks 0/6/12/18) with the FINAL
     3	# deployable model config (TAH + PGIF tempered + absent-hold, tuned tracker ids, ray-cast occlusion-aware candidates)
     4	# and the opening scorer under test. Held-out seeds (never used for training / selection).
     5	#   usage: run_openval.sh <tag> <k> <carla_port> <gpu> <seed_base> <episodes> <OPENING> '<OPENING_CFG>'
     6	cd /nvidia/hque/code/cyhe/uav-acot-track; D=runs/opening_dump
     7	tag=$1; k=$2; CP=$3; G=$4; SB=$5; N=$6
     8	export OPENING=$7 OPENING_CFG="$8" VIS_RAYCAST=1 HIRES=3
     9	export TRK_CFG='{"max_age":8,"w_app":0.85,"gate_px":150,"gate_box":2.0,"min_cos":0.2}'
    10	SRV=ov-$tag-$k CARLA_PORT=$CP GPU=$G TM_PORT=$((9600 + 10 * k)) OUT_NAME=open_val_${tag}_$k EPISODES=$N SEED_BASE=$SB STEPS=19 \
    11	  ASD_CFG='{"filter_kind":"tempered","resid_decay":0.98,"absent_hold":true,"absent_max":8}' ASD_LOG=$PWD/$D/val/${tag}_$k.jsonl \
    12	  HEAD_ARGS="--tid-head tah --tah-ckpt runs/tah_relm_dag.pt --conf-tau 0.5 --gallery-seed committed --reanchor off --occl-cands --tracklets tracker --asd filter" \
    13	  bash carla_uav_tracking/rollout/eval_asd.sh > $D/logs/ov_${tag}_$k.log 2>&1 < /dev/null
    14	echo "[$(date +%H:%M)] openval $tag $k done" >> $D/logs/progress.log
     1	#!/usr/bin/env bash
     2	# TAHRelM FOV-fix retrain pipeline v3 (2026-10-04 00:05): caches already built (off90.pt 64 eps 90°, dag_old.pt, dag_v2.pt).
     3	#  3. train TAHRelM (--motion --aug, 60 epochs, val = first 15% of the offline cache as before; --save-last), seeds 0/1/2
     4	#  4. dev gate on dev 91000–19 under the final protocol (v1 opening, deploy v2), paired with the v1 arm zoa_pgif_trk_*:
     5	#     s0 BEST-by-val (zv90s0_*; 4 servers × 5) and s0 LAST-epoch (zv90s0L_*; 3 servers × 7/7/6) — the offline val split
     6	#     saturates at ~0.99 from epoch 1, so best-by-val may be an arbitrary early epoch.
     7	set -u
     8	R=/nvidia/hque/code/cyhe/uav-acot-track; D=$R/runs/tah_v90; L=$R/runs/asd/iter; LOG=$D/logs/pipeline.log
     9	cd $R; log() { echo "[$(date +%H:%M)] $*" >> $LOG; }
    10	log "v3: training 3 seeds (--save-last)"
    11	k=0; for g in 1 2 4; do
    12	  docker run --rm --network cyh-carla-net --gpus device=$g -v $R:$R -w $R acot-uav-train:cu118 python train/tah_train.py --motion --aug --epochs 60 \
    13	    --cache $D/off90.pt $D/dag_old.pt $D/dag_v2.pt --seed $k --save-last --out $D/tah_relm_v90_s$k.pt --device cuda:0 > $D/logs/train_s$k.log 2>&1 &
    14	  k=$((k + 1)); sleep 3
    15	done; wait
    16	log "trained: $(for s in 0 1 2; do grep 'done. best' $D/logs/train_s$s.log | cut -c8-60; done | tr '\n' ' ')"
    17	TRK='{"max_age":8,"w_app":0.85,"gate_px":150,"gate_box":2.0,"min_cos":0.2}'
    18	H='{"filter_kind":"tempered","resid_decay":0.98,"absent_hold":true,"absent_max":8}'
    19	export VIS_RAYCAST=1 HIRES=3 FIRST_MIN=25 OPENING=attr OPENING_CFG='{"window":3,"ft":0.5}' TRK_CFG="$TRK"
    20	arm() {  # name ckpt port gpu tm seed_base n
    21	  TAH="--tid-head tah --tah-ckpt $2 --conf-tau 0.5 --gallery-seed committed --reanchor off --occl-cands --tracklets tracker"
    22	  SEED_BASE=$6 EPISODES=$7 bash $L/launch_wd.sh $1 $3 $4 $5 Town05 "$TAH --asd filter" "$H"
    23	}
    24	B=runs/tah_v90/tah_relm_v90_s0.pt; LST=runs/tah_v90/tah_relm_v90_s0_last.pt
    25	arm zv90s0_pgif_trk_a $B 2050 6 9301 91000 5 & sleep 2
    26	arm zv90s0_pgif_trk_b $B 2060 7 9331 91005 5 & sleep 2
    27	arm zv90s0_pgif_trk_c $B 2070 6 9361 91010 5 & sleep 2
    28	arm zv90s0_pgif_trk_d $B 2080 7 9391 91015 5 & sleep 2
    29	arm zv90s0L_pgif_trk_a $LST 2090 3 9421 91000 7 & sleep 2
    30	arm zv90s0L_pgif_trk_b $LST 2230 3 9451 91007 7 & sleep 2
    31	arm zv90s0L_pgif_trk_c $LST 2250 0 9481 91014 6 &
    32	wait
    33	log "dev gate done"
    34	cd $R/carla_uav_tracking/rollout
    35	{ echo "== s0 BEST-by-val vs v1 (old ckpt)"; python3 opening_ds.py zv90s0_pgif_trk_a zv90s0_pgif_trk_b zv90s0_pgif_trk_c zv90s0_pgif_trk_d | head -6
    36	  echo "== s0 LAST-epoch vs v1 (old ckpt)"; python3 opening_ds.py zv90s0L_pgif_trk_a zv90s0L_pgif_trk_b zv90s0L_pgif_trk_c | head -6; } >> $LOG 2>&1
    37	log "pipeline done"

