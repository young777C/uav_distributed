   265	def launcher_rows(shfiles):
   266	    rows = []
   267	    for f in shfiles:
   268	        txt = open(os.path.join(ROOT, f), errors="ignore").read()
   269	        me = os.path.basename(f)
   270	        entry = sorted(set(m for m in re.findall(r"(?:python[0-9.]*|bash|sh)\s+(?:-u\s+)?([\w./$-]+\.(?:py|sh))", txt)
   271	                           if os.path.basename(m) != me))
   272	        mods = sorted(set(re.findall(r"python[0-9.]*\s+-m\s+([\w.]+)", txt)))
   273	        docker = [d for d in ("docker run", "docker exec", "docker rm", "docker start", "docker compose", "docker network")
   274	                  if d in txt]
   275	        flags = sorted(set(re.findall(r"(?<![\w-])(--[a-z][a-z0-9-]*)", txt)))
   276	        envs = sorted(set(re.findall(r"\b(ASD_CFG|TRK_CFG|OPENING_CFG|OPENING|ORACLE_ABSENT|TAH_DAGGER_DIR|DAGGER_DIR|"
   277	                                     r"COLD_WINDOW|COLD_LAMBDA|COLD_SINGLE|V1_SELFRESET|DAM4SAM_EVERY_FRAME|DAM4SAM_DIAG|"
   278	                                     r"OPENING_DUMP|DUMP_LABELS|HIRES|VIS_RAYCAST|S2_PERIOD|SEED_BASE|EPISODES|STEPS|TOWN|"
   279	                                     r"HEAD_ARGS|CONFIG)=(?![\"']?\$\{\1\b)", txt)))
   280	        knobs = sorted(set(re.findall(r"\$\{([A-Za-z_]\w*)(?::?[-?+=])", txt)))
   281	        pos = sorted(set(re.findall(r"\$\{?([1-9])\b", txt)))
   282	        rows.append((f, ", ".join(entry + [f"-m {m}" for m in mods]) or "—", ", ".join(docker) or "—",
   283	                     " ".join(flags) or "—", " ".join(envs) or "—", " ".join(knobs) or "—",
   284	                     " ".join(f"${x}" for x in pos) or "—"))
   285	    return rows
