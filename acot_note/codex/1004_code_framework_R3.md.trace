    98	class Policy:
    99	    def __init__(self, ckpt_path: str, cfg: dict, vlm, *, device: str = "cuda:0",
   100	                 s2_period: int = 1, shuffle_seed: int = 0, ablate: str | None = None,
   101	                 ex_source: str = "ear", commit_k: int = 5,
   102	                 tid_head: str = "xattn", tid_ckpt: str | None = None,
   103	                 reid_feature: str = "vlmpool", reid_bank: int = 1, reid_topm: int = 1,
   104	                 conf_tau: float = 0.0, conf_consensus: float = 0.0, frame_gain: float = 0.0, warmup_oracle_s: float = 0.0,
   105	                 reid_tavg: float = 0.0, reid_motion: float = 0.0, reid_motion_gate_px: float = 160.0,
   106	                 gallery_seed: str = "gt", reanchor: str = "off",
   107	                 reanchor_patience: int = 5, reanchor_tavg: float = 0.0, assoc_mode: str = "deepsort",
   108	                 assoc_gate_px: float = 160.0, assoc_lambda: float = 1.0,
   109	                 dam4sam_host: str = "dam4sam-svc", dam4sam_port: int = 5601,
   110	                 tah_ckpt: str = "runs/tah_rel.pt", asd: str = "off", asd_cfg: str = "",
   111	                 tracklets: str = "sim", occl_cands: bool = False, event_override: bool = False):
   112	        self.device = device
   113	        self.cfg = cfg
   114	        self.vlm = vlm                              # OnlineVLM (owns the frozen backbone + language mode)
   115	        self.image_cfg = cfg["image"]
   116	        self.a_scale = float(cfg["action"]["scale"])
   117	        self.steps = int(cfg["flow"]["sample_steps"])
   118	        self.s2_period = int(s2_period)
   119	        self._shuffle_seed = int(shuffle_seed)
   120	        # H1/H2 module ablation: zero the EAR/IAR stream into the DiT, matching a ckpt
   121	        # trained with the same ablation (train/config_v5_no{ear,iar}.yaml). None = full.
   122	        self.ablate = ablate                        # None | "ear" | "iar"
   123	        # memory+CV target-state prior for z_ex during a loss (rollout.target_state).
   124	        if ex_source not in _EX_MODES:
   125	            raise ValueError(f"ex_source must be one of {list(_EX_MODES)}, got {ex_source!r}")
   126	        self.ex_source = ex_source
   127	        self._ex_mode, self._ex_gated = _EX_MODES[ex_source]   # (None,None) for 'ear'
   128	        self._track = (ex_source == "track")                   # Plan A: grounding drives control
   129	        self.commit_k = int(commit_k)                          # hysteresis frames to switch target
   130	        self.conf_tau = float(conf_tau)                        # ①: min pick-margin to commit-fly (track)
   131	        self.conf_consensus = float(conf_consensus)            # borrow#2: also require the pick's motion-consistency
   132	                                                               # (dist < conf_consensus·gate) to commit-fly (0=off)
   133	        self.frame_gain = float(frame_gain)                    # ②: yaw-centering gain on committed target
   134	        self.warmup_oracle_s = float(warmup_oracle_s)          # diag: first N s use oracle id (est. tracking)
   135	        self.reid_tavg = float(reid_tavg)                      # temporal re-ID: per-actor EMA of match score
   136	        self.reid_motion = float(reid_motion)                  # borrow#1: motion-consensus weight fused into reid score (0=off)
   137	        self.reid_motion_gate_px = float(reid_motion_gate_px)  # borrow#1: motion soft-gate radius (px)
   138	        # deployable identity (paper2): gallery_seed 'gt'=legacy oracle-seeded template |
   139	        # 'committed'=GT-free (store the believed-target crop). reanchor 'off'|'lang'=language re-anchor
   140	        # on sustained collapse |'oracle'=GT re-anchor (headroom bound). See memory acot-uav-reid-reframe.
   141	        self.gallery_seed = gallery_seed
   142	        self.reanchor = reanchor
   143	        self.reanchor_patience = int(reanchor_patience)        # consecutive low-margin S2 ticks before re-anchor fires
   144	        self.reanchor_tavg = float(reanchor_tavg)              # temporal language re-anchor: per-actor EMA of language logit (0=single-frame)
   145	        # 1003_dynamic-retarget-design.md §2.3 S1 (GT-driven): on obs.retarget_event, hard-reset
   146	        # TAHRelM memory + PGIF belief to the (currently GT) new target instead of waiting for
   147	        # evidence to out-accumulate the old target. Independent of `reanchor` (different trigger:
   148	        # external event, not detected drift) — only wired for tid_head="tah"/"fusion" + committed.
   149	        self.event_override = bool(event_override)
   150	        self._override_events = 0
   151	        self.fps = int(cfg.get("fps", 10))
   152	        wp = cfg["waypoint"]
   153	        self.estimator = TargetStateEstimator(wp["offsets_s"], wp["scale"], cfg.get("fps", 10))
   154	
   155	        # DAgger collection: if DAGGER_DIR is set, log per-frame (cand_feats, true_idx,
   156	        # target color/make) from the closed-loop distribution → retrain the tid on the
