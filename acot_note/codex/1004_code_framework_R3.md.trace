   306	      f"- Shell:{len(shf)} 个文件(`" + "`、`".join(SH_SCOPES) + "`)\n\n| 排除 | 原因 |\n|---|---|\n")
   307	    for g, why in EXCLUDES:
   308	        w(f"| `{g}` | {why} |\n")
   309	    if broken:
   310	        w("\n**无法解析的文件**(需人工检查):" + "; ".join(f"`{f}` ({m})" for f, m in broken) + "\n")
   311	    cats = {}
   312	    for f in pyf:
   313	        cats.setdefault(category(f), []).append(os.path.basename(f))
   314	    w("\n| 文件类别 | 文件数 |\n|---|---|\n" + "".join(f"| {c} | {len(v)} |\n" for c, v in sorted(cats.items())))
   315	    w(f"\n## 1. argparse 参数({len(a)} 个)与 sys.argv 位置参数({len(argv_rows)} 个文件)\n\n"
   316	      "| 位置 | 文件类别 | 参数 | 默认值 | 分类 |\n|---|---|---|---|---|\n")
   317	    for loc, cat, flag, d, c in a:
   318	        w(f"| `{loc}` | {cat} | `{flag}` | `{d}` | {c} |\n")
   319	    w("\n| 文件 | 文件类别 | sys.argv 下标 |\n|---|---|---|\n")
   320	    for f, cat, idx in argv_rows:
   321	        w(f"| `{f}` | {cat} | {idx} |\n")
   322	    w(f"\n## 2. 构造函数参数与 JSON 配置字段({len(s)} 个)\n\n"
   323	      "Policy 的 kwarg 由 policy_server 的同名 flag 传入;ASD、TrackletAssigner、AttrScorer、ZoomVerifier 的 kwarg 由对应的 JSON 字符串展开传入"
   324	      "(`**json.loads(...)`),未知字段在运行时才报 TypeError;OPENING_CFG 先被 Policy pop 掉 6 个字段。\n\n"
   325	      "| 位置 | 来源通道 | 字段 | 默认值 | 分类 |\n|---|---|---|---|---|\n")
   326	    for loc, src, k, d, c in s:
   327	        w(f"| `{loc}` | {src} | `{k}` | `{d}` | {c} |\n")
   328	    w(f"\n## 3. 环境变量读写({len(e)} 个变量 + {len(dyn)} 处动态键写入)\n\n| 变量 | 位置(读/写) | 默认值 | 分类 |\n|---|---|---|---|\n")
   329	    for var in sorted(e):
   330	        locs = "<br>".join(f"`{l}` {rw}" for l, rw, _, _ in e[var])
   331	        d = next((x for _, rw, x, _ in e[var] if rw == "read"), "—")
   332	        cs = sorted({classify(var, c) for _, _, _, c in e[var]})
   333	        w(f"| `{var}` | {locs} | `{d}` | {' / '.join(cs)} |\n")
   334	    for loc, key, cat in dyn:
   335	        w(f"| `<动态键 {key}>` | `{loc}` WRITE | `—` | {cat} |\n")
   336	    w(f"\n## 4. env → policy 线协议字段({len(WIRE)} 项，人工整理，依据 `remote_policy.py`、`policy_server.py`、`env.py`、`policy.py`、`candidates.py`)\n\n"
   337	      "| 字段 | 内容 | 分类 |\n|---|---|---|\n")
   338	    for k, what, c in WIRE:
   339	        w(f"| `{k}` | {what} | {c} |\n")
   340	    w(f"\n## 5. 启动脚本({len(L)} 个)\n\n"
   341	      "静态提取，作为交叉核对;权威的调用参数由 P0b 的 docker shim 实际捕获(见框架文档 §9 L0)。每个脚本列出：调用的入口、docker 操作、"
   342	      "出现的全部 `--flag`、写死的行为环境变量赋值(不含 `VAR=${VAR:-默认}` 这种自身默认)、`${VAR:-…}` 可调参数、位置参数。\n\n"
   343	      "| 脚本 | 入口 | docker | 出现的 flag | 写死的行为环境变量 | 可调参数 | 位置参数 |\n|---|---|---|---|---|---|---|\n")
   344	    for row in L:
   345	        w("| `" + row[0] + "` | " + " | ".join(r.replace("|", "\\|") for r in row[1:]) + " |\n")
   346	    w(f"\n## 6. 行为常量与已知冲突({len(CONSTANTS)} 项，人工整理;实现时复核行号)\n\n| 位置 | 内容 | 分类 |\n|---|---|---|\n")
   347	    for f, what, c in CONSTANTS:
   348	        w(f"| `{f}` | {what} | {c} |\n")
   349	
   350	
   351	if __name__ == "__main__":
   352	    main()

