   201	def argparse_rows(pyfiles):
   202	    rows, argv_rows, broken = [], [], []
   203	    for f in pyfiles:
   204	        src = open(os.path.join(ROOT, f), errors="ignore").read()
   205	        cat = category(f)
   206	        try:
   207	            tree = ast.parse(src)
   208	        except SyntaxError as e:
   209	            broken.append((f, str(e)))
   210	            continue
   211	        for n in ast.walk(tree):
   212	            if isinstance(n, ast.Call) and getattr(n.func, "attr", "") == "add_argument":
   213	                names = [a.value for a in n.args if isinstance(a, ast.Constant) and isinstance(a.value, str)]
   214	                kw = {k.arg: k.value for k in n.keywords}
   215	                if "default" in kw:
   216	                    d = lit(kw["default"])
   217	                elif "action" in kw and lit(kw["action"]) == "'store_true'":
   218	                    d = "False"
   219	                else:
   220	                    d = "—"
   221	                flag = next((x for x in names if x.startswith("--")), names[0] if names else "?")
   222	                rows.append((f"{f}:{n.lineno}", cat, flag, d, classify(flag, cat)))
   223	        idx = sorted(set(re.findall(r"sys\.argv\[(\d+)", src)))
   224	        if idx:
   225	            argv_rows.append((f, cat, ", ".join(f"argv[{i}]" for i in idx)))
   226	    return rows, argv_rows, broken
   227	
