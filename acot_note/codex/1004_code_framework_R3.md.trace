  1022	                        if o.get("kind") == "absent":
  1023	                            # absence hypothesis: PGIF's MAP tracklet is not visible this tick → make NO pick (the
  1024	                            # commitment is held; WHERE coasts on its CV estimate) and undo this tick's memory write
  1025	                            # (the memory's own pick is, by the posterior, not the target).
  1026	                            self._pred_slot = -1; self._pred_conf = 0.0
