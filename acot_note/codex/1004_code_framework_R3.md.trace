    50	def category(rel):
    51	    base = os.path.splitext(os.path.basename(rel))[0]
    52	    if rel.startswith("runs/data_v6/"):
    53	        return "other-owner"
    54	    if base.startswith(TEST_PREFIX):
    55	        return "test"
    56	    if rel.startswith(R + "/"):
    57	        if base in RUNTIME:
    58	            return "runtime"
    59	        return "offline" if base in OFFLINE_ROLLOUT else "analysis"
    60	    if rel.startswith(("carla_uav_tracking/scene/",)):
    61	        return "runtime"
    62	    if rel.startswith(("carla_uav_tracking/scripts/", "carla_uav_tracking/recording/", "iter/")) or \
    63	            rel == "runs/tah_v90/b_fill.py":
    64	        return "datagen"
    65	    if rel.startswith(("train/", "acot_probe/")):
    66	        return "offline"
    67	    return "analysis"
