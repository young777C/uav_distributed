   160	def files(scopes):
   161	    out = set()
   162	    for g in scopes:
   163	        for p in glob.glob(os.path.join(ROOT, g), recursive=True):
   164	            r = rel(p)
   165	            if os.path.isfile(p) and not excluded(r):
   166	                out.add(r)
   167	    return sorted(out)
